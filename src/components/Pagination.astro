---
interface Props {
	page: number;
	totalPages: number;
	total: number;
	pageSize: number;
	label?: string;
}

const { page, totalPages, total, pageSize, label = "results" } = Astro.props;

const href = (n: number) => {
	const u = new URL(Astro.url);
	if (n <= 1) u.searchParams.delete("page");
	else u.searchParams.set("page", String(n));
	return u.pathname + u.search;
};

const first = total === 0 ? 0 : (page - 1) * pageSize + 1;
const last = Math.min(page * pageSize, total);
---

{totalPages > 1 && (
	<nav class="pager" aria-label="Pagination">
		{page > 1 ? (
			<a class="pager__link" href={href(page - 1)} rel="prev">&larr; Previous</a>
		) : (
			<span class="pager__link pager__link--off" aria-hidden="true">&larr; Previous</span>
		)}
		<span class="pager__status">
			{first.toLocaleString()}&ndash;{last.toLocaleString()} of {total.toLocaleString()} {label} &middot; page {page} of {totalPages}
		</span>
		{page < totalPages ? (
			<a class="pager__link" href={href(page + 1)} rel="next">Next &rarr;</a>
		) : (
			<span class="pager__link pager__link--off" aria-hidden="true">Next &rarr;</span>
		)}
	</nav>
)}

<style>
	.pager {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin: 40px 0 0;
		padding-top: 20px;
		border-top: 1px solid var(--rule);
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.04em;
		color: var(--ink-3);
	}
	.pager__link {
		padding: 8px 14px;
		border: 1px solid var(--rule-strong);
		border-radius: var(--r-2);
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
	}
	a.pager__link:hover { background: var(--paper-2); border-color: var(--ink); }
	.pager__link--off { opacity: 0.35; }
	@media (max-width: 600px) {
		.pager { flex-wrap: wrap; justify-content: center; }
		.pager__status { order: -1; width: 100%; text-align: center; }
	}
</style>
