---
import { renderRegisterSeal, type RegisterSealOptions } from "../../lib/register-seal";

type Props = RegisterSealOptions & { class?: string; label?: string };

const { class: className, label, title, ...opts } = Astro.props;
---

<span class:list={["r-seal", className]} set:html={renderRegisterSeal({ ...opts, title: title ?? label })} />

<style>
	.r-seal { display: inline-block; line-height: 0; flex: none; }
</style>
