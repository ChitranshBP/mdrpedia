---
interface Props {
	active?: "" | "find" | "regions" | "register" | "evidence";
}

const { active = "" } = Astro.props;

const links = [
	{ key: "find", label: "Find a doctor", href: "/search" },
	{ key: "regions", label: "Regions", href: "/geography/india" },
	{ key: "register", label: "Register", href: "/doctors" },
	{ key: "evidence", label: "Evidence", href: "/evidence" },
];

const menus = [
	{
		id: "explore",
		label: "Explore",
		groups: [
			{
				h: "BROWSE THE REGISTER",
				links: [
					{ l: "Specialties", d: "Every field, with its physicians", h: "/specialty" },
					{ l: "Institutions", d: "Hospitals, universities and institutes", h: "/institutions" },
					{ l: "Rankings", d: "Top 100 and tier lists", h: "/rankings" },
					{ l: "Global leaders", d: "Physicians who shaped their field", h: "/global-leaders" },
					{ l: "Compare doctors", d: "Side by side, on the evidence", h: "/compare" },
					{ l: "Lineage", d: "Who trained whom", h: "/lineage" },
					{ l: "Map", d: "Physicians by place", h: "/map" },
				],
			},
			{
				h: "MEDICINE",
				links: [
					{ l: "Rare diseases", d: "Conditions and the specialists who treat them", h: "/rare-diseases" },
					{ l: "Clinical trials", d: "Trials recruiting now", h: "/clinical-trials" },
					{ l: "Communities", d: "Specialty communities", h: "/communities" },
					{ l: "Prizes & honours", d: "The awards medicine gives", h: "/prizes" },
					{ l: "Nobel laureates", d: "Physiology or Medicine", h: "/nobel-laureates" },
					{ l: "News", d: "Medical news, sourced", h: "/news" },
					{ l: "Statistics", d: "The register in numbers", h: "/statistics" },
				],
			},
		],
	},
	{
		id: "doctors",
		label: "For doctors",
		cta: true,
		groups: [
			{
				h: "YOUR RECORD",
				links: [
					{ l: "Claim your record", d: "Correct details, add your work, embed your seal", h: "/doctor/claim" },
					{ l: "Free NMC compliance check", d: "Check your website and social posts against the 2026 guidelines", h: "/nmc-compliance-check", tag: "FREE" },
					{ l: "Add a profile", d: "Not on the register yet?", h: "/doctor/add-profile" },
					{ l: "Doctor sign in", d: "Manage your claimed record", h: "/login" },
				],
			},
			{
				h: "ETHICS",
				links: [
					{ l: "Ethics Register", d: "Audited ethical practice", h: "/ethical-doctors" },
					{ l: "Ethical workplaces", d: "Certified clinics and hospitals", h: "/ethical-workplace" },
					{ l: "Methodology", d: "How records and scores work", h: "/methodology" },
				],
			},
		],
	},
];

const countries = [
	{ name: "India", reg: "NMC · NMR", slug: "india" },
	{ name: "United States", reg: "STATE BOARDS", slug: "united-states" },
	{ name: "United Kingdom", reg: "GMC", slug: "united-kingdom" },
];
---

<header class="r-header" data-country="India">
	<div class="r-header__bar">
		<a href="/" class="r-header__logo">MDRPedia</a>
		<nav class="r-header__nav" aria-label="Primary">
			{links.slice(0, 3).map((l) => (
				<a href={l.href} data-nav={l.key} aria-current={l.key === active ? "page" : undefined}>{l.label}</a>
			))}
			<button type="button" class="r-menu__btn" aria-expanded="false" aria-controls="r-menu-explore">Explore <span aria-hidden="true">▾</span></button>
			{links.slice(3).map((l) => (
				<a href={l.href} data-nav={l.key} aria-current={l.key === active ? "page" : undefined}>{l.label}</a>
			))}
		</nav>
		<div class="r-country">
			<button type="button" class="r-country__btn" aria-haspopup="true" aria-expanded="false" aria-controls="r-country-menu">
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
				<span class="r-sr-only">Register country:</span>
				<span data-country-label>India</span>
				<span class="r-country__caret" aria-hidden="true">▾</span>
			</button>
			<div class="r-country__menu" id="r-country-menu" role="menu" hidden>
				<span class="r-country__label" aria-hidden="true">SHOWING DOCTORS REGISTERED IN</span>
				{countries.map((c) => (
					<button type="button" class="r-country__opt" role="menuitemradio" aria-checked={c.name === "India" ? "true" : "false"} data-name={c.name} data-slug={c.slug}>
						<span>{c.name}</span><span>{c.reg}</span>
					</button>
				))}
				<span class="r-country__note">Set from your location. Regions opens the register for this country.</span>
			</div>
		</div>
		<button type="button" class="r-header__cta r-menu__btn" aria-expanded="false" aria-controls="r-menu-doctors">For doctors <span aria-hidden="true">▾</span></button>
	</div>
	{menus.map((m) => (
		<div class="r-menu" id={`r-menu-${m.id}`} hidden>
			<div class="r-menu__inner">
				{m.groups.map((g) => (
					<nav class="r-menu__group" aria-label={`${m.label}: ${g.h.toLowerCase()}`}>
						<h2>{g.h}</h2>
						<ul>
							{g.links.map((k) => (
								<li>
									<a href={k.h}>
										<span class="r-menu__label">{k.l}{"tag" in k && k.tag && <em>{k.tag}</em>}</span>
										<span class="r-menu__desc">{k.d}</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
				))}
			</div>
		</div>
	))}
	<div class="r-header__stripe" aria-hidden="true"></div>
</header>

<script is:inline>
	(() => {
		const header = document.currentScript.previousElementSibling;
		const slugs = { India: "india", "United States": "united-states", "United Kingdom": "united-kingdom" };
		const guess = () => {
			try {
				const saved = localStorage.getItem("mdr-country");
				if (saved && slugs[saved]) return saved;
			} catch (e) {}
			const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
			if (/Kolkata|Calcutta/.test(tz)) return "India";
			if (tz.startsWith("America/")) return "United States";
			if (tz === "Europe/London") return "United Kingdom";
			return "India";
		};
		const apply = (name) => {
			header.dataset.country = name;
			header.querySelector("[data-country-label]").textContent = name;
			header.querySelector('[data-nav="regions"]').href = "/geography/" + slugs[name];
			header.querySelectorAll(".r-country__opt").forEach((o) => o.setAttribute("aria-checked", String(o.dataset.name === name)));
		};
		apply(guess());
		document.addEventListener("DOMContentLoaded", () => {
			const view = document.querySelector("[data-view-country]");
			if (view && slugs[view.dataset.viewCountry]) apply(view.dataset.viewCountry);
		});

		const btn = header.querySelector(".r-country__btn");
		const menu = header.querySelector(".r-country__menu");
		const opts = [...menu.querySelectorAll(".r-country__opt")];
		const setOpen = (open, focusBtn) => {
			menu.hidden = !open;
			btn.setAttribute("aria-expanded", String(open));
			if (open) (opts.find((o) => o.getAttribute("aria-checked") === "true") || opts[0]).focus();
			else if (focusBtn) btn.focus();
		};
		btn.addEventListener("click", () => setOpen(menu.hidden));
		menu.addEventListener("click", (e) => {
			const opt = e.target.closest(".r-country__opt");
			if (!opt) return;
			try { localStorage.setItem("mdr-country", opt.dataset.name); } catch (err) {}
			apply(opt.dataset.name);
			window.dispatchEvent(new Event("mdr-country"));
			setOpen(false, true);
		});
		menu.addEventListener("keydown", (e) => {
			const i = opts.indexOf(document.activeElement);
			if (e.key === "Escape") setOpen(false, true);
			else if (e.key === "ArrowDown") { e.preventDefault(); opts[(i + 1) % opts.length].focus(); }
			else if (e.key === "ArrowUp") { e.preventDefault(); opts[(i - 1 + opts.length) % opts.length].focus(); }
		});
		document.addEventListener("click", (e) => {
			if (!menu.hidden && !header.querySelector(".r-country").contains(e.target)) setOpen(false);
		});

		const menuBtns = [...header.querySelectorAll(".r-menu__btn")];
		const panelOf = (b) => document.getElementById(b.getAttribute("aria-controls"));
		const closeMenus = (except) => menuBtns.forEach((b) => {
			if (b === except) return;
			b.setAttribute("aria-expanded", "false");
			panelOf(b).hidden = true;
		});
		menuBtns.forEach((b) => b.addEventListener("click", () => {
			const open = b.getAttribute("aria-expanded") !== "true";
			closeMenus(b);
			setOpen(false);
			b.setAttribute("aria-expanded", String(open));
			panelOf(b).hidden = !open;
			if (open) panelOf(b).querySelector("a").focus();
		}));
		btn.addEventListener("click", () => closeMenus());
		header.addEventListener("keydown", (e) => {
			if (e.key !== "Escape") return;
			const openBtn = menuBtns.find((b) => b.getAttribute("aria-expanded") === "true");
			if (openBtn) { closeMenus(); openBtn.focus(); }
		});
		document.addEventListener("click", (e) => {
			if (!header.contains(e.target)) closeMenus();
		});
	})();
</script>
