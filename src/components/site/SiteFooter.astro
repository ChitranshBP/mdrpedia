---
const cols = [
	{
		h: "REGISTER",
		links: [
			{ l: "Find a doctor", h: "/search" },
			{ l: "Browse physicians", h: "/doctors" },
			{ l: "By region", h: "/geography" },
			{ l: "Specialties", h: "/specialty" },
			{ l: "Institutions", h: "/institutions" },
			{ l: "Rankings", h: "/rankings" },
			{ l: "Compare doctors", h: "/compare" },
		],
	},
	{
		h: "MEDICINE",
		links: [
			{ l: "Rare diseases", h: "/rare-diseases" },
			{ l: "Clinical trials", h: "/clinical-trials" },
			{ l: "Prizes & honours", h: "/prizes" },
			{ l: "Nobel laureates", h: "/nobel-laureates" },
			{ l: "Global leaders", h: "/global-leaders" },
			{ l: "Lineage", h: "/lineage" },
			{ l: "News", h: "/news" },
		],
	},
	{
		h: "FOR DOCTORS",
		links: [
			{ l: "Claim your record", h: "/doctor/claim" },
			{ l: "Free NMC compliance check", h: "/nmc-compliance-check" },
			{ l: "Ethics Register", h: "/ethical-doctors" },
			{ l: "Ethical workplaces", h: "/ethical-workplace" },
			{ l: "Add a profile", h: "/doctor/add-profile" },
			{ l: "Doctor sign in", h: "/login" },
		],
	},
	{
		h: "INSTITUTION",
		links: [
			{ l: "Evidence standard", h: "/evidence" },
			{ l: "Methodology", h: "/methodology" },
			{ l: "About", h: "/about" },
			{ l: "Identity", h: "/brand" },
			{ l: "Statistics", h: "/statistics" },
			{ l: "Contact", h: "/contact" },
			{ l: "Privacy", h: "/privacy" },
			{ l: "Terms", h: "/terms" },
		],
	},
];
---

<footer class="r-footer">
	<div class="r-footer__inner">
		<div class="r-footer__cols">
			<div class="r-footer__brand">
				<span>MDRPedia</span>
				<p>The honour roll of medicine. An open, sourced register of the physicians who shaped it. Also known as MDpedia and DRpedia.</p>
			</div>
			{cols.map((c) => (
				<nav class="r-footer__col" aria-labelledby={`r-foot-${c.h}`}>
					<h2 id={`r-foot-${c.h}`}>{c.h}</h2>
					{c.links.map((k) => <a href={k.h}>{k.l}</a>)}
				</nav>
			))}
		</div>
		<div class="r-footer__base">
			<span>MDRPEDIA · EST. 2024 · CC-BY-SA 4.0</span>
			<span>EVERY CLAIM SOURCED · EVERY MARK REVOCABLE</span>
		</div>
	</div>
</footer>
