---
Astro.response.status = 500;
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/pages/utility.css";
---

<SiteLayout
	title="Server error | MDRPedia"
	description="Something went wrong on MDRPedia. Please try again shortly."
	robots="noindex, nofollow"
>
	<div class="u-page">
		<div class="u-wrap u-error">
			<p class="u-error__code" aria-hidden="true">500</p>
			<span class="u-kicker">SOMETHING WENT WRONG</span>
			<h1 class="u-h1">Our server <em>stumbled.</em></h1>
			<p class="u-lede">
				It was an unexpected error on our side. Try again in a moment. If it keeps happening,
				<a href="/contact">tell us what you were doing</a> and we will look into it.
			</p>
			<ul class="u-links">
				<li><a href="/">Home</a></li>
				<li><a href="/doctors">Browse doctors</a></li>
				<li><a href="/contact">Contact support</a></li>
			</ul>
		</div>
	</div>
</SiteLayout>
