---
/**
 * MDRPedia — Top 100 Medical Professionals
 * Flagship leaderboard page with filter tabs
 */
import '../../styles/pages/directory.css';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getTop100 } from '../../lib/ranking';

export const prerender = false;

const specialty = Astro.url.searchParams.get('specialty') || undefined;
const country = Astro.url.searchParams.get('country') || undefined;

const top100 = await getTop100({ specialty, country });

// Get distinct specialties and countries from the unfiltered list for filter tabs
const allTop100 = await getTop100();
const specialties = [...new Set(allTop100.map(d => d.specialty))].sort();
const countries = [...new Set(allTop100.map(d => d.geography?.country).filter(Boolean))].sort() as string[];

const tierLabels: Record<string, string> = {
    TITAN: 'Titan',
    ELITE: 'Elite',
    MASTER: 'Master',
    UNRANKED: '',
};

function buildUrl(params: Record<string, string | undefined>): string {
    const url = new URL('/rankings/top-100', 'https://mdrpedia.com');
    for (const [key, val] of Object.entries(params)) {
        if (val) url.searchParams.set(key, val);
    }
    return url.pathname + url.search;
}

const filtered = Boolean(specialty || country);
---

<SiteLayout
    title="Top 100 Medical Professionals — MDRPedia"
    description="The definitive ranking of the world's 100 most impactful medical professionals, based on research output, clinical impact, and humanitarian contribution."
    active=""
    robots={filtered ? "noindex, follow" : undefined}
>
	<div class="dx">
		<header class="dx-hero">
			<div class="dx-hero__inner">
				<nav class="dx-crumbs" aria-label="Breadcrumb">
					<a href="/">Home</a><span aria-hidden="true">/</span><a href="/rankings">Rankings</a><span aria-hidden="true">/</span><span aria-current="page">Top 100</span>
				</nav>
				<span class="dx-eyebrow">GLOBAL LEADERBOARD</span>
				<h1>MDRPedia Top 100</h1>
				<p class="dx-lede">The most impactful physicians in the register, ranked by composite score.</p>
			</div>
		</header>

		<div class="dx-main">
			<div class="dx-controls">
				<label class="r-sr-only" for="specialty-filter">Specialty</label>
				<select class="dx-select" id="specialty-filter" data-nav>
					<option value="/rankings/top-100" selected={!specialty}>All specialties</option>
					{specialties.map((s) => <option value={buildUrl({ specialty: s, country })} selected={specialty === s}>{s}</option>)}
				</select>
				<label class="r-sr-only" for="country-filter">Country</label>
				<select class="dx-select" id="country-filter" data-nav>
					<option value={buildUrl({ specialty })} selected={!country}>All countries</option>
					{countries.map((c) => <option value={buildUrl({ specialty, country: c })} selected={country === c}>{c}</option>)}
				</select>
				{filtered && <a href="/rankings/top-100" class="dx-btn dx-btn--ghost">Clear filters</a>}
			</div>

			{filtered && (
				<div class="dx-chips" aria-label="Active filters">
					{specialty && <a href={buildUrl({ country })} aria-current="true">{specialty} &times;</a>}
					{country && <a href={buildUrl({ specialty })} aria-current="true">{country} &times;</a>}
				</div>
			)}

			{top100.length > 0 ? (
				<div class="dx-scroll dx-scroll--stack" tabindex="0" role="region" aria-label="Top 100 leaderboard">
					<table class="dx-table dx-stack">
						<caption class="r-sr-only">Top 100 medical professionals by composite score</caption>
						<thead>
							<tr>
								<th scope="col">Rank</th><th scope="col">Physician</th><th scope="col">Tier</th>
								<th scope="col">h-index</th><th scope="col">Country</th><th scope="col">Score</th>
							</tr>
						</thead>
						<tbody>
							{top100.map((doctor) => (
								<tr>
									<td class="rank">{doctor.globalRank}</td>
									<td class="who">
										<a href={`/doctors/${doctor.slug}`}>{doctor.fullName}</a>
										<span class="sub">{doctor.specialty}</span>
									</td>
									<td class:list={["dx-tier", `dx-tier--${(doctor.tier || "unranked").toLowerCase()}`, { "is-none": !tierLabels[doctor.tier] }]} data-label="Tier">{tierLabels[doctor.tier]}</td>
									<td class:list={["num", { "is-none": !doctor.hIndex }]} data-label="h-index">{doctor.hIndex || ""}</td>
									<td class:list={["sub", { "is-none": !doctor.geography?.country }]}>{doctor.geography?.country}</td>
									<td class="num" data-label="Score"><strong>{Math.round(doctor.score).toLocaleString()}</strong></td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			) : (
				<p class="dx-empty">No doctors match the selected filters. <a href="/rankings/top-100">View all Top 100</a></p>
			)}

			<p class="dx-note">
				Rankings use the MDRPedia composite score, built from each physician's published research record and verified recognition.
				See the <a href="/methodology">methodology</a> and the <a href="/evidence">evidence standard</a>.
			</p>
		</div>
	</div>
</SiteLayout>

<script>
	document.querySelectorAll<HTMLSelectElement>("select[data-nav]").forEach((el) =>
		el.addEventListener("change", () => { window.location.href = el.value; }),
	);
</script>
