---
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
    getPublishedNews,
    byDateDesc,
    getCategoryInfo,
} from "../../lib/news";
import "../../styles/pages/feed.css";

export const prerender = true;

// Scheduled (future-dated) entries have no public URL until their date.
export async function getStaticPaths() {
    const newsEntries = await getPublishedNews();
    return newsEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { title, summary, date, category, source, url, content } = entry.data;

// Related articles, drawn from the published feed only
const allNews = await getPublishedNews();
// Prefer same-category articles, then fill with recent ones
const sameCategoryArticles = allNews
    .filter(n => n.id !== entry.id && n.data.category === category)
    .sort(byDateDesc);
const otherArticles = allNews
    .filter(n => n.id !== entry.id && n.data.category !== category)
    .sort(byDateDesc);
const relatedArticles = [...sameCategoryArticles, ...otherArticles].slice(0, 3);


const catInfo = getCategoryInfo(category);

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
    });
}

function formatShortDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        timeZone: "UTC",
    });
}

function getReadingTime(text: string) {
    const wordsPerMinute = 200;
    const words = (text || '').split(/\s+/).length + (summary || '').split(/\s+/).length;
    const minutes = Math.ceil(words / wordsPerMinute);
    return minutes < 1 ? '1 min read' : `${minutes} min read`;
}

const shareUrl = `https://mdrpedia.com/news/${entry.id}`;
const shareText = encodeURIComponent(title);

// NewsArticle JSON-LD for SEO
const newsArticleSchema = {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": title,
    "description": summary,
    "datePublished": date,
    "dateModified": date,
    "author": {
        "@type": "Organization",
        "name": "MDRPedia Editorial",
        "url": "https://mdrpedia.com"
    },
    "publisher": {
        "@type": "Organization",
        "name": "MDRPedia",
        "url": "https://mdrpedia.com",
        "logo": {
            "@type": "ImageObject",
            "url": "https://mdrpedia.com/og-default.png"
        }
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": shareUrl
    },
    "image": "https://mdrpedia.com/og-default.png",
    "articleSection": category,
    "wordCount": ((content || '').split(/\s+/).length + (summary || '').split(/\s+/).length),
    ...(source && { "citation": { "@type": "CreativeWork", "name": source, ...(url && { "url": url }) } })
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mdrpedia.com" },
        { "@type": "ListItem", "position": 2, "name": "News", "item": "https://mdrpedia.com/news" },
        { "@type": "ListItem", "position": 3, "name": title }
    ]
};
---

<SiteLayout
    title={`${title} — MDRPedia News`}
    description={summary}
    active=""
    ogType="article"
    jsonLd={[newsArticleSchema, breadcrumbSchema]}
>
    <div class="fd">
        <article class="fd-article">
            <header class="fd-article__head">
                <nav class="fd-crumbs" aria-label="Breadcrumb">
                    <a href="/news">News</a><span aria-hidden="true">/</span><span aria-current="page">{catInfo.label}</span>
                </nav>
                <div class="fd-article__meta">
                    <span class="cat">{catInfo.label}</span>
                    <time datetime={date}>{formatDate(date)}</time>
                    <span>{getReadingTime(content || '')}</span>
                </div>
                <h1>{title}</h1>
                <p class="fd-article__source">
                    Source: <strong>{source}</strong>
                    {url && <a href={url} target="_blank" rel="noopener noreferrer">View original ↗</a>}
                </p>
            </header>

            <p class="fd-lead">{summary}</p>

            <div class="fd-prose">
                {content ? (
                    content.split('\n\n').map((paragraph: string) => <p>{paragraph}</p>)
                ) : (
                    <div class="fd-pending">
                        <b>Full report coming soon</b>
                        Our editorial team is preparing an in-depth analysis of this story. Check back soon for the complete coverage.
                    </div>
                )}
            </div>

            <div class="fd-share">
                <span class="label">Share</span>
                <a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener noreferrer">X (Twitter)</a>
                <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${shareUrl}&title=${shareText}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
                <button type="button" id="copy-link">Copy link</button>
            </div>

            <p class="fd-note">
                Reported from {source}. For corrections or updates, please <a href="/contact">contact the newsroom</a>.
            </p>

            {relatedArticles.length > 0 && (
                <section class="fd-sec" aria-labelledby="related-h">
                    <div class="fd-sec__head"><h2 id="related-h">Related articles</h2></div>
                    <ol class="fd-list">
                        {relatedArticles.map((article) => (
                            <li class="fd-item">
                                <div class="fd-item__meta">
                                    <span class="cat">{getCategoryInfo(article.data.category).label}</span>
                                    <time datetime={article.data.date}>{formatShortDate(article.data.date)}</time>
                                </div>
                                <div>
                                    <h3><a href={`/news/${article.id}`}>{article.data.title}</a></h3>
                                    <span class="src">{article.data.source}</span>
                                </div>
                            </li>
                        ))}
                    </ol>
                </section>
            )}

            <p class="fd-note"><a href="/news">← Browse all articles</a></p>
        </article>
    </div>
</SiteLayout>

<script>
    const copyBtn = document.getElementById('copy-link');

    copyBtn?.addEventListener('click', async () => {
        try {
            await navigator.clipboard.writeText(window.location.href);
            copyBtn.textContent = 'Link copied';
            setTimeout(() => { copyBtn.textContent = 'Copy link'; }, 2000);
        } catch (err) {
            console.error('Failed to copy:', err);
        }
    });
</script>
