---
/**
 * MDRPedia — Find a doctor (patient-facing search).
 * Country-scoped, plain-language matching ("chest pain" → heart specialists),
 * alphabetical order: no ratings, rankings or "best" claims.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import Pagination from "../components/Pagination.astro";
import "../styles/pages/listing-theme.css";
import "../styles/pages/find-doctor.css";
import { getCollection } from "astro:content";
import { normalizeSpecialty } from "../lib/specialty-groups";
import {
	ALL_COUNTRIES,
	CONDITIONS,
	REGISTER_COUNTRIES,
	displayName,
	fold,
	initials,
	matchQuery,
	matchesCondition,
	plainSpecialty,
	queryTokens,
	resolveCountry,
	type FinderDoctor,
} from "../lib/find-doctor";

export const prerender = false;

const PAGE_SIZE = 20;
const DEFAULT_COUNTRY = REGISTER_COUNTRIES[0];
const DEGREE = /^(MBBS|MBChB|MB\b|BM\b|MD|MS|DM|MCh|M\.Ch|DNB|PhD|DPhil|FRCS|FRCP|FRCPath|FACC|FACS|FACP|MPH|MMed|MRCP|DCH|DGO|MSc|DSc)/i;

const params = Astro.url.searchParams;
const query = (params.get("q") || "").trim().slice(0, 120);
const countryParam = (params.get("country") || "").trim();
const isAll = countryParam.toLowerCase() === ALL_COUNTRIES;
const country = isAll ? null : resolveCountry(countryParam) ?? (countryParam ? null : DEFAULT_COUNTRY);
// Legacy links pass any country name (?country=Germany): filter on it without a register theme.
const otherCountryParam = !isAll && countryParam && !country ? countryParam.slice(0, 60) : "";
const cond = CONDITIONS.find((c) => c.key === params.get("cond")) ?? null;
const cityParam = (params.get("city") || "").trim().slice(0, 80);
const regionParam = (params.get("region") || params.get("state") || "").trim().slice(0, 80);
const specialtyParam = (params.get("specialty") || "").trim();
const requestedPage = Math.max(1, parseInt(params.get("page") || "1", 10) || 1);

type Row = FinderDoctor & {
	country: string;
	living: boolean;
	qualifications: string;
	highlights: string[];
};

const qualificationsOf = (education: string[] | null | undefined, title: string | null | undefined) => {
	const degrees = (education || [])
		.map((e) => e.split(",")[0].trim())
		.filter((e) => e.length <= 40 && DEGREE.test(e));
	if (degrees.length) return [...new Set(degrees)].slice(0, 4).join(", ");
	return title && title.length <= 60 ? title : "";
};

const all: Row[] = (await getCollection("doctors")).map((entry) => {
	const d = entry.data;
	const clinical = [d.specialty, d.subSpecialty, ...(d.medicalSpecialty || []), ...(d.conditionsTreated || [])]
		.filter(Boolean)
		.join(" ");
	const hospital = d.affiliations?.[0]?.hospitalName ?? "";
	const city = d.geography?.city?.trim() || "";
	const region = d.geography?.region?.trim() || "";
	const papers = d.citations?.length ?? 0;
	const highlights = [
		papers > 0 ? `${papers} research paper${papers === 1 ? "" : "s"} on record` : "",
		d.awards?.length ? `${d.awards.length} award${d.awards.length === 1 ? "" : "s"}` : "",
		d.hasInvention || d.techniquesInvented?.length ? "Developed a technique" : "",
		d.students?.length ? "Trains doctors" : "",
		d.rareConditions?.length ? "Treats rare conditions" : "",
	].filter(Boolean);
	return {
		slug: entry.id,
		name: d.fullName,
		title: d.title ?? "",
		specialty: normalizeSpecialty(d.specialty),
		subSpecialty: d.subSpecialty ?? "",
		hospital,
		city,
		region,
		country: d.geography?.country ?? "",
		living: d.status === "LIVING",
		qualifications: qualificationsOf(d.education, d.title),
		highlights: highlights.slice(0, 3),
		clinicalText: fold(clinical),
		searchText: fold([d.fullName, clinical, hospital, city, region, d.geography?.country ?? ""].join(" ")),
	};
});

// Display the stored spelling of a legacy country ("germany" → "Germany").
const otherCountry = otherCountryParam
	? all.find((d) => d.country.toLowerCase() === otherCountryParam.toLowerCase())?.country ?? otherCountryParam
	: "";
const scope = country?.name ?? otherCountry;

const living = all.filter((d) => d.living);
const inCountry = scope ? living.filter((d) => d.country.toLowerCase() === scope.toLowerCase()) : living;
const cities = [...new Set(inCountry.map((d) => d.city).filter(Boolean))].sort((a, b) => a.localeCompare(b));
// Accept any casing from free-text forms; keep an unknown city so the empty state can explain it.
const city = cityParam ? cities.find((c) => fold(c) === fold(cityParam)) ?? cityParam : "";
const region = regionParam;
const inPlace = (d: Row) =>
	(!city || fold(d.city) === fold(city)) && (!region || fold(d.region).includes(fold(region)));

const narrow = (pool: Row[]) => {
	let out = pool;
	if (specialtyParam) out = out.filter((d) => d.clinicalText.includes(fold(specialtyParam)));
	if (cond) out = out.filter((d) => matchesCondition(d, cond));
	// One-letter or stop-word-only queries ("a", "dr") browse the filtered list instead of matching nothing.
	if (queryTokens(query).length) out = matchQuery(out, query).results;
	return out;
};

const matched = narrow(inCountry);
const results = matched.filter(inPlace).sort((a, b) => a.name.localeCompare(b.name));
const searching = !!(queryTokens(query).length || cond || specialtyParam);
const elsewhere = scope && searching ? narrow(living).length - matched.length : 0;
const historical = queryTokens(query).length ? matchQuery(all.filter((d) => !d.living), query).results.length : 0;

const total = results.length;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const page = Math.min(requestedPage, totalPages);
const pageRows = results.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

const href = (overrides: Record<string, string>) => {
	const base: Record<string, string> = {
		q: query,
		country: isAll ? ALL_COUNTRIES : countryParam ? country?.slug ?? otherCountry : "",
		city,
		region,
		cond: cond?.key ?? "",
		specialty: specialtyParam,
	};
	const next = new URLSearchParams();
	for (const [k, v] of Object.entries({ ...base, ...overrides })) if (v) next.set(k, v);
	const qs = next.toString();
	return qs ? `/search?${qs}` : "/search";
};

const nmc = country?.nmc ?? false;
const countLabel = `${total.toLocaleString()} ${total === 1 ? "doctor" : "doctors"} in ${[city, region].filter(Boolean).join(", ") || scope || "all countries"}`;
const orderNote = nmc
	? 'Listed alphabetically. Under NMC guidelines, no one is ranked "best" or "No. 1".'
	: "Listed alphabetically. Open a record to compare the evidence.";
const eyebrow = scope
	? `FOR PATIENTS · ONLY DOCTORS ${country ? "REGISTERED" : "BASED"} IN ${scope.toUpperCase()}`
	: "FOR PATIENTS · DOCTORS IN EVERY COUNTRY ON THE REGISTER";
const tips = [
	{ t: "Check they're registered.", d: "Confirm the registration with the medical council before you book." },
	{ t: "Match the specialist to the problem.", d: "A heart specialist (cardiologist) is not the same as a heart surgeon." },
	{ t: "Look for recent work.", d: "Recent papers, training and teaching show they've kept learning." },
	{ t: "Ask questions at your visit.", d: "Bring your reports and a short list of questions to your first appointment." },
];
const whyTitle = nmc ? 'WHY THERE ARE NO RATINGS OR "TOP DOCTORS"' : "WHY THERE ARE NO RATINGS";
const whyText = nmc
	? "The National Medical Commission's October 2026 guidelines ban fake or paid reviews, testimonials, \"best\" claims and paid rankings on doctor-listing platforms. We think that's right: stars measure waiting rooms, not medicine."
	: "Star ratings measure waiting rooms and parking, not medicine, and they're easy to fake. We show verified evidence instead.";

const title = query
	? `${query} — Find a doctor in ${scope || "any country"} | MDRPedia`
	: `Find a doctor in ${scope || "any country"} | MDRPedia`;
const description = `Find a doctor in ${scope || "any country"} by describing the problem in your own words. Every listing links to a public record of registration, research and training. No ratings, no paid rankings.`;
const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "SearchResultsPage",
		name: title,
		url: new URL("/search", Astro.site ?? "https://mdrpedia.com").href,
		mainEntity: {
			"@type": "ItemList",
			numberOfItems: total,
			itemListElement: pageRows.map((d, i) => ({
				"@type": "ListItem",
				position: (page - 1) * PAGE_SIZE + i + 1,
				url: new URL(`/doctors/${d.slug}`, Astro.site ?? "https://mdrpedia.com").href,
				name: d.name,
			})),
		},
	},
];
---

<SiteLayout title={title} description={description} active="find" robots="noindex, follow" jsonLd={jsonLd}>
	<div class="fd r-listing" data-country={country?.name ?? "all"} data-country-param={countryParam ? "1" : ""} data-view-country={countryParam && country ? country.name : undefined}>
		<section class="fd-hero">
			<span class="fd-eyebrow">{eyebrow}</span>
			<h1>Find a doctor in {scope || "any country"}</h1>
			<form class="fd-bar" action="/search" method="get" role="search">
				<label class="fd-bar__q">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
					<span class="r-sr-only">Describe the problem, or a doctor's name</span>
					<input type="search" name="q" value={query} placeholder="Describe the problem in your own words" autocomplete="off" maxlength="120" />
				</label>
				<label class="fd-bar__city">
					<span class="r-sr-only">City</span>
					<select name="city" data-autosubmit>
						<option value="">All cities</option>
						{city && !cities.includes(city) && <option value={city} selected>{city}</option>}
						{cities.map((c) => <option value={c} selected={c === city}>{c}</option>)}
					</select>
				</label>
				<input type="hidden" name="country" value={isAll ? ALL_COUNTRIES : country?.slug ?? otherCountry} />
				{specialtyParam && <input type="hidden" name="specialty" value={specialtyParam} />}
				{region && <input type="hidden" name="region" value={region} />}
				<button type="submit" class="fd-bar__go">Search</button>
			</form>
			<nav class="fd-chips" aria-label="Common problems">
				{CONDITIONS.map((c) => (
					<a href={href({ cond: c.key === cond?.key ? "" : c.key, q: "", page: "" })} aria-current={c.key === cond?.key ? "true" : undefined}>{c.label}</a>
				))}
			</nav>
			<p class="fd-scope">
				Showing {scope ? `doctors in ${scope}` : "doctors in every country"}.
				{REGISTER_COUNTRIES.filter((c) => c.slug !== country?.slug).map((c) => (
					<a href={href({ country: c.slug, city: "", page: "" })} data-country-link={c.name}>{c.name}</a>
				))}
				{scope && <a href={href({ country: ALL_COUNTRIES, city: "", page: "" })}>All countries</a>}
			</p>
		</section>

		<section class="fd-main">
			<div class="fd-results">
				<div class="fd-count">
					<span>{countLabel}</span>
					<span>{orderNote}</span>
				</div>

				{(specialtyParam || region) && (
					<p class="fd-filter">
						{specialtyParam && <span>Specialty: <strong>{specialtyParam.charAt(0).toUpperCase() + specialtyParam.slice(1)}{specialtyParam.length < 6 ? "…" : ""}</strong> <a href={href({ specialty: "", page: "" })}>Remove</a></span>}
						{region && <span>State or region: <strong>{region}</strong> <a href={href({ region: "", page: "" })}>Remove</a></span>}
					</p>
				)}

				{pageRows.map((d) => (
					<article class="fd-card">
						<div class="fd-card__ini" aria-hidden="true">{initials(d.name)}</div>
						<div class="fd-card__body">
							<div class="fd-card__name">
								<h2><a href={`/doctors/${d.slug}`}>{displayName(d.name)}</a></h2>
								{d.qualifications && <span>{d.qualifications}</span>}
							</div>
							<span class="fd-card__plain"><strong>{plainSpecialty(d.specialty, d.subSpecialty)}</strong> <span>({d.specialty})</span></span>
							{(d.hospital || d.city) && (
								<span class="fd-card__where">{[d.hospital, [...new Set([d.city, d.region].filter(Boolean))].join(", ")].filter(Boolean).join(" · ")}</span>
							)}
							{(() => {
								const reg = REGISTER_COUNTRIES.find((c) => c.name === d.country);
								return reg ? (
									<a class="fd-card__reg" href={reg.verifyUrl} target="_blank" rel="noopener">{reg.verifyLabel} ↗</a>
								) : null;
							})()}
							{d.highlights.length > 0 && (
								<ul class="fd-card__hi">{d.highlights.map((h) => <li>{h}</li>)}</ul>
							)}
						</div>
						<div class="fd-card__side">
							<span>{!scope && d.country && d.country !== "Global" && d.country !== "Unknown" ? `Based in ${d.country}` : ""}</span>
							<a href={`/doctors/${d.slug}`} class="fd-card__cta" aria-label={`View full record: ${d.name}`}>View full record</a>
						</div>
					</article>
				))}

				{total === 0 && (
					<div class="fd-empty">
						<span>No doctors match yet</span>
						<p>Try a simpler word like "heart" or "skin"{city || region ? <>, or <a href={href({ city: "", region: "", page: "" })}>look in every city</a></> : ""}{scope ? <>, or <a href={href({ country: ALL_COUNTRIES, city: "", page: "" })}>search every country</a></> : ""}.</p>
					</div>
				)}

				{elsewhere > 0 && (
					<p class="fd-more">
						<a href={href({ country: ALL_COUNTRIES, city: "", page: "" })}>{elsewhere} more {elsewhere === 1 ? "match" : "matches"} outside {scope} →</a>
					</p>
				)}
				{historical > 0 && (
					<p class="fd-more">
						<a href={`/doctors?country=all&q=${encodeURIComponent(query)}`}>{historical} historical {historical === 1 ? "physician matches" : "physicians match"} in the Register →</a>
					</p>
				)}

				<div class="fd-pager">
					<Pagination page={page} totalPages={totalPages} total={total} pageSize={PAGE_SIZE} label="doctors" />
				</div>

				<p class="fd-note">
					Records are compiled from public sources: medical council registers, publications and hospital pages. Confirm registration with the {country?.regulator ?? "medical council"} before you book.
				</p>
			</div>

			<aside class="fd-aside" aria-label="Choosing a doctor">
				<div class="fd-tips">
					<h2>HOW TO CHOOSE, IN PLAIN WORDS</h2>
					<ol>
						{tips.map((t, i) => <li><span aria-hidden="true">{i + 1}</span><span><strong>{t.t}</strong> <span>{t.d}</span></span></li>)}
					</ol>
				</div>
				<div class="fd-why">
					<h2>{whyTitle}</h2>
					<p>{whyText}</p>
					<a href="/about#methodology">The Evidence Standard →</a>
				</div>
				<div class="fd-emergency">
					In an emergency, don't search. Call {country?.emergency ?? "your local emergency number"} or go to the nearest hospital.
				</div>
			</aside>
		</section>
	</div>
</SiteLayout>

<script>
	import { syncCountry } from "../lib/country-sync";

	syncCountry({ fallbackToGuess: true, reset: ["city", "page"] });

	document.querySelectorAll<HTMLSelectElement>("select[data-autosubmit]").forEach((s) =>
		s.addEventListener("change", () => s.form?.requestSubmit()),
	);
</script>
