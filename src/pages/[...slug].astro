---
import Layout from "../layouts/Layout.astro";
import { prisma } from "../lib/prisma";
import { marked } from "marked";

export const prerender = false;

const { slug } = Astro.params;

// This route handles CMS pages like /about, /terms. It is also the route every
// unmatched URL falls through to — including the ~2,358 legacy URLs from the
// previous site on this domain that are still being crawled.
//
// So its failure mode matters: an unguarded query here turns every one of those
// requests into a 500 the moment the connection pool is saturated, which is
// exactly what production was serving (4,594 500s over three days, accelerating).
// A URL we cannot resolve is a 404, never a 500.

if (!slug) {
    return Astro.redirect("/");
}

let page: Awaited<ReturnType<typeof prisma.contentPage.findUnique>> = null;

try {
    page = await prisma.contentPage.findUnique({
        where: { slug: slug },
    });
} catch (error) {
    console.error(`[...slug] lookup failed for "${slug}":`, error);
    return Astro.rewrite("/404");
}

if (!page || !page.published) {
    return Astro.rewrite("/404");
}

const contentHtml = marked.parse(page.content);
---

<Layout
    title={`${page.seo_title || page.title} — MDRPedia`}
    description={page.seo_desc || undefined}
>
    <div class="container content-page">
        <header class="page-header">
            <h1>{page.title}</h1>
        </header>

        <article class="prose" set:html={contentHtml} />

        <div class="page-meta">
            <small>Last updated: {page.updatedAt.toLocaleDateString()}</small>
        </div>
    </div>
</Layout>

<style>
    .content-page {
        max-width: 800px;
        margin: 0 auto;
        padding: var(--s-9) var(--gutter);
    }

    .page-header {
        margin-bottom: var(--s-7);
        text-align: center;
        border-bottom: 1px solid var(--rule);
        padding-bottom: var(--s-5);
    }

    .prose {
        line-height: 1.7;
        font-size: 1.05rem;
    }

    .prose :global(h2) {
        margin-top: var(--s-7);
        margin-bottom: var(--s-4);
    }

    .prose :global(p) {
        margin-bottom: var(--s-5);
        color: var(--ink-2);
    }

    .prose :global(a) {
        color: var(--ink-blue);
    }

    .prose :global(ul),
    .prose :global(ol) {
        margin-bottom: var(--s-5);
        padding-left: var(--s-5);
        color: var(--ink-2);
    }

    .page-meta {
        margin-top: var(--s-9);
        padding-top: var(--s-5);
        border-top: 1px solid var(--rule);
        color: var(--ink-3);
        text-align: center;
        font-family: var(--font-mono);
        font-size: 12px;
    }

    @media (max-width: 768px) {
        .content-page { padding: var(--s-7) var(--gutter); }
    }
</style>
