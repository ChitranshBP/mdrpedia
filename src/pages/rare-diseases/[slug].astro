---
/**
 * MDRPedia — Individual Rare Disease Page
 * Comprehensive information with expert connections
 */
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/pages/clinical.css";
import { getCollection } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
    const rareDiseases = await getCollection("rareDiseases");
    return rareDiseases.map((disease) => ({
        params: { slug: disease.data.slug },
        props: { disease: disease.data },
    }));
}

const { disease } = Astro.props;

// Get all doctors
const doctors = await getCollection("doctors");

// Find doctors who treat this condition
const treatingDoctors = doctors.filter(doc => {
    const rareConditions = doc.data.rareConditions || [];
    const conditionsTreated = doc.data.conditionsTreated || [];
    const allConditions = [...rareConditions, ...conditionsTreated].map(c => c.toLowerCase());
    return allConditions.some(c =>
        c.includes(disease.name.toLowerCase()) ||
        disease.aliases?.some((a: string) => c.includes(a.toLowerCase()))
    );
}).sort((a, b) => (b.data.rankingScore || 0) - (a.data.rankingScore || 0));

// Get related diseases
const allDiseases = await getCollection("rareDiseases");
const relatedDiseases = allDiseases.filter(d =>
    disease.relatedConditions?.some((rc: string) =>
        d.data.name.toLowerCase().includes(rc.toLowerCase()) ||
        d.data.aliases?.some((a: string) => rc.toLowerCase().includes(a.toLowerCase()))
    ) && d.data.slug !== disease.slug
).slice(0, 4);

// Category info
const CATEGORY_INFO: Record<string, { label: string }> = {
    'GENETIC': { label: 'Genetic Disorder' },
    'METABOLIC': { label: 'Metabolic Disorder' },
    'NEUROLOGICAL': { label: 'Neurological Disorder' },
    'CARDIOVASCULAR': { label: 'Cardiovascular Disorder' },
    'IMMUNOLOGICAL': { label: 'Immunological Disorder' },
    'ONCOLOGICAL': { label: 'Oncological Disorder' },
    'HEMATOLOGICAL': { label: 'Hematological Disorder' },
    'MUSCULOSKELETAL': { label: 'Musculoskeletal Disorder' },
    'DERMATOLOGICAL': { label: 'Dermatological Disorder' },
    'GASTROINTESTINAL': { label: 'Gastrointestinal Disorder' },
    'RESPIRATORY': { label: 'Respiratory Disorder' },
    'ENDOCRINE': { label: 'Endocrine Disorder' },
    'OPHTHALMOLOGICAL': { label: 'Ophthalmological Disorder' },
    'AUTOIMMUNE': { label: 'Autoimmune Disorder' },
    'INFECTIOUS': { label: 'Infectious Disease' },
    'RENAL': { label: 'Renal Disorder' },
    'OTHER': { label: 'Other' },
};

const catInfo = CATEGORY_INFO[disease.category] || CATEGORY_INFO['OTHER'];

// Structured Data: MedicalCondition JSON-LD
const siteBase = Astro.site ?? 'https://mdrpedia.com';
const diseaseUrl = new URL(`/rare-diseases/${disease.slug}`, siteBase).href;
const diseaseSchema = {
    "@context": "https://schema.org",
    "@type": "MedicalCondition",
    "name": disease.name,
    "alternateName": disease.aliases || [],
    "description": disease.description,
    "url": diseaseUrl,
    ...(disease.prevalence && { "epidemiology": disease.prevalence }),
    ...(disease.category && { "medicalSpecialty": catInfo.label }),
    ...(disease.symptoms?.length && {
        "signOrSymptom": disease.symptoms.map((s: string) => ({
            "@type": "MedicalSignOrSymptom",
            "name": s
        }))
    }),
    ...(disease.treatmentOptions?.length && {
        "possibleTreatment": disease.treatmentOptions.map((t: any) => ({
            "@type": "MedicalTherapy",
            "name": t.name
        }))
    }),
    ...(treatingDoctors.length > 0 && {
        "subjectOf": {
            "@type": "CollectionPage",
            "name": `${disease.name} Specialists on MDRPedia`,
            "url": diseaseUrl,
            "mainEntity": {
                "@type": "ItemList",
                "numberOfItems": treatingDoctors.length,
                "itemListElement": treatingDoctors.slice(0, 20).map((doc, i) => ({
                    "@type": "ListItem",
                    "position": i + 1,
                    "item": {
                        "@type": "Physician",
                        "name": doc.data.fullName,
                        "url": new URL(`/doctors/${doc.id}`, siteBase).href
                    }
                }))
            }
        }
    })
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteBase.toString() },
        { "@type": "ListItem", "position": 2, "name": "Rare Diseases", "item": new URL('/rare-diseases', siteBase).href },
        { "@type": "ListItem", "position": 3, "name": disease.name, "item": diseaseUrl }
    ]
};

// Inheritance labels
const INHERITANCE_LABELS: Record<string, string> = {
    'AUTOSOMAL_DOMINANT': 'Autosomal Dominant',
    'AUTOSOMAL_RECESSIVE': 'Autosomal Recessive',
    'X_LINKED': 'X-Linked',
    'MITOCHONDRIAL': 'Mitochondrial',
    'SPORADIC': 'Sporadic',
    'UNKNOWN': 'Unknown'
};

// Research status labels
const RESEARCH_STATUS: Record<string, { label: string }> = {
    'ACTIVE_TRIALS': { label: 'Active Clinical Trials' },
    'OBSERVATIONAL': { label: 'Observational Studies' },
    'PRECLINICAL': { label: 'Preclinical Research' },
    'LIMITED_RESEARCH': { label: 'Limited Research' },
    'NO_ACTIVE_RESEARCH': { label: 'No Active Research' }
};
---

<SiteLayout
	title={`${disease.name} — Rare Disease Profile | MDRPedia`}
	description={disease.description}
	active="find"
	jsonLd={[diseaseSchema, breadcrumbSchema]}
>
	<article class="cl">
		<header class="cl-hero">
			<nav class="cl-crumb" aria-label="Breadcrumb">
				<a href="/rare-diseases">Rare diseases</a>
				<span aria-hidden="true">/</span>
				<span>{catInfo.label}</span>
			</nav>
			<span class="cl-eyebrow">{catInfo.label}</span>
			<h1>{disease.name}</h1>
			{disease.aliases && disease.aliases.length > 0 && <p class="cl-aka">Also known as {disease.aliases.join(", ")}</p>}
			<p>{disease.description}</p>

			<ul class="cl-codes">
				{disease.icdCode && <li><span>ICD-10</span> {disease.icdCode}</li>}
				{disease.orphaCode && (
					<li><span>Orphanet</span> <a href={`https://www.orpha.net/consor/cgi-bin/OC_Exp.php?Expert=${disease.orphaCode.replace("ORPHA", "")}`} target="_blank" rel="noopener">{disease.orphaCode}</a></li>
				)}
				{disease.omimCode && (
					<li><span>OMIM</span> <a href={`https://www.omim.org/entry/${disease.omimCode}`} target="_blank" rel="noopener">{disease.omimCode}</a></li>
				)}
			</ul>

			<ul class="cl-stats" aria-label="Key figures">
				{disease.prevalence && <li><b>{disease.prevalence}</b><span>Prevalence</span></li>}
				{disease.clinicalTrialsCount > 0 && <li><b>{disease.clinicalTrialsCount}</b><span>Listed trials</span></li>}
				{treatingDoctors.length > 0 && <li><b>{treatingDoctors.length}</b><span>Specialist{treatingDoctors.length !== 1 ? "s" : ""} on record</span></li>}
			</ul>
		</header>

		<div class="cl-main cl-layout">
			<div class="cl-col">
				{(disease.eli5Summary || disease.clinicalSummary) && (
					<section class="cl-sec">
						<div class="cl-tabs" role="group" aria-label="Summary view">
							<button type="button" class="toggle-btn" data-view="simple" aria-pressed="true">Simple explanation</button>
							<button type="button" class="toggle-btn" data-view="clinical" aria-pressed="false">Clinical summary</button>
						</div>
						<div class="summary-content" id="summary-simple"><p class="cl-prose">{disease.eli5Summary || disease.description}</p></div>
						<div class="summary-content" id="summary-clinical" hidden><p class="cl-prose">{disease.clinicalSummary || disease.description}</p></div>
					</section>
				)}

				{disease.symptoms && disease.symptoms.length > 0 && (
					<section class="cl-sec">
						<h2 class="cl-h2">Signs and symptoms</h2>
						<ul class="cl-bullets">
							{disease.symptoms.map((symptom: string) => <li>{symptom}</li>)}
						</ul>
					</section>
				)}

				{disease.treatmentOptions && disease.treatmentOptions.length > 0 && (
					<section class="cl-sec">
						<h2 class="cl-h2">Treatment options</h2>
						<ul class="cl-rows">
							{disease.treatmentOptions.map((treatment: any) => (
								<li class="cl-row">
									<span class="cl-row__kicker">
										{treatment.type.replaceAll("_", " ")}
										{treatment.fdaApproved && <span class="cl-flag cl-flag--live">FDA approved</span>}
										{treatment.approvalYear && <span>Approved {treatment.approvalYear}</span>}
										{treatment.effectiveness && <span>{treatment.effectiveness.replaceAll("_", " ")}</span>}
									</span>
									<b class="cl-row__title">{treatment.name}</b>
									{treatment.note && <p class="cl-row__text">{treatment.note}</p>}
									{treatment.sourceUrl && <a class="cl-row__src" href={treatment.sourceUrl} target="_blank" rel="noopener noreferrer">Source</a>}
								</li>
							))}
						</ul>
					</section>
				)}

				{disease.diagnosticMethods && disease.diagnosticMethods.length > 0 && (
					<section class="cl-sec">
						<h2 class="cl-h2">Diagnosis</h2>
						<ul class="cl-bullets">
							{disease.diagnosticMethods.map((method: string) => <li>{method}</li>)}
						</ul>
					</section>
				)}

				{disease.historicalBackground && (
					<section class="cl-sec">
						<h2 class="cl-h2">History</h2>
						<p class="cl-prose">{disease.historicalBackground}</p>
					</section>
				)}

				{disease.recentBreakthroughs && disease.recentBreakthroughs.length > 0 && (
					<section class="cl-sec">
						<h2 class="cl-h2">Recent breakthroughs</h2>
						<ul class="cl-rows">
							{disease.recentBreakthroughs.map((breakthrough: any) => (
								<li class="cl-row cl-row--year">
									<span class="cl-row__year">{breakthrough.year}</span>
									<span class="cl-row__body">
										<b class="cl-row__title">{breakthrough.title}</b>
										<p class="cl-row__text">{breakthrough.description}</p>
										{breakthrough.sourceUrl && <a class="cl-row__src" href={breakthrough.sourceUrl} target="_blank" rel="noopener noreferrer">Source</a>}
									</span>
								</li>
							))}
						</ul>
					</section>
				)}

				{treatingDoctors.length > 0 && (
					<section class="cl-sec">
						<h2 class="cl-h2">Specialists on record</h2>
						<ul class="cl-people">
							{treatingDoctors.slice(0, 6).map((doctor) => (
								<li>
									<a href={`/doctors/${doctor.id}`} class="cl-person">
										<span class="cl-person__av">
											{doctor.data.portraitUrl ? (
												<img src={doctor.data.portraitUrl} alt="" loading="lazy" width="56" height="56" />
											) : (
												<span>{doctor.data.fullName.split(" ").map((n: string) => n[0]).join("").slice(0, 2)}</span>
											)}
										</span>
										<span class="cl-person__body">
											<b>{doctor.data.fullName}</b>
											<span>{doctor.data.specialty}</span>
											<span class="cl-person__loc">{[doctor.data.geography.city, doctor.data.geography.country].filter(Boolean).join(", ")}{doctor.data.tier !== "UNRANKED" ? ` · ${doctor.data.tier.charAt(0)}${doctor.data.tier.slice(1).toLowerCase()}` : ""}</span>
										</span>
									</a>
								</li>
							))}
						</ul>
						{treatingDoctors.length > 6 && (
							<a href={`/search?condition=${encodeURIComponent(disease.name)}`} class="cl-more">View all {treatingDoctors.length} specialists →</a>
						)}
					</section>
				)}

				<p class="cl-note">This entry is for information only and is not medical advice. Talk to a qualified physician about any diagnosis or treatment.</p>
			</div>

			<aside class="cl-aside">
				<div class="cl-box">
					<h2 class="cl-box__t">Quick facts</h2>
					<dl class="cl-facts">
						{disease.inheritance && <div><dt>Inheritance</dt><dd>{INHERITANCE_LABELS[disease.inheritance] || disease.inheritance}</dd></div>}
						{disease.ageOfOnset && <div><dt>Age of onset</dt><dd>{disease.ageOfOnset}</dd></div>}
						{disease.lifeExpectancy && <div><dt>Life expectancy</dt><dd>{disease.lifeExpectancy}</dd></div>}
						{disease.estimatedCases && <div><dt>Est. cases</dt><dd>{disease.estimatedCases.toLocaleString()}</dd></div>}
					</dl>
				</div>

				{disease.researchStatus && (
					<div class="cl-box">
						<h2 class="cl-box__t">Research status</h2>
						<p class="cl-box__lead">{RESEARCH_STATUS[disease.researchStatus]?.label || disease.researchStatus}</p>
						{disease.keyResearchCenters && disease.keyResearchCenters.length > 0 && (
							<>
								<h3 class="cl-box__sub">Key research centres</h3>
								<ul class="cl-plain">
									{disease.keyResearchCenters.slice(0, 4).map((center: string) => <li>{center}</li>)}
								</ul>
							</>
						)}
					</div>
				)}

				{disease.affectedSystems && disease.affectedSystems.length > 0 && (
					<div class="cl-box">
						<h2 class="cl-box__t">Affected systems</h2>
						<ul class="cl-tags">
							{disease.affectedSystems.map((system: string) => <li>{system}</li>)}
						</ul>
					</div>
				)}

				{disease.specialistTypes && disease.specialistTypes.length > 0 && (
					<div class="cl-box">
						<h2 class="cl-box__t">Specialties</h2>
						<ul class="cl-plain">
							{disease.specialistTypes.map((spec: string) => (
								<li><a href={`/search?specialty=${encodeURIComponent(spec)}`}>{spec}</a></li>
							))}
						</ul>
					</div>
				)}

				{disease.patientOrganizations && disease.patientOrganizations.length > 0 && (
					<div class="cl-box">
						<h2 class="cl-box__t">Patient support</h2>
						<ul class="cl-plain">
							{disease.patientOrganizations.map((org: any) => (
								<li><a href={org.url} target="_blank" rel="noopener">{org.name}</a>{org.country && <span class="cl-dim"> · {org.country}</span>}</li>
							))}
						</ul>
					</div>
				)}

				{relatedDiseases.length > 0 && (
					<div class="cl-box">
						<h2 class="cl-box__t">Related conditions</h2>
						<ul class="cl-plain">
							{relatedDiseases.map((related) => (
								<li><a href={`/rare-diseases/${related.data.slug}`}>{related.data.name}</a></li>
							))}
						</ul>
					</div>
				)}

				{disease.sources && disease.sources.length > 0 && (
					<div class="cl-box">
						<h2 class="cl-box__t">Sources</h2>
						<ul class="cl-plain">
							{disease.sources.map((source: any) => (
								<li><a href={source.url} target="_blank" rel="noopener">{source.name}</a></li>
							))}
						</ul>
						{disease.lastUpdated && <p class="cl-dim cl-box__foot">Last updated {disease.lastUpdated}</p>}
					</div>
				)}
			</aside>
		</div>
	</article>
</SiteLayout>

<script>
	const toggleBtns = document.querySelectorAll<HTMLButtonElement>(".toggle-btn");
	const simpleContent = document.getElementById("summary-simple");
	const clinicalContent = document.getElementById("summary-clinical");

	toggleBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			toggleBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
			const simple = btn.dataset.view === "simple";
			if (simpleContent) simpleContent.hidden = !simple;
			if (clinicalContent) clinicalContent.hidden = simple;
		});
	});
</script>
