---
export const prerender = true;
/**
 * MDRPedia — Rare Diseases Directory
 * Reference entries for rare conditions, with the specialists on record who treat them.
 */
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import "../../styles/pages/clinical.css";

const rareDiseases = await getCollection("rareDiseases");
const doctors = await getCollection("doctors");

const sortedDiseases = rareDiseases.sort((a, b) => a.data.name.localeCompare(b.data.name));
const categories = [...new Set(sortedDiseases.map((d) => d.data.category))].sort();

const CATEGORY_LABELS: Record<string, string> = {
	GENETIC: "Genetic",
	METABOLIC: "Metabolic",
	NEUROLOGICAL: "Neurological",
	CARDIOVASCULAR: "Cardiovascular",
	IMMUNOLOGICAL: "Immunological",
	ONCOLOGICAL: "Oncological",
	HEMATOLOGICAL: "Hematological",
	MUSCULOSKELETAL: "Musculoskeletal",
	DERMATOLOGICAL: "Dermatological",
	GASTROINTESTINAL: "Gastrointestinal",
	RESPIRATORY: "Respiratory",
	ENDOCRINE: "Endocrine",
	OPHTHALMOLOGICAL: "Ophthalmological",
	AUTOIMMUNE: "Autoimmune",
	INFECTIOUS: "Infectious",
	RENAL: "Renal",
	OTHER: "Other",
};
const labelOf = (c: string) => CATEGORY_LABELS[c] || CATEGORY_LABELS.OTHER;

function getDoctorCount(disease: any) {
	return doctors.filter((doc) => {
		const rareConditions = doc.data.rareConditions || [];
		const conditionsTreated = doc.data.conditionsTreated || [];
		const allConditions = [...rareConditions, ...conditionsTreated].map((c) => c.toLowerCase());
		return allConditions.some(
			(c) =>
				c.includes(disease.data.name.toLowerCase()) ||
				disease.data.aliases?.some((a: string) => c.includes(a.toLowerCase())),
		);
	}).length;
}

const totalDiseases = sortedDiseases.length;
const totalTrials = sortedDiseases.reduce((sum, d) => sum + (d.data.clinicalTrialsCount || 0), 0);
const clip = (s: string) => (s.length > 150 ? `${s.slice(0, 150).trimEnd()}…` : s);
---

<SiteLayout
	title="Rare Diseases Directory — MDRPedia"
	description="Comprehensive database of rare diseases with expert physicians, treatment options, research updates, and patient resources."
	active="find"
>
	<div class="cl">
		<section class="cl-hero">
			<span class="cl-eyebrow">Rare diseases directory</span>
			<h1>Understanding rare diseases</h1>
			<p>Reference entries for rare conditions, with the specialists on record who treat them and the research under way.</p>
			<ul class="cl-stats" aria-label="Directory totals">
				<li><b>{totalDiseases}</b><span>Diseases</span></li>
				<li><b>{categories.length}</b><span>Categories</span></li>
				<li><b>{totalTrials.toLocaleString("en-US")}</b><span>Listed trials</span></li>
			</ul>
		</section>

		<section class="cl-main">
			<div class="cl-controls">
				<div class="cl-search">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
					<label for="disease-search" class="r-sr-only">Search rare diseases</label>
					<input type="text" id="disease-search" placeholder="Search by name, symptom or category" autocomplete="off" />
				</div>
				<div class="cl-pills" role="group" aria-label="Filter by category">
					<button type="button" class="category-pill cl-pill" data-category="all" aria-pressed="true">All <span>{totalDiseases}</span></button>
					{categories.map((cat) => (
						<button type="button" class="category-pill cl-pill" data-category={cat} aria-pressed="false">
							{labelOf(cat)} <span>{sortedDiseases.filter((d) => d.data.category === cat).length}</span>
						</button>
					))}
				</div>
			</div>

			<p class="cl-meta" id="disease-count" aria-live="polite">{totalDiseases} diseases</p>

			<div class="cl-grid" id="diseases-grid">
				{sortedDiseases.map((disease) => {
					const doctorCount = getDoctorCount(disease);
					return (
						<a
							href={`/rare-diseases/${disease.data.slug}`}
							class="cl-card disease-card"
							data-category={disease.data.category}
							data-name={disease.data.name.toLowerCase()}
							data-aliases={disease.data.aliases?.join(" ").toLowerCase() || ""}
							data-symptoms={disease.data.symptoms?.join(" ").toLowerCase() || ""}
						>
							<span class="cl-card__top">
								<span>{labelOf(disease.data.category)}</span>
								{disease.data.researchStatus === "ACTIVE_TRIALS" && <span class="cl-flag cl-flag--live">Active research</span>}
							</span>
							<h2 class="cl-card__title">{disease.data.name}</h2>
							{disease.data.aliases && disease.data.aliases.length > 0 && (
								<p class="cl-card__aka">Also known as {disease.data.aliases.slice(0, 2).join(", ")}</p>
							)}
							<p class="cl-card__text">{clip(disease.data.description)}</p>
							<span class="cl-card__meta">
								{disease.data.prevalence && <span>{disease.data.prevalence}</span>}
								{disease.data.clinicalTrialsCount > 0 && <span>{disease.data.clinicalTrialsCount} trials</span>}
								{doctorCount > 0 ? (
									<span>{doctorCount} specialist{doctorCount !== 1 ? "s" : ""}</span>
								) : (
									disease.data.specialistTypes?.length > 0 && <span>{disease.data.specialistTypes.slice(0, 2).join(", ")}</span>
								)}
							</span>
						</a>
					);
				})}
			</div>

			<div class="cl-empty" id="empty-state" hidden>
				<h2>No diseases found</h2>
				<p>Try adjusting your search or filter criteria.</p>
			</div>

			<section class="cl-sec" aria-labelledby="res-h">
				<h2 id="res-h" class="cl-h2">Patient resources</h2>
				<p class="cl-lede">Trusted organisations and databases for rare disease information.</p>
				<ul class="cl-links">
					<li><a href="https://rarediseases.org" target="_blank" rel="noopener"><b>NORD</b><span>National Organization for Rare Disorders</span></a></li>
					<li><a href="https://www.orpha.net" target="_blank" rel="noopener"><b>Orphanet</b><span>European rare disease database</span></a></li>
					<li><a href="https://clinicaltrials.gov" target="_blank" rel="noopener"><b>ClinicalTrials.gov</b><span>Find active clinical trials</span></a></li>
					<li><a href="https://www.omim.org" target="_blank" rel="noopener"><b>OMIM</b><span>Genetic disorder database</span></a></li>
				</ul>
			</section>

			<p class="cl-note">Entries are for information only and are not medical advice. Talk to a qualified physician about any diagnosis or treatment.</p>
		</section>
	</div>
</SiteLayout>

<script>
	const searchInput = document.getElementById("disease-search") as HTMLInputElement;
	const categoryPills = document.querySelectorAll<HTMLButtonElement>(".category-pill");
	const diseaseCards = document.querySelectorAll<HTMLElement>(".disease-card");
	const emptyState = document.getElementById("empty-state");
	const countEl = document.getElementById("disease-count");

	let currentCategory = "all";
	let searchQuery = "";

	function filterDiseases() {
		let visibleCount = 0;
		diseaseCards.forEach((card) => {
			const category = card.dataset.category;
			const name = card.dataset.name || "";
			const aliases = card.dataset.aliases || "";
			const symptoms = card.dataset.symptoms || "";
			const matchesCategory = currentCategory === "all" || category === currentCategory;
			const matchesSearch = !searchQuery || name.includes(searchQuery) || aliases.includes(searchQuery) || symptoms.includes(searchQuery);
			if (matchesCategory && matchesSearch) {
				card.style.display = "";
				visibleCount++;
			} else {
				card.style.display = "none";
			}
		});
		if (emptyState) emptyState.hidden = visibleCount > 0;
		if (countEl) countEl.textContent = `${visibleCount} ${visibleCount === 1 ? "disease" : "diseases"}`;
	}

	categoryPills.forEach((pill) => {
		pill.addEventListener("click", () => {
			categoryPills.forEach((p) => p.setAttribute("aria-pressed", "false"));
			pill.setAttribute("aria-pressed", "true");
			currentCategory = pill.dataset.category || "all";
			filterDiseases();
		});
	});

	searchInput?.addEventListener("input", (e) => {
		searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
		filterDiseases();
	});
</script>
