---
/**
 * MDRPedia — Medical Specialties Index
 * Browse all medical specialty groups with doctor counts
 * Optimized for SEO with structured data
 */
import "../../styles/pages/directory.css";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getSpecialtyStats } from "../../lib/cached-stats";
import { SPECIALTY_GROUPS, type SpecialtyGroup } from "../../lib/specialty-groups";
import { slugify } from "../../lib/utils";

export const prerender = false;

// Fetch doctor counts for each specialty group
interface GroupWithCount extends SpecialtyGroup {
    doctorCount: number;
    slug: string;
}

const specialtyStats = await getSpecialtyStats();

const groupsWithCounts: GroupWithCount[] = SPECIALTY_GROUPS.map((group) => {
    const needles = group.specialties.map(specialty => specialty.toLowerCase());
    const doctorCount = specialtyStats
        .filter(row => {
            const value = row.specialty.toLowerCase();
            return needles.some(needle => value.includes(needle));
        })
        .reduce((sum, row) => sum + row.count, 0);

    return {
        ...group,
        doctorCount,
        slug: slugify(group.name)
    };
});

// Sort by doctor count (most doctors first)
const sortedGroups = groupsWithCounts.sort((a, b) => b.doctorCount - a.doctorCount);

// Calculate totals
const totalSpecialties = sortedGroups.reduce((sum, g) => sum + g.specialties.length, 0);

// Page metadata
const pageTitle = "Medical Specialties — MDRPedia";
const pageDescription = `Explore ${sortedGroups.length} medical specialty categories covering ${totalSpecialties} subspecialties. Find the world's leading physicians across surgery, cardiology, oncology, neuroscience, and more.`;
const canonicalUrl = new URL('/specialty', Astro.site ?? 'https://mdrpedia.com').href;

// Structured Data: CollectionPage with ItemList
const structuredData = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Medical Specialties Directory",
    "description": pageDescription,
    "url": canonicalUrl,
    "publisher": {
        "@type": "Organization",
        "name": "MDRPedia",
        "url": Astro.site ?? "https://mdrpedia.com"
    },
    "mainEntity": {
        "@type": "ItemList",
        "name": "Medical Specialty Categories",
        "numberOfItems": sortedGroups.length,
        "itemListElement": sortedGroups.map((group, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "item": {
                "@type": "MedicalSpecialty",
                "name": group.name,
                "description": group.description,
                "url": new URL(`/specialty/${group.slug}`, Astro.site ?? 'https://mdrpedia.com').href
            }
        }))
    },
    "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": Astro.site ?? "https://mdrpedia.com"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Specialties",
                "item": canonicalUrl
            }
        ]
    }
};
---

<SiteLayout title={pageTitle} description={pageDescription} active="register" jsonLd={[structuredData]}>
	<div class="dx">
		<header class="dx-hero">
			<div class="dx-hero__inner">
				<nav class="dx-crumbs" aria-label="Breadcrumb">
					<a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Specialties</span>
				</nav>
				<span class="dx-eyebrow">THE REGISTER BY SPECIALTY</span>
				<h1>Medical specialties</h1>
				<p class="dx-lede">
					Verified physicians grouped into {sortedGroups.length} specialty categories, covering {totalSpecialties} subspecialties.
					Open a category to see the physicians in it.
				</p>
			</div>
		</header>

		<div class="dx-main">
			<section class="dx-section" aria-labelledby="spec-browse">
				<h2 id="spec-browse">Browse by specialty</h2>
				<p class="dx-sub">Categories are ordered by the number of verified physicians in each.</p>
				<ul class="dx-grid">
					{sortedGroups.map((group) => (
						<li class="dx-card">
							<span class="dx-card__kicker">{group.specialties.length} {group.specialties.length === 1 ? "subspecialty" : "subspecialties"}</span>
							<h3><a href={`/specialty/${group.slug}`}>{group.name}</a></h3>
							<p class="dx-card__clamp">{group.description}</p>
							<div class="dx-card__foot">
								<span><b>{group.doctorCount.toLocaleString()}</b> physicians</span>
								<span aria-hidden="true">&rarr;</span>
							</div>
						</li>
					))}
				</ul>
			</section>

			<section class="dx-note">
				Are you a physician? <a href="/doctor/claim">Claim your profile</a> or <a href="/doctor/add-profile">add a new one</a>.
			</section>
		</div>
	</div>
</SiteLayout>
