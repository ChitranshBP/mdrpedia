---
/**
 * MDRPedia — Specialty x Country hub
 * e.g. /specialty/cardiology/india: every doctor of one specialty group in one country.
 */
import "../../../styles/pages/regions.css";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import RegionHero from "../../../components/site/RegionHero.astro";
import RegisterTable from "../../../components/site/RegisterTable.astro";
import RegionSync from "../../../components/site/RegionSync.astro";
import Pagination from "../../../components/Pagination.astro";
import { COUNTRY_REGISTER, getRegister, isAlphabetical, sortEntries, themeKey } from "../../../lib/regions";
import { findGroup, getSpecialtyGeoCombos, MIN_INDEXABLE_DOCTORS, specialtyMatches } from "../../../lib/specialty-geo";

export const prerender = false;

const { slug, country: countrySlug } = Astro.params;

const group = findGroup(slug);
if (!group) return Astro.rewrite("/404");

const matches = (await getRegister()).filter((e) => e.countrySlug === countrySlug && specialtyMatches(group, e.rawSpecialty));
if (matches.length === 0) return Astro.rewrite("/404");

const countryName = matches[0].country;
const alphabetical = isAlphabetical(countryName);
const sorted = sortEntries(matches, alphabetical, "score");
const total = sorted.length;
const thin = total < MIN_INDEXABLE_DOCTORS;

const PAGE_SIZE = 50;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const page = Math.min(Math.max(1, parseInt(Astro.url.searchParams.get("page") || "1", 10) || 1), totalPages);
const shown = sorted.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

Astro.response.headers.set("Cache-Control", "public, max-age=120, s-maxage=300");

const groupLower = group.name.toLowerCase();
const register = COUNTRY_REGISTER[countryName];
const pageTitle = `${group.name} doctors in ${countryName} — verified register | MDRPedia`;
const pageDescription = `${total} verified ${groupLower} ${total === 1 ? "physician" : "physicians"} in ${countryName}, ${alphabetical ? "listed alphabetically" : "ranked by MDRPedia evidence tier and research impact"}. ${group.description}.`;
const site = (Astro.site ?? new URL("https://mdrpedia.com")).origin;
const canonicalUrl = `${site}/specialty/${slug}/${countrySlug}`;

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
			{ "@type": "ListItem", position: 2, name: "Specialties", item: `${site}/specialty` },
			{ "@type": "ListItem", position: 3, name: group.name, item: `${site}/specialty/${slug}` },
			{ "@type": "ListItem", position: 4, name: countryName, item: canonicalUrl },
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		name: `${group.name} doctors in ${countryName}`,
		description: pageDescription,
		url: canonicalUrl,
		mainEntity: {
			"@type": "ItemList",
			numberOfItems: total,
			itemListElement: shown.map((d, i) => ({
				"@type": "ListItem",
				position: (page - 1) * PAGE_SIZE + i + 1,
				url: `${site}/doctors/${d.slug}`,
				name: d.name,
			})),
		},
	},
];

const otherCombos = (await getSpecialtyGeoCombos())
	.filter((c) => c.count >= MIN_INDEXABLE_DOCTORS && !(c.groupSlug === slug && c.countrySlug === countrySlug))
	.filter((c) => c.groupSlug === slug || c.countrySlug === countrySlug);
const sameGroup = otherCombos.filter((c) => c.groupSlug === slug).slice(0, 8);
const sameCountry = otherCombos.filter((c) => c.countrySlug === countrySlug).slice(0, 8);
const countLabel = `${total} ${total === 1 ? "physician" : "physicians"} · ${group.name} · ${countryName}${alphabetical ? " · A–Z" : " · ranked by evidence tier"}`;
---

<SiteLayout title={pageTitle} description={pageDescription} active="regions" jsonLd={jsonLd} robots={thin || page > 1 ? "noindex, follow" : undefined}>
	<div class="rg" data-theme={themeKey(countryName)}>
		<RegionHero
			eyebrow={`BY SPECIALTY · ${group.name.toUpperCase()} · REGISTERED IN ${countryName.toUpperCase()}${register ? ` (${register})` : ""}`}
			heading={`${group.name} doctors in ${countryName}`}
			lede={`${total} verified ${total === 1 ? "physician" : "physicians"} in the MDRPedia register. ${group.description}.`}
			crumbs={[
				{ label: "Specialties", href: "/specialty" },
				{ label: group.name, href: `/specialty/${slug}` },
				{ label: countryName },
			]}
		/>

		<section class="rg-main">
			<aside class="rg-aside">
				{sameCountry.length > 0 && (
					<>
						<h2 class="rg-label">MORE SPECIALTIES IN {countryName.toUpperCase()}</h2>
						<ul class="rg-children">
							{sameCountry.map((c) => (
								<li>
									<a href={`/specialty/${c.groupSlug}/${c.countrySlug}`}>
										<span class="n">{c.group.name}</span>
										<span class="c">{c.count} →</span>
									</a>
								</li>
							))}
						</ul>
					</>
				)}
				{sameGroup.length > 0 && (
					<>
						<h2 class="rg-label">{group.name.toUpperCase()} ELSEWHERE</h2>
						<ul class="rg-children">
							{sameGroup.map((c) => (
								<li>
									<a href={`/specialty/${c.groupSlug}/${c.countrySlug}`}>
										<span class="n">{c.country}</span>
										<span class="c">{c.count} →</span>
									</a>
								</li>
							))}
						</ul>
					</>
				)}
				<p class="rg-note">
					Browse every physician in {countryName} by state and city on the <a href={`/geography/${countrySlug}`}>{countryName} register</a>, or all
					{" "}<a href={`/specialty/${slug}`}>{groupLower} specialists</a>.
				</p>
				<div class="rg-how">
					<b>{alphabetical ? `HOW LISTINGS WORK IN ${countryName.toUpperCase()}` : "HOW RANKS WORK HERE"}</b>
					{alphabetical
						? "Under the NMC's October 2026 advertising guidelines, doctors are listed alphabetically. We never label anyone \"best\" or \"No. 1\", and there is no paid placement."
						: "Physicians are ranked within this specialty and country, on evidence only. Reviews, ratings and payment play no part."}
					<a href="/about#methodology">The Evidence Standard →</a>
				</div>
			</aside>

			<div class="rg-list">
				<p class="rg-count">{countLabel}</p>
				<RegisterTable
					entries={shown}
					rankFrom={alphabetical ? undefined : (page - 1) * PAGE_SIZE + 1}
					showTier={!alphabetical}
					caption={countLabel}
				/>
				<Pagination page={page} totalPages={totalPages} total={total} pageSize={PAGE_SIZE} label="physicians" />
				<p class="rg-foot">
					h-index and papers come from each physician's published research record. Tier is MDRPedia's evidence tier; ethics shows an approved MDRPedia ethics certification.
				</p>
			</div>
		</section>
	</div>
	<RegionSync country={countryName} />
</SiteLayout>
