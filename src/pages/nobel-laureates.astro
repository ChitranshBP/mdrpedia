---
export const prerender = true;
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { portraitAttrs } from "../lib/portrait";
import "../styles/pages/feed.css";

const doctors = await getCollection("doctors");
const laureates = doctors.filter((doc) =>
    doc.data.awards?.some((a) => a.name.includes("Nobel Prize")),
);

// Sort by most recent Nobel Prize year
const sortedLaureates = laureates.sort((a, b) => {
    const yearA = a.data.awards?.find(a => a.name.includes("Nobel Prize"))?.year || 0;
    const yearB = b.data.awards?.find(a => a.name.includes("Nobel Prize"))?.year || 0;
    return yearB - yearA;
});

const STATURE_LABEL: Record<string, string> = { TITAN: "Titan", ELITE: "Elite", MASTER: "Master" };

const seoTitle = "Nobel Laureates in Medicine & Physiology — MDRPedia Registry";
const seoDescription =
    "Explore the verified profiles, research impact, and groundbreaking discoveries of Nobel Prize winning physicians. The definitive registry of medical pioneers.";
---

<SiteLayout title={seoTitle} description={seoDescription} active="">
    <div class="fd">
        <header class="fd-wrap fd-hero">
            <span class="fd-eyebrow">Nobel Prize in Physiology or Medicine</span>
            <h1>Nobel Laureates in Medicine</h1>
            <p>
                The physicians and researchers in the register who have received a Nobel Prize
                for discoveries that changed human health.
            </p>
            <ul class="fd-stats">
                <li><b>{sortedLaureates.length}</b><span>Laureates in register</span></li>
            </ul>
        </header>

        <div class="fd-wrap fd-main">
            <section class="fd-sec" aria-labelledby="laureates-h">
                <div class="fd-sec__head">
                    <div>
                        <h2 id="laureates-h">Laureates</h2>
                        <p>
                            The Nobel Prize is among the highest honours in medicine. Holders are never placed below
                            Elite in the register; see the <a href="/methodology">methodology</a>.
                        </p>
                    </div>
                    <span class="fd-count">Most recent first</span>
                </div>

                <ul class="fd-laureates">
                    {sortedLaureates.map((doc) => {
                        const nobelAward = doc.data.awards?.find((a) => a.name.includes("Nobel Prize"));
                        const initials = doc.data.fullName.split(" ").map((w: string) => w[0]).slice(0, 2).join("").toUpperCase();
                        const stature = doc.data.geography?.country !== "India" ? STATURE_LABEL[doc.data.tier] : undefined;

                        return (
                            <li class="fd-laureate">
                                <div class="fd-laureate__img">
                                    {doc.data.portraitUrl ? (
                                        <img
                                            {...portraitAttrs(doc.data.portraitUrl, 400, 300)}
                                            referrerpolicy="no-referrer"
                                            decoding="async"
                                            onerror="this.remove()"
                                            alt={`Portrait of ${doc.data.fullName}, Nobel Laureate`}
                                            width="600"
                                            height="450"
                                            loading="lazy"
                                        />
                                    ) : (
                                        <span aria-hidden="true">{initials}</span>
                                    )}
                                </div>
                                <div class="yr">
                                    <span>Nobel Prize{nobelAward?.year ? ` ${nobelAward.year}` : ""}</span>
                                    {stature && <span class={`fd-stature fd-stature--${doc.data.tier.toLowerCase()}`}>{stature}</span>}
                                </div>
                                <h3><a href={`/doctors/${doc.id}`}>{doc.data.fullName}</a></h3>
                                <p>{doc.data.biography}</p>
                            </li>
                        );
                    })}
                </ul>
            </section>

            <section class="fd-sec" aria-labelledby="process-h">
                <div class="fd-sec__head"><h2 id="process-h">The selection process</h2></div>
                <div class="fd-cols">
                    <div>
                        <h3>Inside the Karolinska Institute</h3>
                        <p>
                            The process begins long before the October announcement. In September of the
                            preceding year, the Nobel Committee sends confidential invitations to qualified
                            nominators: members of the Nobel Assembly, previous laureates, and professors at
                            selected universities worldwide. No one can nominate themselves.
                        </p>
                        <p>
                            Candidates are screened by the Nobel Assembly at the Karolinska Institute in Sweden.
                            The key criterion is not a lifetime of good service but a <strong>"discovery or
                            improvement that has conferred the greatest benefit on mankind."</strong>
                        </p>
                    </div>
                    <div>
                        <h3>A century of progress</h3>
                        <ul class="fd-timeline">
                            <li><span class="y">1901</span><span>Emil von Behring for serum therapy against diphtheria</span></li>
                            <li><span class="y">1945</span><span>Fleming, Chain, and Florey for the discovery of penicillin</span></li>
                            <li><span class="y">1962</span><span>Crick, Watson, and Wilkins for the structure of DNA</span></li>
                            <li><span class="y">2023</span><span>Karikó and Weissman for mRNA vaccine technology</span></li>
                            <li><span class="y">2024</span><span>Ambros and Ruvkun for the discovery of microRNA</span></li>
                            <li><span class="y">2025</span><span>Brunkow, Ramsdell, and Sakaguchi for peripheral immune tolerance</span></li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="fd-sec" aria-labelledby="faq-h">
                <div class="fd-sec__head"><h2 id="faq-h">Frequently asked questions</h2></div>
                <div class="fd-faq">
                    <div>
                        <h3>How are laureates identified on MDRPedia?</h3>
                        <p>
                            A profile is listed here when its recorded honours include a Nobel Prize. Each profile
                            links to the sources behind its record.
                        </p>
                    </div>
                    <div>
                        <h3>Are all Nobel winners in medicine listed?</h3>
                        <p>
                            This page lists laureates who have a profile in the register, not every Nobel
                            winner. Missing someone? <a href="/doctor/add-profile">Nominate a profile</a>.
                        </p>
                    </div>
                </div>
            </section>
        </div>
    </div>
</SiteLayout>
