---
/**
 * MDRPedia — Ethical Workplace Certification Landing Page
 * Clinic-level ethics certification programme
 */
import SiteLayout from "../../layouts/SiteLayout.astro";
import SealRound from "../../components/SealRound.astro";
import { prisma } from "../../lib/prisma";
import "../../styles/pages/clinical.css";

export const prerender = false;

const certifiedClinics = await prisma.clinicCertification.findMany({
	where: { status: "CERTIFIED" },
	include: {
		hospital: {
			select: {
				id: true,
				name: true,
				slug: true,
				geography: { select: { country: true, city: true } },
			},
		},
	},
	orderBy: { updatedAt: "desc" },
	take: 50,
});

const clinicCount = certifiedClinics.length;
const siteBase = Astro.site?.href.replace(/\/$/, "") ?? "https://mdrpedia.com";
const canonicalUrl = `${siteBase}/ethical-workplace`;
const pageDescription =
	clinicCount > 0
		? `Browse ${clinicCount} ethics-certified clinics and hospitals on MDRPedia. Every affiliated physician holds an active individual ethics certification.`
		: "MDRPedia's Ethical Workplace programme certifies clinics and hospitals where every affiliated physician holds individual ethics certification.";

const collectionPageSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: "Ethics-Certified Workplaces",
	description: pageDescription,
	url: canonicalUrl,
	mainEntity: {
		"@type": "ItemList",
		name: "Ethics-Certified Clinics",
		numberOfItems: clinicCount,
		itemListElement: certifiedClinics.map((cert, i) => ({
			"@type": "ListItem",
			position: i + 1,
			item: {
				"@type": "Hospital",
				name: cert.hospital.name,
				url: `${siteBase}/ethical-workplace/${cert.hospital.slug}`,
				...(cert.hospital.geography?.country && {
					address: {
						"@type": "PostalAddress",
						addressLocality: cert.hospital.geography.city || undefined,
						addressCountry: cert.hospital.geography.country,
					},
				}),
			},
		})),
	},
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Home", item: siteBase },
		{ "@type": "ListItem", position: 2, name: "Ethical Workplace", item: canonicalUrl },
	],
};
---

<SiteLayout
	title="Ethical Workplace Certification | MDRPedia"
	description={pageDescription}
	jsonLd={[collectionPageSchema, breadcrumbSchema]}
>
	<div class="cl">
		<header class="cl-hero">
			<nav class="cl-crumb" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span aria-hidden="true">/</span>
				<span>Ethical Workplace</span>
			</nav>
			<span class="cl-eyebrow">Ethical Workplace programme</span>
			<h1>Clinics of <em>integrity</em></h1>
			<p>The Ethical Workplace badge is awarded to clinics and hospitals where every affiliated physician holds an active MDRPedia Ethics Certification.</p>
		</header>

		<div class="cl-main">
			<section class="cl-sec" aria-labelledby="how-heading">
				<h2 id="how-heading" class="cl-h2">How it works</h2>
				<ol class="cl-steps">
					<li>
						<span class="cl-steps__n">01</span>
						<b>Individual certification</b>
						<p>Every doctor affiliated with the clinic must individually earn and maintain an MDRPedia Ethics Certification.</p>
					</li>
					<li>
						<span class="cl-steps__n">02</span>
						<b>Clinic application</b>
						<p>The clinic submits an application. We verify that all affiliated doctors hold active certifications.</p>
					</li>
					<li>
						<span class="cl-steps__n">03</span>
						<b>Continuous compliance</b>
						<p>If any doctor's certification lapses or is revoked, the clinic status automatically recalculates.</p>
					</li>
				</ol>
			</section>

			<section class="cl-sec" aria-labelledby="tiers-heading">
				<h2 id="tiers-heading" class="cl-h2">Clinic tier equals the lowest individual tier</h2>
				<p class="cl-lede">Your clinic's ethics tier equals the lowest tier among its certified doctors. Elevate every physician to elevate the clinic.</p>
				<ul class="cl-seals">
					<li><SealRound kind="advocate" size={96} /><span>Advocate</span></li>
					<li><SealRound kind="guardian" size={96} /><span>Guardian</span></li>
					<li><SealRound kind="legend" size={96} /><span>Legend</span></li>
				</ul>
			</section>

			{certifiedClinics.length > 0 && (
				<section class="cl-sec" aria-labelledby="certified-heading">
					<h2 id="certified-heading" class="cl-h2">Certified ethical workplaces</h2>
					<div class="cl-grid">
						{certifiedClinics.map((cert) => (
							<a href={`/ethical-workplace/${cert.hospital.slug}`} class="cl-card cl-card--seal">
								{cert.tier && <SealRound kind={cert.tier.toLowerCase() as any} size={64} />}
								<span class="cl-card__body">
									<h3 class="cl-card__title">{cert.hospital.name}</h3>
									<span class="cl-card__aka">{[cert.hospital.geography?.city, cert.hospital.geography?.country].filter(Boolean).join(", ")}</span>
									<span class="cl-card__meta"><span>{cert.certified_doctors} certified physicians</span></span>
								</span>
							</a>
						))}
					</div>
				</section>
			)}

			<section class="cl-cta">
				<h2 class="cl-h2">Apply for clinic certification</h2>
				<p>Is your clinic committed to ethical excellence? Start the certification process today.</p>
				<a href="/contact" class="cl-btn">Get started</a>
			</section>
		</div>
	</div>
</SiteLayout>
