---
/**
 * MDRPedia — The Ethics Register (claude.ai/design "Ethics").
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import Seal from "../components/site/Seal.astro";
import { prisma } from "../lib/prisma";
import { ethicsSeal, SEAL_GREEN } from "../lib/register-seal";
import { normalizeSpecialty } from "../lib/specialty-groups";
import "../styles/pages/ethics.css";

export const prerender = false;

const grades = [
	{ key: "ADVOCATE", score: "60+", d: "Meets the audited baseline on patient transparency, compliance and community service." },
	{ key: "GUARDIAN", score: "75+", d: "Goes well beyond the baseline, with sustained, documented practice across all three areas." },
	{ key: "LEGEND", score: "90+", d: "Exemplary, public-facing ethical practice that sets the standard for peers." },
].map((g) => ({ ...g, ...ethicsSeal(g.key) }));

const steps = [
	{ n: "01", t: "Apply", d: "Sign in to your claimed record and apply with your contact details and the grade you're aiming for." },
	{ n: "02", t: "Initial audit", d: "Complete a 21-item checklist covering patient transparency, compliance and community service, with evidence." },
	{ n: "03", t: "Get certified", d: "Score 60+ for Advocate, 75+ for Guardian or 90+ for Legend." },
	{ n: "04", t: "Quarterly check-ins", d: "Keep the mark with a quarterly audit. A missed quarter costs 15% of your score." },
];

let certified: {
	full_name: string;
	slug: string;
	specialty: string;
	ethics_tier: string | null;
	ethics_cert_id: string | null;
	ethics_score: number | null;
	geography: { country: string | null } | null;
}[] = [];
let loadFailed = false;
try {
	certified = await prisma.profile.findMany({
		where: { ethics_status: "APPROVED", ethics_tier: { not: null }, ethics_cert_id: { not: null } },
		select: {
			full_name: true,
			slug: true,
			specialty: true,
			ethics_tier: true,
			ethics_cert_id: true,
			ethics_score: true,
			geography: { select: { country: true } },
		},
		orderBy: { ethics_score: "desc" },
		take: 100,
	});
} catch (error) {
	console.error("Ethics register query failed:", error);
	loadFailed = true;
}

const siteBase = Astro.site?.href.replace(/\/$/, "") ?? "https://mdrpedia.com";
const canonicalUrl = `${siteBase}/ethical-doctors`;
const title = "The Ethics Register — Physicians of Principle | MDRPedia";
const description =
	certified.length > 0
		? `${certified.length} physicians hold the MDRPedia ethics mark: transparency, compliance and service, verified by audit every quarter.`
		: "MDRPedia's ethics mark shows how a doctor practises: transparency, compliance and service, verified by audit every quarter. Advocate, Guardian and Legend grades.";

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		name: "The Ethics Register",
		description,
		url: canonicalUrl,
		mainEntity: {
			"@type": "ItemList",
			name: "Physicians holding the MDRPedia ethics mark",
			numberOfItems: certified.length,
			itemListElement: certified.map((doc, i) => ({
				"@type": "ListItem",
				position: i + 1,
				item: {
					"@type": "Physician",
					name: doc.full_name,
					medicalSpecialty: normalizeSpecialty(doc.specialty),
					url: `${siteBase}/doctors/${doc.slug}`,
				},
			})),
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "MDRPedia", item: siteBase },
			{ "@type": "ListItem", position: 2, name: "The Ethics Register", item: canonicalUrl },
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: [
			{ q: "How do I apply for MDRPedia ethics certification?", a: "Claim your record, sign in, and apply from your ethics dashboard with your contact details and the grade you're aiming for. You then complete a 21-item checklist covering patient transparency, compliance and community service." },
			{ q: "What are the ethics grades?", a: "Advocate (score 60+), Guardian (75+) and Legend (90+). The grade follows the audited score." },
			{ q: "How is the ethics score calculated?", a: "Reviewers grade each of 21 checklist items against the evidence supplied, across patient transparency, peer review and compliance, and community and pro-bono service." },
			{ q: "What are quarterly check-ins?", a: "After certification, a quarterly audit keeps the mark current. A missed quarter costs 15% of the score; if it drops below the grade's threshold the mark is suspended." },
		].map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
	},
];
---

<SiteLayout title={title} description={description} jsonLd={jsonLd}>
	<div class="et-page">
		<section class="et-hero" aria-labelledby="et-title">
			<div class="et-hero__inner">
				<div class="et-hero__copy">
					<span class="et-kicker">THE ETHICS REGISTER · AUDITED QUARTERLY</span>
					<h1 id="et-title">Physicians of <em>principle.</em></h1>
					<p>
						Stature shows what a doctor has contributed. The green mark shows how they practise: transparency, compliance and service,
						verified by audit every quarter.
					</p>
					<div class="et-hero__ctas">
						<a href="/doctor/ethics" class="et-btn et-btn--light">Apply for certification</a>
						<a href="#certified" class="et-btn et-btn--outline">See certified physicians</a>
					</div>
				</div>
				<div class="et-hero__seal">
					<Seal size={240} color="#f4f0e6" ring="ETHICS · LEGEND · GUARDIAN · ADVOCATE ·" letter="M" no="AUDITED" uid="eth-hero" />
				</div>
			</div>
		</section>

		<section class="et-sec" aria-labelledby="et-grades">
			<header class="et-sec__head">
				<span class="et-sec__no">№ 01 · THREE GRADES</span>
				<h2 id="et-grades">One mark, earned by score</h2>
			</header>
			<div class="et-grades">
				{grades.map((g) => (
					<article class="et-grade">
						<Seal size={110} color={SEAL_GREEN} ring={g.ring} letter={g.letter} no={g.score} uid={`g-${g.letter}`} />
						<div class="et-grade__head">
							<h3>{g.name}</h3>
							<span>{g.score}</span>
						</div>
						<p>{g.d}</p>
					</article>
				))}
			</div>
		</section>

		<section class="et-sec" aria-labelledby="et-process">
			<header class="et-sec__head">
				<span class="et-sec__no">№ 02 · PROCESS</span>
				<h2 id="et-process">How certification works</h2>
			</header>
			<ol class="et-steps">
				{steps.map((s) => (
					<li>
						<span class="et-steps__n" aria-hidden="true">{s.n}</span>
						<span class="et-steps__t">{s.t}</span>
						<span class="et-steps__d">{s.d}</span>
					</li>
				))}
			</ol>
			<p class="et-aside">
				Run a clinic or hospital? <a href="/ethical-workplace">Certify the workplace</a>. Already certified? Check any seal on its
				verification page, linked from the seal itself.
			</p>
		</section>

		<section class="et-sec et-sec--last" id="certified" aria-labelledby="et-certified">
			<header class="et-sec__head">
				<span class="et-sec__no">№ 03 · CERTIFIED</span>
				<h2 id="et-certified">Currently holding the mark</h2>
			</header>
			{loadFailed ? (
				<p class="et-empty" role="status">The list of certified physicians couldn't be loaded. Please refresh in a moment.</p>
			) : certified.length === 0 ? (
				<div class="et-empty">
					<p>
						No physician holds the mark yet. Every certification will be listed here with its
						grade, score and certificate number the day it is granted.
					</p>
					<a href="/doctor/ethics">Apply for the first audit →</a>
				</div>
			) : (
				<ul class="et-list">
					{certified.map((c) => {
						const s = ethicsSeal(c.ethics_tier);
						return (
							<li>
								<a href={`/ethical-doctors/verify/${c.ethics_cert_id}`} class="et-row">
									<Seal size={56} color={SEAL_GREEN} ring={s.ring} letter={s.letter} uid={`c-${c.ethics_cert_id}`} />
									<span class="et-row__who">
										<span class="et-row__name">{c.full_name}</span>
										<span class="et-row__meta">
											{[normalizeSpecialty(c.specialty), c.geography?.country].filter((v) => v && v !== "Global").join(" · ")}
										</span>
									</span>
									<span class="et-row__id">№ {c.ethics_cert_id}</span>
									<span class="et-row__grade">
										{s.name}{c.ethics_score != null && ` · ${Math.round(c.ethics_score)}`}
									</span>
								</a>
							</li>
						);
					})}
				</ul>
			)}
		</section>
	</div>
</SiteLayout>
