---
export const prerender = false;
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/pages/utility.css";
import { getSession } from "../../lib/auth";
import { prisma } from "../../lib/prisma";

// Read session from cookie
const session = await getSession(Astro.request);

if (!session) {
    return Astro.redirect('/login?error=not_authenticated');
}

// Fetch real profile data
const profile = await prisma.profile.findUnique({
    where: { id: session.profileId },
    select: {
        id: true,
        slug: true,
        full_name: true,
        tier: true,
        specialty: true,
        h_index: true,
        ranking_score: true,
        claim_status: true,
    },
});

if (!profile) {
    return Astro.redirect('/login?error=profile_not_found');
}

const doctorName = profile.full_name;
const tier = profile.tier || 'STANDARD';
const slug = profile.slug;

// Fetch real view count
let viewCount = 0;
try {
    viewCount = await prisma.profileView.count({ where: { profile_id: profile.id } });
} catch { /* table may not exist yet */ }

// Fetch search appearance count (searches that led to clicking this profile)
let searchCount = 0;
try {
    searchCount = await prisma.searchLog.count({ where: { clickedSlug: profile.slug } });
} catch { /* optional */ }

const score = profile.ranking_score ? Number(profile.ranking_score).toFixed(1) : '—';
---

<SiteLayout
	title="Doctor portal | MDRPedia"
	description="Private portal for physicians to view their MDRPedia record."
	robots="noindex, nofollow"
>
	<div class="u-page">
		<div class="u-wrap">
			<header class="u-head">
				<span class="u-kicker">DOCTOR PORTAL · PRIVATE</span>
				<h1 class="u-h1">Welcome, <em>{doctorName}.</em></h1>
				<div class="u-portal__bar">
					<span class="u-tag">VERIFIED IDENTITY</span>
					{tier === "TITAN" && <span class="u-tag">TITAN TIER</span>}
					<a class="u-btn u-btn--line" href="/api/auth/logout">Sign out</a>
				</div>
			</header>

			<div class="u-portal">
				<nav class="u-portal__nav" aria-label="Portal">
					<a href="/doctor/portal" aria-current="page">Overview</a>
					<a href={`/doctors/${slug}`}>View my record</a>
					<a href={`/suggest-edit?profile=${encodeURIComponent(slug)}&type=general`}>Suggest an edit</a>
				</nav>

				<div class="u-portal__main">
					<section aria-label="Record statistics">
						<div class="u-stats">
							<div class="u-stat"><b>{viewCount.toLocaleString()}</b><span>Profile views</span></div>
							<div class="u-stat"><b>{searchCount.toLocaleString()}</b><span>Search clicks to your record</span></div>
							<div class="u-stat">
								<b>{score}</b>
								<span>MDR score{profile.h_index ? ` · h-index ${profile.h_index}` : ""}</span>
							</div>
						</div>
					</section>

					<section class="u-prose u-prose--flush">
						<h2>Corrections</h2>
						<p>
							Your score comes from the public evidence on your record. To correct a fact, send a suggestion with a source;
							an editor reviews it before anything changes. Claiming never adds points by itself.
						</p>
						<p>
							<a class="u-btn u-btn--green" href={`/suggest-edit?profile=${encodeURIComponent(slug)}&type=general`}>Suggest an edit</a>
						</p>
					</section>
				</div>
			</div>
		</div>
	</div>
</SiteLayout>
