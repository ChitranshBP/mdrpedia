---
export const prerender = true;
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/pages/utility.css";
---

<SiteLayout
	title="Add a Doctor Profile | MDRPedia"
	description="Propose a physician who is not yet in the MDRPedia register. Every submission is checked by an editor against public sources before a profile is created."
>
	<div class="u-page">
		<div class="u-wrap">
			<header class="u-head u-center">
				<span class="u-kicker">CONTRIBUTE · REVIEWED BEFORE PUBLISHING</span>
				<h1 class="u-h1">Add a <em>physician.</em></h1>
				<p class="u-lede">
					Propose a doctor who is not yet in the register. Nothing is published until an editor has checked it against public sources.
					Already listed? <a href="/doctor/claim">Claim the record</a> instead.
				</p>
			</header>

			<form id="add-profile-form" class="u-form" novalidate>
				<fieldset class="u-set">
					<legend>Basic information</legend>
					<div class="u-row">
						<div class="u-field">
							<label for="full_name">Full name <span class="u-req">*</span></label>
							<input class="u-input" type="text" id="full_name" name="full_name" required maxlength="200" placeholder="e.g. Atul Gawande" />
						</div>
						<div class="u-field">
							<label for="specialty">Specialty <span class="u-req">*</span></label>
							<input class="u-input" type="text" id="specialty" name="specialty" required maxlength="200" placeholder="e.g. Surgery" />
						</div>
					</div>
					<div class="u-row">
						<div class="u-field">
							<label for="country">Country <span class="u-req">*</span></label>
							<input class="u-input" type="text" id="country" name="country" required maxlength="100" placeholder="e.g. United States" />
						</div>
						<div class="u-field">
							<label for="city">City</label>
							<input class="u-input" type="text" id="city" name="city" placeholder="e.g. Boston" />
						</div>
					</div>
					<div class="u-field">
						<label for="hospital">Primary affiliation / hospital <span class="u-req">*</span></label>
						<input class="u-input" type="text" id="hospital" name="hospital" required placeholder="e.g. Brigham and Women's Hospital" />
					</div>
				</fieldset>

				<fieldset class="u-set">
					<legend>Professional details</legend>
					<div class="u-field">
						<label for="biography">Biography</label>
						<textarea class="u-textarea" id="biography" name="biography" rows="4" maxlength="5000" placeholder="A short professional biography, with sources if you have them."></textarea>
					</div>
					<div class="u-row">
						<div class="u-field">
							<label for="orcid_id">ORCID iD</label>
							<input class="u-input" type="text" id="orcid_id" name="orcid_id" placeholder="0000-0000-0000-0000" />
						</div>
						<div class="u-field">
							<label for="npi_number">NPI number (US only)</label>
							<input class="u-input" type="text" id="npi_number" name="npi_number" inputmode="numeric" placeholder="10 digits" />
						</div>
					</div>
				</fieldset>

				<fieldset class="u-set">
					<legend>Contributor</legend>
					<p class="u-set__note">We ask for this to prevent spam. Editors may contact you about the submission.</p>
					<div class="u-row">
						<div class="u-field">
							<label for="contributor_name">Your name <span class="u-req">*</span></label>
							<input class="u-input" type="text" id="contributor_name" name="contributor_name" autocomplete="name" required />
						</div>
						<div class="u-field">
							<label for="contributor_email">Your email <span class="u-req">*</span></label>
							<input class="u-input" type="email" id="contributor_email" name="contributor_email" autocomplete="email" required />
						</div>
					</div>
				</fieldset>

				<div class="u-hp" aria-hidden="true">
					<input type="checkbox" name="honeypot_filled" tabindex="-1" autocomplete="off" />
				</div>

				<div class="u-actions">
					<button type="submit" id="btn-submit" class="u-btn">Submit profile</button>
				</div>

				<p id="form-message" class="u-msg" role="status" aria-live="polite" hidden></p>
			</form>
		</div>
	</div>
</SiteLayout>

<script>
	const form = document.getElementById("add-profile-form") as HTMLFormElement | null;
	const msgEl = document.getElementById("form-message") as HTMLElement | null;
	const btn = document.getElementById("btn-submit") as HTMLButtonElement | null;

	function show(text: string, ok: boolean) {
		if (!msgEl) return;
		msgEl.textContent = text;
		msgEl.className = `u-msg ${ok ? "u-msg--ok" : "u-msg--err"}`;
		msgEl.hidden = false;
	}

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!btn || !msgEl) return;

		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		btn.textContent = "Submitting...";
		btn.disabled = true;
		msgEl.hidden = true;

		const data: Record<string, FormDataEntryValue> = {};
		new FormData(form).forEach((value, key) => {
			data[key] = value;
		});

		try {
			const res = await fetch("/api/submit-profile", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(data),
			});
			const result = await res.json().catch(() => ({}));

			if (res.ok) {
				show("Profile submitted. An editor will review it before anything is published.", true);
				form.reset();
			} else {
				show(result.error || "Submission failed.", false);
			}
		} catch {
			show("Network error. Please try again.", false);
		} finally {
			btn.textContent = "Submit profile";
			btn.disabled = false;
		}
	});
</script>
