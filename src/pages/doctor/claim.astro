---
export const prerender = true;

import SiteLayout from "../../layouts/SiteLayout.astro";
import ClaimRecord from "../../components/ClaimRecord";
import "../../styles/pages/claim.css";

const title = "Claim Your Record — For Physicians | MDRPedia";
const description =
	"Find your MDRPedia record, verify your licence against your national register (NMR, State Medical Council, NPI or GMC), correct facts with a source and embed your seal. Free, and it never changes your score.";

const faqs = [
	{
		q: "How is my identity verified?",
		a: "Editors check the registration number you give against the national register: the NMR or your State Medical Council in India, NPPES in the United States (an NPI is checked automatically) and the GMC in the United Kingdom. Nothing on your record changes until the claim is approved.",
	},
	{
		q: "Will my licence number be published?",
		a: "No. It is stored in our private review queue and seen only by editors. Supporting documents are stored privately and opened only by reviewers.",
	},
	{
		q: "Does claiming change my score?",
		a: "No. Scores come from the public evidence on your record. Claiming lets you correct that evidence with a source; it never adds points by itself.",
	},
	{
		q: "How long does it take?",
		a: "Claims are reviewed by hand. We email the address you give once the review is complete.",
	},
	{
		q: "Is it free?",
		a: "Yes. Claiming, correcting and embedding your seal are free.",
	},
];

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "MDRPedia", item: "https://mdrpedia.com" },
			{ "@type": "ListItem", position: 2, name: "Claim your record", item: "https://mdrpedia.com/doctor/claim" },
		],
	},
];
---

<SiteLayout title={title} description={description} jsonLd={jsonLd}>
	<div class="cl-page">
		<section class="cl-hero" aria-labelledby="cl-title">
			<span class="cl-kicker">FOR PHYSICIANS · FREE · NEVER CHANGES YOUR SCORE</span>
			<h1 id="cl-title">If your record is here, <em>own it.</em></h1>
		</section>

		<ClaimRecord client:load />

		<section class="cl-faq" aria-labelledby="cl-faq-title">
			<h2 id="cl-faq-title">Questions physicians ask</h2>
			{faqs.map((f) => (
				<details>
					<summary>{f.q}</summary>
					<p>{f.a}</p>
				</details>
			))}
		</section>
	</div>
</SiteLayout>
