---
export const prerender = true;
/**
 * MDRPedia — Breakthroughs & Impact
 * Curated feed of medical research breakthroughs, registry updates, and impact stories.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import {
    getPublishedNews,
    getCategoryInfo,
} from "../lib/news";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import "../styles/pages/feed.css";

// Published articles only — entries dated in the future are scheduled,
// not live, so the feed never leads with tomorrow's news.
const articles = (await getPublishedNews()).map((entry) => ({
    ...entry.data,
    id: entry.id,
}));

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
        timeZone: "UTC",
    });
}

// Get unique categories
const uniqueCategories = [...new Set(articles.map(a => a.category))];

// CollectionPage JSON-LD for SEO
const collectionSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Medical Breakthroughs & Impact News — MDRPedia",
    "description": "Curated coverage of medical research breakthroughs, clinical trials, and stories of physicians making a measurable difference in global health.",
    "url": "https://mdrpedia.com/news",
    "publisher": {
        "@type": "Organization",
        "name": "MDRPedia",
        "url": "https://mdrpedia.com"
    },
    "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": articles.length,
        "itemListElement": articles.slice(0, 10).map((a, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "url": `https://mdrpedia.com/news/${a.id}`,
            "name": a.title
        }))
    }
};
---

<SiteLayout
    title="Medical Breakthroughs & Impact News — MDRPedia"
    description="Curated coverage of medical research breakthroughs, clinical trial results, and impact stories from the world's leading physicians and researchers."
    active=""
    jsonLd={[collectionSchema]}
>
    <div class="fd">
        <header class="fd-wrap fd-hero">
            <span class="fd-eyebrow">Breakthroughs &amp; impact</span>
            <h1>Medical Insights</h1>
            <p>
                Curated coverage of research breakthroughs, clinical trials, and stories
                of physicians making a measurable difference in global health.
            </p>
            <ul class="fd-stats">
                <li><b>{articles.length}</b><span>Articles</span></li>
                <li><b>{uniqueCategories.length}</b><span>Categories</span></li>
            </ul>
        </header>

        <div class="fd-wrap fd-main">
            {articles.length > 0 && (
                <section class="fd-sec" aria-labelledby="featured-h">
                    <div class="fd-sec__head"><h2 id="featured-h">Featured story</h2></div>
                    <article class="fd-feature">
                        <span class="kick">{getCategoryInfo(articles[0].category).label}</span>
                        <h3><a href={`/news/${articles[0].id}`}>{articles[0].title}</a></h3>
                        <p>{articles[0].summary}</p>
                        <div class="meta">
                            <time datetime={articles[0].date}>{formatDate(articles[0].date)}</time>
                            <span>{articles[0].source}</span>
                        </div>
                        <a href={`/news/${articles[0].id}`} class="go">Read the full story →</a>
                    </article>
                </section>
            )}

            <section class="fd-sec" aria-labelledby="latest-h">
                <div class="fd-sec__head">
                    <h2 id="latest-h">Latest articles</h2>
                    <span class="fd-count" id="article-count" aria-live="polite">{articles.length - 1} articles</span>
                </div>

                <div class="fd-seg" role="group" aria-label="Filter by category">
                    <button type="button" class="filter-btn" data-category="all" aria-pressed="true">All stories</button>
                    {uniqueCategories.map((cat) => (
                        <button type="button" class="filter-btn" data-category={cat.toLowerCase()} aria-pressed="false">
                            {getCategoryInfo(cat).label}
                        </button>
                    ))}
                </div>

                <ol class="fd-list" id="articles-grid">
                    {articles.slice(1).map((article) => (
                        <li class="fd-item article-card" data-category={article.category.toLowerCase()}>
                            <div class="fd-item__meta">
                                <span class="cat">{getCategoryInfo(article.category).label}</span>
                                <time datetime={article.date}>{formatDate(article.date)}</time>
                            </div>
                            <div>
                                <h3><a href={`/news/${article.id}`}>{article.title}</a></h3>
                                <p>{article.summary}</p>
                                <span class="src">{article.source}</span>
                            </div>
                        </li>
                    ))}
                </ol>

                <p class="fd-empty" id="empty-state" hidden>
                    No articles in this category. <button type="button" id="reset-filter">View all stories</button>
                </p>
            </section>

            <section class="fd-panel" aria-labelledby="submit-h">
                <div>
                    <h3 id="submit-h">Share a breakthrough</h3>
                    <p>Know of a medical breakthrough or impact story we should cover? Submit it for review by our editorial team.</p>
                </div>
                <a href="/contact?subject=submit-story" class="fd-btn">Submit a story</a>
            </section>

            <section class="fd-panel fd-panel--news">
                <NewsletterSignup source="news-page" />
            </section>
        </div>
    </div>
</SiteLayout>

<script>
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const articles = document.querySelectorAll<HTMLElement>('.article-card');
    const emptyState = document.getElementById('empty-state');
    const articleCount = document.getElementById('article-count');
    const resetFilter = document.getElementById('reset-filter');

    function filterArticles(category: string) {
        let visibleCount = 0;

        articles.forEach(article => {
            if (category === 'all' || article.dataset.category === category) {
                article.style.display = '';
                visibleCount++;
            } else {
                article.style.display = 'none';
            }
        });

        if (articleCount) {
            articleCount.textContent = `${visibleCount} article${visibleCount !== 1 ? 's' : ''}`;
        }

        if (emptyState) {
            emptyState.hidden = visibleCount > 0;
        }
    }

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            filterBtns.forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
            filterArticles(btn.dataset.category || 'all');
        });
    });

    resetFilter?.addEventListener('click', () => {
        filterBtns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.category === 'all')));
        filterArticles('all');
    });
</script>
