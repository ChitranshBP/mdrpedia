---
export const prerender = true;
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/pages/utility.css";
---

<SiteLayout
	title="Contact Support | MDRPedia"
	description="Contact MDRPedia support for help with a record, a claim, a correction or a privacy request."
>
	<div class="u-page">
		<div class="u-wrap">
			<header class="u-head">
				<span class="u-kicker">CONTACT</span>
				<h1 class="u-h1">Talk to <em>the editors.</em></h1>
				<p class="u-lede">Reach the team for help with a record, a claim, a correction or a privacy request.</p>
			</header>

			<div class="u-cards">
				<section class="u-card">
					<span class="u-kicker">GENERAL</span>
					<h2>Email support</h2>
					<p>General enquiries, profile claims and technical support.</p>
					<a href="mailto:support@mdrpedia.com" id="support-mailto" class="u-btn u-btn--green">support@mdrpedia.com</a>
				</section>

				<section class="u-card">
					<span class="u-kicker">PHYSICIANS</span>
					<h2>Record verification</h2>
					<p>Are you a doctor? Find your record, verify your licence and correct facts with a source.</p>
					<a href="/doctor/claim" class="u-btn u-btn--line">Claim your record</a>
				</section>

				<section class="u-card">
					<span class="u-kicker">PRIVACY</span>
					<h2>Data privacy</h2>
					<p>Request data removal or ask about how your information is handled.</p>
					<a href="mailto:privacy@mdrpedia.com" class="u-btn u-btn--line">Privacy team</a>
				</section>
			</div>
		</div>
	</div>
</SiteLayout>

<script>
	const params = new URLSearchParams(window.location.search);
	const subject = params.get("subject");
	const award = params.get("award");
	const link = document.getElementById("support-mailto") as HTMLAnchorElement | null;
	if (link && (subject || award)) {
		const labels: Record<string, string> = { "suggest-recipient": "Suggest a recipient" };
		const title = [subject ? labels[subject] ?? subject : "Enquiry", award].filter(Boolean).join(": ");
		link.href = `mailto:support@mdrpedia.com?subject=${encodeURIComponent(title)}`;
		link.textContent = `Email us about: ${title}`;
	}
</script>
