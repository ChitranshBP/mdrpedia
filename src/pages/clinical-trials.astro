---
/**
 * MDRPedia — Clinical Trials & Drug Development Tracker
 * Vaccines, treatments and therapies in development, by company.
 */
export const prerender = true;

import SiteLayout from "../layouts/SiteLayout.astro";
import trialsData from "../content/trials/index.json";
import { summarise, progressPercent, statusTone } from "../lib/trials";
import "../styles/pages/clinical.css";

const { companies, categories, lastUpdated } = trialsData;

const { totalTrials, openTrials, phase3Trials, totalEnrollment } = summarise(companies);

function formatDate(dateStr: string): string {
	return new Date(dateStr).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}

const categoryName = (id: string) => categories.find((c) => c.id === id)?.name;
---

<SiteLayout
	title="Clinical Trials & Drug Development — MDRPedia"
	description="Track the latest clinical trials, vaccine development, and breakthrough treatments from leading pharmaceutical companies worldwide."
	active="find"
>
	<div class="cl">
		<section class="cl-hero">
			<span class="cl-eyebrow">Last reviewed {formatDate(lastUpdated)}</span>
			<h1>Clinical trials and drug development</h1>
			<p>Vaccines, treatments and therapies in development at leading pharmaceutical companies, with the latest trial results and regulatory milestones.</p>
			<ul class="cl-stats" aria-label="Tracker totals">
				<li><b>{openTrials}</b><span>Trials under way</span></li>
				<li><b>{totalTrials}</b><span>Programmes tracked</span></li>
				<li><b>{phase3Trials}</b><span>Phase 3 studies</span></li>
				<li><b>{totalEnrollment.toLocaleString("en-US")}</b><span>Patients enrolled</span></li>
				<li><b>{companies.length}</b><span>Companies tracked</span></li>
			</ul>
		</section>

		<section class="cl-main">
			<div class="cl-controls">
				<div class="cl-pills" role="group" aria-label="Filter by category">
					<button type="button" class="category-pill cl-pill" data-category="all" aria-pressed="true">All trials</button>
					{categories.map((cat) => (
						<button type="button" class="category-pill cl-pill" data-category={cat.id} aria-pressed="false">{cat.name}</button>
					))}
				</div>
			</div>

			{companies.map((company) => (
				<section class="cl-sec company-section" id={company.id}>
					<div class="cl-company">
						<div class="cl-company__id">
							{company.logo && <img src={company.logo} alt="" width="48" height="48" loading="lazy" onerror="this.style.display='none'" />}
							<div>
								<h2 class="cl-h2">{company.name}</h2>
								<p class="cl-meta">
									<span>{company.headquarters}</span>
									<span>Market cap {company.marketCap}</span>
									<span>{company.trials.length} {company.trials.length === 1 ? "programme" : "programmes"}</span>
								</p>
								<ul class="cl-tags">
									{company.focus.map((f) => <li>{f}</li>)}
								</ul>
							</div>
						</div>
						<a href={company.website} target="_blank" rel="noopener" class="cl-btn cl-btn--line">Visit website ↗</a>
					</div>

					<div class="cl-grid">
						{company.trials.map((trial) => (
							<article class="cl-card trial-card" data-category={trial.category}>
								<span class="cl-card__top">
									<span>{trial.phase}</span>
									<span class={`cl-flag cl-flag--${statusTone(trial.status)}`}>{trial.status}</span>
								</span>
								<h3 class="cl-card__title"><a href={`/trials/${trial.id}`}>{trial.name}</a></h3>
								<p class="cl-card__aka">{trial.indication}{categoryName(trial.category) ? ` · ${categoryName(trial.category)}` : ""}</p>
								<p class="cl-card__text">{trial.description}</p>

								{trial.latestUpdate && (
									<div class="cl-update">
										<span class="cl-update__k">Latest update · {formatDate(trial.latestUpdate.date)}</span>
										<p>{trial.latestUpdate.summary}</p>
										{trial.latestUpdate.source ? (
											<a href={trial.latestUpdate.source} target="_blank" rel="noopener noreferrer">Source</a>
										) : null}
									</div>
								)}

								<dl class="cl-kv">
									{trial.enrollment ? <div><dt>Enrolled</dt><dd>{trial.enrollment.toLocaleString()}</dd></div> : null}
									{trial.sites ? <div><dt>Sites</dt><dd>{trial.sites}</dd></div> : null}
									{trial.countries?.length ? <div><dt>Countries</dt><dd>{trial.countries.length}</dd></div> : null}
									{trial.registryId ? (
										<div><dt>Registry</dt><dd><a href={`https://clinicaltrials.gov/study/${trial.registryId}`} target="_blank" rel="noopener noreferrer">{trial.registryId}</a></dd></div>
									) : null}
								</dl>

								{trial.startDate && trial.estimatedCompletion ? (
									<div class="cl-timeline">
										<div class="cl-timeline__ends"><span>Started {trial.startDate}</span><span>Est. completion {trial.estimatedCompletion}</span></div>
										<div class="cl-bar" role="img" aria-label={`${progressPercent(trial.startDate, trial.estimatedCompletion)} percent of the planned duration has elapsed`}><div style={`width: ${progressPercent(trial.startDate, trial.estimatedCompletion)}%`}></div></div>
									</div>
								) : null}

								{trial.countries?.length ? <p class="cl-card__loc">Trial locations: {trial.countries.join(" · ")}</p> : null}
							</article>
						))}
					</div>
				</section>
			))}

			<section class="cl-cta">
				<h2 class="cl-h2">Are you a clinical trial investigator?</h2>
				<p>Claim your MDRPedia profile to highlight your research contributions and connect with the global medical community.</p>
				<a href="/doctor/claim" class="cl-btn">Claim your profile</a>
			</section>

			<p class="cl-note">Trial information is compiled from public sources and may be out of date. It is not medical advice and is not an offer of enrolment; check the registry entry or speak to a physician before acting on it.</p>
		</section>
	</div>
</SiteLayout>

<script>
	const pills = document.querySelectorAll(".category-pill");
	const cards = document.querySelectorAll(".trial-card");

	pills.forEach((pill) => {
		pill.addEventListener("click", () => {
			const category = (pill as HTMLElement).dataset.category;
			pills.forEach((p) => p.setAttribute("aria-pressed", String(p === pill)));
			cards.forEach((card) => {
				(card as HTMLElement).style.display = category === "all" || (card as HTMLElement).dataset.category === category ? "" : "none";
			});
			document.querySelectorAll(".company-section").forEach((section) => {
				const visible = [...section.querySelectorAll(".trial-card")].some((c) => (c as HTMLElement).style.display !== "none");
				(section as HTMLElement).style.display = visible ? "" : "none";
			});
		});
	});
</script>
