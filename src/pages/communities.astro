---
export const prerender = true;
/**
 * MDRPedia — Communities & Organizations
 * Real medical organizations + specialty groupings
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import "../styles/pages/clinical.css";

const allDoctors = await getCollection("doctors");
const communityEntries = await getCollection("communities");

const staticCommunities = communityEntries.map((c) => c.data);

const orgsWithCounts = staticCommunities.map((org) => {
	const count = allDoctors.filter((d) => {
		const spec = (d.data.specialty || "").toLowerCase();
		return org.relatedSpecialties.some((rs) => spec.includes(rs.toLowerCase()));
	}).length;
	return { ...org, doctorCount: count };
});

const regions = Array.from(new Set(staticCommunities.map((c) => c.region)));

const specMap = new Map<string, typeof allDoctors>();
allDoctors.forEach((d) => {
	const s = d.data.specialty;
	if (s && s.length > 2) {
		if (!specMap.has(s)) specMap.set(s, []);
		specMap.get(s)!.push(d);
	}
});

const specialtyCommunities = [...specMap.entries()]
	.filter(([name, members]) => {
		// Skip numeric / bulk-import artefacts and tiny groups.
		if (/^\d+$/.test(name.trim())) return false;
		if (/^[\d\s.]+$/.test(name.trim())) return false;
		if (name.trim().length < 3) return false;
		return members.length >= 3;
	})
	.sort((a, b) => b[1].length - a[1].length)
	.slice(0, 20)
	.map(([name, members]) => ({
		name,
		count: members.length,
		head: members.sort((a, b) => (b.data.hIndex || 0) - (a.data.hIndex || 0))[0],
		members: members.slice(0, 5),
	}));

const initials = (full: string) =>
	full
		.split(" ")
		.map((w) => w[0])
		.filter((_, i) => i < 2)
		.join("")
		.toUpperCase();
const titleCase = (s: string) => s.charAt(0) + s.slice(1).toLowerCase();
---

<SiteLayout
	title="Medical Communities & Organizations — MDRPedia"
	description="Browse medical organizations, specialty communities, and verified professional networks."
>
	<div class="cl">
		<section class="cl-hero">
			<span class="cl-eyebrow">Communities</span>
			<h1>Communities and organizations</h1>
			<p>Medical organizations, specialty communities, and verified professional networks in the MDRPedia register.</p>
		</section>

		<section class="cl-main">
			<section class="cl-sec" aria-labelledby="orgs-h">
				<div class="cl-head">
					<h2 id="orgs-h" class="cl-h2">Medical organizations</h2>
					<div class="cl-pills region-filter" role="group" aria-label="Filter by region">
						<button type="button" class="filter-btn cl-pill" data-region="All" aria-pressed="true">All</button>
						{regions.map((region) => <button type="button" class="filter-btn cl-pill" data-region={region} aria-pressed="false">{region}</button>)}
					</div>
				</div>

				<div class="cl-grid" id="orgsGrid">
					{orgsWithCounts.map((org) => (
						<article class="cl-card org-card" data-region={org.region}>
							<span class="cl-card__top"><span>{org.region}</span><span class="cl-abbr">{org.abbr}</span></span>
							<h3 class="cl-card__title">{org.name}</h3>
							<p class="cl-card__text">{org.desc}</p>
							<ul class="cl-tags">
								{org.relatedSpecialties.slice(0, 3).map((s) => <li>{s}</li>)}
							</ul>
							<span class="cl-card__meta">
								<span>{org.doctorCount} related profiles</span>
								{org.url && org.url !== "#" && <a href={org.url} target="_blank" rel="noopener noreferrer">Visit website ↗</a>}
							</span>
						</article>
					))}
				</div>

				<div class="cl-empty" id="noResults" hidden>
					<p>No organizations found for this region.</p>
				</div>
			</section>

			<section class="cl-sec" aria-labelledby="spec-h">
				<h2 id="spec-h" class="cl-h2">Specialty communities</h2>
				<p class="cl-lede">Physicians on the register grouped by medical specialty. Each community is headed by the member with the highest h-index.</p>
				<div class="cl-grid">
					{specialtyCommunities.map((community) => (
						<article class="cl-card">
							<span class="cl-card__top"><span>{community.count} members</span></span>
							<h3 class="cl-card__title">{community.name}</h3>
							<div class="cl-person cl-person--static">
								<span class="cl-person__av"><span>{initials(community.head.data.fullName)}</span></span>
								<span class="cl-person__body">
									<span class="cl-person__k">Community head</span>
									<b><a href={`/doctors/${community.head.id}`}>{community.head.data.fullName}</a></b>
									<span class="cl-person__loc">
										h-index {community.head.data.hIndex}
										{community.head.data.tier !== "UNRANKED" && community.head.data.geography?.country !== "India" ? ` · ${titleCase(community.head.data.tier)}` : ""}
									</span>
								</span>
							</div>
							<ul class="cl-initials">
								{community.members.slice(1, 4).map((m) => (
									<li><a href={`/doctors/${m.id}`} title={m.data.fullName} aria-label={m.data.fullName}>{initials(m.data.fullName)}</a></li>
								))}
								{community.count > 4 && <li class="cl-initials__more">+{community.count - 4}</li>}
							</ul>
						</article>
					))}
				</div>
			</section>
		</section>
	</div>
</SiteLayout>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const buttons = document.querySelectorAll(".filter-btn");
		const cards = document.querySelectorAll(".org-card");
		const noResults = document.getElementById("noResults");
		const grid = document.getElementById("orgsGrid");

		buttons.forEach((btn) => {
			btn.addEventListener("click", () => {
				buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
				const region = btn.getAttribute("data-region");
				let visibleCount = 0;
				cards.forEach((card) => {
					const show = region === "All" || card.getAttribute("data-region") === region;
					(card as HTMLElement).style.display = show ? "" : "none";
					if (show) visibleCount++;
				});
				if (noResults) noResults.hidden = visibleCount > 0;
				if (grid) grid.style.display = visibleCount > 0 ? "" : "none";
			});
		});
	});
</script>
