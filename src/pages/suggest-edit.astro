---
// Server-rendered: the ?profile= and ?type= query strings are read per request.
export const prerender = false;
/**
 * MDRPedia — Suggest a profile edit.
 * Posts to /api/suggest-edit (field_name, new_value, reason, contributor_*, profile_slug, honeypot_filled).
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import { getEntry } from "astro:content";
import { prisma } from "../lib/prisma";
import "../styles/pages/utility.css";

const profileSlug = (Astro.url.searchParams.get("profile") || "").slice(0, 200);
const editType = Astro.url.searchParams.get("type") || "general";

let doctor: { name: string; tier: string } | null = null;
if (profileSlug) {
	try {
		const entry = await getEntry("doctors", profileSlug);
		if (entry) doctor = { name: entry.data.fullName, tier: entry.data.tier };
	} catch {
		/* fall through to the database */
	}
	if (!doctor) {
		try {
			const p = await prisma.profile.findUnique({ where: { slug: profileSlug }, select: { full_name: true, tier: true } });
			if (p) doctor = { name: p.full_name, tier: String(p.tier ?? "UNRANKED") };
		} catch {
			/* the form still works without the name */
		}
	}
}

const editTypes = {
	citation: { title: "Add a citation", description: "Add a research paper, publication or academic citation." },
	award: { title: "Add an honour", description: "Add an award, honour or recognition." },
	affiliation: { title: "Add an affiliation", description: "Add a hospital, institution or organisation affiliation." },
	general: { title: "Correct or add information", description: "Add or correct any other part of the record." },
} as const;
type EditKey = keyof typeof editTypes;
const currentKey: EditKey = (editType in editTypes ? editType : "general") as EditKey;
const current = editTypes[currentKey];
const categories = [
	["biography", "Biography / summary"],
	["specialty", "Specialty / sub-specialty"],
	["location", "Location / geography"],
	["techniques", "Techniques / procedures"],
	["metrics", "h-index / citations"],
	["photo", "Profile photo"],
	["other", "Other"],
];
const defaultCategory = categories.some(([k]) => k === editType) ? editType : "";
const query = (type: string) => `/suggest-edit?${profileSlug ? `profile=${encodeURIComponent(profileSlug)}&` : ""}type=${type}`;

const title = `Suggest an edit${doctor ? ` to ${doctor.name}` : ""} | MDRPedia`;
const description = "Suggest a correction or addition to a physician's record on MDRPedia. Every suggestion is reviewed by an editor against a source before anything changes.";
---

<SiteLayout title={title} description={description} robots="noindex, follow">
	<div class="u-page">
		<div class="u-wrap">
			<header class="u-head u-center">
				{doctor ? <a class="u-back" href={`/doctors/${profileSlug}`}>&larr; Back to {doctor.name}</a> : <a class="u-back" href="/doctors">&larr; Browse the register</a>}
				<span class="u-kicker">SUGGEST AN EDIT · REVIEWED BY AN EDITOR</span>
				<h1 class="u-h1">{current.title}</h1>
				<p class="u-lede">{current.description}</p>
				{doctor && <p class="u-for"><b>{doctor.name}</b><span>{doctor.tier}</span></p>}
				<nav class="u-tabs" aria-label="Type of suggestion">
					{Object.entries(editTypes).map(([key, v]) => (
						<a href={query(key)} aria-current={currentKey === key ? "page" : undefined}>{v.title}</a>
					))}
				</nav>
			</header>

			<form class="u-form" id="suggest-form" novalidate>
				<input type="hidden" name="profile_slug" value={profileSlug} />
				<input type="hidden" name="edit_type" value={currentKey} />

				<fieldset class="u-set">
					<legend>The suggestion</legend>

					{currentKey === "citation" && (
						<>
							<div class="u-field">
								<label for="citationTitle">Publication title <span class="u-req">*</span></label>
								<input class="u-input" type="text" id="citationTitle" name="citationTitle" placeholder="e.g. Novel approaches to cardiac surgery" required maxlength="300" />
							</div>
							<div class="u-row">
								<div class="u-field">
									<label for="citationDOI">DOI</label>
									<input class="u-input" type="text" id="citationDOI" name="citationDOI" placeholder="10.1000/xyz123" maxlength="200" />
								</div>
								<div class="u-field">
									<label for="citationPubMed">PubMed ID</label>
									<input class="u-input" type="text" id="citationPubMed" name="citationPubMed" placeholder="12345678" maxlength="20" />
								</div>
							</div>
							<div class="u-row">
								<div class="u-field">
									<label for="citationJournal">Journal</label>
									<input class="u-input" type="text" id="citationJournal" name="citationJournal" placeholder="e.g. The Lancet" maxlength="200" />
								</div>
								<div class="u-field">
									<label for="citationYear">Year</label>
									<input class="u-input" type="number" id="citationYear" name="citationYear" placeholder="2024" min="1900" max="2100" />
								</div>
							</div>
						</>
					)}

					{currentKey === "award" && (
						<>
							<div class="u-field">
								<label for="awardName">Award name <span class="u-req">*</span></label>
								<input class="u-input" type="text" id="awardName" name="awardName" placeholder="e.g. Lasker Award" required maxlength="300" />
							</div>
							<div class="u-row">
								<div class="u-field">
									<label for="awardYear">Year received</label>
									<input class="u-input" type="number" id="awardYear" name="awardYear" placeholder="2024" min="1900" max="2100" />
								</div>
								<div class="u-field">
									<label for="awardIssuer">Issuing organisation</label>
									<input class="u-input" type="text" id="awardIssuer" name="awardIssuer" placeholder="e.g. Lasker Foundation" maxlength="200" />
								</div>
							</div>
							<div class="u-field">
								<label for="awardContribution">Contribution (why it was awarded)</label>
								<textarea class="u-textarea" id="awardContribution" name="awardContribution" rows="3" maxlength="1500"></textarea>
							</div>
						</>
					)}

					{currentKey === "affiliation" && (
						<>
							<div class="u-field">
								<label for="affiliationName">Institution name <span class="u-req">*</span></label>
								<input class="u-input" type="text" id="affiliationName" name="affiliationName" placeholder="e.g. Johns Hopkins Hospital" required maxlength="300" />
							</div>
							<div class="u-row">
								<div class="u-field">
									<label for="affiliationRole">Role or position</label>
									<input class="u-input" type="text" id="affiliationRole" name="affiliationRole" placeholder="e.g. Chief of Cardiology" maxlength="200" />
								</div>
								<div class="u-field">
									<label for="affiliationDepartment">Department</label>
									<input class="u-input" type="text" id="affiliationDepartment" name="affiliationDepartment" placeholder="e.g. Department of Surgery" maxlength="200" />
								</div>
							</div>
							<div class="u-field">
								<label for="affiliationUrl">Institution website</label>
								<input class="u-input" type="url" id="affiliationUrl" name="affiliationUrl" placeholder="https://" maxlength="500" />
							</div>
						</>
					)}

					{currentKey === "general" && (
						<>
							<div class="u-field">
								<label for="generalCategory">What would you like to add or correct? <span class="u-req">*</span></label>
								<select class="u-select" id="generalCategory" name="generalCategory" required>
									<option value="" selected={!defaultCategory}>Select a category</option>
									{categories.map(([k, label]) => <option value={k} selected={defaultCategory === k}>{label}</option>)}
								</select>
							</div>
							<div class="u-field">
								<label for="generalDetails">Details <span class="u-req">*</span></label>
								<textarea class="u-textarea" id="generalDetails" name="generalDetails" rows="5" placeholder="What should change, and what should it say?" required maxlength="4000"></textarea>
							</div>
						</>
					)}

					<div class="u-field">
						<label for="sourceUrl">Source URL</label>
						<input class="u-input" type="url" id="sourceUrl" name="sourceUrl" placeholder="https://" maxlength="500" />
						<p class="u-hint">A link that verifies the information. Suggestions with a source are reviewed faster.</p>
					</div>
				</fieldset>

				<fieldset class="u-set">
					<legend>Who is suggesting this</legend>
					<p class="u-set__note">Editors may contact you about the suggestion. Your details are never shown publicly.</p>
					<div class="u-row">
						<div class="u-field">
							<label for="contributor_name">Your name <span class="u-req">*</span></label>
							<input class="u-input" type="text" id="contributor_name" name="contributor_name" autocomplete="name" required maxlength="200" />
						</div>
						<div class="u-field">
							<label for="contributor_email">Your email <span class="u-req">*</span></label>
							<input class="u-input" type="email" id="contributor_email" name="contributor_email" autocomplete="email" required maxlength="200" />
						</div>
					</div>
				</fieldset>

				<div class="u-hp" aria-hidden="true">
					<input type="checkbox" name="honeypot_filled" tabindex="-1" autocomplete="off" />
				</div>

				<p class="u-msg u-msg--err" id="suggest-error" role="alert" hidden></p>

				<div class="u-actions">
					<button type="submit" class="u-btn" id="suggest-submit">Submit suggestion</button>
					<span class="u-hint">An editor reviews every suggestion before anything is published.</span>
				</div>
			</form>

			<div class="u-done" id="suggest-done" hidden tabindex="-1">
				<span class="u-kicker">RECEIVED</span>
				<h2>Thank you.</h2>
				<p>Your suggestion is in the review queue. An editor will check it against the source before anything changes.</p>
				{doctor && <a class="u-btn u-btn--line" href={`/doctors/${profileSlug}`}>Return to {doctor.name}</a>}
			</div>
		</div>
	</div>
</SiteLayout>

<script>
	const form = document.getElementById("suggest-form") as HTMLFormElement | null;
	const done = document.getElementById("suggest-done") as HTMLElement | null;
	const errEl = document.getElementById("suggest-error") as HTMLElement | null;
	const btn = document.getElementById("suggest-submit") as HTMLButtonElement | null;

	const val = (fd: FormData, k: string) => String(fd.get(k) ?? "").trim();

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!errEl || !btn) return;
		errEl.hidden = true;

		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		const fd = new FormData(form);
		const type = val(fd, "edit_type");
		let field_name = type;
		const lines: string[] = [];
		const add = (label: string, k: string) => {
			const v = val(fd, k);
			if (v) lines.push(`${label}: ${v}`);
		};

		if (type === "citation") {
			add("Title", "citationTitle"); add("DOI", "citationDOI"); add("PubMed ID", "citationPubMed");
			add("Journal", "citationJournal"); add("Year", "citationYear");
		} else if (type === "award") {
			add("Award", "awardName"); add("Year", "awardYear"); add("Issuer", "awardIssuer"); add("Contribution", "awardContribution");
		} else if (type === "affiliation") {
			add("Institution", "affiliationName"); add("Role", "affiliationRole");
			add("Department", "affiliationDepartment"); add("Website", "affiliationUrl");
		} else {
			field_name = val(fd, "generalCategory");
			add("Details", "generalDetails");
		}

		const sourceUrl = val(fd, "sourceUrl");
		const payload = {
			profile_slug: val(fd, "profile_slug"),
			field_name,
			new_value: lines.join("\n"),
			reason: sourceUrl ? `Source: ${sourceUrl}` : undefined,
			contributor_name: val(fd, "contributor_name"),
			contributor_email: val(fd, "contributor_email"),
			honeypot_filled: fd.get("honeypot_filled") === "on",
		};

		if (!payload.profile_slug) {
			errEl.textContent = "Open this form from a doctor's record so we know which record to correct.";
			errEl.hidden = false;
			return;
		}

		btn.disabled = true;
		btn.textContent = "Submitting...";
		try {
			const res = await fetch("/api/suggest-edit", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});
			if (res.ok) {
				form.hidden = true;
				if (done) {
					done.hidden = false;
					done.focus();
				}
			} else {
				const data = await res.json().catch(() => ({}));
				errEl.textContent = data.error || "Could not submit. Please try again.";
				errEl.hidden = false;
			}
		} catch {
			errEl.textContent = "Network error. Please try again.";
			errEl.hidden = false;
		} finally {
			btn.disabled = false;
			btn.textContent = "Submit suggestion";
		}
	});
</script>
