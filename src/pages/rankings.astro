---
/**
 * MDRPedia — Global Impact Rankings
 * The world's leading physicians ranked by humanitarian impact
 * Database-first with static fallback
 */
import "../styles/pages/directory.css";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getDoctorRankingsAsync } from "../lib/ranking";
import { getSpecialtyGroup } from "../lib/specialty-groups";

export const prerender = false;

const rankings = await getDoctorRankingsAsync();

// Group doctors by broader specialty categories
const doctorsByGroup: Record<string, any[]> = {};
const groupIcons: Record<string, string> = {};

Object.values(rankings).forEach((r) => {
    const group = getSpecialtyGroup(r.specialty);
    const groupName = group?.name || 'Other Specialties';

    if (!doctorsByGroup[groupName]) {
        doctorsByGroup[groupName] = [];
        groupIcons[groupName] = group?.svgPath || '';
    }
    doctorsByGroup[groupName].push(r);
});

// Sort groups by number of doctors (most first), then alphabetically
const sortedGroups = Object.keys(doctorsByGroup).sort((a, b) => {
    const diff = doctorsByGroup[b].length - doctorsByGroup[a].length;
    return diff !== 0 ? diff : a.localeCompare(b);
});

// Get stats
const totalDoctors = Object.values(rankings).length;
const titanCount = Object.values(rankings).filter(r => r.tier === 'TITAN').length;
const eliteCount = Object.values(rankings).filter(r => r.tier === 'ELITE').length;

// Structured Data
const siteBase = Astro.site ?? 'https://mdrpedia.com';
const rankingsSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Global Medical Impact Rankings",
    "description": "The definitive ranking of medical professionals by humanitarian impact, research contribution, and clinical excellence.",
    "url": new URL('/rankings', siteBase).href,
    "mainEntity": {
        "@type": "ItemList",
        "name": "Top Medical Professionals by Impact Score",
        "numberOfItems": totalDoctors,
        "itemListOrder": "https://schema.org/ItemListOrderDescending",
        "itemListElement": Object.values(rankings)
            .sort((a, b) => (b.score || 0) - (a.score || 0))
            .slice(0, 50)
            .map((doc, i) => ({
                "@type": "ListItem",
                "position": i + 1,
                "item": {
                    "@type": "Physician",
                    "name": doc.fullName,
                    "medicalSpecialty": doc.specialty,
                    "url": new URL(`/doctors/${doc.slug}`, siteBase).href,
                    ...(doc.geography?.country && { "workLocation": { "@type": "Place", "name": doc.geography.country } })
                }
            }))
    },
    "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": siteBase.toString() },
            { "@type": "ListItem", "position": 2, "name": "Global Rankings", "item": new URL('/rankings', siteBase).href }
        ]
    }
};
---

<SiteLayout
    title="Global Impact Rankings — MDRPedia"
    description="The definitive ranking of medical professionals by humanitarian impact, research contribution, and clinical excellence."
    active=""
    jsonLd={[rankingsSchema]}
>
	<div class="dx">
		<header class="dx-hero">
			<div class="dx-hero__inner">
				<span class="dx-eyebrow">THE IMPACT QUOTIENT</span>
				<h1>Global medical rankings</h1>
				<p class="dx-lede">
					Physicians ranked by the measurable contribution of their published work and verified record. Not by reputation.
				</p>
				<ul class="dx-facts">
					<li><b>{totalDoctors.toLocaleString()}</b><span>Ranked physicians</span></li>
					<li><b>{titanCount}</b><span>Titan</span></li>
					<li><b>{eliteCount}</b><span>Elite</span></li>
					<li><b>{sortedGroups.length}</b><span>Specialty groups</span></li>
				</ul>
				<p><a href="/rankings/top-100">See the top 100 overall &rarr;</a></p>
			</div>
		</header>

		<div class="dx-main">
			<nav class="dx-section" aria-label="Jump to specialty">
				<div class="dx-chips">
					{sortedGroups.slice(0, 10).map((group) => (
						<a href={`#${group.toLowerCase().replace(/[^a-z0-9]/g, "-")}`}>{group}<small>{doctorsByGroup[group].length}</small></a>
					))}
				</div>
			</nav>

			{sortedGroups.map((group) => {
				const doctors = doctorsByGroup[group].sort((a, b) => (b.score || 0) - (a.score || 0)).slice(0, 10);
				const gid = group.toLowerCase().replace(/[^a-z0-9]/g, "-");
				return (
					<section id={gid} class="dx-section" aria-labelledby={`${gid}-h`}>
						<h2 id={`${gid}-h`}>{group}</h2>
						<p class="dx-count">{doctorsByGroup[group].length} physicians · top {doctors.length} by impact score</p>
						<div class="dx-scroll dx-scroll--stack" tabindex="0" role="region" aria-label={`${group} leaderboard`}>
							<table class="dx-table dx-stack">
								<caption class="r-sr-only">{group}: top {doctors.length} by impact score</caption>
								<thead>
									<tr><th scope="col">Rank</th><th scope="col">Physician</th><th scope="col">Tier</th><th scope="col">Impact score</th></tr>
								</thead>
								<tbody>
									{doctors.map((doc, index) => (
										<tr>
											<td class="rank">#{index + 1}</td>
											<td class="who">
												<a href={`/doctors/${doc.slug}`}>{doc.fullName}</a>
												<span class="sub">{doc.specialty}{doc.country && ` · ${doc.country}`}</span>
											</td>
											<td class:list={["dx-tier", `dx-tier--${(doc.tier || "unranked").toLowerCase()}`, { "is-none": !["TITAN", "ELITE", "MASTER"].includes(doc.tier) }]} data-label="Tier">
												{doc.tier === "TITAN" ? "Titan" : doc.tier === "ELITE" ? "Elite" : doc.tier === "MASTER" ? "Master" : ""}
											</td>
											<td class="num" data-label="Score">{doc.score?.toFixed(1) || "—"}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
						{doctorsByGroup[group].length > 10 && (
							<p><a href={`/doctors?specialty=${encodeURIComponent(group)}`}>View all {doctorsByGroup[group].length} physicians in {group} &rarr;</a></p>
						)}
					</section>
				);
			})}

			<section class="dx-section" aria-labelledby="how-h">
				<h2 id="how-h">How we rank</h2>
				<div class="dx-prose">
					<p>
						The Impact Quotient is built from each physician's published research and verified record, not from reputation surveys,
						reviews or payment. The full scoring method is set out on the <a href="/methodology">methodology page</a>, and the
						sources each claim must meet are on the <a href="/evidence">evidence standard</a>.
					</p>
				</div>
			</section>
		</div>
	</div>
</SiteLayout>
