---
/**
 * MDRPedia — Institution Directory
 * Browse all hospitals and medical institutions
 */
import "../../styles/pages/directory.css";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Pagination from "../../components/Pagination.astro";
import { prisma } from "../../lib/prisma";
import { getInstitutionLogo, getInstitutionInitials } from "../../lib/institution-logos";

export const prerender = false;

const url = new URL(Astro.request.url);
const filterCountry = url.searchParams.get('country');
const filterSector = url.searchParams.get('sector');
const searchQuery = url.searchParams.get('q');
const errorParam = url.searchParams.get('error');
const PAGE_SIZE = 48;
const requestedPage = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10) || 1);

// Build where clause
const whereClause: any = {};
if (filterCountry) {
    whereClause.geography = { country: filterCountry };
}
if (filterSector) {
    whereClause.sector = filterSector;
}
if (searchQuery) {
    whereClause.name = { contains: searchQuery, mode: 'insensitive' };
}

let institutions: any[] = [];
let countries: any[] = [];
let dbError = false;
let totalInstitutions = 0;
let page = requestedPage;

try {
    totalInstitutions = await prisma.hospital.count({ where: whereClause });
    page = Math.min(requestedPage, Math.max(1, Math.ceil(totalInstitutions / PAGE_SIZE)));

    institutions = await prisma.hospital.findMany({
        where: whereClause,
        include: {
            geography: true,
            affiliations: {
                include: {
                    profile: {
                        select: { tier: true }
                    }
                }
            }
        },
        orderBy: [
            { ranking_position: 'asc' },
            { name: 'asc' }
        ],
        skip: (page - 1) * PAGE_SIZE,
        take: PAGE_SIZE
    });

    // Get unique countries for filter
    countries = await prisma.geography.findMany({
        where: {
            hospitals: { some: {} }
        },
        select: { country: true },
        distinct: ['country'],
        orderBy: { country: 'asc' }
    });
} catch (e) {
    console.error('Institutions page database error:', e);
    dbError = true;
}

// Process institutions with stats
const processedInstitutions = institutions.map(inst => {
    const tierCounts = { TITAN: 0, ELITE: 0, MASTER: 0, UNRANKED: 0 };
    inst.affiliations.forEach((aff: any) => {
        if (aff.profile?.tier) {
            tierCounts[aff.profile.tier as keyof typeof tierCounts]++;
        }
    });

    return {
        ...inst,
        doctorCount: inst.affiliations.length,
        tierCounts
    };
});

const totalPages = Math.max(1, Math.ceil(totalInstitutions / PAGE_SIZE));

const sectorLabels: Record<string, string> = {
    PUBLIC: 'Public',
    PRIVATE: 'Private'
};

const hasFilters = Boolean(filterCountry || filterSector || searchQuery);
const canonical = page > 1 && !hasFilters ? `/institutions?page=${page}` : undefined;
---

<SiteLayout
	title="Medical Institutions — MDRPedia"
	description="Hospitals, universities and research centres represented in the MDRPedia register, with the physicians affiliated to each."
	active="register"
	canonical={canonical}
>
	<div class="dx">
		<header class="dx-hero">
			<div class="dx-hero__inner">
				<span class="dx-eyebrow">THE REGISTER BY INSTITUTION</span>
				<h1>Medical institutions</h1>
				<p class="dx-lede">Hospitals and research institutions where the physicians in the register practise.</p>
			</div>
		</header>

		<div class="dx-main">
			{errorParam === "not_found" && <p class="dx-note" role="alert">Institution not found. It may have been removed or the URL is incorrect.</p>}
			{dbError && <p class="dx-note" role="alert">Unable to load institutions. Please try again later.</p>}

			<div class="dx-controls">
				<form method="get" style="display:contents">
					<label class="dx-search">
						<span class="r-sr-only">Search institutions</span>
						<input id="institution-q" type="search" name="q" placeholder="Search institutions" value={searchQuery || ""} />
					</label>
					{filterCountry && <input type="hidden" name="country" value={filterCountry} />}
					{filterSector && <input type="hidden" name="sector" value={filterSector} />}
					<button type="submit" class="dx-btn">Search</button>
				</form>
				<label class="r-sr-only" for="countryFilter">Country</label>
				<select id="countryFilter" class="dx-select" data-filter="country">
					<option value="">All countries</option>
					{countries.map((c) => <option value={c.country} selected={c.country === filterCountry}>{c.country}</option>)}
				</select>
				<label class="r-sr-only" for="sectorFilter">Sector</label>
				<select id="sectorFilter" class="dx-select" data-filter="sector">
					<option value="">All sectors</option>
					<option value="PUBLIC" selected={filterSector === "PUBLIC"}>Public</option>
					<option value="PRIVATE" selected={filterSector === "PRIVATE"}>Private</option>
				</select>
			</div>

			{!dbError && (
				<p class="dx-count" aria-live="polite">
					{totalInstitutions.toLocaleString()} {totalInstitutions === 1 ? "institution" : "institutions"} found
					{hasFilters && <> · <a href="/institutions">Clear filters</a></>}
				</p>
			)}

			{!dbError && (
				<>
					{processedInstitutions.length > 0 ? (
						<ul class="dx-grid">
							{processedInstitutions.map((inst) => {
								const logoUrl = inst.logo_url || getInstitutionLogo(inst.name, inst.website);
								const initials = getInstitutionInitials(inst.name);
								const place = [inst.geography?.city, inst.geography?.country || "Unknown"].filter(Boolean).join(", ");
								return (
									<li class="dx-card">
										<div class="dx-inst">
											{logoUrl ? (
												<>
													<img src={logoUrl} alt="" class="dx-logo" width="48" height="48" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
													<span class="dx-logo dx-logo--ph" style="display:none">{initials}</span>
												</>
											) : (
												<span class="dx-logo dx-logo--ph">{initials}</span>
											)}
											<div>
												<h3><a href={`/institutions/${inst.slug}`}>{inst.name}</a></h3>
												<span class="dx-card__kicker">{place}</span>
											</div>
										</div>
										<p class="dx-meta">
											<span>{sectorLabels[inst.sector]}</span>
											{inst.ranking_position && <span title={inst.ranking_source || "Ranking"}>Ranked #{inst.ranking_position}</span>}
											{inst.center_of_excellence && <span>Centre of excellence: {inst.center_of_excellence}</span>}
										</p>
										{inst.description && <p class="dx-card__clamp">{inst.description.slice(0, 100)}...</p>}
										<div class="dx-card__foot">
											<span><b>{inst.doctorCount}</b> affiliated {inst.doctorCount === 1 ? "doctor" : "doctors"}</span>
											<span>
												{inst.tierCounts.TITAN > 0 && <>{inst.tierCounts.TITAN} Titan{inst.tierCounts.TITAN !== 1 ? "s" : ""}</>}
												{inst.tierCounts.TITAN > 0 && inst.tierCounts.ELITE > 0 && " · "}
												{inst.tierCounts.ELITE > 0 && <>{inst.tierCounts.ELITE} Elite</>}
											</span>
										</div>
									</li>
								);
							})}
						</ul>
					) : (
						<p class="dx-empty">No institutions found matching your criteria.{hasFilters && <> <a href="/institutions">Clear filters</a></>}</p>
					)}
					<Pagination page={page} totalPages={totalPages} total={totalInstitutions} pageSize={PAGE_SIZE} label="institutions" />
				</>
			)}
		</div>
	</div>
</SiteLayout>

<script>
	document.querySelectorAll<HTMLSelectElement>("select[data-filter]").forEach((el) =>
		el.addEventListener("change", () => {
			const url = new URL(window.location.href);
			if (el.value) url.searchParams.set(el.dataset.filter!, el.value);
			else url.searchParams.delete(el.dataset.filter!);
			url.searchParams.delete("page");
			window.location.href = url.toString();
		}),
	);
</script>
