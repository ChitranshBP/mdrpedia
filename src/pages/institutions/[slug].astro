---
/**
 * MDRPedia — Institution Profile Page
 * Display institution details and affiliated doctors
 * Includes Medical Knowledge Graph schema for AI crawlers
 */
import "../../styles/pages/directory.css";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { prisma } from "../../lib/prisma";
import { generateHospitalPageSchema } from "../../lib/medical-knowledge-graph";
import { getInstitutionLogo, getInstitutionInitials } from "../../lib/institution-logos";

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/institutions");

// Fetch institution with all related data
let institution = null;
let dbError = false;

try {
    institution = await prisma.hospital.findUnique({
        where: { slug },
        include: {
            geography: true,
            affiliations: {
                include: {
                    profile: {
                        select: {
                            id: true,
                            slug: true,
                            full_name: true,
                            specialty: true,
                            tier: true,
                            h_index: true,
                            portrait_url: true
                        }
                    }
                },
                orderBy: {
                    profile: { h_index: 'desc' }
                }
            }
        }
    });
} catch (e) {
    console.error('Institution page database error:', e);
    dbError = true;
}

if (!institution) {
    // A 302 to a listing page is a soft-404: Google keeps the dead URL in the
    // index and attributes the listing's content to it. Answer with a real 404.
    return Astro.rewrite("/404");
}

// Process doctors by tier
const doctors = institution.affiliations
    .filter(aff => aff.profile)
    .map(aff => ({
        ...aff.profile,
        role: aff.role,
        department: aff.department,
        isPrimary: aff.is_primary
    }));

const tierCounts = { TITAN: 0, ELITE: 0, MASTER: 0, UNRANKED: 0 };
doctors.forEach(d => {
    if (d.tier) tierCounts[d.tier]++;
});

// Get unique specialties
const specialties = [...new Set(doctors.map(d => d.specialty).filter(Boolean))];

const sectorLabels: Record<string, string> = {
    PUBLIC: 'Public Institution',
    PRIVATE: 'Private Institution'
};

const TIER_LABEL: Record<string, string> = { TITAN: "Titan", ELITE: "Elite", MASTER: "Master" };

// Generate Hospital Knowledge Graph Schema
const hospitalSchema = generateHospitalPageSchema(
    {
        hospitalName: institution.name,
        slug: institution.slug,
        hospitalUrl: institution.website || undefined,
        sector: institution.sector as 'PUBLIC' | 'PRIVATE',
        centerOfExcellence: institution.center_of_excellence || undefined,
        description: institution.description || undefined,
        logoUrl: institution.logo_url || undefined,
        geography: institution.geography ? {
            country: institution.geography.country,
            region: institution.geography.region || undefined,
            city: institution.geography.city || undefined,
        } : undefined,
    },
    doctors.map(d => ({
        fullName: d.full_name || '',
        slug: d.slug || '',
        specialty: d.specialty || '',
        tier: d.tier || 'UNRANKED',
    }))
);

// Dataset schema describing the hospital's physician roster
const hospitalDatasetSchema = {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: `${institution.name} - Affiliated Physicians`,
    description: `Complete roster of ${doctors.length} verified physicians affiliated with ${institution.name}, including ${tierCounts.TITAN} Titans, ${tierCounts.ELITE} Elite, and ${tierCounts.MASTER} Masters.`,
    keywords: [
        institution.name,
        ...specialties.slice(0, 10),
        institution.geography?.country,
        institution.geography?.city,
        'hospital',
        'medical institution',
        'physicians',
    ].filter(Boolean).join(', '),
    variableMeasured: [
        { '@type': 'PropertyValue', name: 'Total Physicians', value: doctors.length },
        { '@type': 'PropertyValue', name: 'Titan Tier', value: tierCounts.TITAN },
        { '@type': 'PropertyValue', name: 'Elite Tier', value: tierCounts.ELITE },
        { '@type': 'PropertyValue', name: 'Master Tier', value: tierCounts.MASTER },
        { '@type': 'PropertyValue', name: 'Specialties', value: specialties.length },
    ],
    creator: {
        '@type': 'Organization',
        name: 'MDRPedia',
        url: 'https://mdrpedia.com',
    },
    isAccessibleForFree: true,
};

const logoUrl = institution.logo_url || getInstitutionLogo(institution.name, institution.website);
const initials = getInstitutionInitials(institution.name);
const place = [institution.geography?.city, institution.geography?.region, institution.geography?.country || "Unknown location"].filter(Boolean).join(", ");
const title = `${institution.name} — MDRPedia`;
const description = `${doctors.length} verified physician${doctors.length === 1 ? "" : "s"} affiliated with ${institution.name}${institution.geography?.country ? `, ${institution.geography.country}` : ""}${specialties.length ? ` across ${specialties.length} ${specialties.length === 1 ? "specialty" : "specialties"}` : ""}. Profiles, citations and clinical impact on MDRPedia.`;
---

<SiteLayout title={title} description={description} active="register" jsonLd={[hospitalSchema, hospitalDatasetSchema]}>
	<div class="dx">
		<header class="dx-hero">
			<div class="dx-hero__inner">
				<nav class="dx-crumbs" aria-label="Breadcrumb">
					<a href="/">Home</a><span aria-hidden="true">/</span><a href="/institutions">Institutions</a><span aria-hidden="true">/</span><span aria-current="page">{institution.name}</span>
				</nav>
				<div class="dx-inst dx-inst--lg">
					{logoUrl ? (
						<>
							<img src={logoUrl} alt="" class="dx-logo" width="88" height="88" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
							<span class="dx-logo dx-logo--ph" style="display:none">{initials}</span>
						</>
					) : (
						<span class="dx-logo dx-logo--ph">{initials}</span>
					)}
					<div>
						<span class="dx-eyebrow">{sectorLabels[institution.sector].toUpperCase()}</span>
						<h1>{institution.name}</h1>
					</div>
				</div>
				<p class="dx-lede">{place}</p>
				<p class="dx-meta">
					{institution.ranking_position && <span>Ranked #{institution.ranking_position}{institution.ranking_source && ` (${institution.ranking_source})`}</span>}
					{institution.center_of_excellence && <span>Centre of excellence: {institution.center_of_excellence}</span>}
				</p>
				<ul class="dx-facts">
					<li><b>{doctors.length}</b><span>Affiliated doctors</span></li>
					<li><b>{tierCounts.TITAN}</b><span>Titan</span></li>
					<li><b>{tierCounts.ELITE}</b><span>Elite</span></li>
					<li><b>{tierCounts.MASTER}</b><span>Master</span></li>
					<li><b>{specialties.length}</b><span>Specialties</span></li>
				</ul>
			</div>
		</header>

		<div class="dx-main">
			<div class="dx-two">
				<div class="dx-section">
					{institution.description && (
						<section class="dx-section" aria-labelledby="about-h">
							<h2 id="about-h">About</h2>
							<div class="dx-prose"><p>{institution.description}</p></div>
						</section>
					)}

					<section class="dx-section" aria-labelledby="phys-h">
						<h2 id="phys-h">Affiliated physicians</h2>
						<p class="dx-count">{doctors.length} {doctors.length === 1 ? "doctor" : "doctors"} · ordered by h-index</p>
						{doctors.length > 0 ? (
							<div class="dx-scroll dx-scroll--stack" tabindex="0" role="region" aria-label={`Physicians affiliated with ${institution.name}`}>
								<table class="dx-table dx-stack">
									<caption class="r-sr-only">Physicians affiliated with {institution.name}</caption>
									<thead>
										<tr><th scope="col">Physician</th><th scope="col">Role</th><th scope="col">Tier</th><th scope="col">h-index</th></tr>
									</thead>
									<tbody>
										{doctors.map((doctor) => (
											<tr>
												<td class="who">
													<a href={`/doctors/${doctor.slug}`}>{doctor.full_name}</a>
													<span class="sub">{doctor.specialty}{doctor.isPrimary && " · Primary affiliation"}</span>
												</td>
												<td class:list={["sub", { "is-none": !doctor.role }]}>{doctor.role}</td>
												<td class:list={["dx-tier", `dx-tier--${(doctor.tier || "unranked").toLowerCase()}`, { "is-none": !TIER_LABEL[doctor.tier || ""] }]} data-label="Tier">{TIER_LABEL[doctor.tier || ""]}</td>
												<td class:list={["num", { "is-none": !doctor.h_index }]} data-label="h-index">{doctor.h_index || ""}</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						) : (
							<p class="dx-empty">No affiliated doctors found.</p>
						)}
					</section>
				</div>

				<aside class="dx-side dx-section" aria-label="Institution details">
					<h2 class="dx-h2">Quick facts</h2>
					<dl class="dx-dl">
						<div><dt>Type</dt><dd>{sectorLabels[institution.sector]}</dd></div>
						{institution.geography?.country && <div><dt>Country</dt><dd>{institution.geography.country}</dd></div>}
						{institution.geography?.city && <div><dt>City</dt><dd>{institution.geography.city}</dd></div>}
						{institution.website && <div><dt>Website</dt><dd><a href={institution.website} target="_blank" rel="noopener noreferrer">Visit &rarr;</a></dd></div>}
					</dl>
					{specialties.length > 0 && (
						<>
							<h2 class="dx-h2">Specialties</h2>
							<div class="dx-chips">
								{specialties.slice(0, 10).map((spec) => <a href={`/doctors?specialty=${encodeURIComponent(spec || "")}`}>{spec}</a>)}
								{specialties.length > 10 && <span class="dx-count">+{specialties.length - 10} more</span>}
							</div>
						</>
					)}
					<p><a href="/institutions">&larr; All institutions</a></p>
				</aside>
			</div>
		</div>
	</div>
</SiteLayout>
