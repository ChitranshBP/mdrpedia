---
/**
 * MDRPedia -- Medical Mentorship Lineage Explorer
 * Searchable directory of mentor-student relationships across the register.
 * Database-first, SSR-only.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/pages/lineage.css";
import { prisma } from "../lib/prisma";

export const prerender = false;

// Fetch profiles with mentor/mentee relationships
interface LineageProfile {
    slug: string;
    full_name: string;
    specialty: string;
    tier: string;
    portrait_url: string | null;
    geography: { country: string } | null;
    mentored_by: {
        slug: string;
        full_name: string;
        specialty: string;
        tier: string;
        portrait_url: string | null;
        geography: { country: string } | null;
    } | null;
    mentees: {
        slug: string;
        full_name: string;
        specialty: string;
        tier: string;
        portrait_url: string | null;
        geography: { country: string } | null;
    }[];
}

let profiles: LineageProfile[] = [];
let error: string | null = null;

try {
    profiles = await prisma.profile.findMany({
        where: {
            OR: [
                { mentored_by_id: { not: null } },
                { mentees: { some: {} } },
            ],
        },
        select: {
            slug: true,
            full_name: true,
            specialty: true,
            tier: true,
            portrait_url: true,
            geography: { select: { country: true } },
            mentored_by: {
                select: {
                    slug: true,
                    full_name: true,
                    specialty: true,
                    tier: true,
                    portrait_url: true,
                    geography: { select: { country: true } },
                },
            },
            mentees: {
                select: {
                    slug: true,
                    full_name: true,
                    specialty: true,
                    tier: true,
                    portrait_url: true,
                    geography: { select: { country: true } },
                },
            },
        },
        orderBy: { full_name: "asc" },
    });
} catch (e) {
    error = "Unable to load mentorship data. Please try again later.";
}

// Build lineage entries: one per mentor who has students
interface LineageEntry {
    mentor: {
        slug: string;
        full_name: string;
        specialty: string;
        tier: string;
        portrait_url: string | null;
        country: string;
    };
    students: {
        slug: string;
        full_name: string;
        specialty: string;
        tier: string;
        portrait_url: string | null;
        geography: { country: string } | null;
    }[];
}

const mentorMap = new Map<string, LineageEntry>();

for (const p of profiles) {
    // If this profile has mentees, they are a mentor
    if (p.mentees.length > 0) {
        if (!mentorMap.has(p.slug)) {
            mentorMap.set(p.slug, {
                mentor: {
                    slug: p.slug,
                    full_name: p.full_name,
                    specialty: p.specialty,
                    tier: p.tier,
                    portrait_url: p.portrait_url,
                    country: p.geography?.country || "Unknown",
                },
                students: [],
            });
        }
        const entry = mentorMap.get(p.slug)!;
        for (const m of p.mentees) {
            if (!entry.students.find((s) => s.slug === m.slug)) {
                entry.students.push(m);
            }
        }
    }

    // If this profile has a mentor, ensure the mentor entry exists
    if (p.mentored_by) {
        const mentorSlug = p.mentored_by.slug;
        if (!mentorMap.has(mentorSlug)) {
            mentorMap.set(mentorSlug, {
                mentor: {
                    slug: mentorSlug,
                    full_name: p.mentored_by.full_name,
                    specialty: p.mentored_by.specialty,
                    tier: p.mentored_by.tier,
                    portrait_url: p.mentored_by.portrait_url,
                    country: p.mentored_by.geography?.country || "Unknown",
                },
                students: [],
            });
        }
        const entry = mentorMap.get(mentorSlug)!;
        if (!entry.students.find((s) => s.slug === p.slug)) {
            entry.students.push({
                slug: p.slug,
                full_name: p.full_name,
                specialty: p.specialty,
                tier: p.tier,
                portrait_url: p.portrait_url,
                geography: p.geography,
            });
        }
    }
}

const lineageEntries = Array.from(mentorMap.values())
    .filter((e) => e.students.length > 0)
    .sort((a, b) => b.students.length - a.students.length);

const totalMentors = lineageEntries.length;
const totalStudents = lineageEntries.reduce(
    (acc, e) => acc + e.students.length,
    0,
);

// Stature tiers are not shown for physicians in India (NMC 2026 guidelines).
const TIER_LABEL: Record<string, string> = { TITAN: "Titan", ELITE: "Elite", MASTER: "Master" };
function stature(tier: string, country?: string | null): string | undefined {
    return country === "India" ? undefined : TIER_LABEL[tier];
}

function getInitials(name: string): string {
    return name
        .split(" ")
        .filter(Boolean)
        .map((n) => n[0])
        .join("")
        .slice(0, 2)
        .toUpperCase();
}

// JSON-LD BreadcrumbList
const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://mdrpedia.com/",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Mentorship Lineage",
            item: "https://mdrpedia.com/lineage",
        },
    ],
};

Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=60, s-maxage=120",
);
---

<SiteLayout
    title="Medical Mentorship Lineage -- MDRPedia"
    description="Explore the academic genealogy of medicine. Discover who trained whom across generations of medical mentorship on MDRPedia."
    active="register"
    jsonLd={[breadcrumbJsonLd]}
>
    <div class="ln">
        <header class="ln-wrap ln-hero">
            <nav class="ln-crumbs" aria-label="Breadcrumb">
                <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Mentorship lineage</span>
            </nav>
            <span class="ln-eyebrow">Academic genealogy</span>
            <h1>Medical Mentorship Lineage</h1>
            <p>
                The academic genealogy of medicine: who trained whom, across generations of
                knowledge transfer.
            </p>
            <ul class="ln-stats">
                <li><b>{totalMentors}</b><span>Mentors</span></li>
                <li><b>{totalStudents}</b><span>Students</span></li>
            </ul>
        </header>

        <div class="ln-wrap ln-main">
            {error && <p class="ln-error" role="alert">{error}</p>}

            <section class="ln-sec" aria-labelledby="lineage-h">
                <div class="ln-sec__head">
                    <h2 id="lineage-h">The lineage register</h2>
                    <span class="ln-count"><span id="visible-count">{lineageEntries.length}</span> of {lineageEntries.length} lineages</span>
                </div>

                <form class="ln-search" role="search" onsubmit="return false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                    <label for="lineage-search" class="r-sr-only">Filter lineages by mentor, student, or specialty</label>
                    <input id="lineage-search" type="search" placeholder="Filter by mentor, student, or specialty" autocomplete="off" />
                </form>

                {lineageEntries.length === 0 && !error && (
                    <p class="ln-empty">No mentorship relationships have been recorded yet.</p>
                )}

                <ol id="lineage-list" class="ln-list">
                    {lineageEntries.map((entry) => {
                        const mTier = stature(entry.mentor.tier, entry.mentor.country);
                        return (
                            <li
                                class="ln-entry lineage-entry"
                                data-search={`${entry.mentor.full_name} ${entry.mentor.specialty} ${entry.mentor.country} ${entry.students.map((s) => s.full_name).join(" ")}`.toLowerCase()}
                            >
                                <div class="ln-mentor">
                                    <span class="ln-role">Mentor</span>
                                    <a class="ln-person" href={`/doctors/${entry.mentor.slug}`}>
                                        <span class="ln-portrait">
                                            {entry.mentor.portrait_url ? (
                                                <img src={entry.mentor.portrait_url} alt="" width="56" height="56" loading="lazy" />
                                            ) : (
                                                <span aria-hidden="true">{getInitials(entry.mentor.full_name)}</span>
                                            )}
                                        </span>
                                        <span class="ln-person__txt">
                                            <span class="ln-name">{entry.mentor.full_name}</span>
                                            <span class="ln-meta">
                                                {entry.mentor.specialty}{entry.mentor.country !== "Unknown" && ` · ${entry.mentor.country}`}{mTier && ` · ${mTier}`}
                                            </span>
                                        </span>
                                    </a>
                                    <span class="ln-n">{entry.students.length} student{entry.students.length !== 1 ? "s" : ""}</span>
                                </div>

                                <ul class="ln-students">
                                    {entry.students.map((student) => {
                                        const sTier = stature(student.tier, student.geography?.country);
                                        return (
                                            <li>
                                                <a class="ln-person ln-person--sm" href={`/doctors/${student.slug}`}>
                                                    <span class="ln-portrait ln-portrait--sm">
                                                        {student.portrait_url ? (
                                                            <img src={student.portrait_url} alt="" width="40" height="40" loading="lazy" />
                                                        ) : (
                                                            <span aria-hidden="true">{getInitials(student.full_name)}</span>
                                                        )}
                                                    </span>
                                                    <span class="ln-person__txt">
                                                        <span class="ln-name">{student.full_name}</span>
                                                        <span class="ln-meta">{student.specialty}{sTier && ` · ${sTier}`}</span>
                                                    </span>
                                                </a>
                                            </li>
                                        );
                                    })}
                                </ul>
                            </li>
                        );
                    })}
                </ol>
            </section>

            <section class="ln-sec" aria-labelledby="method-h">
                <div class="ln-sec__head"><h2 id="method-h">How lineage is traced</h2></div>
                <div class="ln-method">
                    <div>
                        <h3>Published sources</h3>
                        <p>Mentor and student relationships are recorded from published acknowledgments, institutional records, and fellowship training registries.</p>
                    </div>
                    <div>
                        <h3>Corrections</h3>
                        <p>Anyone can suggest a correction to a lineage. An editor checks it against its source before it goes live. See the <a href="/methodology">methodology</a>.</p>
                    </div>
                </div>
            </section>
        </div>
    </div>
</SiteLayout>

<script>
    // Client-side search/filter
    const input = document.getElementById("lineage-search") as HTMLInputElement | null;
    const entries = document.querySelectorAll<HTMLElement>(".lineage-entry");
    const countEl = document.getElementById("visible-count");

    if (input) {
        input.addEventListener("input", () => {
            const q = input.value.toLowerCase().trim();
            let visible = 0;

            entries.forEach((entry) => {
                const data = entry.getAttribute("data-search") || "";
                const show = !q || data.includes(q);
                entry.style.display = show ? "" : "none";
                if (show) visible++;
            });

            if (countEl) countEl.textContent = String(visible);
        });
    }
</script>
