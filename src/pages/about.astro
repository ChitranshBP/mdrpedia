---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getRegisterStats, fmt } from "../lib/register-stats";
import "../styles/pages/editorial.css";

export const prerender = true;

const stats = await getRegisterStats();

const figures = [
	{ v: fmt(stats.profiles), l: "Physicians on the register" },
	{ v: fmt(stats.countries), l: "Countries" },
	{ v: fmt(stats.specialties), l: "Specialties" },
	{ v: fmt(stats.citations), l: "Papers on record" },
];

const how = [
	{ k: "THE EVIDENCE STANDARD", t: "What counts, and what never will", d: "The sixteen signals we use, where each is checked, and which are still being built.", h: "/evidence", c: "Read the standard" },
	{ k: "METHODOLOGY", t: "How a score becomes a tier", d: "The four pillars, their weights, and the thresholds for Titan, Elite and Master.", h: "/methodology", c: "See the formula" },
	{ k: "LINEAGE", t: "Who trained whom", d: "Mentor-to-trainee lines across generations, traced from published and contributed records.", h: "/lineage", c: "Explore lineage" },
];

const sources = [
	{ t: "OpenAlex", d: `Author records, h-index and citation counts. ${fmt(stats.withOpenAlex)} profiles are matched to an OpenAlex author.` },
	{ t: "PubMed (NCBI E-utilities)", d: "Publication details and abstracts, matched by DOI." },
	{ t: "CrossRef", d: "DOI checks for papers PubMed doesn't index." },
	{ t: "ClinicalTrials.gov", d: "Listings for the clinical trials section." },
	{ t: "NPI Registry", d: "Licence lookups for physicians practising in the United States." },
	{ t: "Wikimedia Commons", d: "Freely licensed portraits." },
	{ t: "Prize and honour records", d: "Matched against our list of recognised medical prizes and national honours." },
];

const title = "About MDRPedia — a register of physicians, built on evidence";
const description = `MDRPedia records ${fmt(stats.profiles)} physicians across ${fmt(stats.countries)} countries by what they verifiably did: publications, inventions, honours and documented work. No stars, no reviews, no paid placement.`;
const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "AboutPage",
		name: "About MDRPedia",
		url: "https://mdrpedia.com/about",
		description,
		mainEntity: {
			"@type": "Organization",
			name: "MDRPedia",
			alternateName: ["MDpedia", "DRpedia"],
			url: "https://mdrpedia.com",
		},
	},
];
---

<SiteLayout title={title} description={description} jsonLd={jsonLd}>
	<div class="ed">
		<section class="ed-hero" aria-labelledby="a-title">
			<div class="ed-wrap ed-hero__inner">
				<span class="ed-kicker">ABOUT MDRPEDIA</span>
				<h1 class="ed-h1" id="a-title">A register of physicians, <em>built on evidence.</em></h1>
				<p class="ed-hero__lede">
					MDRPedia records the physicians who shaped medicine, and the ones practising it now, by what they verifiably did: what they
					published, what they invented, the honours they earned and the work they can document.
				</p>
				<div class="ed-stats">
					{figures.map((f) => <div class="ed-stat"><b>{f.v}</b><span>{f.l}</span></div>)}
				</div>
			</div>
		</section>

		<section class="ed-wrap ed-sec ed-sec--first" aria-labelledby="a-what">
			<div class="ed-rule">
				<div class="ed-head__title">
					<span class="ed-kicker">№ 01 · WHAT IT IS</span>
					<h2 class="ed-h2" id="a-what">Not a directory. A record.</h2>
				</div>
				<div class="ed-cards">
					<div class="ed-panel ed-panel--sand">
						<span class="ed-label">What MDRPedia is not</span>
						<span class="ed-strike">A booking site or a review site</span>
						<p class="ed-muted">There are no star ratings, no patient reviews, no appointments and no sponsored listings. Plenty of sites already do that.</p>
					</div>
					<div class="ed-panel ed-panel--deep">
						<span class="ed-label">What it is</span>
						<span class="ed-own">A sourced record of who changed medicine, and whether it holds up</span>
						<p>Every profile is built from public sources, scored by a published formula and open to correction by anyone.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="ed-wrap ed-sec" id="methodology" aria-labelledby="a-how">
			<div class="ed-rule">
				<div class="ed-head__title">
					<span class="ed-kicker">№ 02 · HOW IT WORKS</span>
					<h2 class="ed-h2" id="a-how">Published, so it can be checked</h2>
				</div>
				<div class="ed-cards">
					{how.map((h) => (
						<div class="ed-card">
							<span class="ed-kicker">{h.k}</span>
							<span class="ed-card__t">{h.t}</span>
							<p>{h.d}</p>
							<a href={h.h} class="ed-btn ed-btn--line">{h.c} →</a>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="ed-wrap ed-sec" id="data-sources" aria-labelledby="a-sources">
			<div class="ed-rule ed-rule--row">
				<div class="ed-col">
					<span class="ed-kicker">№ 03 · DATA SOURCES</span>
					<h2 class="ed-h2" id="a-sources">Where the record comes from</h2>
					<p class="ed-muted">Facts are drawn from open, public sources. Where a fact has no source, it's flagged and then fixed or removed.</p>
				</div>
				<ul class="ed-col ed-col--wide ed-numlist">
					{sources.map((s, i) => (
						<li><span class="ed-numlist__n">{String(i + 1).padStart(2, "0")}</span><span><b>{s.t}</b><span>{s.d}</span></span></li>
					))}
				</ul>
			</div>
		</section>

		<section class="ed-wrap ed-sec" id="editorial-board" aria-labelledby="a-gov">
			<div class="ed-rule ed-rule--row">
				<div class="ed-col">
					<span class="ed-kicker">№ 04 · GOVERNANCE</span>
					<h2 class="ed-h2" id="a-gov">Who keeps it honest</h2>
				</div>
				<div class="ed-col ed-col--wide" style="gap:14px">
					<p class="ed-muted">
						MDRPedia doesn't yet have an external advisory board. The methodology is maintained in-house and published in full, so it can be
						checked rather than taken on trust.
					</p>
					<p class="ed-muted">
						Suggested corrections are reviewed by an editor against their source before they go live, and every change is logged. Claiming a
						profile lets a physician correct facts; it never changes their score.
					</p>
					<p class="ed-muted">
						If a profile is wrong, <a href="/suggest-edit">tell us</a>. If you're a clinician or bibliometrician willing to review the methodology
						in public, <a href="/contact">we'd like to hear from you</a>.
					</p>
				</div>
			</div>
		</section>

		<section class="ed-wrap ed-sec ed-sec--last" aria-labelledby="a-name">
			<div class="ed-rule ed-rule--row">
				<div class="ed-col">
					<span class="ed-kicker">№ 05 · ONE NAME</span>
					<h2 class="ed-h2" id="a-name">MDRPedia, also searched as MDpedia and DRpedia</h2>
				</div>
				<div class="ed-col ed-col--wide" style="gap:14px">
					<p class="ed-muted">
						People search for the register under different names. <a href="/about/mdpedia">MDpedia</a> follows the "MD" degree used in the
						Americas and Europe; <a href="/about/drpedia">DRpedia</a> follows the "Dr." title used across South Asia, the Middle East and Africa.
						Both refer to MDRPedia.
					</p>
					<p class="ed-muted"><a href="/about/our-name">Why the name</a> · <a href="/brand">Brand and seals</a> · <a href="/contact">Contact</a></p>
				</div>
			</div>
		</section>
	</div>
</SiteLayout>

<script is:inline>
	if (location.hash === "#methodology") location.replace("/methodology");
</script>
