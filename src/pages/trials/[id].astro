---
/**
 * MDRPedia - Individual Clinical Trial Page
 * Display detailed information about a specific clinical trial
 */
export const prerender = true;

import SiteLayout from "../../layouts/SiteLayout.astro";
import trialsData from "../../content/trials/index.json";
import { statusTone } from "../../lib/trials";
import "../../styles/pages/clinical.css";

export function getStaticPaths() {
	const paths: { params: { id: string }; props: { trial: any; company: any; category: any } }[] = [];

	trialsData.companies.forEach((company: any) => {
		company.trials.forEach((trial: any) => {
			const category = trialsData.categories.find((c: any) => c.id === trial.category);
			paths.push({
				params: { id: trial.id },
				props: { trial, company, category },
			});
		});
	});

	return paths;
}

const { trial, company, category } = Astro.props;

function formatDate(dateStr: string): string {
	if (!dateStr) return "TBD";
	return new Date(dateStr).toLocaleDateString("en-US", { year: "numeric", month: "long" });
}

const site = Astro.site ?? "https://mdrpedia.com";
const trialUrl = new URL(`/trials/${trial.id}`, site).href;
const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "MedicalTrial",
		name: trial.name,
		description: trial.description,
		url: trialUrl,
		studyLocation: (trial.countries || []).map((c: string) => ({ "@type": "AdministrativeArea", name: c })),
		sponsor: { "@type": "Organization", name: company.name, url: company.website },
		...(trial.indication && { studySubject: { "@type": "MedicalCondition", name: trial.indication } }),
		...(trial.registryId && { sameAs: `https://clinicaltrials.gov/study/${trial.registryId}` }),
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Home", item: new URL("/", site).href },
			{ "@type": "ListItem", position: 2, name: "Clinical Trials", item: new URL("/clinical-trials", site).href },
			{ "@type": "ListItem", position: 3, name: trial.name, item: trialUrl },
		],
	},
];
---

<SiteLayout title={`${trial.name} - Clinical Trial | MDRPedia`} description={trial.description} active="find" jsonLd={jsonLd}>
	<article class="cl">
		<header class="cl-hero">
			<nav class="cl-crumb" aria-label="Breadcrumb">
				<a href="/clinical-trials">Clinical trials</a>
				<span aria-hidden="true">/</span>
				<a href={`/clinical-trials#${company.id}`}>{company.name}</a>
				<span aria-hidden="true">/</span>
				<span>{trial.id.toUpperCase()}</span>
			</nav>
			<span class="cl-eyebrow">
				{trial.phase} <span class={`cl-flag cl-flag--${statusTone(trial.status)}`}>{trial.status}</span>
				{category && <span>{category.name}</span>}
			</span>
			<h1>{trial.name}</h1>
			<p>{trial.indication}</p>
			<p class="cl-aka">Sponsor: {company.name}</p>

			<ul class="cl-stats" aria-label="Trial figures">
				<li><b>{trial.enrollment?.toLocaleString() || "N/A"}</b><span>Enrollment target</span></li>
				<li><b>{trial.sites || "N/A"}</b><span>Trial sites</span></li>
				<li><b>{trial.countries?.length || "N/A"}</b><span>Countries</span></li>
				<li><b>{formatDate(trial.estimatedCompletion)}</b><span>Est. completion</span></li>
				<li>
					<b>
						{trial.registryId ? (
							<a href={`https://clinicaltrials.gov/study/${trial.registryId}`} target="_blank" rel="noopener noreferrer">{trial.registryId}</a>
						) : (
							"N/A"
						)}
					</b>
					<span>Registry record</span>
				</li>
			</ul>
		</header>

		<div class="cl-main cl-layout">
			<div class="cl-col">
				<section class="cl-sec">
					<h2 class="cl-h2">About this trial</h2>
					<p class="cl-prose">{trial.description}</p>
				</section>

				{trial.primaryEndpoints && trial.primaryEndpoints.length > 0 && (
					<section class="cl-sec">
						<h2 class="cl-h2">Primary endpoints</h2>
						<ul class="cl-bullets">
							{trial.primaryEndpoints.map((endpoint: string) => <li>{endpoint}</li>)}
						</ul>
					</section>
				)}

				{trial.latestUpdate && (
					<section class="cl-sec">
						<h2 class="cl-h2">Latest update</h2>
						<div class="cl-update">
							<span class="cl-update__k">{formatDate(trial.latestUpdate.date)}</span>
							<p>{trial.latestUpdate.summary}</p>
							{trial.latestUpdate.source && (
								<a href={trial.latestUpdate.source} target="_blank" rel="noopener noreferrer">Source</a>
							)}
						</div>
					</section>
				)}

				<p class="cl-note">Trial information is compiled from public sources and may be out of date. It is not medical advice and is not an offer of enrolment; check the registry entry or speak to a physician before acting on it.</p>
			</div>

			<aside class="cl-aside">
				<div class="cl-box">
					<h2 class="cl-box__t">Trial details</h2>
					<dl class="cl-facts">
						<div><dt>Trial ID</dt><dd>{trial.id.toUpperCase()}</dd></div>
						<div><dt>Phase</dt><dd>{trial.phase}</dd></div>
						<div><dt>Status</dt><dd>{trial.status}</dd></div>
						<div><dt>Start date</dt><dd>{formatDate(trial.startDate)}</dd></div>
						<div><dt>Est. completion</dt><dd>{formatDate(trial.estimatedCompletion)}</dd></div>
					</dl>
				</div>

				{trial.countries && trial.countries.length > 0 && (
					<div class="cl-box">
						<h2 class="cl-box__t">Trial locations</h2>
						<ul class="cl-tags">
							{trial.countries.map((country: string) => <li>{country}</li>)}
						</ul>
					</div>
				)}

				<div class="cl-box">
					<h2 class="cl-box__t">Sponsor</h2>
					<p class="cl-box__lead">{company.name}</p>
					<p class="cl-dim">{company.headquarters}</p>
					{company.website && (
						<p><a href={company.website} target="_blank" rel="noopener noreferrer">Visit website ↗</a></p>
					)}
				</div>

				<a href="/clinical-trials" class="cl-more">← All clinical trials</a>
			</aside>
		</div>
	</article>
</SiteLayout>
