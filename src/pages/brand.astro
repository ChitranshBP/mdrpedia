---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import Seal from "../components/site/Seal.astro";
import { getRegisterStats, fmt } from "../lib/register-stats";
import "../styles/pages/editorial.css";

export const prerender = true;

const stats = await getRegisterStats();

const titans = (await getCollection("doctors"))
	.filter((d) => d.data.tier === "TITAN" && d.data.status !== "HISTORICAL")
	.sort((a, b) => (b.data.hIndex ?? 0) - (a.data.hIndex ?? 0))
	.slice(0, 4)
	.map((d) => ({
		slug: d.id,
		name: d.data.fullName,
		specialty: d.data.specialty,
		country: d.data.geography?.country ?? "",
		hIndex: d.data.hIndex ?? 0,
		papers: Array.isArray(d.data.citations) ? d.data.citations.length : 0,
		score: Math.round(d.data.rankingScore ?? 0),
	}));
const lead = titans[0];

const principles = [
	{ t: "Earned, not listed", b: "Every visual decision should make being on the register feel like an honour." },
	{ t: "Sourced, visibly", b: "Show the evidence and where it came from. Trust has to be seen." },
	{ t: "One mark, everywhere", b: "The seal appears on every profile, embed and share card." },
];

const swatches = [
	{ n: "Registry Green", hex: "#0E3B2E", fg: "#f4f0e6" },
	{ n: "Brass", hex: "#C9A24A", fg: "#0e3b2e" },
	{ n: "Vellum", hex: "#F4F0E6", fg: "#14171a" },
	{ n: "Ink", hex: "#14171A", fg: "#f4f0e6" },
];

const lineage = [{ g: "GEN I", n: "Halsted" }, { g: "GEN II", n: "Cushing" }, { g: "GEN III", n: "Dandy" }];

const title = "Brand and seals — the MDRPedia identity";
const description = "The MDRPedia identity: the seal, Registry Green and Brass, the typefaces, and how the mark appears on profiles, clinic websites and share cards.";
---

<SiteLayout title={title} description={description}>
	<div class="ed">
		<section class="ed-hero" aria-labelledby="b-title">
			<div class="ed-wrap ed-hero__inner" style="gap:56px;padding-top:48px">
				<div class="ed-head" style="font-family:var(--r-mono);font-size:12px;letter-spacing:0.08em;color:#c9b77e;border-bottom:1px solid var(--ed-line-dark);padding-bottom:14px">
					<span>MDRPEDIA · IDENTITY</span><span>{fmt(stats.profiles)} PHYSICIANS ON THE REGISTER</span>
				</div>
				<div class="ed-cover">
					<div style="display:flex;flex-direction:column;gap:28px">
						<h1 class="ed-h1" id="b-title">The honour roll <em>of medicine.</em></h1>
						<p class="ed-hero__lede" style="font-size:20px;max-width:40ch">
							Not a better directory. A mark doctors want to earn, and put on their wall.
						</p>
					</div>
					<div class="ed-cover__seal">
						<Seal size={300} uid="b-cover" no="MDRPEDIA" label="The MDRPedia seal" />
					</div>
				</div>
			</div>
		</section>

		<section class="ed-wrap ed-sec ed-sec--first" aria-labelledby="b-pos">
			<div class="ed-rule" style="gap:40px">
				<div class="ed-head__title">
					<span class="ed-kicker">01 · POSITIONING</span>
					<h2 class="ed-h2" id="b-pos">Recognition, not search</h2>
				</div>
				<div class="ed-cards">
					<div class="ed-panel ed-panel--sand">
						<span class="ed-label">Every health site competes on</span>
						<span class="ed-strike">Finding a doctor near you</span>
						<p class="ed-muted">Booking platforms and maps already do this, with reviews, appointments and insurance data.</p>
					</div>
					<div class="ed-panel ed-panel--deep">
						<span class="ed-label">MDRPedia owns</span>
						<span class="ed-own">Recognition: the mark of a physician's standing, earned on evidence</span>
						<p>Think of the marks people remember because the people they honour display them.</p>
					</div>
				</div>
				<div class="ed-principles">
					{principles.map((p) => <div class="ed-principle"><b>{p.t}</b><span>{p.b}</span></div>)}
				</div>
			</div>
		</section>

		<section class="ed-wrap ed-sec" id="seal" aria-labelledby="b-assets">
			<div class="ed-rule" style="gap:32px">
				<div class="ed-head__title">
					<span class="ed-kicker">02 · THREE ASSETS</span>
					<h2 class="ed-h2" id="b-assets" style="max-width:22ch">Things only MDRPedia has, repeated everywhere</h2>
				</div>
				<div class="ed-grid">
					<div class="ed-card" style="gap:16px">
						<div class="ed-asset__art"><Seal size={120} uid="b-a1" ring="TITAN · TIER I · MDRPEDIA · VERIFIED ·" /></div>
						<span class="ed-card__t" style="font-size:26px">The Seal</span>
						<p>One seal, two metals: <strong>brass</strong> for stature (Titan, Elite, Master) and <strong>green</strong> for ethics. Certified doctors can embed it on their clinic website, linked to a public verification page.</p>
					</div>
					<div class="ed-card" style="gap:16px">
						<div class="ed-asset__art ed-asset__art--sand"><span class="ed-small" style="font-family:var(--r-mono);font-size:12px">Register number</span><span class="ed-regno">MDR № ····</span></div>
						<span class="ed-card__t" style="font-size:26px">The Register Number <span class="ed-status ed-status--planned">PLANNED</span></span>
						<p>A permanent ID for every physician, like a DOI or ORCID, to appear on profiles, seals and citations so the register can be cited the way a paper is.</p>
					</div>
					<div class="ed-card" style="gap:16px">
						<div class="ed-asset__art ed-asset__art--lineage">
							{lineage.map((l) => <div class="ed-lineage-step"><div><small>{l.g}</small><b>{l.n}</b></div><i></i></div>)}
						</div>
						<span class="ed-card__t" style="font-size:26px">The Lineage</span>
						<p>Who trained whom. Content nobody else publishes, and every doctor wants to share their line of mentors. <a href="/lineage">Explore lineage</a>.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="ed-wrap ed-sec" aria-labelledby="b-system">
			<div class="ed-rule" style="gap:32px">
				<div class="ed-head__title">
					<span class="ed-kicker">03 · IDENTITY SYSTEM</span>
					<h2 class="ed-h2" id="b-system">Colour and type</h2>
				</div>
				<div class="ed-grid">
					<div style="display:flex;flex-direction:column;gap:16px">
						<h3 class="ed-h3">Colour: Registry Green and Brass</h3>
						<p class="ed-muted">Blue belongs to every health portal. Green is the traditional academic colour of medicine, used on doctoral hoods. Paired with brass it signals honour rather than a clinic.</p>
						<div class="ed-swatches">
							{swatches.map((s) => <div style={`background:${s.hex};color:${s.fg}`}><strong>{s.n}</strong><span>{s.hex}</span></div>)}
						</div>
					</div>
					<div style="display:flex;flex-direction:column;gap:16px">
						<h3 class="ed-h3">Type: engraved, clinical, catalogued</h3>
						<div class="ed-type">
							<div><span style="font-family:var(--r-serif);font-size:40px;line-height:1">Honour</span><small>Bodoni Moda · names, headlines</small></div>
							<div><span style="font-size:22px;font-weight:600">Evidence, plainly</span><small>Hanken Grotesk · UI, body</small></div>
							<div><span style="font-family:var(--r-mono);font-size:18px">h {lead?.hIndex ?? 0} · {fmt(stats.citations)} papers</span><small>Spline Sans Mono · numbers, IDs</small></div>
						</div>
						<p class="ed-muted">Signature device: the <strong>double rule</strong>, a certificate border that opens every section, with <strong>№ numbering</strong>.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="ed-wrap ed-sec ed-sec--last" aria-labelledby="b-applied">
			<div class="ed-rule" style="gap:32px">
				<div class="ed-head__title">
					<span class="ed-kicker">04 · APPLIED</span>
					<h2 class="ed-h2" id="b-applied">Where people see it</h2>
				</div>

				<figure class="ed-figure">
					<div class="ed-mock">
						<div class="ed-mock__bar" aria-hidden="true">
							<b>MDRPedia</b><span>Find a doctor</span><span>Regions</span><span>Register</span><span>Evidence</span><em>For doctors</em>
						</div>
						<div class="ed-mock__body">
							<span class="ed-kicker">HOMEPAGE · {fmt(stats.profiles)} PHYSICIANS ON THE REGISTER</span>
							<p class="ed-mock__h">Who changed medicine, <em>and does it hold up?</em></p>
							<div class="ed-mock__search" aria-hidden="true"><span>Search the register by name, specialty or breakthrough</span><span>⌘K</span></div>
							<div class="ed-mock__results">
								{titans.map((t) => <a href={`/doctors/${t.slug}`}><span><b>{t.name}</b><small>{t.specialty}</small></span><i>h {t.hIndex}</i></a>)}
							</div>
						</div>
					</div>
					<figcaption>Homepage search, with the highest h-index Titans on the register</figcaption>
				</figure>

				<div class="ed-grid">
					{lead && (
						<figure class="ed-figure">
							<figcaption>Profile header</figcaption>
							<div class="ed-profile-card">
								<div class="ed-profile-card__top"><span>THE REGISTER</span><span>TITAN · TIER I</span></div>
								<a class="ed-profile-card__name" href={`/doctors/${lead.slug}`}>{lead.name}</a>
								<div class="ed-muted">{lead.specialty}{lead.country && ` · ${lead.country}`}</div>
								<div class="ed-profile-card__facts">
									<div><b>{lead.hIndex}</b><span>h-index</span></div>
									<div><b>{lead.papers}</b><span>Key papers</span></div>
									<div><b>{lead.score}</b><span>MDR Score</span></div>
								</div>
							</div>
						</figure>
					)}
					<figure class="ed-figure">
						<figcaption>Embeddable ethics seal, on a clinic's website (example)</figcaption>
						<div class="ed-embed-stage">
							<div class="ed-embed">
								<Seal size={64} color="#0e3b2e" uid="b-embed" ring="ETHICS · LEGEND · MDRPEDIA ·" />
								<div><small>Ethics Legend</small><b>Listed on the MDRPedia Register</b><span>verify ↗</span></div>
							</div>
						</div>
					</figure>
				</div>

				<div class="ed-grid">
					{lead && (
						<figure class="ed-figure">
							<figcaption>Social share card for a profile</figcaption>
							<div class="ed-share ed-share--deep">
								<div class="ed-share__top"><span>MDRPEDIA · THE REGISTER</span><span>TITAN · TIER I</span></div>
								<div><div class="ed-share__name">{lead.name}</div><div class="ed-share__sub">{lead.specialty} · h-index {lead.hIndex}</div></div>
							</div>
						</figure>
					)}
					<figure class="ed-figure">
						<figcaption>Published rankings</figcaption>
						<a href="/rankings/top-100" class="ed-share ed-share--brass" style="text-decoration:none">
							<div class="ed-share__top"><span>THE REGISTER · TOP 100</span></div>
							<div class="ed-share__big">The Register 100</div>
						</a>
					</figure>
				</div>
			</div>
		</section>
	</div>
</SiteLayout>
