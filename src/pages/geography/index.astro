---
/**
 * MDRPedia — Regions: every country in the register, the top of the
 * country → state → city drill-down.
 */
import "../../styles/pages/regions.css";
import SiteLayout from "../../layouts/SiteLayout.astro";
import RegionHero from "../../components/site/RegionHero.astro";
import RegionSync from "../../components/site/RegionSync.astro";
import { COUNTRY_REGISTER, getRegister, getUnlistedCount, summarizeCountries } from "../../lib/regions";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, max-age=120, s-maxage=300");

const register = await getRegister();
const unlisted = await getUnlistedCount();
const countries = summarizeCountries(register);
const listed = register.length;
const placed = countries.reduce((n, c) => n + c.placed, 0);

const pageTitle = "Verified doctors by country, state and city — Regions | MDRPedia";
const pageDescription = `${listed.toLocaleString()} verified physicians across ${countries.length} countries. Browse the MDRPedia register by country, then state and city, with specialty filters and evidence-only ranking.`;

const site = (Astro.site ?? new URL("https://mdrpedia.com")).origin;
const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		name: "Regions — physicians by country",
		description: pageDescription,
		url: `${site}/geography`,
		mainEntity: {
			"@type": "ItemList",
			numberOfItems: countries.length,
			itemListElement: countries.map((c, i) => ({
				"@type": "ListItem",
				position: i + 1,
				name: `Physicians in ${c.name}`,
				url: `${site}/geography/${c.slug}`,
			})),
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "MDRPedia", item: `${site}/` },
			{ "@type": "ListItem", position: 2, name: "Regions", item: `${site}/geography` },
		],
	},
];
---

<SiteLayout title={pageTitle} description={pageDescription} active="regions" jsonLd={jsonLd}>
	<div class="rg">
		<RegionHero
			eyebrow="BY PLACE · COUNTRY → STATE → CITY · EVIDENCE ONLY, NO PAID PLACEMENT"
			heading="The register, by place"
			lede={`${listed.toLocaleString()} verified physicians in ${countries.length} countries. Pick a country, then narrow to a state and city.`}
			crumbs={[{ label: "All countries" }]}
			levels={[{ label: "Country", state: "current" }, { label: "State", state: "" }, { label: "City", state: "" }]}
		/>

		<section class="rg-main">
			<aside class="rg-aside" aria-labelledby="rg-children-label">
				<h2 class="rg-label" id="rg-children-label">COUNTRIES</h2>
				<input type="search" class="rg-filter" placeholder="Filter countries" aria-label="Filter countries" aria-controls="rg-children" data-place-filter />
				<ul class="rg-children" id="rg-children">
					{countries.map((c) => (
						<li data-name={c.name}>
							<a href={`/geography/${c.slug}`}>
								<span class="n">{c.name}</span>
								<span class="c">{c.count} {c.count === 1 ? "physician" : "physicians"} →</span>
							</a>
						</li>
					))}
				</ul>
				<p class="rg-empty-filter" id="rg-children-none" hidden>No countries match.</p>
				{unlisted > 0 && (
					<p class="rg-unplaced">
						{unlisted.toLocaleString()} more {unlisted === 1 ? "physician has" : "physicians have"} no verified country yet, so {unlisted === 1 ? "is" : "are"} not listed by place. Find them through <a href="/search">search</a>.
					</p>
				)}
				<div class="rg-how">
					<b>HOW PLACES WORK</b>
					A physician is listed where they are registered to practise. We only show a state or city once we have verified it, and in India listings are alphabetical under the NMC's advertising guidelines.
					<a href="/evidence">The Evidence Standard →</a>
				</div>
			</aside>

			<div class="rg-list">
				<p class="rg-count">{countries.length} countries · {placed.toLocaleString()} physicians placed to a state or city</p>
				<div class="rg-scroll" tabindex="0" role="region" aria-label="Countries in the register">
					<table class="rg-table">
						<caption class="r-sr-only">Countries in the register</caption>
						<thead>
							<tr>
								<th scope="col">COUNTRY</th>
								<th scope="col" class="col-tier">REGISTER</th>
								<th scope="col" class="col-num">DOCTORS</th>
								<th scope="col" class="col-tier">PLACED</th>
								<th scope="col" class="col-tier">SPECIALTIES</th>
								<th scope="col" class="col-where">MOST LISTED</th>
							</tr>
						</thead>
						<tbody>
							{countries.map((c) => (
								<tr>
									<td><a class="rg-name" href={`/geography/${c.slug}`}>{c.name}</a></td>
									<td class="rg-tier">{COUNTRY_REGISTER[c.name] ?? <span class="rg-dim">—</span>}</td>
									<td class="rg-num">{c.count.toLocaleString()}</td>
									<td class="rg-num">{c.placed > 0 ? c.placed.toLocaleString() : <span class="rg-dim">—</span>}</td>
									<td class="rg-num">{c.specialties}</td>
									<td class="rg-where">{c.leading ?? <span class="rg-dim">—</span>}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="rg-foot">Placed: physicians whose state or city we have verified. Specialties: how many of the register's specialty groups are represented. Most listed: the group with the most physicians.</p>
			</div>
		</section>
	</div>
	<RegionSync />
</SiteLayout>
