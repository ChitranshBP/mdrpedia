---
/**
 * MDRPedia — the register by place: country → state → city.
 * ?state= and ?city= drill down, ?spec= filters by specialty group, ?sort= ranks
 * (outside India, where listings are A–Z), ?page= paginates.
 */
import "../../styles/pages/regions.css";
import SiteLayout from "../../layouts/SiteLayout.astro";
import RegionHero from "../../components/site/RegionHero.astro";
import RegisterTable from "../../components/site/RegisterTable.astro";
import RegionSync from "../../components/site/RegionSync.astro";
import Pagination from "../../components/Pagination.astro";
import SpecialtyGeoLinks from "../../components/SpecialtyGeoLinks.astro";
import {
	COUNTRY_REGISTER, OTHER_GROUP, SORTS, getRegister, hasStates, isAlphabetical, sortEntries, tally, themeKey,
	type SortKey,
} from "../../lib/regions";
import { slugify } from "../../lib/slug";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, max-age=120, s-maxage=300");

const { country: countrySlug } = Astro.params;
const params = Astro.url.searchParams;

const inCountry = (await getRegister()).filter((e) => e.countrySlug === countrySlug);
if (inCountry.length === 0) return Astro.rewrite("/404");

const country = inCountry[0].country;
const threeLevels = hasStates(country);
const alphabetical = isAlphabetical(country);
const levelNames = threeLevels ? ["Country", "State", "City"] : ["Country", "City"];

// Resolve the drill-down path from ?state / ?city; unknown values are a 404, not an empty page.
const stateParam = threeLevels ? params.get("state") : null;
const cityParam = params.get("city");
const state = stateParam ? inCountry.find((e) => e.state && slugify(e.state) === stateParam)?.state : null;
if (stateParam && !state) return Astro.rewrite("/404");
const inState = state ? inCountry.filter((e) => e.state === state) : inCountry;
const city = cityParam ? inState.find((e) => e.city && slugify(e.city) === cityParam)?.city : null;
if (cityParam && !city) return Astro.rewrite("/404");
if (threeLevels && city && !state) {
	const owner = inState.find((e) => e.city === city)?.state;
	if (owner) return Astro.redirect(`/geography/${countrySlug}?state=${slugify(owner)}&city=${cityParam}`, 301);
}
const here = city ? inState.filter((e) => e.city === city) : inState;

const path = [country, state, city].filter((p): p is string => !!p);
const depth = path.length;
const place = path[depth - 1];
const atLeaf = depth === levelNames.length;

const base = `/geography/${countrySlug}`;
const href = (q: Record<string, string | null | undefined>) => {
	const u = new URLSearchParams();
	for (const [k, v] of Object.entries(q)) if (v) u.set(k, v);
	const s = u.toString();
	return s ? `${base}?${s}` : base;
};
const placeQuery = { state: state ? slugify(state) : null, city: city ? slugify(city) : null };

// Children: states at country level (or cities, for countries without states), cities at state level.
const childKey = atLeaf ? null : threeLevels && depth === 1 ? "state" : "city";
const children = childKey
	? tally(here.map((e) => e[childKey]).filter((v): v is string => !!v))
		.sort((a, b) => a[0].localeCompare(b[0]))
		.map(([name, count]) => ({
			name,
			count,
			href: href(childKey === "state" ? { state: slugify(name) } : { ...placeQuery, city: slugify(name) }),
		}))
	: [];
const unplaced = childKey ? here.filter((e) => !e[childKey]).length : 0;
const childPlural = childKey === "state" ? (country === "United Kingdom" ? "NATIONS" : "STATES") : "CITIES";

// Specialty chips, then sort and paginate.
const groups = tally(here.map((e) => e.group)).sort((a, b) =>
	a[0] === OTHER_GROUP ? 1 : b[0] === OTHER_GROUP ? -1 : b[1] - a[1] || a[0].localeCompare(b[0]),
);
const specParam = params.get("spec");
const spec = specParam ? groups.find(([g]) => slugify(g) === specParam)?.[0] : null;
const sortParam = params.get("sort") as SortKey | null;
const sort: SortKey = SORTS.some((s) => s.key === sortParam) ? sortParam! : "score";
const filtered = sortEntries(spec ? here.filter((e) => e.group === spec) : here, alphabetical, sort);

const PAGE_SIZE = 50;
const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
const page = Math.min(Math.max(1, parseInt(params.get("page") || "1", 10) || 1), totalPages);
const shown = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const keep = { ...placeQuery, spec: spec ? slugify(spec) : null, sort: !alphabetical && sort !== "score" ? sort : null };

const sortLabel = SORTS.find((s) => s.key === sort)!.label.toLowerCase();
const countLabel = `${filtered.length.toLocaleString()} ${filtered.length === 1 ? "physician" : "physicians"} in ${place}${spec ? ` · ${spec}` : ""}${alphabetical ? " · A–Z" : ` · ranked by ${sortLabel}`}`;
const register = COUNTRY_REGISTER[country];

const heading = depth === 1 ? `Verified doctors in ${country}` : `Doctors in ${place}`;
const pageTitle = depth === 1 ? `Verified doctors in ${country} — by state and city | MDRPedia` : `Doctors in ${path.slice(1).reverse().join(", ")}, ${country} | MDRPedia`;
const pageDescription = `${here.length.toLocaleString()} verified ${here.length === 1 ? "physician" : "physicians"} in ${path.slice().reverse().join(", ")}${register ? `, registered with ${register.split(" · ")[0]}` : ""}. Browse by ${threeLevels ? "state, city" : "city"} and specialty${alphabetical ? ", listed alphabetically under the NMC advertising guidelines" : ", ranked on evidence only"}.`;
// SiteLayout's canonical drops the query, so drill-down and filtered views stay out of the index until it accepts one.
const filteredView = Boolean(state || city || spec || keep.sort || page > 1);

const site = (Astro.site ?? new URL("https://mdrpedia.com")).origin;
const pageUrl = `${site}${href(placeQuery)}`;
const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		name: heading,
		description: pageDescription,
		url: pageUrl,
		mainEntity: {
			"@type": "ItemList",
			numberOfItems: filtered.length,
			itemListOrder: alphabetical ? "https://schema.org/ItemListOrderAscending" : "https://schema.org/ItemListUnordered",
			itemListElement: shown.map((e, i) => ({
				"@type": "ListItem",
				position: (page - 1) * PAGE_SIZE + i + 1,
				item: {
					"@type": "Physician",
					name: e.name,
					medicalSpecialty: e.specialty,
					url: `${site}/doctors/${e.slug}`,
					address: {
						"@type": "PostalAddress",
						addressCountry: e.country,
						...(e.state ? { addressRegion: e.state } : {}),
						...(e.city ? { addressLocality: e.city } : {}),
					},
				},
			})),
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "MDRPedia", item: `${site}/` },
			{ "@type": "ListItem", position: 2, name: "Regions", item: `${site}/geography` },
			...path.map((p, i) => ({
				"@type": "ListItem",
				position: i + 3,
				name: p,
				item: `${site}${href(i === 0 ? {} : i === 1 && threeLevels ? { state: placeQuery.state } : placeQuery)}`,
			})),
		],
	},
];

const crumbs = [
	{ label: "All countries", href: "/geography" },
	...path.map((p, i) => ({
		label: p,
		href: i === depth - 1 ? undefined : href(i === 0 ? {} : { state: placeQuery.state }),
	})),
];
const levels = levelNames.map((label, i) => ({
	label,
	state: (i < depth - 1 ? "done" : i === depth - 1 ? "current" : "") as "done" | "current" | "",
}));
---

<SiteLayout title={pageTitle} description={pageDescription} active="regions" jsonLd={jsonLd} robots={filteredView ? "noindex, follow" : undefined}>
	<div class="rg" data-theme={themeKey(country)}>
		<RegionHero
			eyebrow={`BY PLACE · ONLY DOCTORS REGISTERED IN ${country.toUpperCase()}${register ? ` (${register})` : ""} · ${threeLevels ? (country === "United Kingdom" ? "NATION" : "STATE") + " → CITY" : "CITY"}`}
			heading={heading}
			crumbs={crumbs}
			levels={levels}
		/>

		<section class="rg-main">
			<aside class="rg-aside" aria-labelledby="rg-children-label">
				<h2 class="rg-label" id="rg-children-label">{childKey ? `${childPlural} IN ${place.toUpperCase()}` : `${levelNames[depth - 1].toUpperCase()} LEVEL`}</h2>
				{childKey && children.length > 0 && (
					<>
						<input
							type="search"
							class="rg-filter"
							placeholder={`Filter ${childPlural.toLowerCase()}`}
							aria-label={`Filter ${childPlural.toLowerCase()}`}
							aria-controls="rg-children"
							data-place-filter
						/>
						<ul class="rg-children" id="rg-children">
							{children.map((c) => (
								<li data-name={c.name}>
									<a href={c.href}>
										<span class="n">{c.name}</span>
										<span class="c">{c.count} {c.count === 1 ? "physician" : "physicians"} →</span>
									</a>
								</li>
							))}
						</ul>
						<p class="rg-empty-filter" id="rg-children-none" hidden>No {childPlural.toLowerCase()} match.</p>
					</>
				)}
				{childKey && children.length === 0 && (
					<p class="rg-note">We have not verified a {childKey} for any physician in {place} yet, so everyone is listed at {levelNames[depth - 1].toLowerCase()} level.</p>
				)}
				{childKey && children.length > 0 && unplaced > 0 && (
					<p class="rg-unplaced">
						{unplaced} {unplaced === 1 ? "physician" : "physicians"} in {place} {unplaced === 1 ? "has" : "have"} no verified {childKey} yet. They appear in the list for {place}.
					</p>
				)}
				{atLeaf && (
					<p class="rg-note">This is the most local level. The list shows every verified physician practising in {place}.</p>
				)}
				<div class="rg-how">
					<b>{alphabetical ? `HOW LISTINGS WORK IN ${country.toUpperCase()}` : "HOW RANKS WORK HERE"}</b>
					{alphabetical
						? "Under the NMC's October 2026 advertising guidelines, doctors are listed alphabetically. We never label anyone \"best\" or \"No. 1\", and there is no paid placement."
						: "Physicians are ranked within this place and specialty, on evidence only. Reviews, ratings and payment play no part."}
					<a href="/about#methodology">The Evidence Standard →</a>
				</div>
			</aside>

			<div class="rg-list">
				<div class="rg-toolbar">
					{groups.length > 1 && (
						<nav class="rg-specs" aria-label="Filter by specialty">
							<a href={href({ ...keep, spec: null })} aria-current={spec ? undefined : "true"}>All</a>
							{groups.map(([g, n]) => (
								<a href={href({ ...keep, spec: slugify(g) })} aria-current={g === spec ? "true" : undefined}>
									{g}<small>{n}</small>
								</a>
							))}
						</nav>
					)}
					{alphabetical ? (
						<p class="rg-sorts">Listed alphabetically</p>
					) : (
						<nav class="rg-sorts" aria-label="Rank by">
							<span aria-hidden="true">Rank by</span>
							{SORTS.map((s) => (
								<a href={href({ ...keep, sort: s.key === "score" ? null : s.key })} aria-current={s.key === sort ? "true" : undefined}>{s.label}</a>
							))}
						</nav>
					)}
				</div>
				<p class="rg-count" aria-live="polite">{countLabel}</p>

				<RegisterTable
					entries={shown}
					rankFrom={alphabetical ? undefined : (page - 1) * PAGE_SIZE + 1}
					showTier={!alphabetical}
					where={depth >= 2 && threeLevels ? "city" : "city-state"}
					caption={countLabel}
				/>
				{shown.length === 0 && (
					<div class="rg-empty">
						<strong>No physicians listed here yet</strong>
						We are adding verified physicians in {place} every week. <a href={href(placeQuery)}>Clear the specialty filter</a>.
					</div>
				)}

				<Pagination page={page} totalPages={totalPages} total={filtered.length} pageSize={PAGE_SIZE} label="physicians" />
				<p class="rg-foot">
					h-index and papers come from each physician's published research record. Tier is MDRPedia's evidence tier; ethics shows an approved MDRPedia ethics certification.
				</p>
				{depth === 1 && <SpecialtyGeoLinks countrySlug={countrySlug} />}
			</div>
		</section>
	</div>
	<RegionSync country={country} />
</SiteLayout>
