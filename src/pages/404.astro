---
Astro.response.status = 404;
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/pages/utility.css";
---

<SiteLayout
	title="Page not found | MDRPedia"
	description="The page you were looking for is not on MDRPedia."
	robots="noindex, follow"
>
	<div class="u-page">
		<div class="u-wrap u-error">
			<p class="u-error__code" aria-hidden="true">404</p>
			<span class="u-kicker">NOT IN THE REGISTER</span>
			<h1 class="u-h1">Page <em>not found.</em></h1>
			<p class="u-lede">
				The page or profile you are looking for may have moved, been renamed, or is still awaiting verification.
			</p>

			<form action="/doctors" method="get" class="u-search" role="search">
				<label for="not-found-search" class="r-sr-only">Search doctors by name, specialty or institution</label>
				<input class="u-input" type="text" id="not-found-search" name="q" placeholder="Search by name, specialty or institution" autocomplete="off" />
				<button type="submit">Search</button>
			</form>

			<ul class="u-links">
				<li><a href="/">Home</a></li>
				<li><a href="/doctors">Browse doctors</a></li>
				<li><a href="/rankings">Rankings</a></li>
				<li><a href="/hospitals">Hospitals</a></li>
				<li><a href="/rare-diseases">Rare diseases</a></li>
				<li><a href="/doctor/claim">Claim your record</a></li>
			</ul>
		</div>
	</div>
</SiteLayout>

<script>
	const body = new Blob(
		[JSON.stringify({ url: location.pathname + location.search, referrer: document.referrer })],
		{ type: "application/json" },
	);
	if (navigator.sendBeacon) navigator.sendBeacon("/api/log-404", body);
	else fetch("/api/log-404", { method: "POST", body, keepalive: true });
</script>
