---
/**
 * MDRPedia — The Register.
 * Every physician on record, in register-number order. Database-first with a
 * static fallback. Stature tiers are hidden for India (NMC 2026 guidelines).
 */
import SiteLayout from "../../layouts/SiteLayout.astro";
import Pagination from "../../components/Pagination.astro";
import "../../styles/pages/listing-theme.css";
import "../../styles/pages/register-list.css";
import { getCollection } from "astro:content";
import { prisma } from "../../lib/prisma";
import { normalizeSpecialty } from "../../lib/specialty-groups";
import { ALL_COUNTRIES, REGISTER_COUNTRIES, resolveCountry } from "../../lib/find-doctor";
import { formatRegisterNumber, getRegisterNumbers } from "../../lib/register-numbers";

export const prerender = false;

type Sort = "id" | "name" | "h";
type Row = {
	slug: string;
	no: string;
	name: string;
	specialty: string;
	country: string;
	tier: string;
	status: string;
	hIndex: number;
	ethics: string;
};

const PAGE_SIZE = 50;
const TIERS = ["TITAN", "ELITE", "MASTER"];
const ROLES = ["surgeon", "physician", "researcher"];
const TIER_LABEL: Record<string, string> = { TITAN: "Titan · I", ELITE: "Elite · II", MASTER: "Master · III" };

const params = Astro.url.searchParams;
const countryParam = (params.get("country") || "").trim();
const country = countryParam.toLowerCase() === ALL_COUNTRIES ? null : resolveCountry(countryParam);
// Legacy links pass any country name (?country=Germany); filter on it without the register theme.
const otherCountry = !country && countryParam && countryParam.toLowerCase() !== ALL_COUNTRIES ? countryParam.slice(0, 60) : "";
const nmc = country?.nmc ?? false;
const tierParam = (params.get("tier") || "").toUpperCase();
const tier = !nmc && TIERS.includes(tierParam) ? tierParam : "";
const ethicsOnly = params.get("ethics") === "1";
const role = ROLES.includes(params.get("role") || "") ? params.get("role")! : "";
const specialty = (params.get("specialty") || "").trim().slice(0, 100);
const query = (params.get("q") || "").trim().slice(0, 100);
const requestedPage = Math.max(1, parseInt(params.get("page") || "1", 10) || 1);

const sortCycle: Sort[] = nmc ? ["id", "name"] : country ? ["h", "id"] : ["id", "h"];
const sortParam = params.get("sort") as Sort | null;
const sort: Sort = sortParam && ["id", "name", "h"].includes(sortParam) ? sortParam : sortCycle[0];
const nextSort = sortCycle[(sortCycle.indexOf(sort) + 1) % sortCycle.length];
const SORT_LABEL: Record<Sort, string> = { id: "Register №", name: "Name A–Z", h: "h-index" };

const surgeonSpecialty = [
	{ specialty: { contains: "surgery", mode: "insensitive" } },
	{ specialty: { contains: "surgeon", mode: "insensitive" } },
	{ specialty: { contains: "transplant", mode: "insensitive" } },
];
const researcherSignal = [{ h_index: { gt: 50 } }, { title: { contains: "PhD" } }];

const where: Record<string, any> = {};
const and: any[] = [];
const countryName = country?.name ?? otherCountry;
if (countryName) where.geography = { is: { country: { equals: countryName, mode: "insensitive" } } };
if (tier) where.tier = tier;
if (ethicsOnly) and.push({ ethics_status: "APPROVED" }, { ethics_tier: { not: null } });
if (specialty) where.specialty = { contains: specialty, mode: "insensitive" };
if (role === "surgeon") and.push({ OR: surgeonSpecialty });
if (role === "researcher") and.push({ NOT: { OR: surgeonSpecialty } }, { OR: researcherSignal });
if (role === "physician") and.push({ NOT: { OR: [...surgeonSpecialty, ...researcherSignal] } });
if (query) {
	and.push({
		OR: [
			{ full_name: { contains: query, mode: "insensitive" } },
			{ specialty: { contains: query, mode: "insensitive" } },
			{ sub_specialty: { contains: query, mode: "insensitive" } },
			{ geography: { is: { city: { contains: query, mode: "insensitive" } } } },
		],
	});
}
if (and.length) where.AND = and;

const orderBy =
	sort === "name"
		? [{ full_name: "asc" as const }, { slug: "asc" as const }]
		: sort === "h"
			? [{ h_index: "desc" as const }, { slug: "asc" as const }]
			: [{ createdAt: "asc" as const }, { slug: "asc" as const }];

const titleCase = (s: string) => s.charAt(0) + s.slice(1).toLowerCase();
const placeName = (c: string | null | undefined) => (!c || c === "Global" || c === "Unknown" ? "—" : c);

let rows: Row[] = [];
let total = 0;
let page = requestedPage;

try {
	const [count, numbers] = await Promise.all([prisma.profile.count({ where }), getRegisterNumbers()]);
	total = count;
	page = Math.min(requestedPage, Math.max(1, Math.ceil(total / PAGE_SIZE)));
	const found = await prisma.profile.findMany({
		where,
		select: {
			slug: true,
			full_name: true,
			specialty: true,
			tier: true,
			status: true,
			h_index: true,
			ethics_tier: true,
			ethics_status: true,
			geography: { select: { country: true } },
		},
		orderBy,
		skip: (page - 1) * PAGE_SIZE,
		take: PAGE_SIZE,
	});
	rows = found.map((d) => ({
		slug: d.slug,
		no: formatRegisterNumber(numbers.get(d.slug)),
		name: d.full_name,
		specialty: normalizeSpecialty(d.specialty),
		country: placeName(d.geography?.country),
		tier: d.tier,
		status: d.status,
		hIndex: d.h_index,
		ethics: d.ethics_status === "APPROVED" && d.ethics_tier ? titleCase(d.ethics_tier) : "—",
	}));
} catch (e) {
	console.error("Register: database unavailable, using static records", e);
	const entries = (await getCollection("doctors")).sort((a, b) => a.id.localeCompare(b.id));
	const q = query.toLowerCase();
	const isSurgeon = (s: string) => /surg|transplant/i.test(s);
	let all = entries
		.map((d, i) => ({ entry: d, n: i + 1 }))
		.filter(({ entry: { data: d } }) =>
			(!countryName || d.geography.country.toLowerCase() === countryName.toLowerCase()) &&
			(!tier || d.tier === tier) &&
			!ethicsOnly &&
			(!specialty || d.specialty.toLowerCase().includes(specialty.toLowerCase())) &&
			(!role || (role === "surgeon") === isSurgeon(d.specialty)) &&
			(!q || `${d.fullName} ${d.specialty} ${d.subSpecialty ?? ""} ${d.geography.city ?? ""}`.toLowerCase().includes(q)),
		);
	if (sort === "name") all = all.sort((a, b) => a.entry.data.fullName.localeCompare(b.entry.data.fullName));
	if (sort === "h") all = all.sort((a, b) => b.entry.data.hIndex - a.entry.data.hIndex);
	total = all.length;
	page = Math.min(requestedPage, Math.max(1, Math.ceil(total / PAGE_SIZE)));
	rows = all.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE).map(({ entry, n }) => ({
		slug: entry.id,
		no: formatRegisterNumber(n),
		name: entry.data.fullName,
		specialty: normalizeSpecialty(entry.data.specialty),
		country: placeName(entry.data.geography.country),
		tier: entry.data.tier,
		status: entry.data.status,
		hIndex: entry.data.hIndex,
		ethics: "—",
	}));
}

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

const href = (overrides: Record<string, string>) => {
	const base: Record<string, string> = {
		q: query,
		country: country ? country.slug : countryParam ? (otherCountry || ALL_COUNTRIES) : "",
		tier: tier.toLowerCase(),
		ethics: ethicsOnly ? "1" : "",
		sort: sortParam ? sort : "",
		specialty,
		role,
	};
	const next = new URLSearchParams();
	for (const [k, v] of Object.entries({ ...base, ...overrides })) if (v) next.set(k, v);
	const qs = next.toString();
	return qs ? `/doctors?${qs}` : "/doctors";
};

const scopeName = country?.name ?? (otherCountry || "every country");
const eyebrow = country
	? `THE REGISTER · ONLY PHYSICIANS REGISTERED IN ${country.name.toUpperCase()}`
	: otherCountry
		? `THE REGISTER · PHYSICIANS IN ${otherCountry.toUpperCase()}`
		: "THE REGISTER · EVERY PHYSICIAN ON RECORD";
const intro = nmc
	? "Every physician on record in India, listed by register number or by name. Search by name or specialty, or filter by the ethics mark."
	: `Every physician on record in ${scopeName}, in register-number order. Filter by mark or specialty, or sort by evidence.`;
const countLabel =
	`${total.toLocaleString()} ${total === 1 ? "physician" : "physicians"} in ${scopeName}` +
	(totalPages > 1 ? ` · page ${page} of ${totalPages}` : "") +
	(nmc ? " · stature tiers hidden under NMC 2026 guidelines" : "");
const filtered = !!(query || tier || ethicsOnly || specialty || role || sortParam);

const site = Astro.site ?? "https://mdrpedia.com";
const title = country
	? `The Register — Physicians in ${country.name} | MDRPedia`
	: "The Register — Every Physician on MDRPedia";
const description = `${total.toLocaleString()} physicians on record in ${scopeName}, listed by register number. Search by name or specialty, filter by the ethics mark, and open each record for registration, research and training.`;
const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		name: title,
		url: new URL("/doctors", site).href,
		description,
		mainEntity: {
			"@type": "ItemList",
			numberOfItems: total,
			itemListElement: rows.map((r, i) => ({
				"@type": "ListItem",
				position: (page - 1) * PAGE_SIZE + i + 1,
				url: new URL(`/doctors/${r.slug}`, site).href,
				name: r.name,
			})),
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "MDRPedia", item: new URL("/", site).href },
			{ "@type": "ListItem", position: 2, name: "The Register", item: new URL("/doctors", site).href },
		],
	},
];
---

<SiteLayout title={title} description={description} active="register" robots={filtered ? "noindex, follow" : "index, follow"} jsonLd={jsonLd}>
	<div class="rg r-listing" data-country={country?.name ?? "all"} data-country-param={countryParam ? "1" : ""}>
		<section class="rg-hero">
			<span class="rg-eyebrow">{eyebrow}</span>
			<h1>The Register</h1>
			<p>{intro}</p>
		</section>

		<section class="rg-main">
			<div class="rg-controls">
				<form class="rg-search" action="/doctors" method="get" role="search">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
					<label class="r-sr-only" for="rg-q">Search the register by name or specialty</label>
					<input id="rg-q" type="search" name="q" value={query} placeholder="Name or specialty" autocomplete="off" maxlength="100" />
					{countryParam && <input type="hidden" name="country" value={country ? country.slug : otherCountry || ALL_COUNTRIES} />}
					{tier && <input type="hidden" name="tier" value={tier.toLowerCase()} />}
					{ethicsOnly && <input type="hidden" name="ethics" value="1" />}
					{sortParam && <input type="hidden" name="sort" value={sort} />}
					{specialty && <input type="hidden" name="specialty" value={specialty} />}
					{role && <input type="hidden" name="role" value={role} />}
				</form>
				{!nmc && (
					<nav class="rg-tiers" aria-label="Stature">
						{["", ...TIERS].map((t) => (
							<a href={href({ tier: t.toLowerCase(), page: "" })} aria-current={t === tier ? "true" : undefined}>{t ? titleCase(t) : "All"}</a>
						))}
					</nav>
				)}
				<a class="rg-toggle" href={href({ ethics: ethicsOnly ? "" : "1", page: "" })} data-on={ethicsOnly ? "" : undefined}>{ethicsOnly && <span aria-hidden="true">✓ </span>}Ethics-certified only{ethicsOnly && <span class="r-sr-only"> (on — show everyone)</span>}</a>
				<a class="rg-sort" href={href({ sort: nextSort === sortCycle[0] ? "" : nextSort, page: "" })} title={`Sort by ${SORT_LABEL[nextSort]}`}>Sort: {SORT_LABEL[sort]}</a>
			</div>

			<div class="rg-meta">
				<span>{countLabel}</span>
				<span class="rg-scope">
					{REGISTER_COUNTRIES.filter((c) => c.slug !== country?.slug).map((c) => (
						<a href={href({ country: c.slug, tier: "", sort: "", page: "" })} data-country-link={c.name}>{c.name}</a>
					))}
					{(country || otherCountry) && <a href={href({ country: ALL_COUNTRIES, page: "" })}>All countries</a>}
				</span>
			</div>

			{(specialty || role) && (
				<p class="rg-filters">
					{specialty && <span>Specialty: <strong>{specialty}</strong> <a href={href({ specialty: "", page: "" })}>Remove</a></span>}
					{role && <span>Role: <strong>{role}</strong> <a href={href({ role: "", page: "" })}>Remove</a></span>}
				</p>
			)}

			<div class="rg-table-wrap">
				<table class="rg-table">
					<caption class="r-sr-only">{countLabel}</caption>
					<thead>
						<tr>
							<th scope="col">MDR №</th>
							<th scope="col">Physician</th>
							<th scope="col">Specialty</th>
							<th scope="col">Country</th>
							<th scope="col">{nmc ? "Status" : "Stature"}</th>
							<th scope="col">H-index</th>
							<th scope="col">Ethics</th>
						</tr>
					</thead>
					<tbody>
						{rows.map((r) => (
							<tr>
								<td class="rg-no">{r.no}</td>
								<th scope="row" class="rg-name"><a href={`/doctors/${r.slug}`}>{r.name}</a></th>
								<td class="rg-spec">{r.specialty}</td>
								<td class="rg-country">{r.country}</td>
								{nmc ? (
									<td class="rg-tier rg-tier--status">{r.status === "HISTORICAL" ? "Historical" : "Living"}</td>
								) : (
									<td class={`rg-tier rg-tier--${r.tier.toLowerCase()}`}>{TIER_LABEL[r.tier] ?? "—"}</td>
								)}
								<td class="rg-h"><span class="rg-label" aria-hidden="true">h </span>{r.hIndex || "—"}</td>
								<td class={`rg-ethics${r.ethics === "—" ? " rg-ethics--none" : ""}`}>{r.ethics}</td>
							</tr>
						))}
					</tbody>
				</table>
				{rows.length === 0 && (
					<p class="rg-empty">No physicians match. Try a broader filter, or <a href="/doctor/add-profile">nominate someone</a>.</p>
				)}
			</div>

			<Pagination page={page} totalPages={totalPages} total={total} pageSize={PAGE_SIZE} label="physicians" />
		</section>
	</div>
</SiteLayout>

<script>
	import { syncCountry } from "../../lib/country-sync";

	syncCountry({ fallbackToGuess: false, reset: ["tier", "sort", "page"] });
</script>
