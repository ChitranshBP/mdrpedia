---
/**
 * MDRPedia — Homepage (claude.ai/design "Home v2").
 * Country-aware: the header's register country (localStorage `mdr-country`)
 * picks which variant of each country-specific block is shown.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/pages/home.css";
import { getCollection } from "astro:content";
import { prisma } from "../lib/prisma";
import { getTierCounts, getCountryStats, getFeaturedTitans } from "../lib/cached-stats";
import { REGISTER_COUNTRIES, regionsFor, type RegisterCountry } from "../lib/places";

export const prerender = false;

const COUNTRIES = Object.keys(REGISTER_COUNTRIES) as RegisterCountry[];

let total = 0;
let countriesCount = 0;
type Titan = { slug: string; full_name: string; specialty: string; h_index: number | null; geography: { country: string; city: string | null } | null };
let titans: Titan[] = [];
try {
	const [tiers, countryStats, featured] = await Promise.all([getTierCounts(), getCountryStats(), getFeaturedTitans(12)]);
	total = tiers.total;
	countriesCount = countryStats.filter((c) => !/^(unknown|global)$/i.test(c.country)).length;
	titans = featured as Titan[];
} catch {
	titans = [];
}

const doctors = await getCollection("doctors");
if (!total) total = doctors.length;
const places = doctors.map((d) => d.data.geography);
const byCountry = Object.fromEntries(
	COUNTRIES.map((c) => {
		const regions = regionsFor(c, places);
		const cities = [...new Set(regions.flatMap((r) => r.cities.map((x) => x.name)))].sort();
		const count = doctors.filter((d) => d.data.geography.country === c).length;
		return [c, { regions, cities, count }];
	})
) as Record<RegisterCountry, { regions: ReturnType<typeof regionsFor>; cities: string[]; count: number }>;

const searchHref = (params: Record<string, string>) => "/search?" + new URLSearchParams(params).toString();

const conditions = [
	{ l: "Heart & chest pain", q: "Cardiology", sp: "cardi" },
	{ l: "Diabetes & thyroid", q: "Endocrinology", sp: "endocrin" },
	{ l: "Breathing & lungs", q: "Pulmonology", sp: "pulmon" },
	{ l: "Joints & back", q: "Orthopedics", sp: "ortho" },
	{ l: "Child health", q: "Pediatrics", sp: "pediatr" },
	{ l: "Pregnancy", q: "Obstetrics", sp: "obstet" },
	{ l: "Cancer", q: "Oncology", sp: "oncolog" },
	{ l: "Stomach & liver", q: "Gastroenterology", sp: "gastro" },
];

const checks = [
	{ n: "I", t: "Registered and qualified", d: "Registration number, licensing council and every degree, checked with the body that issued it.", why: "It confirms the person is legally allowed to treat you." },
	{ n: "II", t: "Keeping up to date", d: "Accredited continuing medical education (CME/CPD) completed in recent years.", why: "Medicine changes quickly, and this shows they're keeping up." },
	{ n: "III", t: "Contribution to medicine", d: "Published research, clinical trials, guidelines written and doctors trained.", why: "It shows other experts rely on their work." },
	{ n: "IV", t: "Trusted by colleagues", d: "Unprompted referrals from other verified doctors, for named conditions.", why: "Doctors know which colleagues they'd send their own family to." },
];

const rules = (nmc: boolean) => [
	{ t: "Paid ranking.", d: "No one can pay to appear higher, or to appear at all." },
	{ t: "Reviews or testimonials.", d: "No star ratings, patient stories or endorsements." },
	nmc ? { t: "\"Best\" or \"No. 1\" claims.", d: "Doctors are listed, never ranked as best." } : { t: "Vanity awards.", d: "Pay-to-enter honours are excluded." },
	{ t: "Success rates and case photos.", d: "No before-and-after images or personal success claims." },
	{ t: "Offers or discounts.", d: "No coupons, free consultations or referral fees." },
];

const docPerks = (nmc: boolean) => [
	"Publications, trials and citations, linked to their sources",
	"CPD credits, conference faculty and teaching roles",
	"Community and public-health work",
	nmc ? "Your NMR/SMR number shown on every page, as NMC rules require" : "Your registration number shown on every page",
];

const titanPlace = (g: Titan["geography"]) => {
	const country = g?.country && !/^(unknown|global)$/i.test(g.country) ? g.country : "";
	return [g?.city, country].filter(Boolean).join(", ");
};

type LedgerRow = { date: string; type: string; record: string; source: string };
let ledger: LedgerRow[] = [];
try {
	const [logs, edits] = await Promise.all([
		prisma.adminLog.findMany({
			where: { NOT: [{ action: { startsWith: "nmc_" } }, { target: { in: ["bulk", "all"] } }] },
			orderBy: { createdAt: "desc" },
			take: 4,
		}),
		prisma.profileEdit.findMany({ where: { status: "APPROVED" }, orderBy: { createdAt: "desc" }, take: 3 }),
	]);
	const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
	const reason = (details: string | null) => {
		try {
			return (details && JSON.parse(details).reason) || "Editorial review";
		} catch {
			return "Editorial review";
		}
	};
	const rows = [
		...logs.map((l) => ({ at: l.createdAt, row: { date: fmt(l.createdAt), type: l.action.replace(/_/g, " ").toLowerCase().replace(/^\w/, (c) => c.toUpperCase()), record: l.target, source: reason(l.details) } })),
		...edits.map((e) => ({ at: e.createdAt, row: { date: fmt(e.createdAt), type: "Correction", record: `${e.field_name} updated · ${e.profile_slug}`, source: e.reason || "Community edit" } })),
	];
	ledger = rows.sort((a, b) => b.at.getTime() - a.at.getTime()).slice(0, 5).map((r) => r.row);
} catch {
	ledger = [];
}

const variants = COUNTRIES.map((c) => {
	const m = REGISTER_COUNTRIES[c];
	const nmc = c === "India";
	return {
		c,
		m,
		nmc,
		data: byCountry[c],
		unitSingular: m.unit.replace(/s$/, ""),
	};
});

const countryData = Object.fromEntries(
	variants.map((v) => [v.c, { cities: v.data.cities, placeholder: v.nmc ? "e.g. NMR ID" : v.m.placeholder }])
);

Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=120, stale-while-revalidate=300");

const site = Astro.site?.origin ?? "https://mdrpedia.com";
const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "Organization",
		name: "MDRPedia",
		alternateName: ["MDpedia", "DRpedia", "MD Pedia", "DR Pedia", "MDR Pedia"],
		url: site,
		sameAs: ["https://twitter.com/mdrpedia"],
		description: "An open, sourced register of physicians. Registration, qualifications, training and contributions to medicine, with no paid rankings, reviews or testimonials.",
		foundingDate: "2024",
		logo: { "@type": "ImageObject", url: `${site}/favicon.svg` },
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "MDRPedia",
		alternateName: ["MDpedia", "DRpedia"],
		url: site,
		potentialAction: {
			"@type": "SearchAction",
			target: { "@type": "EntryPoint", urlTemplate: `${site}/search?q={search_term_string}` },
			"query-input": "required name=search_term_string",
		},
	},
];
---

<SiteLayout
	title="MDRPedia — Find a doctor you can verify"
	description={`Find a doctor you can verify. ${total.toLocaleString("en-US")} physician records checked against official medical registers: registration, qualifications, ongoing training and real contributions to medicine. No paid rankings, reviews or testimonials.`}
	jsonLd={jsonLd}
>
	<div class="home" data-country="India">
		<script is:inline>
			(() => {
				const root = document.currentScript.parentElement;
				const known = ["India", "United States", "United Kingdom"];
				let c = null;
				try { c = localStorage.getItem("mdr-country"); } catch (e) {}
				if (!known.includes(c)) {
					const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
					c = tz.startsWith("America/") ? "United States" : tz === "Europe/London" ? "United Kingdom" : "India";
				}
				root.dataset.country = c;
			})();
		</script>

		<section class="home-hero" aria-labelledby="home-title">
			<div class="home-hero__inner">
				<div class="home-hero__copy">
					{variants.map((v) => <span class="home-eyebrow home-hi" data-for={v.c}>MDRPEDIA · DOCTORS REGISTERED IN {v.c.toUpperCase()}</span>)}
					<h1 id="home-title">Find a doctor <em>you can verify.</em></h1>
					{variants.map((v) => (
						<p class="home-hero__sub" data-for={v.c}>
							Every doctor here is checked against {v.m.register}. We show registration, qualifications, ongoing training and real contributions to
							medicine. We have no paid rankings, reviews or testimonials.
						</p>
					))}

					<form class="home-search" action="/search" method="get" role="search" data-search>
						<label class="home-search__field home-search__field--cond">
							<span>What do you need help with?</span>
							<input name="q" type="search" placeholder="e.g. chest pain, diabetes, knee" autocomplete="off" />
						</label>
						<label class="home-search__field home-search__field--city">
							<span>City</span>
							<select name="city" data-city>
								<option value="" data-all>All of India</option>
								{byCountry.India.cities.map((c) => <option value={c}>{c}</option>)}
							</select>
						</label>
						<input type="hidden" name="country" value="India" data-country-input />
						<button type="submit" class="home-search__go">Search</button>
					</form>

					<nav class="home-conds" aria-label="Common reasons to see a doctor">
						{conditions.map((c) => (
							<a href={searchHref({ q: c.q, specialty: c.sp, country: "India" })} data-cond={JSON.stringify({ q: c.q, specialty: c.sp })}>{c.l}</a>
						))}
					</nav>

					<p class="home-facts">
						{total.toLocaleString("en-US")} PHYSICIAN RECORDS · {countriesCount} COUNTRIES ·
						{variants.map((v) => <span data-for={v.c}> {v.data.count.toLocaleString("en-US")} IN {v.c.toUpperCase()}</span>)}
					</p>
				</div>

				<div class="home-reg">
					<span class="home-reg__kicker home-hi">CHECK A REGISTRATION</span>
					<h2 class="home-reg__title">Is your doctor registered?</h2>
					{variants.map((v) => (
						<p class="home-reg__help" data-for={v.c}>
							{v.c === "United States"
								? `Enter an NPI number to check it live against the federal NPPES registry.`
								: `Enter a registration number and we'll point you to ${v.m.register} to confirm it.`}
						</p>
					))}
					<form class="home-reg__form" data-reg>
						<label class="r-sr-only" for="home-reg-number">Registration number</label>
						<input id="home-reg-number" name="number" inputmode="text" autocomplete="off" required minlength="3" maxlength="30" placeholder="e.g. NMR ID" data-reg-input />
						<button type="submit">Check</button>
					</form>
					<div class="home-reg__result" data-reg-result role="status" aria-live="polite" hidden></div>
				</div>
			</div>
		</section>

		<section class="home-sec" aria-labelledby="home-records">
			<div class="home-sec__rule">
				<div class="home-sec__head">
					<div>
						<span class="home-num">№ 01 · FOR PATIENTS</span>
						<h2 id="home-records">What every record tells you</h2>
					</div>
					<p>In plain words: what we check, and why it matters when you choose a doctor.</p>
				</div>
				<div class="home-checks">
					{checks.map((c) => (
						<article class="home-check">
							<span class="home-check__n" aria-hidden="true">{c.n}</span>
							<h3>{c.t}</h3>
							<p>{c.d}</p>
							<p class="home-check__why"><strong>Why it matters:</strong> {c.why}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="home-sec home-sec--pair" aria-label="For doctors">
			<div class="home-sec__rule home-pair">
				<div class="home-doctors">
					<span class="home-num home-hi">№ 02 · FOR DOCTORS</span>
					<h2>Your work, on the record</h2>
					<p>
						Claim your profile to showcase your publications, trials, CPD, teaching and community work. You can also publish health-education
						articles. Every item is either verified by us or clearly marked as added by you.
					</p>
					{variants.map((v) => (
						<ul class="home-perks" data-for={v.c}>
							{docPerks(v.nmc).map((p) => <li>{p}</li>)}
						</ul>
					))}
					<div class="home-doctors__ctas">
						<a href="/doctor/claim" class="home-btn home-btn--hi">Claim your profile</a>
						<a href="/doctors/devi-shetty" class="home-btn home-btn--ghost">See an example profile</a>
					</div>
					<a href="/nmc-compliance-check" class="home-doctors__nmc">Free: check your website and social posts against the NMC guidelines →</a>
				</div>
				{variants.map((v) => (
					<div class="home-rules" data-for={v.c}>
						<span class="home-num">{v.nmc ? "BUILT FOR THE NMC ADVERTISING GUIDELINES · OCT 2026" : "WHAT YOU WON'T FIND HERE"}</span>
						<h2>{v.nmc ? "What MDRPedia will never show" : "No noise, by design"}</h2>
						<ul>
							{rules(v.nmc).map((r) => (
								<li><span class="home-rules__x" aria-hidden="true">✕</span><span><strong>{r.t}</strong> <span class="home-muted">{r.d}</span></span></li>
							))}
						</ul>
						<a href="/about#methodology">How we measure instead →</a>
					</div>
				))}
			</div>
		</section>

		<section class="home-sec" aria-label="Browse by place">
			<div class="home-sec__rule">
				{variants.map((v) => (
					<div class="home-sec__head" data-for={v.c}>
						<div>
							<span class="home-num">№ 03 · BY PLACE</span>
							<h2>Browse {v.c} by {v.unitSingular}</h2>
						</div>
						<a href={`/geography/${v.m.slug}`}>All of {v.c} →</a>
					</div>
				))}
				{variants.map((v) => (
					v.data.regions.length > 0 ? (
						<ul class="home-states" data-for={v.c}>
							{v.data.regions.map((r) => (
								<li class="home-state">
									<span class="home-state__name">{r.name}</span>
									<span class="home-state__cities">
										{r.cities.map((city, i) => (
											<>{i > 0 && " · "}<a href={searchHref({ q: city.name, city: city.name, country: v.c })}>{city.name}</a></>
										))}
									</span>
									<span class="home-state__count">{r.count} {r.count === 1 ? "doctor" : "doctors"} on record</span>
								</li>
							))}
						</ul>
					) : (
						<p class="home-muted" data-for={v.c}>No doctors in {v.c} have a recorded city yet. <a href={`/geography/${v.m.slug}`}>See all doctors in {v.c} →</a></p>
					)
				))}
			</div>
		</section>

		{titans.length > 0 && (
			<section class="home-sec" aria-labelledby="home-titans">
				<div class="home-sec__rule">
					<div class="home-sec__head">
						<div>
							<span class="home-num">№ 04 · THE TITANS</span>
							<h2 id="home-titans">Tier I of the Register</h2>
						</div>
						<a href="/rankings">All tiers →</a>
					</div>
					<ul class="home-titans">
						{titans.map((t, i) => (
							<li>
								<a href={`/doctors/${t.slug}`} class="home-titan">
									<span class="home-titan__top"><span>№ {String(i + 1).padStart(2, "0")}</span><span>TITAN</span></span>
									<span class="home-titan__name">{t.full_name}</span>
									<span class="home-titan__meta">{[t.specialty, titanPlace(t.geography)].filter(Boolean).join(" · ")}</span>
									{t.h_index ? (
										<span class="home-titan__h"><span>h-index</span><span class="r-mono">{t.h_index}</span></span>
									) : null}
								</a>
							</li>
						))}
					</ul>
					<a href="/rankings" class="home-btn home-btn--deep">Open the full Register →</a>
				</div>
			</section>
		)}

		{ledger.length > 0 && (
			<section class="home-sec home-sec--last" aria-labelledby="home-ledger">
				<div class="home-sec__rule">
					<div class="home-sec__head">
						<div>
							<span class="home-num">№ 05 · VERIFICATION LEDGER</span>
							<h2 id="home-ledger">Corrections, in public</h2>
						</div>
						<span class="home-live">● LATEST EDITORIAL ACTIONS</span>
					</div>
					<div class="home-ledger" tabindex="0" role="region" aria-label="Verification ledger">
						<table>
							<thead><tr><th scope="col">DATE</th><th scope="col">TYPE</th><th scope="col">RECORD</th><th scope="col">SOURCE</th></tr></thead>
							<tbody>
								{ledger.map((e) => (
									<tr><td class="r-mono">{e.date}</td><td><strong>{e.type}</strong></td><td>{e.record}</td><td class="home-muted">{e.source}</td></tr>
								))}
							</tbody>
						</table>
					</div>
				</div>
			</section>
		)}
	</div>

	<script is:inline type="application/json" id="home-country-data" set:html={JSON.stringify(countryData)} />
</SiteLayout>

<script>
	type CountryData = Record<string, { cities: string[]; placeholder: string }>;
	type RegResponse = {
		success: boolean;
		error?: string;
		status?: "active" | "inactive" | "not_found" | "invalid" | "external";
		message?: string;
		name?: string;
		detail?: string;
		profile?: { slug: string; name: string } | null;
		officialUrl?: string;
	};

	const root = document.querySelector<HTMLElement>(".home");
	const data: CountryData = JSON.parse(document.getElementById("home-country-data")?.textContent || "{}");
	const KNOWN = Object.keys(data);

	const currentCountry = () => {
		try {
			const c = localStorage.getItem("mdr-country");
			if (c && KNOWN.includes(c)) return c;
		} catch {}
		return root?.dataset.country || "India";
	};

	const searchForm = document.querySelector<HTMLFormElement>("[data-search]");
	const citySelect = document.querySelector<HTMLSelectElement>("[data-city]");
	const countryInput = document.querySelector<HTMLInputElement>("[data-country-input]");
	const regInput = document.querySelector<HTMLInputElement>("[data-reg-input]");
	const regForm = document.querySelector<HTMLFormElement>("[data-reg]");
	const regResult = document.querySelector<HTMLElement>("[data-reg-result]");

	function applyCountry(c: string) {
		if (!root || !data[c]) return;
		root.dataset.country = c;
		if (countryInput) countryInput.value = c;
		if (citySelect) {
			citySelect.replaceChildren(new Option(`All of ${c}`, ""), ...data[c].cities.map((city) => new Option(city, city)));
		}
		if (regInput) regInput.placeholder = data[c].placeholder;
		if (regResult) {
			regResult.hidden = true;
			regResult.replaceChildren();
		}
		document.querySelectorAll<HTMLAnchorElement>("[data-cond]").forEach((a) => {
			const p = JSON.parse(a.dataset.cond || "{}");
			a.href = "/search?" + new URLSearchParams({ ...p, country: c }).toString();
		});
	}

	applyCountry(currentCountry());
	window.addEventListener("mdr-country", () => applyCountry(currentCountry()));

	searchForm?.addEventListener("submit", (e) => {
		const q = searchForm.elements.namedItem("q") as HTMLInputElement;
		const city = citySelect?.value || "";
		if (q.value.trim().length >= 2) return;
		e.preventDefault();
		const params = new URLSearchParams({ q: city || currentCountry(), country: currentCountry() });
		if (city) params.set("city", city);
		location.href = "/search?" + params.toString();
	});

	function line(tag: "strong" | "span", text: string, cls?: string) {
		const el = document.createElement(tag);
		el.textContent = text;
		if (cls) el.className = cls;
		return el;
	}

	function link(href: string, text: string, external = false) {
		const a = document.createElement("a");
		a.href = href;
		a.textContent = text;
		if (external) {
			a.target = "_blank";
			a.rel = "noopener noreferrer";
		}
		return a;
	}

	regForm?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!regInput || !regResult) return;
		const number = regInput.value.trim();
		if (number.length < 3) return;
		const button = regForm.querySelector("button");
		button?.setAttribute("disabled", "");
		regResult.hidden = false;
		regResult.dataset.tone = "wait";
		regResult.replaceChildren(line("span", "Checking…"));
		try {
			const res = await fetch("/api/registration-check?" + new URLSearchParams({ country: currentCountry(), number }));
			const body: RegResponse = await res.json();
			if (!res.ok || !body.success) throw new Error(body.error || (res.status === 429 ? "Too many checks. Wait a minute and try again." : "Check failed"));
			const parts: HTMLElement[] = [];
			if (body.status === "active" || body.status === "inactive") {
				regResult.dataset.tone = body.status === "active" ? "ok" : "warn";
				parts.push(line("strong", body.status === "active" ? "✓ Registered · Active" : "Registered · Deactivated"));
				parts.push(line("span", `${body.name}${body.detail ? " · " + body.detail : ""}`));
				if (body.profile) parts.push(link(`/doctors/${body.profile.slug}`, `View ${body.profile.name} on MDRPedia →`));
			} else {
				regResult.dataset.tone = "warn";
				parts.push(line("strong", body.status === "not_found" ? "Not found" : body.status === "invalid" ? "Check the number" : "Confirm with the official register"));
				if (body.message) parts.push(line("span", body.message));
			}
			if (body.officialUrl) parts.push(link(body.officialUrl, "Open the official register ↗", true));
			regResult.replaceChildren(...parts);
		} catch (err) {
			regResult.dataset.tone = "warn";
			regResult.replaceChildren(line("strong", "Couldn't check right now"), line("span", err instanceof Error ? err.message : "Try again shortly."));
		} finally {
			button?.removeAttribute("disabled");
		}
	});
</script>
