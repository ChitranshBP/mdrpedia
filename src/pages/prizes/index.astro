---
export const prerender = true;
/**
 * MDRPedia — Awards & Honors Directory
 * Comprehensive catalog of medical awards organized by prestige tier
 */
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/pages/feed.css";
import { getCollection } from "astro:content";
import { HonorTier, GLOBAL_HONORS_DB } from "../../lib/global-honors";

// Get prizes from content collection
const prizes = await getCollection("prizes");

// Get all doctors to count recipients
const doctors = await getCollection("doctors");

// Count recipients for each prize
function countRecipients(prizeName: string): number {
    const normalizedPrize = prizeName.toLowerCase();
    return doctors.filter(d =>
        d.data.awards?.some(a => {
            const awardName = (a as any).name || a;
            return awardName?.toLowerCase().includes(normalizedPrize);
        })
    ).length;
}

// Organize prizes by tier
interface PrizeWithMeta {
    id: string;
    name: string;
    description: string;
    category: string;
    image?: string;
    tier: HonorTier;
    tierLabel: string;
    recipientCount: number;
}

const TIER_LABEL: Record<HonorTier, string> = {
    [HonorTier.GLOBAL_LANDMARK]: 'Global Landmark',
    [HonorTier.NATIONAL_HONOR]: 'National Honor',
    [HonorTier.PROFESSIONAL_EXCELLENCE]: 'Professional Excellence',
    [HonorTier.UNCLASSIFIED]: 'Other Awards',
};

// Map content prizes to display format with tier info
const prizeList: PrizeWithMeta[] = prizes.map(p => {
    // Find matching honor in database
    const normalizedName = p.data.name.toLowerCase();
    const matchedHonor = GLOBAL_HONORS_DB.find(h =>
        normalizedName.includes(h.name.toLowerCase()) ||
        h.name.toLowerCase().includes(normalizedName)
    );

    const tier = matchedHonor?.tier || HonorTier.UNCLASSIFIED;

    return {
        id: p.id,
        name: p.data.name,
        description: p.data.description,
        category: p.data.category,
        image: p.data.image,
        tier,
        tierLabel: TIER_LABEL[tier],
        recipientCount: countRecipients(p.data.name),
    };
});

// Group by tier
const groupedPrizes = {
    [HonorTier.GLOBAL_LANDMARK]: prizeList.filter(p => p.tier === HonorTier.GLOBAL_LANDMARK),
    [HonorTier.NATIONAL_HONOR]: prizeList.filter(p => p.tier === HonorTier.NATIONAL_HONOR),
    [HonorTier.PROFESSIONAL_EXCELLENCE]: prizeList.filter(p => p.tier === HonorTier.PROFESSIONAL_EXCELLENCE),
    [HonorTier.UNCLASSIFIED]: prizeList.filter(p => p.tier === HonorTier.UNCLASSIFIED),
};

// Stats
const totalPrizes = prizes.length;
const totalRecipients = prizeList.reduce((sum, p) => sum + p.recipientCount, 0);

const sections = [
    { id: 'global-landmark', tier: HonorTier.GLOBAL_LANDMARK, title: 'Global Landmark awards', note: 'Paradigm-defining recognition for contributions to medicine worldwide.' },
    { id: 'national-honor', tier: HonorTier.NATIONAL_HONOR, title: 'National honors', note: 'State-level recognition honoring outstanding medical service.' },
    { id: 'professional-excellence', tier: HonorTier.PROFESSIONAL_EXCELLENCE, title: 'Professional excellence', note: 'Peer-recognized achievements in specialized medical fields.' },
    { id: 'other-awards', tier: HonorTier.UNCLASSIFIED, title: 'Other awards', note: 'Awards on record that are not yet placed in a tier.' },
].map((sec) => ({ ...sec, items: groupedPrizes[sec.tier] })).filter((sec) => sec.items.length > 0);

function blurb(text: string): string {
    return text.length > 110 ? `${text.slice(0, 110).trimEnd()}…` : text;
}
---

<SiteLayout
    title="Awards & Honors — MDRPedia"
    description="Explore the most prestigious awards in medicine, from Nobel Prizes to national honors. Discover the physicians who have shaped medical history."
    active=""
>
    <div class="fd">
        <header class="fd-wrap fd-hero">
            <span class="fd-eyebrow">Awards &amp; honors</span>
            <h1>Excellence in Medicine</h1>
            <p>
                The awards MDRPedia tracks, from Nobel laureates to national honors, and the
                physicians in the register who received them.
            </p>
            <ul class="fd-stats">
                <li><b>{totalPrizes}</b><span>Awards tracked</span></li>
                <li><b>{totalRecipients}</b><span>Recipients in register</span></li>
            </ul>
        </header>

        <div class="fd-wrap fd-main">
            {sections.length > 1 && (
                <nav class="fd-seg" aria-label="Jump to a tier">
                    {sections.map((sec) => (
                        <a href={`#${sec.id}`}>{sec.title} <span class="n">{sec.items.length}</span></a>
                    ))}
                </nav>
            )}

            {sections.map((sec) => (
                <section id={sec.id} class="fd-sec" aria-labelledby={`${sec.id}-h`}>
                    <div class="fd-sec__head">
                        <div>
                            <h2 id={`${sec.id}-h`}>{sec.title}</h2>
                            <p>{sec.note}</p>
                        </div>
                        <span class="fd-count">{sec.items.length} award{sec.items.length !== 1 ? 's' : ''}</span>
                    </div>
                    <ul class="fd-grid">
                        {sec.items.map((prize) => (
                            <li class="fd-card">
                                <div class="fd-card__img">
                                    <span aria-hidden="true">{prize.name[0]}</span>
{prize.image && <img src={prize.image} alt="" loading="lazy" onerror="this.remove()" />}
                                </div>
                                <div>
                                    <h3><a href={`/prizes/${prize.id}`}>{prize.name}</a></h3>
                                    <p>{blurb(prize.description)}</p>
                                    <span class="m">{prize.recipientCount} recipient{prize.recipientCount !== 1 ? 's' : ''} in register</span>
                                </div>
                            </li>
                        ))}
                    </ul>
                </section>
            ))}

            {totalPrizes === 0 && (
                <p class="fd-empty">The awards database is being compiled. We are continuously adding awards and their recipients.</p>
            )}

            <section class="fd-sec" aria-labelledby="tiers-h">
                <div class="fd-sec__head">
                    <div>
                        <h2 id="tiers-h">How awards are tiered</h2>
                        <p>
                            Awards are placed in tiers by recognition and historical significance. Honours
                            count toward a physician's score, and the top two tiers set a floor under their stature;
                            see the <a href="/methodology">methodology</a>.
                        </p>
                    </div>
                </div>
                <div class="fd-tiers">
                    <div class="fd-tier">
                        <span class="tag">Tier I</span>
                        <h3>Global Landmark</h3>
                        <p>Paradigm-defining awards such as the Nobel Prize, Lasker Award, Wolf Prize and Breakthrough Prize. Holders are never placed below Elite.</p>
                    </div>
                    <div class="fd-tier">
                        <span class="tag">Tier II</span>
                        <h3>National Honor</h3>
                        <p>Government recognition for exceptional medical service, such as the Padma awards, the Presidential Medal of Freedom and knighthoods. Holders are never placed below Elite.</p>
                    </div>
                    <div class="fd-tier">
                        <span class="tag">Tier III</span>
                        <h3>Professional Excellence</h3>
                        <p>Peer-recognized achievements in specialized fields: specialty society awards, research prizes and academy memberships.</p>
                    </div>
                </div>
            </section>

            <section class="fd-panel" aria-labelledby="suggest-h">
                <div>
                    <h3 id="suggest-h">Know an award we should track?</h3>
                    <p>Help us build a complete record of medical awards.</p>
                </div>
                <a href="/contact?subject=suggest-award" class="fd-btn">Suggest an award</a>
            </section>
        </div>
    </div>
</SiteLayout>
