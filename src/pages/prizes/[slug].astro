---
/**
 * MDRPedia — Individual Award Page
 * Premium display of award details and recipients
 */
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/pages/feed.css";
import { getCollection } from "astro:content";
import { HonorTier, classifyAward } from "../../lib/global-honors";

export const prerender = true;

export async function getStaticPaths() {
    const prizes = await getCollection("prizes");
    return prizes.map((prize) => ({
        params: { slug: prize.id },
        props: { prize },
    }));
}

const { prize } = Astro.props;
const allDoctors = await getCollection("doctors");

// Classify this award
const classification = classifyAward(prize.data.name);
const TIER_LABEL: Record<HonorTier, string> = {
    [HonorTier.GLOBAL_LANDMARK]: 'Global Landmark',
    [HonorTier.NATIONAL_HONOR]: 'National Honor',
    [HonorTier.PROFESSIONAL_EXCELLENCE]: 'Professional Excellence',
    [HonorTier.UNCLASSIFIED]: 'Award',
};
const TIER_ORDINAL: Record<HonorTier, string> = {
    [HonorTier.GLOBAL_LANDMARK]: 'Tier I',
    [HonorTier.NATIONAL_HONOR]: 'Tier II',
    [HonorTier.PROFESSIONAL_EXCELLENCE]: 'Tier III',
    [HonorTier.UNCLASSIFIED]: 'Unclassified',
};

const tierLabel = TIER_LABEL[classification.tier];

const STATURE_LABEL: Record<string, string> = { TITAN: 'Titan', ELITE: 'Elite', MASTER: 'Master' };

// Helper to safely extract award name from either string or object entries
type AwardEntry = { name: string; year?: number; contribution?: string; issuingBody?: string } | string;
function getAwardName(award: AwardEntry): string {
    return typeof award === 'string' ? award : award.name;
}
function getAwardYear(award: AwardEntry): number {
    return typeof award === 'object' ? (award.year || 0) : 0;
}
function getAwardContribution(award: AwardEntry): string | undefined {
    return typeof award === 'object' ? award.contribution : undefined;
}

// Find winners
const winners = allDoctors.filter((doctor) => {
    // Check strict manual list
    if (prize.data.winners.includes(doctor.id)) return true;

    // Check awards array in doctor profile
    const awards = (doctor.data.awards || []) as AwardEntry[];
    return awards.some((award) => {
        return getAwardName(award)?.toLowerCase().includes(prize.data.name.toLowerCase());
    });
});

// Sort winners by year (if available) or ranking score
const sortedWinners = winners.sort((a, b) => {
    const getYear = (d: typeof winners[0]) => {
        const awards = (d.data.awards || []) as AwardEntry[];
        const award = awards.find((a) =>
            getAwardName(a)?.toLowerCase().includes(prize.data.name.toLowerCase())
        );
        return award ? getAwardYear(award) : 0;
    };

    const yearA = getYear(a);
    const yearB = getYear(b);

    if (yearA !== yearB) return yearB - yearA; // Newest first
    return (b.data.rankingScore || 0) - (a.data.rankingScore || 0);
});

// Get years range
const years = sortedWinners.map(w => {
    const awards = (w.data.awards || []) as AwardEntry[];
    const award = awards.find((a) =>
        getAwardName(a)?.toLowerCase().includes(prize.data.name.toLowerCase())
    );
    return award ? getAwardYear(award) : 0;
}).filter(Boolean);

const earliestYear = years.length > 0 ? Math.min(...years) : null;
const latestYear = years.length > 0 ? Math.max(...years) : null;

// Find related awards in the same category
const allPrizes = await getCollection("prizes");
const relatedPrizes = allPrizes
    .filter(p => p.id !== prize.id && p.data.category === prize.data.category)
    .slice(0, 3);

const awardFor = (doctor: (typeof winners)[number]) =>
    ((doctor.data.awards || []) as AwardEntry[]).find((a) =>
        getAwardName(a)?.toLowerCase().includes(prize.data.name.toLowerCase())
    );
const isNmc = (doctor: (typeof winners)[number]) => doctor.data.geography?.country === 'India';
---

<SiteLayout
    title={`${prize.data.name} — MDRPedia`}
    description={`Learn about the ${prize.data.name} and discover the medical pioneers who have received this prestigious honor.`}
    active=""
>
    <div class="fd">
        <header class="fd-wrap fd-hero">
            <nav class="fd-crumbs" aria-label="Breadcrumb">
                <a href="/prizes">Awards &amp; Honors</a><span aria-hidden="true">/</span><span aria-current="page">{prize.data.name}</span>
            </nav>
            <div class="fd-prizehead">
                <div class="fd-prizehead__img">
                    <span aria-hidden="true">{prize.data.name[0]}</span>
{prize.data.image && <img src={prize.data.image} alt="" loading="lazy" onerror="this.remove()" />}
                </div>
                <div class="fd-prizehead__copy">
                    <span class="fd-eyebrow">{tierLabel} · {prize.data.category}</span>
                    <h1>{prize.data.name}</h1>
                    <p>{prize.data.description}</p>
                    <ul class="fd-stats">
                        <li><b>{sortedWinners.length}</b><span>Recipients in register</span></li>
                        {earliestYear && latestYear && (
                            <li><b>{earliestYear === latestYear ? earliestYear : `${earliestYear}–${latestYear}`}</b><span>Years tracked</span></li>
                        )}
                        <li><b>{TIER_ORDINAL[classification.tier]}</b><span>Award tier</span></li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="fd-wrap fd-main">
            <section class="fd-sec" aria-labelledby="recipients-h">
                <div class="fd-sec__head">
                    <h2 id="recipients-h">Laureates &amp; recipients</h2>
                    <span class="fd-count">{sortedWinners.length} in register</span>
                </div>

                {sortedWinners.length > 0 ? (
                    <ul class="fd-recips">
                        {sortedWinners.map((doctor) => {
                            const award = awardFor(doctor);
                            const year = award ? getAwardYear(award) : undefined;
                            const contribution = award ? getAwardContribution(award) : undefined;
                            const stature = !isNmc(doctor) ? STATURE_LABEL[doctor.data.tier] : undefined;

                            return (
                                <li class="fd-recip">
                                    <span class="yr">{year || ''}</span>
                                    <div class="fd-card__img">
                                        <span aria-hidden="true">{doctor.data.fullName[0]}</span>
{doctor.data.portraitUrl && <img src={doctor.data.portraitUrl} alt="" loading="lazy" onerror="this.remove()" />}
                                    </div>
                                    <div class="who">
                                        <h3>
                                            <a href={`/doctors/${doctor.id}`}>{doctor.data.fullName}</a>
                                            {stature && <span class={`fd-stature fd-stature--${doctor.data.tier.toLowerCase()}`}>{stature}</span>}
                                        </h3>
                                        <p>{doctor.data.specialty}</p>
                                        {contribution ? (
                                            <p class="quote">"{contribution}"</p>
                                        ) : doctor.data.aiSummary ? (
                                            <p>{doctor.data.aiSummary.slice(0, 120)}…</p>
                                        ) : null}
                                    </div>
                                    <div class="side">
                                        <span>{doctor.data.geography.country}</span>
                                        {doctor.data.hIndex > 0 && <span>h-index {doctor.data.hIndex}</span>}
                                    </div>
                                </li>
                            );
                        })}
                    </ul>
                ) : (
                    <p class="fd-empty">
                        No recipients found in the register. We are continuously updating our records.
                        Know someone who received this award? <a href="/contact?subject=suggest-recipient">Suggest a recipient</a>.
                    </p>
                )}
            </section>

            {relatedPrizes.length > 0 && (
                <section class="fd-sec" aria-labelledby="related-h">
                    <div class="fd-sec__head"><h2 id="related-h">Related awards</h2></div>
                    <ul class="fd-grid">
                        {relatedPrizes.map((rp) => (
                            <li class="fd-card">
                                <div class="fd-card__img">
                                    <span aria-hidden="true">{rp.data.name[0]}</span>{rp.data.image && <img src={rp.data.image} alt="" loading="lazy" onerror="this.remove()" />}
                                </div>
                                <div>
                                    <h3><a href={`/prizes/${rp.id}`}>{rp.data.name}</a></h3>
                                    <p>{rp.data.category}</p>
                                </div>
                            </li>
                        ))}
                    </ul>
                </section>
            )}

            <section class="fd-panel" aria-labelledby="cta-h">
                <div>
                    <h3 id="cta-h">Know a recipient?</h3>
                    <p>Help us document the complete history of this award by suggesting physicians who have received it.</p>
                </div>
                <a href={`/contact?subject=suggest-recipient&award=${encodeURIComponent(prize.data.name)}`} class="fd-btn">Suggest a recipient</a>
            </section>
        </div>
    </div>
</SiteLayout>
