---
/**
 * MDRPedia — Open Data Dashboard
 * Live statistics drawn from the database.
 * SSR only (prerender = false) so numbers are always fresh.
 */
import "../styles/pages/directory.css";
import SiteLayout from "../layouts/SiteLayout.astro";
import { prisma } from "../lib/prisma";
import { getCountryStats } from "../lib/cached-stats";

export const prerender = false;

/* ── helpers ────────────────────────────────────────────────── */
const pct = (n: number, total: number) =>
	total === 0 ? "0" : ((n / total) * 100).toFixed(1);

const fmtMonth = (d: Date) =>
	d.toLocaleDateString("en-US", { year: "numeric", month: "short" });

/* ── data fetches ───────────────────────────────────────────── */
const now = new Date();
const twelveMonthsAgo = new Date(now.getFullYear(), now.getMonth() - 11, 1);

let tierCounts: { tier: string; _count: { _all: number } }[] = [];
let countryCounts: { country: string; count: number }[] = [];
let specialtyCounts: { specialty: string; _count: { _all: number } }[] = [];
let ethicsCounts: { ethics_tier: string; _count: { _all: number } }[] = [];
let totalProfiles = 0;
let countryTotal = 0;
let portraitCount = 0;
let hIndexCount = 0;
let biographyCount = 0;
let growthRaw: { month: Date; count: number }[] = [];

try {
	const [
		_tierCounts,
		_countryCounts,
		_specialtyCounts,
		_ethicsCounts,
		_totalProfiles,
		_portraitCount,
		_hIndexCount,
		_biographyCount,
		_growthRaw,
	] = await Promise.all([
		prisma.profile.groupBy({
			by: ["tier"],
			_count: { _all: true },
		}),
		getCountryStats(),
		prisma.profile.groupBy({
			by: ["specialty"],
			_count: { _all: true },
			orderBy: { _count: { specialty: "desc" } },
			take: 20,
		}),
		prisma.profile.groupBy({
			by: ["ethics_tier"],
			_count: { _all: true },
			where: { ethics_tier: { not: null } },
		}),
		prisma.profile.count(),
		prisma.profile.count({ where: { portrait_url: { not: null } } }),
		prisma.profile.count({ where: { h_index: { gt: 0 } } }),
		prisma.profile.count({ where: { biography: { not: null } } }),
		prisma.$queryRaw<{ month: Date; count: number }[]>`
			SELECT date_trunc('month', "createdAt") AS month, COUNT(*)::int AS count
			FROM profiles
			WHERE "createdAt" >= ${twelveMonthsAgo}
			GROUP BY 1
			ORDER BY 1`,
	]);

	tierCounts = _tierCounts as typeof tierCounts;
	countryTotal = _countryCounts.length;
	countryCounts = _countryCounts.slice(0, 20);
	specialtyCounts = _specialtyCounts as typeof specialtyCounts;
	ethicsCounts = _ethicsCounts as typeof ethicsCounts;
	totalProfiles = _totalProfiles;
	portraitCount = _portraitCount;
	hIndexCount = _hIndexCount;
	biographyCount = _biographyCount;
	growthRaw = _growthRaw;
} catch (e) {
	// If DB is unavailable every array stays empty — the page renders gracefully.
	console.error("Statistics page DB error:", e);
}

/* ── derived data ───────────────────────────────────────────── */

// Tier map
const tierMap: Record<string, number> = { TITAN: 0, ELITE: 0, MASTER: 0, UNRANKED: 0 };
for (const t of tierCounts) tierMap[t.tier] = t._count._all;
const tierTotal = Object.values(tierMap).reduce((a, b) => a + b, 0);

// Country max for bar scaling
const countryMax = countryCounts.length > 0 ? countryCounts[0].count : 1;

// Specialty max for bar scaling
const specMax = specialtyCounts.length > 0 ? specialtyCounts[0]._count._all : 1;

// Ethics
const ethicsMap: Record<string, number> = { LEGEND: 0, GUARDIAN: 0, ADVOCATE: 0 };
for (const e of ethicsCounts) {
	if (e.ethics_tier in ethicsMap) ethicsMap[e.ethics_tier] = e._count._all;
}
const ethicsTotal = Object.values(ethicsMap).reduce((a, b) => a + b, 0);

// Growth — bucket by month
const monthKey = (y: number, m: number) => `${y}-${String(m + 1).padStart(2, "0")}`;
const growthByMonth = new Map(
	growthRaw.map((r) => [monthKey(r.month.getUTCFullYear(), r.month.getUTCMonth()), Number(r.count)])
);
const growthBuckets: { label: string; count: number }[] = [];
for (let i = 11; i >= 0; i--) {
	const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
	growthBuckets.push({
		label: fmtMonth(d),
		count: growthByMonth.get(monthKey(d.getFullYear(), d.getMonth())) ?? 0,
	});
}
const growthMax = Math.max(...growthBuckets.map((b) => b.count), 1);

// Data quality
const quality = [
	{ label: "Portrait image", count: portraitCount, pct: pct(portraitCount, totalProfiles) },
	{ label: "h-index recorded", count: hIndexCount, pct: pct(hIndexCount, totalProfiles) },
	{ label: "Biography written", count: biographyCount, pct: pct(biographyCount, totalProfiles) },
];

const tierLabel: Record<string, string> = { TITAN: "Titan", ELITE: "Elite", MASTER: "Master", UNRANKED: "Unranked" };
const ethicsLabel: Record<string, string> = { LEGEND: "Legend", GUARDIAN: "Guardian", ADVOCATE: "Advocate" };

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Home", item: "https://mdrpedia.com/" },
			{ "@type": "ListItem", position: 2, name: "Open Data Dashboard", item: "https://mdrpedia.com/statistics" },
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "Dataset",
		name: "MDRPedia Open Data Dashboard",
		description: "Aggregated, anonymized statistics about the MDRPedia physician registry — tier distribution, country coverage, specialty breakdown, ethics programme participation, growth trends, and data-quality metrics.",
		url: "https://mdrpedia.com/statistics",
		license: "https://creativecommons.org/licenses/by-sa/4.0/",
		creator: { "@type": "Organization", name: "MDRPedia", url: "https://mdrpedia.com" },
		temporalCoverage: `2024/${now.getFullYear()}`,
		variableMeasured: [
			"Physician tier distribution",
			"Country coverage",
			"Specialty distribution",
			"Ethics certification status",
			"Monthly profile growth",
			"Data completeness",
		],
	},
];

const refreshedAt = now.toISOString();

Astro.response.headers.set(
	"Cache-Control",
	"public, max-age=300, s-maxage=600, stale-while-revalidate=600"
);
---

<SiteLayout
	title="Open Data Dashboard — MDRPedia"
	description="Explore MDRPedia's open data: physician distributions by tier, country, specialty, and ethics status."
	active="evidence"
	jsonLd={jsonLd}
>
	<div class="dx">
		<header class="dx-hero">
			<div class="dx-hero__inner">
				<span class="dx-eyebrow">OPEN DATA · CC-BY-SA 4.0</span>
				<h1>Open data dashboard</h1>
				<p class="dx-lede">
					Aggregate counts drawn from the MDRPedia database for {totalProfiles.toLocaleString()} physician profiles, refreshed every few minutes and licensed CC-BY-SA 4.0.
				</p>
				<p class="dx-count">
					Data refreshed <time datetime={refreshedAt}>{now.toLocaleString("en-US", { dateStyle: "long", timeStyle: "short" })}</time>{" "}
					· {totalProfiles.toLocaleString()} profiles · {countryTotal} countries
				</p>
			</div>
		</header>

		<div class="dx-main">
			<section class="dx-section" aria-labelledby="s-tier">
				<h2 id="s-tier">Tier distribution</h2>
				<p class="dx-count">{tierTotal.toLocaleString()} total profiles</p>
				<div class="dx-figs">
					{(["TITAN", "ELITE", "MASTER", "UNRANKED"] as const).map((key) => (
						<div class="dx-fig">
							<span>{tierLabel[key]}</span>
							<b>{tierMap[key].toLocaleString()}</b>
							<span>{pct(tierMap[key], tierTotal)}%</span>
						</div>
					))}
				</div>
			</section>

			<section class="dx-section" aria-labelledby="s-country">
				<h2 id="s-country">Country distribution</h2>
				<p class="dx-count">Top 20 by profile count</p>
				{countryCounts.length > 0 ? (
					<ol class="dx-bars">
						{countryCounts.map((c) => (
							<li class="dx-bar">
								<span class="dx-bar__label">{c.country}</span>
								<span class="dx-bar__track"><span class="dx-bar__fill" style={`width: ${(c.count / countryMax) * 100}%`}></span></span>
								<span class="dx-bar__n">{c.count.toLocaleString()}</span>
							</li>
						))}
					</ol>
				) : <p class="dx-empty">No country data available.</p>}
			</section>

			<section class="dx-section" aria-labelledby="s-spec">
				<h2 id="s-spec">Specialty distribution</h2>
				<p class="dx-count">Top 20 by profile count</p>
				{specialtyCounts.length > 0 ? (
					<ol class="dx-bars">
						{specialtyCounts.map((s) => (
							<li class="dx-bar">
								<span class="dx-bar__label">{s.specialty}</span>
								<span class="dx-bar__track"><span class="dx-bar__fill" style={`width: ${(s._count._all / specMax) * 100}%`}></span></span>
								<span class="dx-bar__n">{s._count._all.toLocaleString()}</span>
							</li>
						))}
					</ol>
				) : <p class="dx-empty">No specialty data available.</p>}
			</section>

			<section class="dx-section" aria-labelledby="s-eth">
				<h2 id="s-eth">Ethics programme</h2>
				<p class="dx-count">{ethicsTotal.toLocaleString()} certified physicians</p>
				<div class="dx-figs">
					{(["LEGEND", "GUARDIAN", "ADVOCATE"] as const).map((key) => (
						<div class="dx-fig">
							<span>{ethicsLabel[key]}</span>
							<b>{ethicsMap[key].toLocaleString()}</b>
							<span>{ethicsTotal > 0 ? pct(ethicsMap[key], ethicsTotal) : "0"}%</span>
						</div>
					))}
				</div>
			</section>

			<section class="dx-section" aria-labelledby="s-growth">
				<h2 id="s-growth">Growth</h2>
				<p class="dx-count">Last 12 months · new profiles per month</p>
				<ol class="dx-cols">
					{growthBuckets.map((b) => (
						<li>
							<span class="dx-cols__n">{b.count > 0 ? b.count : ""}</span>
							<span class="dx-cols__bar"><span style={`height: ${(b.count / growthMax) * 100}%`}></span></span>
							<span class="dx-cols__l">{b.label.split(" ")[0]}</span>
						</li>
					))}
				</ol>
			</section>

			<section class="dx-section" aria-labelledby="s-quality">
				<h2 id="s-quality">Data quality</h2>
				<p class="dx-count">Profile completeness</p>
				<ul class="dx-bars">
					{quality.map((q) => (
						<li class="dx-bar">
							<span class="dx-bar__label">{q.label}<br /><small class="dx-count">{q.count.toLocaleString()} of {totalProfiles.toLocaleString()} profiles</small></span>
							<span class="dx-bar__track"><span class="dx-bar__fill" style={`width: ${q.pct}%`}></span></span>
							<span class="dx-bar__n">{q.pct}%</span>
						</li>
					))}
				</ul>
			</section>

			<section class="dx-note">
				<strong>Use the data, cite the source.</strong> These aggregate statistics are released under Creative Commons Attribution-ShareAlike 4.0. If you use them in research, journalism or any derivative work, please cite MDRPedia.
				<a href="/methodology">Read the methodology</a> or <a href="/contact">contact the editorial board</a>.
			</section>
		</div>
	</div>
</SiteLayout>
