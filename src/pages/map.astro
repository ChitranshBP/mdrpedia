---
/**
 * MDRPedia — Global Doctors Map
 * Interactive map showing distribution of medical professionals worldwide
 */
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { prisma } from "../lib/prisma";
import { slugify } from "../lib/utils";

export const prerender = false;

type CountryStat = { total: number; titans: number; elites: number };

const countryStats: Record<string, CountryStat> = {};
const bump = (country: string, tier: string, n: number) => {
    const stat = (countryStats[country] ??= { total: 0, titans: 0, elites: 0 });
    stat.total += n;
    if (tier === 'TITAN') stat.titans += n;
    if (tier === 'ELITE') stat.elites += n;
};

try {
    const [grouped, geographies] = await Promise.all([
        prisma.profile.groupBy({
            by: ['geography_id', 'tier'],
            _count: { _all: true },
        }),
        prisma.geography.findMany({ select: { id: true, country: true } }),
    ]);
    if (grouped.length === 0) throw new Error('No profiles in database');
    const countryById = new Map(geographies.map(g => [g.id, g.country]));
    for (const row of grouped) {
        bump(countryById.get(row.geography_id ?? '') || 'Unknown', row.tier, row._count._all);
    }
} catch (e) {
    for (const key of Object.keys(countryStats)) delete countryStats[key];
    const contentDoctors = await getCollection("doctors");
    for (const d of contentDoctors) {
        bump(d.data.geography?.country || 'Unknown', d.data.tier || 'UNRANKED', 1);
    }
}

const sortedCountries = Object.entries(countryStats)
    .filter(([country]) => country !== 'Unknown')
    .sort((a, b) => b[1].total - a[1].total);

const totalDoctors = Object.values(countryStats).reduce((sum, c) => sum + c.total, 0);
const totalTitans = Object.values(countryStats).reduce((sum, c) => sum + c.titans, 0);
const totalCountries = sortedCountries.length;

// Country coordinates for map markers
const COUNTRY_COORDS: Record<string, { lat: number; lng: number }> = {
    'United States': { lat: 39.8283, lng: -98.5795 },
    'USA': { lat: 39.8283, lng: -98.5795 },
    'United Kingdom': { lat: 55.3781, lng: -3.4360 },
    'UK': { lat: 55.3781, lng: -3.4360 },
    'Canada': { lat: 56.1304, lng: -106.3468 },
    'Germany': { lat: 51.1657, lng: 10.4515 },
    'France': { lat: 46.2276, lng: 2.2137 },
    'India': { lat: 20.5937, lng: 78.9629 },
    'Australia': { lat: -25.2744, lng: 133.7751 },
    'Japan': { lat: 36.2048, lng: 138.2529 },
    'China': { lat: 35.8617, lng: 104.1954 },
    'Brazil': { lat: -14.2350, lng: -51.9253 },
    'South Korea': { lat: 35.9078, lng: 127.7669 },
    'Italy': { lat: 41.8719, lng: 12.5674 },
    'Spain': { lat: 40.4637, lng: -3.7492 },
    'Netherlands': { lat: 52.1326, lng: 5.2913 },
    'Switzerland': { lat: 46.8182, lng: 8.2275 },
    'Sweden': { lat: 60.1282, lng: 18.6435 },
    'Singapore': { lat: 1.3521, lng: 103.8198 },
    'Israel': { lat: 31.0461, lng: 34.8516 },
};

const maxCount = sortedCountries[0]?.[1].total ?? 1;
const markers = sortedCountries.flatMap(([country, stats]) => {
    const coords = COUNTRY_COORDS[country];
    if (!coords) return [];
    return [{
        country,
        slug: slugify(country),
        total: stats.total,
        x: ((coords.lng + 180) / 360) * 1000,
        y: ((90 - coords.lat) / 180) * 500,
        r: 6 + 20 * Math.sqrt(stats.total / maxCount),
    }];
});
const meridians = [-120, -60, 0, 60, 120].map(lng => ((lng + 180) / 360) * 1000);
const parallels = [-60, -30, 0, 30, 60].map(lat => ((90 - lat) / 180) * 500);
---

<Layout title="Global Doctors Map — MDRPedia" description="Explore where the register's physicians practice: a country-by-country distribution with links to every national directory.">
    <div class="map-page">
        <!-- Hero Section -->
        <header class="page-hero">
            <div class="container">
                <span class="hero-badge">GLOBAL NETWORK</span>
                <h1>World Map of Medical Excellence</h1>
                <p class="hero-description">
                    Explore {totalDoctors.toLocaleString()} medical professionals across {totalCountries} countries.
                    Discover the global distribution of medical expertise.
                </p>

                <div class="hero-stats">
                    <div class="stat-item">
                        <span class="stat-value">{totalDoctors.toLocaleString()}</span>
                        <span class="stat-label">Doctors</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                        <span class="stat-value stat-titan">{totalTitans}</span>
                        <span class="stat-label">Titans</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                        <span class="stat-value">{totalCountries}</span>
                        <span class="stat-label">Countries</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- Country plot -->
        <section class="map-section">
            <div class="map-container" id="world-map">
                <svg viewBox="0 0 1000 500" role="group" aria-label="Countries plotted by location, sized by number of physicians">
                    {meridians.map(x => <line x1={x} y1="0" x2={x} y2="500" class="grid" />)}
                    {parallels.map(y => <line x1="0" y1={y} x2="1000" y2={y} class={y === 250 ? 'grid grid--equator' : 'grid'} />)}
                    {markers.map(m => (
                        <a href={`/geography/${m.slug}`} aria-label={`${m.country}: ${m.total} physicians`}>
                            <circle cx={m.x} cy={m.y} r={m.r} class="marker">
                                <title>{m.country} — {m.total.toLocaleString()} physicians</title>
                            </circle>
                            {m.r > 14 && <text x={m.x} y={m.y + 4} class="marker-label" text-anchor="middle">{m.total}</text>}
                        </a>
                    ))}
                </svg>
                <p class="map-caption">Each circle marks a country, sized by physicians on the register. Select one to open its directory.</p>
            </div>
        </section>

        <!-- Countries List -->
        <section class="countries-section">
            <div class="container">
                <h2>Medical Professionals by Country</h2>

                <div class="countries-grid">
                    {sortedCountries.map(([country, stats]) => (
                        <a href={`/geography/${slugify(country)}`} class="country-card">
                            <div class="country-header">
                                <h3>{country}</h3>
                                {stats.titans > 0 && (
                                    <span class="titan-badge">{stats.titans} Titan{stats.titans > 1 ? 's' : ''}</span>
                                )}
                            </div>
                            <div class="country-stats">
                                <div class="country-stat">
                                    <span class="value">{stats.total.toLocaleString()}</span>
                                    <span class="label">Total</span>
                                </div>
                                {stats.elites > 0 && (
                                    <div class="country-stat elite">
                                        <span class="value">{stats.elites}</span>
                                        <span class="label">Elite</span>
                                    </div>
                                )}
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    </div>
</Layout>

<style>
    .map-page {
        background: var(--paper);
        min-height: 100vh;
    }

    .container {
        max-width: var(--max);
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    /* Hero */
    .page-hero {
        padding: 4rem 0 3rem;
        text-align: center;
        background: var(--paper);
        border-bottom: 1px solid var(--rule);
    }

    .hero-badge {
        display: inline-block;
        padding: 6px 16px;
        background: var(--verdant-2);
        border: 1px solid var(--verdant);
        border-radius: var(--r-pill);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        color: var(--verdant);
        margin-bottom: 1.5rem;
    }

    .page-hero h1 {
        font-family: var(--font-serif);
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 400;
        color: var(--ink);
        margin-bottom: 1rem;
    }

    .hero-description {
        font-size: 1.1rem;
        color: var(--ink-2);
        max-width: 600px;
        margin: 0 auto 2.5rem;
    }

    .hero-stats {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .stat-item {
        text-align: center;
    }

    .stat-value {
        display: block;
        font-size: 2rem;
        font-weight: 500;
        font-family: var(--font-mono);
        color: var(--ink);
    }

    .stat-value.stat-titan {
        color: var(--titan-text);
    }

    .stat-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--ink-3);
    }

    .stat-divider {
        width: 1px;
        height: 40px;
        background: var(--rule);
    }

    /* Map Section */
    .map-section {
        padding: 2rem 0;
    }

    .map-container {
        background: var(--paper-2);
        border: 1px solid var(--rule);
        border-radius: var(--r-4);
        overflow: hidden;
        position: relative;
        aspect-ratio: 2 / 1;
    }

    .map-container svg {
        width: 100%;
        height: 100%;
        display: block;
    }

    .grid {
        stroke: var(--rule);
        stroke-width: 1;
    }

    .grid--equator {
        stroke: var(--rule-strong);
    }

    .marker {
        fill: var(--ink-blue);
        fill-opacity: 0.35;
        stroke: var(--ink-blue);
        stroke-width: 1.5;
        transition: fill-opacity 0.2s;
    }

    a:hover .marker, a:focus-visible .marker {
        fill-opacity: 0.7;
    }

    .marker-label {
        font-family: var(--font-mono);
        font-size: 11px;
        fill: var(--ink);
        pointer-events: none;
    }

    .map-caption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0.75rem;
        text-align: center;
        font-size: 0.8rem;
        color: var(--ink-3);
        margin: 0;
    }

    /* Countries Section */
    .countries-section {
        padding: 4rem 0;
    }

    .countries-section h2 {
        font-family: var(--font-serif);
        font-size: 1.75rem;
        font-weight: 400;
        color: var(--ink);
        text-align: center;
        margin-bottom: 2rem;
    }

    .countries-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1rem;
    }

    .country-card {
        padding: 1.25rem;
        background: var(--paper);
        border: 1px solid var(--rule);
        border-radius: var(--r-4);
        text-decoration: none;
        transition: all 0.25s;
    }

    .country-card:hover {
        background: var(--paper-2);
        border-color: var(--rule-strong);
        transform: translateY(-2px);
        box-shadow: var(--shadow-2);
    }

    .country-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
    }

    .country-header h3 {
        font-size: 1rem;
        font-weight: 500;
        color: var(--ink);
        margin: 0;
    }

    .titan-badge {
        padding: 2px 8px;
        background: var(--titan-bg);
        border-radius: var(--r-pill);
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--titan-text);
    }

    .country-stats {
        display: flex;
        gap: 1rem;
        margin-bottom: 0.75rem;
    }

    .country-stat {
        display: flex;
        flex-direction: column;
    }

    .country-stat .value {
        font-size: 1.25rem;
        font-weight: 500;
        font-family: var(--font-mono);
        color: var(--ink);
    }

    .country-stat.elite .value {
        color: var(--elite-text);
    }

    .country-stat .label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--ink-3);
    }

    @media (max-width: 768px) {
        .hero-stats {
            flex-direction: column;
            gap: 1rem;
        }

        .stat-divider {
            width: 60px;
            height: 1px;
        }

        .countries-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
