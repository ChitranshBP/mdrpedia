---
/**
 * MDRPedia — Global Doctors Map
 * Interactive map showing distribution of medical professionals worldwide
 */
import "../styles/pages/directory.css";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { prisma } from "../lib/prisma";
import { slugify } from "../lib/utils";

export const prerender = false;

type CountryStat = { total: number; titans: number; elites: number };

const countryStats: Record<string, CountryStat> = {};
const bump = (country: string, tier: string, n: number) => {
    const stat = (countryStats[country] ??= { total: 0, titans: 0, elites: 0 });
    stat.total += n;
    if (tier === 'TITAN') stat.titans += n;
    if (tier === 'ELITE') stat.elites += n;
};

try {
    const [grouped, geographies] = await Promise.all([
        prisma.profile.groupBy({
            by: ['geography_id', 'tier'],
            _count: { _all: true },
        }),
        prisma.geography.findMany({ select: { id: true, country: true } }),
    ]);
    if (grouped.length === 0) throw new Error('No profiles in database');
    const countryById = new Map(geographies.map(g => [g.id, g.country]));
    for (const row of grouped) {
        bump(countryById.get(row.geography_id ?? '') || 'Unknown', row.tier, row._count._all);
    }
} catch (e) {
    for (const key of Object.keys(countryStats)) delete countryStats[key];
    const contentDoctors = await getCollection("doctors");
    for (const d of contentDoctors) {
        bump(d.data.geography?.country || 'Unknown', d.data.tier || 'UNRANKED', 1);
    }
}

const sortedCountries = Object.entries(countryStats)
    .filter(([country]) => country !== 'Unknown')
    .sort((a, b) => b[1].total - a[1].total);

const totalDoctors = Object.values(countryStats).reduce((sum, c) => sum + c.total, 0);
const totalTitans = Object.values(countryStats).reduce((sum, c) => sum + c.titans, 0);
const totalCountries = sortedCountries.length;

// Country coordinates for map markers
const COUNTRY_COORDS: Record<string, { lat: number; lng: number }> = {
    'United States': { lat: 39.8283, lng: -98.5795 },
    'USA': { lat: 39.8283, lng: -98.5795 },
    'United Kingdom': { lat: 55.3781, lng: -3.4360 },
    'UK': { lat: 55.3781, lng: -3.4360 },
    'Canada': { lat: 56.1304, lng: -106.3468 },
    'Germany': { lat: 51.1657, lng: 10.4515 },
    'France': { lat: 46.2276, lng: 2.2137 },
    'India': { lat: 20.5937, lng: 78.9629 },
    'Australia': { lat: -25.2744, lng: 133.7751 },
    'Japan': { lat: 36.2048, lng: 138.2529 },
    'China': { lat: 35.8617, lng: 104.1954 },
    'Brazil': { lat: -14.2350, lng: -51.9253 },
    'South Korea': { lat: 35.9078, lng: 127.7669 },
    'Italy': { lat: 41.8719, lng: 12.5674 },
    'Spain': { lat: 40.4637, lng: -3.7492 },
    'Netherlands': { lat: 52.1326, lng: 5.2913 },
    'Switzerland': { lat: 46.8182, lng: 8.2275 },
    'Sweden': { lat: 60.1282, lng: 18.6435 },
    'Singapore': { lat: 1.3521, lng: 103.8198 },
    'Israel': { lat: 31.0461, lng: 34.8516 },
};

const maxCount = sortedCountries[0]?.[1].total ?? 1;
const markers = sortedCountries.flatMap(([country, stats]) => {
    const coords = COUNTRY_COORDS[country];
    if (!coords) return [];
    return [{
        country,
        slug: slugify(country),
        total: stats.total,
        x: ((coords.lng + 180) / 360) * 1000,
        y: ((90 - coords.lat) / 180) * 500,
        r: 6 + 20 * Math.sqrt(stats.total / maxCount),
    }];
});
const meridians = [-120, -60, 0, 60, 120].map(lng => ((lng + 180) / 360) * 1000);
const parallels = [-60, -30, 0, 30, 60].map(lat => ((90 - lat) / 180) * 500);
---

<SiteLayout title="Global Doctors Map — MDRPedia" description="Explore where the register's physicians practice: a country-by-country distribution with links to every national directory." active="regions">
	<div class="dx">
		<header class="dx-hero">
			<div class="dx-hero__inner">
				<span class="dx-eyebrow">THE REGISTER BY PLACE</span>
				<h1>World map of the register</h1>
				<p class="dx-lede">
					{totalDoctors.toLocaleString()} physicians across {totalCountries} countries. Select a country to open its directory.
				</p>
				<ul class="dx-facts">
					<li><b>{totalDoctors.toLocaleString()}</b><span>Doctors</span></li>
					<li><b>{totalTitans}</b><span>Titan</span></li>
					<li><b>{totalCountries}</b><span>Countries</span></li>
				</ul>
			</div>
		</header>

		<div class="dx-main">
			<section class="dx-section" aria-labelledby="plot-h">
				<h2 id="plot-h">Where physicians practise</h2>
				<figure class="dx-map" id="world-map">
					<svg viewBox="0 0 1000 500" role="group" aria-label="Countries plotted by location, sized by number of physicians">
						{meridians.map((x) => <line x1={x} y1="0" x2={x} y2="500" class="grid" />)}
						{parallels.map((y) => <line x1="0" y1={y} x2="1000" y2={y} class={y === 250 ? "grid grid--equator" : "grid"} />)}
						{markers.map((m) => (
							<a href={`/geography/${m.slug}`} aria-label={`${m.country}: ${m.total} physicians`}>
								<circle cx={m.x} cy={m.y} r={m.r} class="marker">
									<title>{m.country} — {m.total.toLocaleString()} physicians</title>
								</circle>
								{m.r > 14 && <text x={m.x} y={m.y + 4} class="marker-label" text-anchor="middle">{m.total}</text>}
							</a>
						))}
					</svg>
					<figcaption class="dx-count">Each circle marks a country, sized by physicians on the register. Circles are placed at an approximate national centre; countries without a plotted position are listed below.</figcaption>
				</figure>
			</section>

			<section class="dx-section" aria-labelledby="by-country-h">
				<h2 id="by-country-h">By country</h2>
				<ul class="dx-grid dx-grid--tight">
					{sortedCountries.map(([country, stats]) => (
						<li class="dx-card">
							<h3><a href={`/geography/${slugify(country)}`}>{country}</a></h3>
							<div class="dx-card__foot">
								<span><b>{stats.total.toLocaleString()}</b> {stats.total === 1 ? "physician" : "physicians"}</span>
								<span>
									{stats.titans > 0 && <>{stats.titans} Titan{stats.titans > 1 ? "s" : ""}</>}
									{stats.titans > 0 && stats.elites > 0 && " · "}
									{stats.elites > 0 && <>{stats.elites} Elite</>}
								</span>
							</div>
						</li>
					))}
				</ul>
			</section>
		</div>
	</div>
</SiteLayout>
