---
/**
 * MDRPedia -- Doctor Comparison Tool
 * Side-by-side comparison of up to 3 physician profiles.
 * Database-first, SSR-only.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/pages/compare.css";
import CompareSearch from "../components/CompareSearch";
import { prisma } from "../lib/prisma";
import { getFeaturedTitans } from "../lib/cached-stats";

export const prerender = false;

// Parse query params
const url = new URL(Astro.request.url);
const slugsParam = url.searchParams.get("doctors") || "";
const slugs = slugsParam
    .split(",")
    .map((s) => s.trim())
    .filter(Boolean)
    .slice(0, 3);

// Fetch doctors if slugs are provided
interface CompareDoctor {
    slug: string;
    full_name: string;
    portrait_url: string | null;
    tier: string;
    specialty: string;
    sub_specialty: string | null;
    h_index: number;
    ranking_score: number | null;
    years_active: number;
    ethics_tier: string | null;
    geography: { country: string; city: string | null } | null;
    _count: { citations: number; awards: number };
}

let doctors: CompareDoctor[] = [];
let error: string | null = null;

if (slugs.length > 0) {
    try {
        const results = await prisma.profile.findMany({
            where: { slug: { in: slugs } },
            select: {
                slug: true,
                full_name: true,
                portrait_url: true,
                tier: true,
                specialty: true,
                sub_specialty: true,
                h_index: true,
                ranking_score: true,
                years_active: true,
                ethics_tier: true,
                geography: { select: { country: true, city: true } },
                _count: { select: { citations: true, awards: true } },
            },
        });

        // Preserve the order from URL params
        doctors = slugs
            .map((s) => results.find((r) => r.slug === s))
            .filter(Boolean) as CompareDoctor[];

        if (doctors.length === 0) {
            error = "None of the requested profiles were found.";
        }
    } catch (e) {
        error = "Unable to load profiles. Please try again later.";
    }
}

const hasDoctors = doctors.length > 0;

let examples: { label: string; href: string }[] = [];
if (!hasDoctors) {
    try {
        const titans = await getFeaturedTitans(5);
        const pair = (a: typeof titans[number], b: typeof titans[number]) => ({
            label: `${a.full_name} vs ${b.full_name}`,
            href: `/compare?doctors=${a.slug},${b.slug}`,
        });
        if (titans.length >= 2) examples.push(pair(titans[0], titans[1]));
        if (titans.length >= 4) examples.push(pair(titans[2], titans[3]));
        if (titans.length >= 3) {
            examples.push({
                label: `${titans[0].full_name}, ${titans[1].full_name} & ${titans[2].full_name}`,
                href: `/compare?doctors=${titans[0].slug},${titans[1].slug},${titans[2].slug}`,
            });
        }
    } catch {
        examples = [];
    }
}
const pageTitle = hasDoctors
    ? `Compare: ${doctors.map((d) => d.full_name).join(" vs ")} -- MDRPedia`
    : "Compare Physicians -- MDRPedia";

function getInitials(name: string): string {
    return name
        .split(" ")
        .filter(Boolean)
        .map((n) => n[0])
        .join("")
        .slice(0, 2)
        .toUpperCase();
}

// Stature tiers and ranking scores are not shown for physicians in India (NMC 2026 guidelines).
const hideStature = (d: CompareDoctor) => d.geography?.country === "India";

function tierLabel(tier: string): string {
    const map: Record<string, string> = {
        TITAN: "Titan",
        ELITE: "Elite",
        MASTER: "Master",
        UNRANKED: "Unranked",
    };
    return map[tier] || tier;
}

function ethicsLabel(tier: string | null): string {
    if (!tier) return "—";
    const map: Record<string, string> = {
        LEGEND: "Legend",
        GUARDIAN: "Guardian",
        ADVOCATE: "Advocate",
    };
    return map[tier] || tier;
}

// JSON-LD
const itemListLd = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Physician Comparison",
    description: hasDoctors
        ? `Side-by-side comparison of ${doctors.map((d) => d.full_name).join(", ")}`
        : "Compare physician profiles on MDRPedia",
    numberOfItems: doctors.length,
    itemListElement: doctors.map((d, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
            "@type": "Physician",
            name: d.full_name,
            url: `https://mdrpedia.com/doctors/${d.slug}`,
            medicalSpecialty: d.specialty,
            ...(d.geography?.country
                ? {
                      address: {
                          "@type": "PostalAddress",
                          addressCountry: d.geography.country,
                          ...(d.geography.city
                              ? { addressLocality: d.geography.city }
                              : {}),
                      },
                  }
                : {}),
        },
    })),
};

Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=60, s-maxage=120",
);
---

<SiteLayout
    title={pageTitle}
    description="Compare physician profiles side-by-side on MDRPedia. Evaluate h-index, ranking score, specialties, and more."
    active="register"
    jsonLd={[itemListLd]}
>
    <div class="cmp">
        <header class="cmp-wrap cmp-hero">
            <nav class="cmp-crumbs" aria-label="Breadcrumb">
                <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Compare</span>
            </nav>
            <span class="cmp-eyebrow">Comparison tool</span>
            <h1>Compare Physicians</h1>
            <p>Select two or three physicians to compare their credentials, impact, and rankings side by side.</p>
        </header>

        <div class="cmp-wrap cmp-main">
            <section class="cmp-search" aria-label="Choose physicians">
                <CompareSearch client:load selectedSlugs={slugs} maxDoctors={3} />
            </section>

            {error && <p class="cmp-error" role="alert">{error}</p>}

            {!hasDoctors && !error && (
                <section class="cmp-empty" aria-labelledby="start-h">
                    <h2 id="start-h">Start a comparison</h2>
                    <p>
                        Use the search bar above to find physicians by name, specialty, or institution.
                        You can compare up to three profiles at once.
                    </p>
                    {examples.length > 0 && (
                        <p class="cmp-hints">
                            <span>Try:</span>
                            {examples.map((ex) => <a href={ex.href}>{ex.label}</a>)}
                        </p>
                    )}
                </section>
            )}

            {hasDoctors && (
                <>
                    <ul class="cmp-heads" style={`--cols: ${doctors.length}`}>
                        {doctors.map((doc) => (
                            <li>
                                <a href={`/doctors/${doc.slug}`} class="cmp-head">
                                    <span class="cmp-portrait">
                                        {doc.portrait_url ? (
                                            <img src={doc.portrait_url} alt="" width="88" height="88" loading="lazy" />
                                        ) : (
                                            <span aria-hidden="true">{getInitials(doc.full_name)}</span>
                                        )}
                                    </span>
                                    <span class="cmp-head__name">{doc.full_name}</span>
                                    {!hideStature(doc) && doc.tier !== "UNRANKED" && (
                                        <span class={`cmp-tier cmp-tier--${doc.tier.toLowerCase()}`}>{tierLabel(doc.tier)}</span>
                                    )}
                                </a>
                            </li>
                        ))}
                    </ul>

                    <table class="cmp-table" style={`--cols: ${doctors.length}`}>
                        <caption class="r-sr-only">Side-by-side comparison of {doctors.map((d) => d.full_name).join(", ")}</caption>
                        <thead>
                            <tr>
                                <th scope="col"><span class="r-sr-only">Measure</span></th>
                                {doctors.map((d) => <th scope="col">{d.full_name}</th>)}
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Specialty</th>
                                {doctors.map((d) => (
                                    <td data-doctor={d.full_name}>
                                        <span class="cmp-primary">{d.specialty}</span>
                                        {d.sub_specialty && <span class="cmp-secondary">{d.sub_specialty}</span>}
                                    </td>
                                ))}
                            </tr>
                            <tr>
                                <th scope="row">h-index</th>
                                {doctors.map((d) => {
                                    const maxH = Math.max(...doctors.map((x) => x.h_index));
                                    const best = d.h_index === maxH && d.h_index > 0 && doctors.length > 1;
                                    return (
                                        <td data-doctor={d.full_name} class={best ? "is-best" : undefined}>
                                            <span class="cmp-num">{d.h_index || "—"}</span>
                                            {best && <span class="cmp-best">highest</span>}
                                        </td>
                                    );
                                })}
                            </tr>
                            <tr>
                                <th scope="row">Ranking score</th>
                                {doctors.map((d) => {
                                    const shown = !hideStature(d);
                                    const scores = doctors.filter((x) => !hideStature(x)).map((x) => x.ranking_score ?? 0).filter((v) => v > 0);
                                    const maxS = scores.length > 0 ? Math.max(...scores) : 0;
                                    const best = shown && (d.ranking_score ?? 0) === maxS && maxS > 0 && scores.length > 1;
                                    return (
                                        <td data-doctor={d.full_name} class={best ? "is-best" : undefined}>
                                            <span class="cmp-num">{shown ? d.ranking_score?.toFixed(1) || "—" : "—"}</span>
                                            {best && <span class="cmp-best">highest</span>}
                                        </td>
                                    );
                                })}
                            </tr>
                            <tr>
                                <th scope="row">Location</th>
                                {doctors.map((d) => (
                                    <td data-doctor={d.full_name}>
                                        <span class="cmp-primary">{d.geography?.country || "Unknown"}</span>
                                        {d.geography?.city && <span class="cmp-secondary">{d.geography.city}</span>}
                                    </td>
                                ))}
                            </tr>
                            <tr>
                                <th scope="row">Years active</th>
                                {doctors.map((d) => {
                                    const maxY = Math.max(...doctors.map((x) => x.years_active));
                                    const best = d.years_active === maxY && d.years_active > 0 && doctors.length > 1;
                                    return (
                                        <td data-doctor={d.full_name} class={best ? "is-best" : undefined}>
                                            <span class="cmp-num">{d.years_active || "—"}</span>
                                            {best && <span class="cmp-best">highest</span>}
                                        </td>
                                    );
                                })}
                            </tr>
                            <tr>
                                <th scope="row">Ethics tier</th>
                                {doctors.map((d) => (
                                    <td data-doctor={d.full_name}>
                                        <span class={`cmp-primary ${d.ethics_tier ? "cmp-ethics" : ""}`}>{ethicsLabel(d.ethics_tier)}</span>
                                    </td>
                                ))}
                            </tr>
                            <tr>
                                <th scope="row">Citations</th>
                                {doctors.map((d) => {
                                    const maxC = Math.max(...doctors.map((x) => x._count.citations));
                                    const best = d._count.citations === maxC && d._count.citations > 0 && doctors.length > 1;
                                    return (
                                        <td data-doctor={d.full_name} class={best ? "is-best" : undefined}>
                                            <span class="cmp-num">{d._count.citations > 0 ? d._count.citations.toLocaleString() : "—"}</span>
                                            {best && <span class="cmp-best">highest</span>}
                                        </td>
                                    );
                                })}
                            </tr>
                            <tr>
                                <th scope="row">Awards</th>
                                {doctors.map((d) => {
                                    const maxA = Math.max(...doctors.map((x) => x._count.awards));
                                    const best = d._count.awards === maxA && d._count.awards > 0 && doctors.length > 1;
                                    return (
                                        <td data-doctor={d.full_name} class={best ? "is-best" : undefined}>
                                            <span class="cmp-num">{d._count.awards || "—"}</span>
                                            {best && <span class="cmp-best">highest</span>}
                                        </td>
                                    );
                                })}
                            </tr>
                        </tbody>
                    </table>

                    <ul class="cmp-actions">
                        {doctors.map((d) => (
                            <li><a href={`/doctors/${d.slug}`}>View {d.full_name}'s full profile →</a></li>
                        ))}
                    </ul>
                </>
            )}
        </div>
    </div>
</SiteLayout>
