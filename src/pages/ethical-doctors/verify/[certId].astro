---
/**
 * MDRPedia — public verification page for an ethics seal (claude.ai/design "Seal").
 */
import SiteLayout from "../../../layouts/SiteLayout.astro";
import Seal from "../../../components/site/Seal.astro";
import { prisma } from "../../../lib/prisma";
import { isValidCertId } from "../../../lib/ethics-cert-id";
import { scoreBand } from "../../../lib/ethics-score";
import { ethicsSeal, SEAL_GREEN } from "../../../lib/register-seal";
import { normalizeSpecialty } from "../../../lib/specialty-groups";
import "../../../styles/pages/ethics.css";

export const prerender = false;

const { certId } = Astro.params;

if (!certId || !isValidCertId(certId)) {
	return Astro.rewrite("/404");
}

const profile = await prisma.profile.findUnique({
	where: { ethics_cert_id: certId },
	select: {
		full_name: true,
		slug: true,
		specialty: true,
		sub_specialty: true,
		ethics_tier: true,
		ethics_cert_id: true,
		ethics_certified_at: true,
		ethics_status: true,
		ethics_score: true,
		geography: { select: { country: true, city: true } },
		ethics_applications: {
			where: { status: "APPROVED" },
			orderBy: { updatedAt: "desc" },
			take: 1,
			include: {
				audits: {
					where: { status: "APPROVED" },
					orderBy: { createdAt: "desc" },
					take: 1,
					include: { items: { where: { reviewer_verdict: "PASS" }, orderBy: { item_key: "asc" } } },
				},
			},
		},
	},
});

if (!profile) {
	return Astro.rewrite("/404");
}

const STATES: Record<string, { key: string; label: string; desc: string }> = {
	APPROVED: { key: "active", label: "ACTIVE", desc: "This certification is current and verified by audit." },
	SUSPENDED: { key: "suspended", label: "SUSPENDED", desc: "This certification is suspended until a pending audit or renewal is completed." },
	REVOKED: { key: "revoked", label: "REVOKED", desc: "This certification was revoked for non-compliance. The physician does not currently hold the mark." },
	EXPIRED: { key: "expired", label: "EXPIRED", desc: "This certification has expired. A new audit is needed to reinstate it." },
};
const state = STATES[profile.ethics_status ?? ""] ?? {
	key: "expired",
	label: "NOT ACTIVE",
	desc: "This certificate number exists but the certification is not currently active.",
};
const isActive = state.key === "active";

const seal = ethicsSeal(profile.ethics_tier);
const latestAudit = profile.ethics_applications[0]?.audits[0];
const passedItems = latestAudit?.items ?? [];
const templates = passedItems.length
	? await prisma.ethicsChecklistTemplate.findMany({ select: { item_key: true, label: true } })
	: [];
const templateLabel = new Map(templates.map((t) => [t.item_key, t.label]));
const categoryLabels: Record<string, string> = {
	PATIENT_TRANSPARENCY: "Patient transparency",
	PEER_REVIEW_COMPLIANCE: "Peer review and compliance",
	COMMUNITY_PROBONO: "Community and pro-bono service",
};

const fmtMonth = (d: Date) => new Date(d).toLocaleDateString("en-GB", { month: "long", year: "numeric" });
const location = [profile.geography?.city, profile.geography?.country].filter((v) => v && v !== "Global").join(", ");
const specialty = normalizeSpecialty(profile.specialty) + (profile.sub_specialty ? ` · ${profile.sub_specialty}` : "");
const scoreText = profile.ethics_score != null ? `${profile.ethics_score.toFixed(1)} / 100` : null;

const facts = [
	{ k: "Physician", v: profile.full_name, href: `/doctors/${profile.slug}` },
	{ k: "Specialty", v: specialty },
	location && { k: "Location", v: location },
	{ k: "Grade", v: `${seal.name} · Ethics ${profile.ethics_tier === "LEGEND" ? "I" : profile.ethics_tier === "GUARDIAN" ? "II" : "III"}` },
	{ k: "Status", v: isActive ? "Active" : state.label.charAt(0) + state.label.slice(1).toLowerCase() },
	scoreText && { k: "Audit score", v: `${scoreText}${profile.ethics_score != null ? ` (${scoreBand(profile.ethics_score)})` : ""}` },
	profile.ethics_certified_at && { k: "Certified since", v: fmtMonth(profile.ethics_certified_at) },
	latestAudit && { k: "Last audit", v: `${latestAudit.audit_type.charAt(0)}${latestAudit.audit_type.slice(1).toLowerCase()} · ${fmtMonth(latestAudit.period_end)}` },
	{ k: "Certificate №", v: certId },
].filter(Boolean) as { k: string; v: string; href?: string }[];

const siteBase = Astro.site?.href.replace(/\/$/, "") ?? "https://mdrpedia.com";
const canonicalUrl = `${siteBase}/ethical-doctors/verify/${certId}`;
const title = `Verify ${profile.full_name}'s ethics seal (${certId}) | MDRPedia`;
const description = `${profile.full_name} — MDRPedia ethics ${seal.name}, ${isActive ? "active" : state.label.toLowerCase()}${scoreText ? `, audit score ${scoreText}` : ""}. Certificate ${certId}.`;

const widgetCode = `<script src="${siteBase}/api/ethics/widget/${certId}.js" async></script>`;
const badgeCode = `<a href="${canonicalUrl}"><img src="${siteBase}/api/ethics/badge/${certId}.svg" alt="MDRPedia ethics ${seal.name} — verify" width="120" height="120"></a>`;

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "ProfilePage",
		url: canonicalUrl,
		mainEntity: {
			"@type": "Physician",
			name: profile.full_name,
			url: `${siteBase}/doctors/${profile.slug}`,
			medicalSpecialty: normalizeSpecialty(profile.specialty),
			...(location && { workLocation: { "@type": "Place", name: location } }),
			...(isActive && {
				hasCredential: {
					"@type": "EducationalOccupationalCredential",
					credentialCategory: "Ethics certification",
					name: `MDRPedia Ethics ${seal.name}`,
					recognizedBy: { "@type": "Organization", name: "MDRPedia", url: siteBase },
				},
			}),
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "MDRPedia", item: siteBase },
			{ "@type": "ListItem", position: 2, name: "The Ethics Register", item: `${siteBase}/ethical-doctors` },
			{ "@type": "ListItem", position: 3, name: profile.full_name, item: canonicalUrl },
		],
	},
];
---

<SiteLayout title={title} description={description} jsonLd={jsonLd} robots={isActive ? "index, follow" : "noindex, follow"}>
	<div class="et-page">
		<header class="sv-head">
			<nav class="sv-crumbs" aria-label="Breadcrumb">
				<a href="/ethical-doctors">The Ethics Register</a> / <span>Seal verification</span>
			</nav>
			<span class="et-sec__no">CERTIFICATE № {certId}</span>
			<h1>{profile.full_name}</h1>
			<span class="sv-status" data-state={state.key}>{state.label}</span>
			{!isActive && <p class="sv-banner" data-state={state.key}>{state.desc}</p>}
		</header>

		<section class="sv-body" aria-label="Certification details">
			<div class="sv-seal" data-inactive={!isActive || undefined}>
				<Seal
					size={200}
					color={SEAL_GREEN}
					ring={seal.ring}
					letter={seal.letter}
					no={profile.ethics_score != null ? String(Math.round(profile.ethics_score)) : "AUDITED"}
					uid="verify"
					title={`MDRPedia ethics ${seal.name} seal, ${isActive ? "active" : state.label.toLowerCase()}`}
				/>
				<span class="sv-seal__caption">{isActive ? state.desc : "This seal is not currently valid."}</span>
			</div>
			<dl class="sv-facts">
				{facts.map((f) => (
					<div>
						<dt>{f.k}</dt>
						<dd>{f.href ? <a href={f.href}>{f.v}</a> : f.v}</dd>
					</div>
				))}
			</dl>
		</section>

		{passedItems.length > 0 && (
			<section class="et-sec" aria-labelledby="sv-checks">
				<header class="et-sec__head">
					<span class="et-sec__no">LATEST AUDIT · {passedItems.length} ITEMS PASSED</span>
					<h2 id="sv-checks">What the audit verified</h2>
				</header>
				<ul class="sv-checks">
					{passedItems.map((item) => (
						<li>
							<span class="sv-checks__tick" aria-hidden="true">✓</span>
							<span>
								<span class="sv-checks__label">{templateLabel.get(item.item_key) ?? item.item_key}</span>
								<span class="sv-checks__cat">{categoryLabels[item.category] ?? item.category}</span>
							</span>
							<span class="sv-checks__pts">{item.points_earned}/{item.max_points}</span>
						</li>
					))}
				</ul>
			</section>
		)}

		{isActive && (
			<section class="et-sec" aria-labelledby="sv-embed">
				<header class="et-sec__head">
					<span class="et-sec__no">FOR THE PHYSICIAN</span>
					<h2 id="sv-embed">Embed this seal</h2>
				</header>
				<div class="sv-embed">
					<p>The live widget checks the Register every time it loads, so it changes the moment the status does.</p>
					<pre class="sv-code"><code>{widgetCode}</code></pre>
					<p>Or use the static badge, which links back here:</p>
					<pre class="sv-code"><code>{badgeCode}</code></pre>
				</div>
			</section>
		)}

		<section class="et-sec et-sec--last">
			<div class="sv-actions">
				<a href={`/doctors/${profile.slug}`} class="et-btn et-btn--solid">View the full record</a>
				<a href="/ethical-doctors" class="et-btn et-btn--ghost">About the Ethics Register</a>
			</div>
		</section>
	</div>
</SiteLayout>
