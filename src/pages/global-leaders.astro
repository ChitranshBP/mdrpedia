---
export const prerender = true;
import "../styles/pages/directory.css";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { portraitAttrs } from "../lib/portrait";

const doctors = await getCollection("doctors");
const leaders = doctors.filter((doc) =>
    [
        "Tedros Adhanom Ghebreyesus",
        "Anthony Fauci",
        "Atul Gawande",
        "Devi Shetty",
        "Patrick Soon-Shiong",
        "Vivek Murthy",
        "Soumya Swaminathan",
        "Jeremy Farrar",
        "Didier Pittet",
        "Christopher J. L. Murray",
        "Jean-Jacques Muyembe",
    ].includes(doc.data.fullName),
);

const TIER: Record<string, string> = { TITAN: "Titan", ELITE: "Elite", MASTER: "Master" };
---

<SiteLayout
    title="Global Health Leaders — MDRPedia"
    description="Heads of major international healthcare communities and organizations."
    active=""
>
	<div class="dx">
		<header class="dx-hero">
			<div class="dx-hero__inner">
				<span class="dx-eyebrow">INTERNATIONAL LEADERSHIP</span>
				<h1>Global health leaders</h1>
				<p class="dx-lede">People who have shaped global health policy, pandemic response and international medical cooperation.</p>
			</div>
		</header>

		<div class="dx-main">
			<section class="dx-section" aria-labelledby="leaders-h">
				<h2 id="leaders-h">Profiles</h2>
				<p class="dx-count">{leaders.length} {leaders.length === 1 ? "profile" : "profiles"}</p>
				<ul class="dx-grid">
					{leaders.map((doc) => (
						<li class="dx-card dx-card--photo">
							{doc.data.portraitUrl ? (
								<div class="dx-photo">
									<img
										{...portraitAttrs(doc.data.portraitUrl, 400, 300)}
										alt=""
										loading="lazy"
										decoding="async"
										referrerpolicy="no-referrer"
										onerror="this.parentElement.hidden=true"
									/>
								</div>
							) : (
								<div class="dx-photo dx-photo--ph" aria-hidden="true">
									{doc.data.fullName.split(" ").map((w: string) => w[0]).slice(0, 2).join("").toUpperCase()}
								</div>
							)}
							<div class="dx-card__body">
								<span class="dx-card__kicker">
									{doc.data.affiliations?.[0]?.hospitalName || "Global leader"}{TIER[doc.data.tier] && ` · ${TIER[doc.data.tier]}`}
								</span>
								<h3><a href={`/doctors/${doc.id}`}>{doc.data.fullName}</a></h3>
								<p class="dx-card__clamp">{doc.data.biography}</p>
							</div>
						</li>
					))}
				</ul>
			</section>

			<section class="dx-section" aria-labelledby="def-h">
				<h2 id="def-h">What this page covers</h2>
				<div class="dx-prose">
					<p>
						A top clinician works in the clinic or operating theatre. A global health leader works at the scale of populations,
						through policy, advocacy and institution-building. This page collects profiles of physicians who lead major
						international health organisations or have directed global responses to public-health emergencies.
					</p>
					<p>
						The list is curated by the editors. Each profile follows the same <a href="/evidence">evidence standard</a> and
						<a href="/methodology">scoring method</a> as the rest of the register.
					</p>
				</div>
			</section>
		</div>
	</div>
</SiteLayout>
