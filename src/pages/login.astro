---
export const prerender = true;
/**
 * MDRPedia — Sign in. Doctor portal (magic link) and editor/admin access key.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/pages/utility.css";
---

<SiteLayout
	title="Sign in | MDRPedia"
	description="Sign in to the MDRPedia doctor portal or the editor dashboard."
	robots="noindex, nofollow"
>
	<div class="u-page">
		<div class="u-wrap">
			<header class="u-head">
				<span class="u-kicker">SIGN IN</span>
				<h1 class="u-h1">Doctor portal and <em>editor access.</em></h1>
				<p class="u-lede">
					Physicians sign in with a one-time link sent to the email on their claimed record. Editors use an access key.
					Not yet claimed? <a href="/doctor/claim">Claim your record</a>.
				</p>
			</header>

			<div class="u-cards">
				<section class="u-card" aria-labelledby="doc-title">
					<span class="u-kicker">FOR PHYSICIANS</span>
					<h2 id="doc-title">Doctor portal</h2>
					<p>Enter the email address on your verified record. We will send a one-time sign-in link.</p>
					<form id="doctorLoginForm" novalidate>
						<div class="u-field">
							<label for="doctor-email">Email address</label>
							<input class="u-input" type="email" id="doctor-email" name="email" placeholder="you@hospital.org" autocomplete="email" required />
						</div>
						<button type="submit" class="u-btn" id="doctor-submit">Send sign-in link</button>
						<p class="u-status doctor-login-status" role="status" aria-live="polite"></p>
					</form>
				</section>

				<section class="u-card u-card--deep" aria-labelledby="admin-title">
					<span class="u-kicker">FOR EDITORS</span>
					<h2 id="admin-title">Editor dashboard</h2>
					<p>Enter your access key to open the review queue. Need help? <a href="mailto:admin@mdrpedia.com">admin@mdrpedia.com</a></p>
					<form id="loginForm">
						<div class="u-field">
							<label for="key">Access key</label>
							<div class="u-pw">
								<input class="u-input" type="password" id="key" name="key" autocomplete="current-password" required />
								<button type="button" class="toggle-visibility" aria-controls="key" aria-pressed="false">Show</button>
							</div>
						</div>
						<button type="submit" class="u-btn">Open dashboard</button>
					</form>
				</section>
			</div>
		</div>
	</div>
</SiteLayout>

<script>
	const toggleBtn = document.querySelector(".toggle-visibility") as HTMLButtonElement | null;
	const passwordInput = document.getElementById("key") as HTMLInputElement | null;

	toggleBtn?.addEventListener("click", () => {
		if (!passwordInput) return;
		const show = passwordInput.type === "password";
		passwordInput.type = show ? "text" : "password";
		toggleBtn.textContent = show ? "Hide" : "Show";
		toggleBtn.setAttribute("aria-pressed", String(show));
	});

	document.getElementById("loginForm")?.addEventListener("submit", (e) => {
		e.preventDefault();
		const input = document.getElementById("key") as HTMLInputElement | null;
		if (input && input.value) {
			window.location.href = `/admin?key=${encodeURIComponent(input.value)}`;
		}
	});

	const doctorForm = document.getElementById("doctorLoginForm");
	const statusEl = document.querySelector(".doctor-login-status") as HTMLElement;

	doctorForm?.addEventListener("submit", async (e) => {
		e.preventDefault();
		const emailInput = document.getElementById("doctor-email") as HTMLInputElement;
		const submitBtn = document.getElementById("doctor-submit") as HTMLButtonElement;
		const email = emailInput?.value?.trim();

		if (!email) {
			statusEl.textContent = "Enter your email address.";
			statusEl.dataset.state = "err";
			return;
		}

		submitBtn.disabled = true;
		statusEl.textContent = "Sending sign-in link...";
		statusEl.dataset.state = "busy";

		try {
			const res = await fetch("/api/auth/magic-link", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ email }),
			});
			const data = await res.json().catch(() => ({}));

			if (res.ok) {
				statusEl.textContent = "Check your email for a sign-in link.";
				statusEl.dataset.state = "ok";
				emailInput.value = "";
			} else {
				statusEl.textContent = data.error || "Something went wrong. Please try again.";
				statusEl.dataset.state = "err";
			}
		} catch {
			statusEl.textContent = "Network error. Please try again.";
			statusEl.dataset.state = "err";
		} finally {
			submitBtn.disabled = false;
		}
	});

	// Surface errors the portal redirects here with (?error=...).
	const err = new URLSearchParams(location.search).get("error");
	if (err) {
		const messages: Record<string, string> = {
			not_authenticated: "Please sign in to open the doctor portal.",
			profile_not_found: "We could not find a record for that account. Claim your record first.",
		};
		statusEl.textContent = messages[err] ?? "Sign-in failed. Please try again.";
		statusEl.dataset.state = "err";
	}
</script>
