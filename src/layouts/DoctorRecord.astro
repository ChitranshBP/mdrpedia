											<>
												<img src={sImg} alt="" class="js-portrait" loading="lazy" decoding="async" width="56" height="56" referrerpolicy="no-referrer" />
												<span class="p-portrait__initials" hidden>{sInitials}</span>
											</>
										) : (
											<span class="p-portrait__initials">{sInitials}</span>
										)}
									</span>
									<span class="p-related__txt">
										<span class="p-related__name">{s.full_name}</span>
										<span class="p-rows__meta">{[normalizeSpecialty(s.specialty), sCity, sCountry].filter(Boolean).join(" · ")}</span>
										{TIERS[s.tier] && <span class="p-related__tier">{TIERS[s.tier].name} · {TIERS[s.tier].tier}</span>}
									</span>
								</a>
							</li>
						);
					})}
				</ul>
			</section>
		)}

		<nav class="p-wrap p-browse" aria-label="Continue browsing">
			<span class="p-label">CONTINUE BROWSING</span>
			<ul>
				{browse.map((b) => <li><a href={b.href}>{b.label}</a></li>)}
			</ul>
		</nav>

		{claimable && (
			<section class="p-claimform" id="claim-profile" aria-labelledby="claim-title">
				<div class="p-wrap p-claimform__inner">
					<div class="p-claimform__copy">
						<span class="p-label p-label--light">FOR THE DOCTOR</span>
						<h2 id="claim-title">Are you {doctor.fullName}?</h2>
						<p>Claim this record to correct details, add your lineage and teaching, and embed your seal. Claims are checked against your registration before anything changes.</p>
					</div>
					<form class="p-form" id="claimForm" data-slug={slug} novalidate>
						<div class="p-form__row">
							<label for="claimEmail">Work email</label>
							<input type="email" id="claimEmail" name="email" autocomplete="email" placeholder="dr.name@hospital.org" required />
						</div>
						<div class="p-form__row">
							<label for="claimLicense">Registration number (NMR, GMC, NPI or state licence)</label>
							<input type="text" id="claimLicense" name="registration_number" autocomplete="off" required />
						</div>
						<div class="p-form__row">
							<label for="certUpload">Proof of registration <span>(PDF, JPG or PNG, up to 10 MB, optional)</span></label>
							<input type="file" id="certUpload" name="document" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" />
						</div>
						<div class="p-honeypot" aria-hidden="true">
							<label for="website_url_hp">Leave this empty</label>
							<input type="text" id="website_url_hp" name="website_url_hp" tabindex="-1" autocomplete="off" />
						</div>
						<button type="submit" class="p-claim__btn" id="claimSubmit">Send claim request</button>
						<p class="p-form__status" id="claimStatus" role="status" aria-live="polite"></p>
					</form>
				</div>
			</section>
		)}
	</article>

	<dialog class="p-share" id="shareDialog" aria-labelledby="share-title">
		<form method="dialog" class="p-share__inner">
			<div class="p-share__head">
				<h2 id="share-title">Share this record</h2>
				<button class="p-share__x" value="close" aria-label="Close">✕</button>
			</div>
			<img class="p-share__card" src={ogImageUrl} alt={`Share card for ${doctor.fullName}`} width="600" height="315" loading="lazy" />
			<div class="p-share__links">
				<button type="button" class="p-btn" data-copy={pageUrl} data-copy-done="Link copied ✓">Copy link</button>
				<button type="button" class="p-btn" data-native-share hidden>Share…</button>
				<a class="p-btn" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener noreferrer">X</a>
				<a class="p-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
				<a class="p-btn" href={`https://wa.me/?text=${encodeURIComponent(`${shareText} ${pageUrl}`)}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
				<a class="p-btn" href={`mailto:?subject=${encodeURIComponent(`${doctor.fullName} — MDRPedia`)}&body=${encodeURIComponent(`${doctor.fullName}'s record on MDRPedia: ${pageUrl}`)}`}>Email</a>
				<a class="p-btn" href={ogImageUrl} download={`${slug}-mdrpedia.png`}>Download card</a>
			</div>
			<label class="p-label" for="embedCode">EMBED THIS RECORD ON YOUR SITE</label>
			<textarea id="embedCode" class="p-share__code" readonly rows="3">{embedCode}</textarea>
			<button type="button" class="p-btn" data-copy={embedCode} data-copy-done="Embed code copied ✓">Copy embed code</button>
			<p class="r-sr-only" role="status" aria-live="polite" data-share-status></p>
		</form>
	</dialog>

	<dialog class="p-lightbox" id="lightbox" aria-label="Image viewer">
		<form method="dialog">
			<button class="p-share__x" value="close" aria-label="Close">✕</button>
			<img alt="" />
		</form>
	</dialog>
</SiteLayout>

<script define:vars={{ slug, doctorFullName: doctor.fullName, doctorSpecialty: doctor.specialty, doctorTier: doctor.tier, doctorPortrait: doctor.portraitUrl || "" }}>
	try {
		const KEY = "mdrpedia_recently_viewed";
		const list = JSON.parse(localStorage.getItem(KEY) || "[]").filter((p) => p.slug !== slug);
		list.unshift({ slug, fullName: doctorFullName, specialty: doctorSpecialty, tier: doctorTier, portraitUrl: doctorPortrait || undefined, viewedAt: Date.now() });
		localStorage.setItem(KEY, JSON.stringify(list.slice(0, 8)));
	} catch {}
</script>

<script>
	import { initRecordPage } from "../scripts/doctor-record";
	initRecordPage();
</script>
