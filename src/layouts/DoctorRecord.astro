---
/**
 * MDRPedia — doctor record (claude.ai/design "Profile", with the tabbed body
 * and NMC-safe framing from "Doctor Showcase").
 */
import "../styles/pages/profile.css";
import SiteLayout from "./SiteLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import MedicalKnowledgeGraph from "../components/MedicalKnowledgeGraph.astro";
import Seal from "../components/site/Seal.astro";
import PaperRow from "../components/site/PaperRow.astro";
import { generateAISummary } from "../lib/ai-summary";
import { generatePatientSummary } from "../lib/patient-summary";
import { normalizeSpecialty } from "../lib/specialty-groups";
import { getProfileStanding } from "../lib/profile-ranks";
import { getSimilarDoctors } from "../lib/similar-doctors";
import { slugify } from "../lib/slug";
import type { ProfileData } from "../lib/types";

interface Props {
	doctor: ProfileData;
}

const { doctor } = Astro.props;
const slug = Astro.url.pathname.split("/").filter(Boolean).pop() || "";
const site = Astro.site ?? new URL("https://mdrpedia.com");
const pageUrl = new URL(`/doctors/${slug}`, site).href;

const isHistorical = doctor.status === "HISTORICAL";
const isUnclaimed = !doctor.claimStatus || doctor.claimStatus === "UNCLAIMED";
const claimable = isUnclaimed && !isHistorical;
const openalexId = doctor.openalexId?.replace(/^https?:\/\/openalex\.org\//i, "") || null;
const known = (v?: string | null): v is string => !!v && v.trim() !== "" && !["unknown", "global"].includes(v.trim().toLowerCase());

const specialtyLabel = normalizeSpecialty(doctor.specialty);
const city = known(doctor.geography.city) ? doctor.geography.city : null;
const region = known(doctor.geography.region) && doctor.geography.region !== city ? doctor.geography.region : null;
const country = known(doctor.geography.country) ? doctor.geography.country : null;
const location = [city, region, country].filter(Boolean).join(", ");
const primaryInstitution = doctor.affiliations?.[0]?.hospitalName;

const hasImage = !!doctor.portraitUrl && !doctor.portraitUrl.startsWith("data:image/svg");
const initials = doctor.fullName
	.replace(/^(dr|prof|sir|dame)\.?\s+/i, "")
	.split(/\s+/)
	.filter((w) => /^[\p{L}]/u.test(w))
	.map((w) => w[0])
	.filter((_, i, a) => i === 0 || i === a.length - 1)
	.join("")
	.toUpperCase();

const citations = doctor.citations ?? [];
const citationCount = (c: (typeof citations)[number]) => (c as { citationCount?: number }).citationCount ?? c.totalCitationCount ?? 0;
const totalCitations = citations.reduce((acc, c) => acc + citationCount(c), 0);
const pubmedLinked = citations.filter((c) => c.pubmedId).length;
const openAccess = citations.filter((c) => c.isOpenAccess && c.openAccessUrl).length;
const papers = [...citations].sort((a, b) => citationCount(b) - citationCount(a) || (b.year ?? 0) - (a.year ?? 0));
const PAPERS_SHOWN = 5;
const paperYears = citations.map((c) => c.year).filter((y): y is number => !!y);
const yearCounts = (() => {
	if (paperYears.length < 3) return [];
	const lo = Math.min(...paperYears);
	const hi = Math.max(...paperYears);
	if (hi - lo > 80) return [];
	const counts = new Map<number, number>();
	paperYears.forEach((y) => counts.set(y, (counts.get(y) ?? 0) + 1));
	return Array.from({ length: hi - lo + 1 }, (_, i) => ({ y: lo + i, n: counts.get(lo + i) ?? 0 }));
})();
const maxYearCount = Math.max(1, ...yearCounts.map((y) => y.n));
const topJournals = [...new Set(citations.map((c) => c.journal).filter((j): j is string => !!j))].slice(0, 5);

const awards = [...(doctor.awards ?? [])].sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
const timeline = [...(doctor.timeline ?? [])].sort((a, b) => a.year - b.year);
const talks = [...(doctor.talks ?? [])].sort((a, b) => b.year - a.year);
const techniques = doctor.techniquesInvented ?? [];
const mentors = doctor.mentors ?? [];
const students = doctor.students ?? [];
const certifications = doctor.certifications ?? [];
const education = doctor.education ?? [];

const aiSummary =
	doctor.aiSummary ||
	generateAISummary({
		fullName: doctor.fullName,
		specialty: doctor.specialty,
		subSpecialty: doctor.subSpecialty || undefined,
		tier: doctor.tier,
		hIndex: doctor.hIndex,
		yearsActive: doctor.yearsActive,
		verifiedSurgeries: doctor.verifiedSurgeries,
		livesSaved: doctor.livesSaved,
		techniquesInvented: doctor.techniquesInvented,
		geography: { country: doctor.geography.country, region: doctor.geography.region || undefined, city: doctor.geography.city || undefined },
		affiliations: doctor.affiliations?.map((a) => ({ hospitalName: a.hospitalName, role: a.role || undefined, hospitalUrl: a.hospitalUrl || undefined })),
		biography: doctor.biography || undefined,
		status: doctor.status,
		dateOfBirth: doctor.dateOfBirth || undefined,
		dateOfDeath: doctor.dateOfDeath || undefined,
		citations: doctor.citations,
		awards: doctor.awards,
	});
const hasBio = !!doctor.biography && doctor.biography.replace(/<[^>]+>/g, "").trim().length > 50;

// Patient counts and outcome claims stay off the record (NMC Guidelines on Ethical Advertising, 8.1(iii)).
const plainWords = generatePatientSummary({
	fullName: doctor.fullName,
	specialty: specialtyLabel,
	subSpecialty: doctor.subSpecialty,
	yearsActive: doctor.yearsActive,
	verifiedSurgeries: 0,
	livesSaved: 0,
	techniquesInvented: techniques,
	hIndex: doctor.hIndex,
	totalCitations,
	geography: doctor.geography,
	affiliations: doctor.affiliations?.map((a) => ({ hospitalName: a.hospitalName, role: a.role })),
	status: doctor.status,
	dateOfBirth: doctor.dateOfBirth,
	dateOfDeath: doctor.dateOfDeath,
}).map((b) => b.text);

const expertise = [
	{ h: "Conditions treated", items: doctor.conditionsTreated ?? [], href: (t: string) => `/search?q=${encodeURIComponent(t)}` },
	{ h: "Rare conditions", items: doctor.rareConditions ?? [], href: (t: string) => `/search?q=${encodeURIComponent(t)}` },
	{ h: "Specialties", items: doctor.medicalSpecialty ?? [], href: (t: string) => `/doctors?specialty=${encodeURIComponent(t)}` },
	{ h: "Clinical knowledge and procedures", items: doctor.knowsAbout ?? [], href: (t: string) => `/search?q=${encodeURIComponent(t)}` },
].filter((g) => g.items.length > 0);

const galleryImages = [
	...(doctor.galleryUrls ?? []).map((url) => ({ url, title: doctor.fullName, source: undefined as string | undefined })),
	...(doctor.media ?? []).filter((m) => m.type === "IMAGE").map((m) => ({ url: m.url, title: m.title || doctor.fullName, source: m.source ?? undefined })),
];
function videoEmbed(url: string, videoId?: string | null): string | null {
	const yt = videoId || url.match(/(?:youtube(?:-nocookie)?\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{11})/)?.[1];
	if (yt) return `https://www.youtube-nocookie.com/embed/${yt}?rel=0&autoplay=1`;
	const vimeo = url.match(/vimeo\.com\/(?:video\/)?(\d+)/)?.[1];
	return vimeo ? `https://player.vimeo.com/video/${vimeo}?autoplay=1` : null;
}
const videos = (doctor.media ?? [])
	.filter((m) => m.type === "VIDEO")
	.map((m) => {
		const yt = m.video_id || m.url.match(/(?:v=|youtu\.be\/|embed\/|shorts\/)([\w-]{11})/)?.[1];
		return { ...m, embed: videoEmbed(m.url, m.video_id), thumb: m.thumbnail || (yt ? `https://i.ytimg.com/vi/${yt}/hqdefault.jpg` : null) };
	});
const documents = (doctor.media ?? []).filter((m) => m.type === "DOCUMENT");
const hasMedia = galleryImages.length > 0 || videos.length > 0 || documents.length > 0;

const portal = {
	languages: doctor.languagesSpoken ?? [],
	insurance: doctor.acceptedInsurance ?? [],
	philosophy: doctor.patientPhilosophy ?? null,
	booking: doctor.bookingUrl ?? null,
	fee: doctor.consultationFee ?? doctor.consultationPrice ?? null,
	teleFee: doctor.teleConsultationPrice ?? null,
};
const hasPractice = !isHistorical && !!(portal.languages.length || portal.insurance.length || portal.philosophy || portal.booking || portal.fee || portal.teleFee);

const pillars = [
	{ label: "Clinical mastery", value: doctor.clinicalMasteryIndex },
	{ label: "Intellectual legacy", value: doctor.intellectualLegacy },
	{ label: "Global mentorship", value: doctor.globalMentorshipScore },
	{ label: "Humanitarian impact", value: doctor.humanitarianImpact },
].filter((p): p is { label: string; value: number } => typeof p.value === "number" && p.value > 0);

const hasCareer = awards.length > 0 || timeline.length > 0 || talks.length > 0 || techniques.length > 0 || certifications.length > 0 || pillars.length > 0 || education.length > 0;

const standing = await getProfileStanding(slug, doctor.specialty, doctor.geography.country, doctor.hIndex);
let similar: Awaited<ReturnType<typeof getSimilarDoctors>> = [];
try {
	similar = await getSimilarDoctors({
		currentSlug: slug,
		specialty: doctor.specialty,
		country: doctor.geography.country,
		tier: doctor.tier,
		subSpecialty: doctor.subSpecialty,
		techniques,
		journals: topJournals,
		hIndex: doctor.hIndex,
	});
} catch {
	similar = [];
}

const TIERS: Record<string, { name: string; tier: string; color: string }> = {
	TITAN: { name: "TITAN", tier: "TIER I", color: "#b08a35" },
	ELITE: { name: "ELITE", tier: "TIER II", color: "#1f5c45" },
	MASTER: { name: "MASTER", tier: "TIER III", color: "#0e3b2e" },
};
const tier = TIERS[doctor.tier] ?? null;
const reviewed = !!(doctor.manuallyVerified || doctor.licenseVerified);
const updated = doctor.updatedAt ? new Date(doctor.updatedAt) : null;
const created = doctor.createdAt ? new Date(doctor.createdAt) : null;
const fmtShort = (d: Date) => d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "2-digit", timeZone: "UTC" });
const fmtLong = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const lifeYears = (() => {
	const b = doctor.dateOfBirth ? new Date(doctor.dateOfBirth).getUTCFullYear() : null;
	const d = doctor.dateOfDeath ? new Date(doctor.dateOfDeath).getUTCFullYear() : null;
	if (isHistorical) return b || d ? `${b ?? "?"}–${d ?? "?"}` : null;
	return null;
})();

const ring = tier
	? `${tier.name} · ${tier.tier} · MDRPEDIA · ${reviewed ? "VERIFIED" : "LISTED"}${updated ? ` ${updated.getUTCFullYear()}` : ""} ·`
	: `THE PHYSICIANS' REGISTER · MDRPEDIA · ${reviewed ? "VERIFIED" : "LISTED"} ·`;

const stats = [
	doctor.hIndex > 0 && { v: doctor.hIndex.toLocaleString("en-US"), l: "h-index (OpenAlex)" },
	citations.length > 0 && { v: citations.length.toLocaleString("en-US"), l: pubmedLinked ? `Papers on record · ${pubmedLinked} on PubMed` : "Papers on record" },
	totalCitations > 0 && { v: totalCitations.toLocaleString("en-US"), l: "Citations to these papers" },
	{ v: tier ? tier.tier.replace("TIER", "Tier") : "Listed", l: "Stature" },
	doctor.yearsActive > 0 && { v: String(doctor.yearsActive), l: isHistorical ? "Years in practice" : "Years in practice" },
	updated && { v: fmtShort(updated), l: "Last updated" },
].filter((s): s is { v: string; l: string } => !!s).slice(0, 5);

const ordinal = (n: number) => `${n}${n % 100 >= 11 && n % 100 <= 13 ? "th" : ["th", "st", "nd", "rd"][n % 10] ?? "th"}`;
type Row = { k: string; v: string; src: string; st: "ok" | "pub" | "no" };
const ok = (k: string, v: string, src: string): Row => ({ k, v, src, st: "ok" });
const pub = (k: string, v: string, src: string): Row => ({ k, v, src, st: "pub" });
const no = (k: string, v: string, src: string): Row => ({ k, v, src, st: "no" });
const ST = { ok: "✓ Verified", pub: "◐ Public record", no: "○ Not reported" };
const activeCerts = certifications.filter((c) => c.isActive);
const ethicsApproved = doctor.ethics?.status === "APPROVED";
const evidence: { h: string; rows: Row[] }[] = [
	{
		h: "I · SCHOLARSHIP",
		rows: [
			doctor.hIndex > 0
				? (openalexId ? ok : pub)("h-index", standing.hIndexPercentile !== null ? `${doctor.hIndex} · ${ordinal(standing.hIndexPercentile)} pct` : String(doctor.hIndex), "OpenAlex")
				: no("h-index", "—", "OpenAlex"),
			citations.length > 0
				? (pubmedLinked ? ok : pub)("Papers on record", String(citations.length), pubmedLinked ? `PubMed · ${pubmedLinked === citations.length ? "all" : pubmedLinked} linked` : "Crossref / DOI")
				: no("Papers on record", "—", "PubMed"),
			totalCitations > 0 ? pub("Citations received", totalCitations.toLocaleString("en-US"), "OpenAlex") : no("Citations received", "—", "OpenAlex"),
		],
	},
	{
		h: "II · PRACTICE",
		rows: [
			doctor.licenseVerified ? ok("Licence", "Checked", "Issuing board") : no("Licence", isHistorical ? "Historical record" : "Not yet checked", "Medical council"),
			activeCerts.length
				? (activeCerts.some((c) => c.verified) ? ok : pub)("Board certification", activeCerts.length === 1 ? "Current" : `${activeCerts.length} current`, activeCerts[0].issuingBody)
				: no("Board certification", "—", "Specialty boards"),
			doctor.npiNumber ? ok("Registration", `NPI ${doctor.npiNumber}`, "NPPES") : no("Registration ID", "—", "National registry"),
			(doctor.affiliations?.length ?? 0) > 0
				? pub("Institutions", String(doctor.affiliations!.length), "Institution records")
				: no("Institutions", "—", "Institution records"),
		],
	},
	{
		h: "III · LEARNING & TEACHING",
		rows: [
			students.length ? pub("Trainees traced", String(students.length), "Lineage") : no("Trainees traced", "Not yet traced", "Lineage"),
			mentors.length ? pub("Mentors traced", String(mentors.length), "Lineage") : no("Mentors traced", "Not yet traced", "Lineage"),
			talks.length ? pub("Invited talks", String(talks.length), "Congress programmes") : no("Invited talks", "—", "Congress programmes"),
		],
	},
	{
		h: "IV · PEER STANDING",
		rows: [
			awards.length ? (awards.some((a) => a.sourceUrl) ? ok : pub)("Honours", String(awards.length), "Awarding bodies") : no("Honours", "—", "Awarding bodies"),
			techniques.length ? pub("Techniques pioneered", String(techniques.length), "Published literature") : no("Techniques pioneered", "—", "Published literature"),
			isHistorical
				? no("Ethics mark", "Not applicable", "MDRPedia audit")
				: ethicsApproved
				? ok("Ethics mark", doctor.ethics?.tier ? doctor.ethics.tier.charAt(0) + doctor.ethics.tier.slice(1).toLowerCase() : "Awarded", "MDRPedia audit")
				: no("Ethics mark", "Not yet audited", "MDRPedia audit"),
		],
	},
];

const sources = new Set<string>();
if (openalexId || doctor.hIndex > 0) sources.add("OpenAlex");
if (doctor.orcidId) sources.add("ORCID");
if (doctor.npiNumber) sources.add("NPPES");
if (pubmedLinked) sources.add("PubMed");
if (citations.some((c) => c.doi)) sources.add("Crossref");
if (doctor.affiliations?.length) sources.add("Institutions");
if (awards.some((a) => a.sourceUrl)) sources.add("Awarding bodies");
if (doctor.portraitUrl?.includes("wikimedia.org")) sources.add("Wikimedia Commons");

const facts = [
	{ k: "Specialty", v: specialtyLabel },
	doctor.subSpecialty && { k: "Focus", v: doctor.subSpecialty },
	primaryInstitution && { k: "Institution", v: primaryInstitution },
	country && { k: "Country", v: country },
	doctor.dateOfBirth && { k: "Born", v: fmtLong(new Date(doctor.dateOfBirth)) },
	isHistorical && doctor.dateOfDeath && { k: "Died", v: fmtLong(new Date(doctor.dateOfDeath)) },
	!isHistorical && { k: "Ethics mark", v: ethicsApproved ? `Awarded${doctor.ethics?.certId ? ` · ${doctor.ethics.certId}` : ""}` : "Not yet audited" },
	!isHistorical && { k: "Record", v: isUnclaimed ? "Not claimed" : doctor.claimStatus === "VERIFIED" ? "Claimed by the doctor" : "Claim under review" },
].filter((f): f is { k: string; v: string } => !!f);
const identifiers = [
	doctor.npiNumber && { k: "NPI", v: doctor.npiNumber, href: `https://npiregistry.cms.hhs.gov/provider-view/${doctor.npiNumber}` },
	doctor.orcidId && { k: "ORCID", v: doctor.orcidId, href: `https://orcid.org/${doctor.orcidId}` },
	openalexId && { k: "OpenAlex", v: openalexId, href: `https://openalex.org/${openalexId}` },
].filter((f): f is { k: string; v: string; href: string } => !!f);

const history = [
	updated && { d: updated, t: reviewed ? "Record reviewed by editors" : "Record updated" },
	updated && pubmedLinked > 0 && { d: updated, t: `${pubmedLinked} ${pubmedLinked === 1 ? "paper" : "papers"} linked to PubMed` },
	doctor.ethics?.certifiedAt && ethicsApproved && { d: new Date(doctor.ethics.certifiedAt), t: "Ethics mark awarded" },
	created && { d: created, t: tier ? `Entered the register · ${tier.name.charAt(0) + tier.name.slice(1).toLowerCase()}` : "Entered the register" },
].filter((h): h is { d: Date; t: string } => !!h);

const tabs = [
	{ id: "record", label: "Record" },
	citations.length > 0 && { id: "publications", label: `Publications · ${citations.length}` },
	hasCareer && { id: "career", label: "Career & honours" },
	{ id: "lineage", label: "Lineage" },
	hasMedia && { id: "media", label: "Media" },
	hasPractice && { id: "practice", label: "Practice details" },
].filter((t): t is { id: string; label: string } => !!t);

const crumbs = [
	country && { label: country, href: `/geography/${slugify(country)}` },
	region && { label: region },
	city && { label: city },
	standing.groupSlug ? { label: specialtyLabel, href: standing.countryHub ?? `/specialty/${standing.groupSlug}` } : { label: specialtyLabel },
].filter((c): c is { label: string; href?: string } => !!c);

const browse = [
	standing.countryHub && country && standing.groupName && { label: `${standing.groupName} doctors in ${country}`, href: standing.countryHub },
	standing.groupSlug && standing.groupName && { label: `All ${standing.groupName.toLowerCase()} doctors`, href: `/specialty/${standing.groupSlug}` },
	country && { label: `Doctors in ${country}`, href: `/geography/${slugify(country)}` },
	{ label: "Top 100 physicians", href: "/rankings/top-100" },
].filter((b): b is { label: string; href: string } => !!b);

const citeDate = updated ?? new Date();
const citation = `MDRPedia. (${citeDate.getUTCFullYear()}, ${citeDate.toLocaleDateString("en-US", { month: "long", day: "numeric", timeZone: "UTC" })}). ${doctor.fullName}. In MDRPedia: The Physicians' Register. ${pageUrl}`;
const shareText = `${doctor.fullName} — ${specialtyLabel} | MDRPedia`;
const embedCode = `<a href="${pageUrl}" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;padding:8px 14px;background:#fbf8f1;border:1px solid #0e3b2e;color:#0e3b2e;font:600 14px/1.3 system-ui,sans-serif;text-decoration:none">${doctor.fullName}<span style="color:#7a5c16;font-weight:400">· MDRPedia${tier ? ` · ${tier.tier}` : ""}</span></a>`;

const titleParts = [specialtyLabel, city].filter(Boolean);
const pageTitle = titleParts.length ? `${doctor.fullName} — ${titleParts.join(", ")} | MDRPedia` : `${doctor.fullName} | MDRPedia`;
const ogImageUrl = new URL(`/og/${slug}.png`, site).href;
const institutionHref = (a: { hospitalSlug?: string | null }) => (a.hospitalSlug ? `/institutions/${a.hospitalSlug}` : null);
const ALLOWED_TAGS = /<(?!\/?(p|br|em|strong|i|b|a|ul|ol|li)\b)[^>]*>/gi;
const bioHtml = hasBio ? doctor.biography!.replace(/<(script|style)[\s\S]*?<\/\1>/gi, "").replace(ALLOWED_TAGS, "").replace(/\son\w+\s*=\s*("[^"]*"|'[^']*'|[^\s>]+)/gi, "").replace(/href\s*=\s*(["'])\s*javascript:[^"']*\1/gi, 'href="#"') : "";
---

<SiteLayout title={pageTitle} description={aiSummary.slice(0, 160)} active="register" ogImage={ogImageUrl}>
	<JsonLd
		fullName={doctor.fullName}
		specialty={specialtyLabel}
		subSpecialty={doctor.subSpecialty || undefined}
		biography={doctor.biography || undefined}
		portraitUrl={doctor.portraitUrl || undefined}
		geography={{ country: doctor.geography.country, region: doctor.geography.region || undefined, city: doctor.geography.city || undefined }}
		citations={doctor.citations}
		tier={doctor.tier}
		hIndex={doctor.hIndex}
		yearsActive={doctor.yearsActive}
		url={pageUrl}
		media={doctor.media}
		npiNumber={doctor.npiNumber || undefined}
		orcidId={doctor.orcidId || undefined}
		openalexId={doctor.openalexId || undefined}
		education={doctor.education}
		boardCertifications={certifications.map((c) => ({ boardName: c.boardName, specialty: c.specialty }))}
		medicalSpecialty={doctor.medicalSpecialty}
		knowsAbout={doctor.knowsAbout}
		affiliations={doctor.affiliations?.map((a) => ({ hospitalName: a.hospitalName, role: a.role || undefined, hospitalUrl: a.hospitalUrl || undefined }))}
		aiSummary={aiSummary || undefined}
		dateOfBirth={doctor.dateOfBirth || undefined}
		dateOfDeath={doctor.dateOfDeath || undefined}
		mentors={doctor.mentors}
		students={doctor.students}
		createdAt={doctor.createdAt}
		updatedAt={doctor.updatedAt}
	/>
	<MedicalKnowledgeGraph
		slug={slug}
		fullName={doctor.fullName}
		specialty={doctor.specialty}
		subSpecialty={doctor.subSpecialty || undefined}
		biography={doctor.biography || undefined}
		aiSummary={aiSummary || undefined}
		portraitUrl={doctor.portraitUrl || undefined}
		geography={{ country: doctor.geography.country, region: doctor.geography.region || undefined, city: doctor.geography.city || undefined }}
		tier={doctor.tier}
		hIndex={doctor.hIndex}
		yearsActive={doctor.yearsActive}
		url={pageUrl}
		npiNumber={doctor.npiNumber || undefined}
		orcidId={doctor.orcidId || undefined}
		dateOfBirth={doctor.dateOfBirth || undefined}
		dateOfDeath={doctor.dateOfDeath || undefined}
		medicalSpecialty={doctor.medicalSpecialty}
		knowsAbout={doctor.knowsAbout}
		conditionsTreated={doctor.conditionsTreated}
		rareConditions={doctor.rareConditions}
		affiliations={doctor.affiliations?.map((a) => ({ hospitalName: a.hospitalName, role: a.role || undefined, hospitalUrl: a.hospitalUrl || undefined }))}
		techniques={techniques.map((name) => ({
			name,
			yearInvented: timeline.find((t) => t.title.toLowerCase().includes(name.toLowerCase()) || t.description?.toLowerCase().includes(name.toLowerCase()))?.year,
			isGoldStandard: doctor.hasInvention,
		}))}
		citations={citations.map((c) => ({ doi: c.doi, pubmedId: c.pubmedId, title: c.title, journal: c.journal, year: c.year, abstract: c.abstract, citationCount: c.totalCitationCount, isOpenAccess: c.isOpenAccess }))}
		awards={awards.map((a) => ({ name: a.name, year: a.year, issuingBody: a.issuingBody || undefined }))}
		mentors={doctor.mentors}
		students={doctor.students}
		talks={doctor.talks}
	/>

	<article class="p-record" aria-labelledby="profile-name">
		<nav class="p-wrap p-crumbs" aria-label="Breadcrumb">
			<ol>
				{crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>)}
				<li><span aria-current="page">{doctor.fullName}</span></li>
			</ol>
		</nav>

		<header class="p-wrap p-hero">
			<div class="p-hero__rule">
				<div class={`p-portrait${hasImage ? "" : " p-portrait--initials"}`}>
