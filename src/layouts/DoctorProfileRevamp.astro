---
/**
 * MDRPedia — Premium Doctor Profile Layout
 * A world-class medical professional profile experience
 */

import Layout from "./Layout.astro";
import JsonLd from "../components/JsonLd.astro";
import MedicalKnowledgeGraph from "../components/MedicalKnowledgeGraph.astro";
import TierBadge from "../components/TierBadge.astro";
import SimilarDoctors from "../components/SimilarDoctors.astro";
import ImpactVoteButton from "../components/ImpactVoteButton";
import { generateAISummary } from "../lib/ai-summary";
import ClaimProfile from "../components/ClaimProfile.astro";
import PatientFriendlySummary from "../components/PatientFriendlySummary.astro";
import ResearchTimelineChart from "../components/ResearchTimelineChart.astro";
import Top100Badge from "../components/Top100Badge.astro";
import { getTop100Rank } from "../lib/ranking";
import { normalizeSpecialty } from "../lib/specialty-groups";

// Premium Components
import MediaVault from "../components/MediaVault.astro";
import MedicalLineageGraph from "../components/MedicalLineageGraph";
import AwardsRibbon from "../components/AwardsRibbon.astro";
import LegacyTimeline from "../components/LegacyTimeline.astro";
import ProfileEmbed from "../components/ProfileEmbed.astro";

import { classifyAward, HonorTier } from "../lib/global-honors";
import type { ProfileData } from "../lib/types";
import { getInstitutionLogo, getInstitutionInitials, getInstitutionColor } from "../lib/institution-logos";

interface Props {
    doctor: ProfileData;
    profileId?: string;
}

const { doctor, profileId } = Astro.props;

// --- Data Preparation ---
const isHistorical = doctor.status === "HISTORICAL";
const hasImage = doctor.portraitUrl && !doctor.portraitUrl.startsWith("data:image/svg");
const initials = doctor.fullName
    .split(" ")
    .map((w) => w[0])
    .filter((_, i) => i < 2)
    .join("")
    .toUpperCase();

const location = [doctor.geography.city, doctor.geography.region, doctor.geography.country]
    .filter(Boolean)
    .filter(v => v !== "Unknown")
    .join(", ") || doctor.geography.country;

// Total Citations - handle both citationCount and totalCitationCount field names
const totalCitations = doctor.citations?.reduce((acc, curr) => {
    const count = (curr as any).citationCount ?? curr.totalCitationCount ?? 0;
    return acc + count;
}, 0) || 0;

// Total Impact — use the pre-calculated value from the page (single source of truth)
const totalImpact = doctor.totalImpact || 0;

// AI Summary with fallback
const aiSummary = doctor.aiSummary || generateAISummary({
    fullName: doctor.fullName,
    specialty: doctor.specialty,
    subSpecialty: doctor.subSpecialty || undefined,
    tier: doctor.tier,
    hIndex: doctor.hIndex,
    yearsActive: doctor.yearsActive,
    verifiedSurgeries: doctor.verifiedSurgeries,
    livesSaved: doctor.livesSaved,
    techniquesInvented: doctor.techniquesInvented,
    geography: {
        country: doctor.geography.country,
        region: doctor.geography.region || undefined,
        city: doctor.geography.city || undefined,
    },
    affiliations: doctor.affiliations?.map((a) => ({
        hospitalName: a.hospitalName,
        role: a.role || undefined,
        hospitalUrl: a.hospitalUrl || undefined,
    })),
    biography: doctor.biography || undefined,
    status: doctor.status,
    dateOfBirth: doctor.dateOfBirth || undefined,
    dateOfDeath: doctor.dateOfDeath || undefined,
    citations: doctor.citations,
    awards: doctor.awards,
});

// Tier gradients
const tierGradients: Record<string, string> = {
    TITAN: "var(--paper-2)",
    ELITE: "var(--paper-2)",
    MASTER: "var(--paper-2)",
    UNRANKED: "var(--paper-2)",
};

const heroGradient = tierGradients[doctor.tier] || tierGradients.UNRANKED;
const slug = Astro.url.pathname.split("/").filter(Boolean).pop() || "";

// Top 100 rank (null if not in top 100)
let top100Rank: number | null = null;
try { top100Rank = await getTop100Rank(slug); } catch {};

// Computed data quality flags
const hasMeaningfulBio = doctor.biography && doctor.biography.length > 50;
const hasAffiliations = doctor.affiliations && doctor.affiliations.length > 0;
const hasPublications = doctor.citations && doctor.citations.length > 0;
const hasRibbonAwards = !!doctor.awards?.some((a) => classifyAward(a.name).tier !== HonorTier.UNCLASSIFIED);
const hasTimeline = doctor.timeline && doctor.timeline.length > 0;
const hasLineage = (doctor.mentors && doctor.mentors.length > 0) || (doctor.students && doctor.students.length > 0);
const hasMedia = hasImage || (doctor.galleryUrls && doctor.galleryUrls.length > 0) || (doctor.media && doctor.media.length > 0);

// Citation milestone
const citationMilestone = totalCitations >= 50000 ? '50K+' : totalCitations >= 10000 ? '10K+' : totalCitations >= 5000 ? '5K+' : totalCitations >= 1000 ? '1K+' : null;

// Four Pillars score breakdown
const hasFourPillars = !!(doctor.clinicalMasteryIndex || doctor.intellectualLegacy || doctor.globalMentorshipScore || doctor.humanitarianImpact);
const pillars = hasFourPillars ? [
    { label: 'Clinical Mastery', value: doctor.clinicalMasteryIndex ?? 0, icon: 'M22 12h-4l-3 9L9 3l-3 9H2' },
    { label: 'Intellectual Legacy', value: doctor.intellectualLegacy ?? 0, icon: 'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z' },
    { label: 'Global Mentorship', value: doctor.globalMentorshipScore ?? 0, icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75' },
    { label: 'Humanitarian Impact', value: doctor.humanitarianImpact ?? 0, icon: 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z' },
] : [];

// Top journals from citations
const topJournals = [...new Set(doctor.citations?.map(c => c.journal).filter((j): j is string => !!j) || [])].slice(0, 5);

// The <title> is the highest-value slot on the page. "<Name> — MDRPedia"
// on all ~1,150 profiles wastes it; specialty and city are already in scope.
const titleParts = [normalizeSpecialty(doctor.specialty), doctor.geography.city]
    .filter((v): v is string => !!v && v !== "Unknown");
const pageTitle = titleParts.length
    ? `${doctor.fullName} — ${titleParts.join(", ")} | MDRPedia`
    : `${doctor.fullName} | MDRPedia`;

// Astro.site is a URL; interpolating it into a template string yields a
// trailing slash and so a double slash in the path.
const ogImageUrl = new URL(`/og/${slug}.png`, Astro.site ?? "https://mdrpedia.com").href;

function institutionHref(aff: { hospitalName: string; hospitalSlug?: string | null }): string | null {
    if (aff.hospitalSlug) return `/institutions/${aff.hospitalSlug}`;
    const fallback = aff.hospitalName
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
    return fallback ? `/institutions/${fallback}` : null;
}

const portraitOrigin = (() => {
    if (!hasImage || !doctor.portraitUrl) return null;
    try {
        const u = new URL(doctor.portraitUrl);
        return u.origin === Astro.url.origin ? null : u.origin;
    } catch {
        return null;
    }
})();

const isUnclaimed = !doctor.claimStatus || doctor.claimStatus === "UNCLAIMED";
const consultationFee = doctor.consultationFee ?? doctor.consultationPrice ?? null;
const showConsultation = !isHistorical && !!doctor.bookingUrl && !!(consultationFee || doctor.teleConsultationPrice);

const metrics = [
    { label: "H-Index", value: doctor.hIndex, impact: false },
    { label: "Citations", value: totalCitations, impact: false },
    { label: "Surgeries", value: doctor.verifiedSurgeries, impact: false },
    { label: "Lives Saved", value: doctor.livesSaved, impact: false },
    { label: "Years Active", value: doctor.yearsActive, impact: false },
    { label: "Total Impact", value: totalImpact, impact: true },
].filter((m) => m.value > 0);

const PUBLICATIONS_COLLAPSED = 5;
const publications = doctor.citations ?? [];
---

<Layout
    title={pageTitle}
    description={aiSummary.slice(0, 160)}
    tier={doctor.tier}
    ogType="profile"
    ogImage={ogImageUrl}
>
    {portraitOrigin && <link rel="preconnect" href={portraitOrigin} />}
    <JsonLd
        fullName={doctor.fullName}
        specialty={doctor.specialty}
        subSpecialty={doctor.subSpecialty || undefined}
        biography={doctor.biography || undefined}
        portraitUrl={doctor.portraitUrl || undefined}
        geography={{
            country: doctor.geography.country,
            region: doctor.geography.region || undefined,
            city: doctor.geography.city || undefined,
        }}
        citations={doctor.citations}
        tier={doctor.tier}
        hIndex={doctor.hIndex}
        yearsActive={doctor.yearsActive}
        url={Astro.url.href}
        media={doctor.media}
        npiNumber={doctor.npiNumber || undefined}
        orcidId={doctor.orcidId || undefined}
        openalexId={doctor.openalexId || undefined}
        education={doctor.education}
        medicalSpecialty={doctor.medicalSpecialty}
        knowsAbout={doctor.knowsAbout}
        affiliations={doctor.affiliations?.map((a) => ({
            hospitalName: a.hospitalName,
            role: a.role || undefined,
            hospitalUrl: a.hospitalUrl || undefined,
        }))}
        aiSummary={aiSummary || undefined}
        dateOfBirth={doctor.dateOfBirth || undefined}
        dateOfDeath={doctor.dateOfDeath || undefined}
        mentors={doctor.mentors}
        students={doctor.students}
        createdAt={doctor.createdAt}
        updatedAt={doctor.updatedAt}
    />

    <!-- Medical Knowledge Graph: Interconnected Doctor → Hospital → Technique → Citation -->
    <MedicalKnowledgeGraph
        slug={slug}
        fullName={doctor.fullName}
        specialty={doctor.specialty}
        subSpecialty={doctor.subSpecialty || undefined}
        biography={doctor.biography || undefined}
        aiSummary={aiSummary || undefined}
        portraitUrl={doctor.portraitUrl || undefined}
        geography={{
            country: doctor.geography.country,
            region: doctor.geography.region || undefined,
            city: doctor.geography.city || undefined,
        }}
        tier={doctor.tier}
        hIndex={doctor.hIndex}
        yearsActive={doctor.yearsActive}
        url={Astro.url.href}
        npiNumber={doctor.npiNumber || undefined}
        orcidId={doctor.orcidId || undefined}
        dateOfBirth={doctor.dateOfBirth || undefined}
        dateOfDeath={doctor.dateOfDeath || undefined}
        medicalSpecialty={doctor.medicalSpecialty}
        knowsAbout={doctor.knowsAbout}
        conditionsTreated={doctor.conditionsTreated}
        rareConditions={doctor.rareConditions}
        affiliations={doctor.affiliations?.map((a) => ({
            hospitalName: a.hospitalName,
            role: a.role || undefined,
            hospitalUrl: a.hospitalUrl || undefined,
        }))}
        techniques={doctor.techniquesInvented?.map((name, i) => ({
            name,
            yearInvented: doctor.timeline?.find(t =>
                t.title.toLowerCase().includes(name.toLowerCase()) ||
                t.description?.toLowerCase().includes(name.toLowerCase())
            )?.year,
            isGoldStandard: doctor.hasInvention,
        })) || []}
        citations={doctor.citations?.map((c) => ({
            doi: c.doi,
            pubmedId: c.pubmedId,
            title: c.title,
            journal: c.journal,
            year: c.year,
            abstract: c.abstract,
            citationCount: c.totalCitationCount,
            isOpenAccess: c.isOpenAccess,
        }))}
        awards={doctor.awards?.map((a) => ({
            name: a.name,
            year: a.year,
            issuingBody: a.issuingBody || undefined,
        }))}
        mentors={doctor.mentors}
        students={doctor.students}
        talks={doctor.talks}
    />

    <article class={`doctor-profile tier-${doctor.tier.toLowerCase()}`}>
        <!-- ═══════════════════ HERO SECTION ═══════════════════ -->
        <header class="hero" style={`background: ${heroGradient};`}>
            <div class="hero__container">
                <!-- Portrait Column -->
                <div class="hero__portrait-col">
                    <div class={`hero__frame hero__frame--${doctor.tier.toLowerCase()}`}>
                        {hasImage ? (
                            <img src={doctor.portraitUrl} alt={doctor.fullName} class="hero__image" loading="eager" fetchpriority="high" decoding="async" width="280" height="280" />
                        ) : (
                            <div class="hero__initials">{initials}</div>
                        )}
                    </div>

                    {/* Quick verification badges */}
                    <div class="hero__badges">
                        {doctor.npiNumber && <span class="verify-badge" title="NPI Verified">✓ NPI</span>}
                        {doctor.orcidId && (
                            <a href={`https://orcid.org/${doctor.orcidId}`} target="_blank" rel="noopener" class="verify-badge">✓ ORCID</a>
                        )}
                    </div>
                </div>

                <!-- Info Column -->
                <div class="hero__info-col">
                    <div class="hero__tier-row">
                        <TierBadge tier={doctor.tier as any} />
                        {isHistorical && <span class="historical-tag">Historical Figure</span>}
                        {top100Rank && <Top100Badge rank={top100Rank} />}
                    </div>

                    <h1 class="hero__name" id="profile-name">{doctor.fullName}</h1>

                    <p class="hero__specialty">
                        <a href={`/doctors?specialty=${encodeURIComponent(doctor.specialty)}`} class="hero__specialty-link">
                            {doctor.specialty}
                        </a>
                        {doctor.subSpecialty && <span class="hero__subspecialty"> · {doctor.subSpecialty}</span>}
                    </p>

                    {location && location !== "Unknown" && (
                        <p class="hero__location">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                            </svg>
                            {location}
                        </p>
                    )}

                    <!-- Key Metrics Grid -->
                    <div class="hero__metrics">
                        {metrics.map((m) => (
                            <div class={m.impact ? "metric metric--impact" : "metric"}>
                                <span class="metric__value js-counter" data-target={m.value} aria-hidden="true">{m.value.toLocaleString()}</span>
                                <span class="sr-only">{m.value.toLocaleString()}</span>
                                <span class="metric__label">{m.label}</span>
                            </div>
                        ))}
                    </div>

                    <!-- Action Buttons -->
                    <div class="hero__actions">
                        <ImpactVoteButton
                            client:idle
                            slug={slug}
                            profileId={profileId}
                            doctorName={doctor.fullName}
                        />
                        <ProfileEmbed
                            slug={slug}
                            fullName={doctor.fullName}
                            specialty={doctor.specialty}
                            tier={doctor.tier}
                            hasImage={!!hasImage}
                            totalImpact={totalImpact}
                            hIndex={doctor.hIndex}
                            livesSaved={doctor.livesSaved}
                        />
                        {isUnclaimed && (
                            <a href="#claim-profile" class="btn btn--outline">Claim Profile</a>
                        )}
                    </div>
                </div>
            </div>
        </header>

        <!-- ═══════════════════ AWARDS RIBBON ═══════════════════ -->
        {hasRibbonAwards && (
            <section class="awards-ribbon-section">
                <div class="container">
                    <AwardsRibbon awards={doctor.awards!.map(a => ({
                        name: a.name,
                        year: a.year,
                        issuingBody: a.issuingBody ?? undefined,
                        sourceUrl: a.sourceUrl ?? undefined,
                    }))} />
                </div>
            </section>
        )}

        <!-- ═══════════════════ MAIN CONTENT ═══════════════════ -->
        <div class="content-wrapper">
            <div class="container">
                <div class="content-grid">
                    <!-- Main Column -->
                    <div class="main-col">

                        <!-- Overview / Summary -->
                        <section class="card card--overview">
                            <h2 class="card__title">
                                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
                                </svg>
                                Overview
                            </h2>
                            <p class="card__summary" id="ai-summary-content">{aiSummary}</p>

                            <!-- Patient-Friendly Summary -->
                            <PatientFriendlySummary doctor={doctor} totalCitations={totalCitations} />
                        </section>

                        <!-- Four Pillars Score Breakdown -->
                        {hasFourPillars && (
                            <section class="card card--pillars">
                                <h2 class="card__title">
                                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M18 20V10M12 20V4M6 20v-6"/>
                                    </svg>
                                    Impact Score Breakdown
                                </h2>
                                <p class="pillars__intro">Four pillars that compose the MDRPedia Impact Quotient.</p>
                                <div class="pillars__grid">
                                    {pillars.map(p => {
                                        const pct = Math.max(0, Math.min(Math.round(p.value), 100));
                                        return (
                                            <div class="pillar">
                                                <div class="pillar__head">
                                                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d={p.icon}/></svg>
                                                    <span class="pillar__label">{p.label}</span>
                                                    <span class="pillar__value">{pct}</span>
                                                </div>
                                                <div class="pillar__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={pct} aria-label={p.label}>
                                                    <div class="pillar__fill" style={`width: ${pct}%`} />
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>
                            </section>
                        )}

                        <!-- Biography -->
                        {hasMeaningfulBio && (
                            <section class="card">
                                <h2 class="card__title">Biography</h2>
                                <div class="prose" set:html={doctor.biography} />
                            </section>
                        )}

                        <!-- Affiliations & Institutions -->
                        {hasAffiliations && (
                            <section class="card">
                                <h2 class="card__title">
                                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                    </svg>
                                    Affiliations & Institutions
                                </h2>
                                <div class="affiliations-grid">
                                    {doctor.affiliations!.map((aff) => {
                                        const logoUrl = getInstitutionLogo(aff.hospitalName);
                                        const initials = getInstitutionInitials(aff.hospitalName);
                                        const bgColor = getInstitutionColor(aff.hospitalName);
                                        const href = institutionHref(aff);
                                        const Tag = href ? "a" : "div";
                                        return (
                                            <Tag
                                                href={href ?? undefined}
                                                class="affiliation-card"
                                            >
                                                <div class="affiliation-card__logo">
                                                    {logoUrl ? (
                                                        <img
                                                            src={logoUrl}
                                                            alt={aff.hospitalName}
                                                            loading="lazy"
                                                            class="js-logo"
                                                            width="40"
                                                            height="40"
                                                        />
                                                        <div class="affiliation-card__initials" style={`background: ${bgColor}; display: none;`}>
                                                            {initials}
                                                        </div>
                                                    ) : (
                                                        <div class="affiliation-card__initials" style={`background: ${bgColor};`}>
                                                            {initials}
                                                        </div>
                                                    )}
                                                </div>
                                                <div class="affiliation-card__info">
                                                    <h3 class="affiliation-card__name">{aff.hospitalName}</h3>
                                                    {aff.role && <p class="affiliation-card__role">{aff.role}</p>}
                                                </div>
                                                {href && (
                                                    <svg class="affiliation-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                        <path d="M5 12h14M12 5l7 7-7 7"/>
                                                    </svg>
                                                )}
                                            </Tag>
                                        );
                                    })}
                                </div>
                            </section>
                        )}

                        <!-- Research Impact -->
                        {hasPublications && (
                            <section class="card">
                                <h2 class="card__title">
                                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                                    </svg>
                                    Research Impact
                                </h2>

                                <!-- Research Stats Bar -->
                                <div class="research-stats">
                                    <div class="research-stat">
                                        <span class="research-stat__value">{doctor.citations!.length}</span>
                                        <span class="research-stat__label">Publications</span>
                                    </div>
                                    <div class="research-stat">
                                        <span class="research-stat__value">{totalCitations.toLocaleString()}</span>
                                        <span class="research-stat__label">Total Citations</span>
                                    </div>
                                    {citationMilestone && (
                                        <div class="research-stat research-stat--highlight">
                                            <span class="research-stat__value">{citationMilestone}</span>
                                            <span class="research-stat__label">Citation Milestone</span>
                                        </div>
                                    )}
                                </div>

                                {/* Research Timeline Chart */}
                                <ResearchTimelineChart citations={doctor.citations!} />

                                {/* Top Journals */}
                                {topJournals.length > 0 && (
                                    <div class="journals-section">
                                        <h3 class="journals-title">Published In</h3>
                                        <div class="journals-list">
                                            {topJournals.map(journal => (
                                                <span class="journal-tag">{journal}</span>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                <!-- Key Publications -->
                                <div class="publications-list" id="publications">
                                    <h3 class="publications-title">Key Publications</h3>
                                    {publications.slice(0, PUBLICATIONS_COLLAPSED).map((citation) => (
                                        <article class="publication">
                                            <h4 class="publication__title">
                                                {citation.doi ? (
                                                    <a
                                                        href={`https://doi.org/${citation.doi}`}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                    >
                                                        {citation.title}
                                                    </a>
                                                ) : (
                                                    <span>{citation.title}</span>
                                                )}
                                            </h4>
                                            <div class="publication__meta">
                                                {citation.journal && <span class="publication__journal">{citation.journal}</span>}
                                                {citation.year && <span class="publication__year">{citation.year}</span>}
                                                {(((citation as any).citationCount ?? citation.totalCitationCount ?? 0) > 0) && (
                                                    <span class="publication__citations">
                                                        {((citation as any).citationCount ?? citation.totalCitationCount ?? 0).toLocaleString()} citations
                                                    </span>
                                                )}
                                            </div>
                                            <div class="publication__links">
                                                {citation.doi && (
                                                    <a href={`https://doi.org/${citation.doi}`} target="_blank" rel="noopener" class="pub-link" title="DOI">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                                                            <polyline points="15 3 21 3 21 9"/>
                                                            <line x1="10" y1="14" x2="21" y2="3"/>
                                                        </svg>
                                                        DOI
                                                    </a>
                                                )}
                                                {citation.pubmedId && (
                                                    <a href={`https://pubmed.ncbi.nlm.nih.gov/${citation.pubmedId}`} target="_blank" rel="noopener" class="pub-link pub-link--pubmed" title="PubMed">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M4 19.5A2.5 2.5 0 016.5 17H20"/>
                                                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>
                                                        </svg>
                                                        PubMed
                                                    </a>
                                                )}
                                                {citation.isOpenAccess && citation.openAccessUrl && (
                                                    <a href={citation.openAccessUrl} target="_blank" rel="noopener" class="pub-link pub-link--oa" title="Open Access">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                                                        </svg>
                                                        Free PDF
                                                    </a>
                                                )}
                                            </div>
                                        </article>
                                    ))}

                                    {publications.length > PUBLICATIONS_COLLAPSED && (
                                        <details class="publications-more">
                                            <summary class="btn btn--text">
                                                <span class="publications-more__closed">View all {publications.length} publications</span>
                                                <span class="publications-more__open">Show fewer publications</span>
                                            </summary>
                                            {publications.slice(PUBLICATIONS_COLLAPSED).map((citation) => (
                                        <article class="publication">
                                            <h4 class="publication__title">
                                                {citation.doi ? (
                                                    <a
                                                        href={`https://doi.org/${citation.doi}`}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                    >
                                                        {citation.title}
                                                    </a>
                                                ) : (
                                                    <span>{citation.title}</span>
                                                )}
                                            </h4>
                                            <div class="publication__meta">
                                                {citation.journal && <span class="publication__journal">{citation.journal}</span>}
                                                {citation.year && <span class="publication__year">{citation.year}</span>}
                                                {(((citation as any).citationCount ?? citation.totalCitationCount ?? 0) > 0) && (
                                                    <span class="publication__citations">
                                                        {((citation as any).citationCount ?? citation.totalCitationCount ?? 0).toLocaleString()} citations
                                                    </span>
                                                )}
                                            </div>
                                            <div class="publication__links">
                                                {citation.doi && (
                                                    <a href={`https://doi.org/${citation.doi}`} target="_blank" rel="noopener" class="pub-link" title="DOI">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                                                            <polyline points="15 3 21 3 21 9"/>
                                                            <line x1="10" y1="14" x2="21" y2="3"/>
                                                        </svg>
                                                        DOI
                                                    </a>
                                                )}
                                                {citation.pubmedId && (
                                                    <a href={`https://pubmed.ncbi.nlm.nih.gov/${citation.pubmedId}`} target="_blank" rel="noopener" class="pub-link pub-link--pubmed" title="PubMed">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M4 19.5A2.5 2.5 0 016.5 17H20"/>
                                                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>
                                                        </svg>
                                                        PubMed
                                                    </a>
                                                )}
                                                {citation.isOpenAccess && citation.openAccessUrl && (
                                                    <a href={citation.openAccessUrl} target="_blank" rel="noopener" class="pub-link pub-link--oa" title="Open Access">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                                                        </svg>
                                                        Free PDF
                                                    </a>
                                                )}
                                            </div>
                                        </article>
                                    ))}
                                        </details>
                                    )}
                                </div>
                            </section>
                        )}

                        <!-- Expertise & Specializations -->
                        {((doctor.knowsAbout && doctor.knowsAbout.length > 0) ||
                          (doctor.rareConditions && doctor.rareConditions.length > 0) ||
                          (doctor.conditionsTreated && doctor.conditionsTreated.length > 0) ||
                          (doctor.techniquesInvented && doctor.techniquesInvented.length > 0) ||
                          (doctor.medicalSpecialty && doctor.medicalSpecialty.length > 0)) && (
                            <section class="card">
                                <h2 class="card__title">
                                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    Areas of Expertise
                                </h2>
                                <div class="expertise-container">
                                    {doctor.techniquesInvented && doctor.techniquesInvented.length > 0 && (
                                        <div class="expertise-group">
                                            <h3 class="expertise-group__title">Pioneering Techniques</h3>
                                            <div class="tags">
                                                {doctor.techniquesInvented.map(tech => (
                                                    <span class="tag tag--technique">{tech}</span>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                    {doctor.rareConditions && doctor.rareConditions.length > 0 && (
                                        <div class="expertise-group">
                                            <h3 class="expertise-group__title">Rare Conditions Treated</h3>
                                            <div class="tags">
                                                {doctor.rareConditions.map(condition => (
                                                    <span class="tag tag--rare">{condition}</span>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                    {doctor.medicalSpecialty && doctor.medicalSpecialty.length > 0 && (
                                        <div class="expertise-group">
                                            <h3 class="expertise-group__title">Medical Specialties</h3>
                                            <div class="tags">
                                                {doctor.medicalSpecialty.map(spec => (
                                                    <a href={`/doctors?specialty=${encodeURIComponent(spec)}`} class="tag tag--specialty" style="text-decoration: none;">{spec}</a>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                    {doctor.conditionsTreated && doctor.conditionsTreated.length > 0 && (
                                        <div class="expertise-group">
                                            <h3 class="expertise-group__title">Conditions & Diseases Treated</h3>
                                            <div class="tags">
                                                {doctor.conditionsTreated.map(condition => (
                                                    <a href={`/search?q=${encodeURIComponent(condition)}`} class="tag tag--condition" style="text-decoration: none;">{condition}</a>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                    {doctor.knowsAbout && doctor.knowsAbout.length > 0 && (
                                        <div class="expertise-group">
                                            <h3 class="expertise-group__title">Clinical Knowledge & Procedures</h3>
                                            <div class="tags">
                                                {doctor.knowsAbout.map(topic => (
                                                    <a href={`/search?q=${encodeURIComponent(topic)}`} class="tag" style="text-decoration: none;">{topic}</a>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                </div>
                            </section>
                        )}

                        <!-- Talks & Lectures -->
                        {doctor.talks && doctor.talks.length > 0 && (
                            <section class="card">
                                <h2 class="card__title">
                                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                                    </svg>
                                    Talks & Lectures
                                </h2>
                                <div class="talks-list">
                                    {doctor.talks.map((talk) => (
                                        <article class="talk-card">
                                            <div class="talk-card__year">{talk.year}</div>
                                            <div class="talk-card__content">
                                                <h3 class="talk-card__title">{talk.title}</h3>
                                                <p class="talk-card__event">{talk.event}</p>
                                            </div>
                                        </article>
                                    ))}
                                </div>
                            </section>
                        )}

                        <!-- Medical Lineage -->
                        {hasLineage && (
                            <section class="card">
                                <MedicalLineageGraph
                                    client:visible
                                    doctorName={doctor.fullName}
                                    mentors={doctor.mentors || []}
                                    students={doctor.students || []}
                                />
                            </section>
                        )}

                        <!-- Career Timeline -->
                        {hasTimeline && (
                            <section class="card">
                                <LegacyTimeline
                                    entries={doctor.timeline!}
                                    doctorName={doctor.fullName}
                                />
                            </section>
                        )}

                        <!-- Media Gallery -->
                        {hasMedia && (
                            <section class="card">
                                <h2 class="card__title">
                                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
                                    </svg>
                                    Media Archive
                                </h2>
                                <MediaVault
                                    portraitUrl={doctor.portraitUrl || ''}
                                    fullName={doctor.fullName}
                                    galleryUrls={doctor.galleryUrls || []}
                                    tier={doctor.tier}
                                    media={(doctor.media || []).map(m => ({
                                        type: m.type,
                                        url: m.url,
                                        title: m.title ?? undefined,
                                        description: m.description ?? undefined,
                                        source: m.source ?? undefined,
                                        video_id: m.video_id ?? undefined,
                                        thumbnail: m.thumbnail ?? undefined,
                                        is_featured: m.is_featured,
                                    }))}
                                />
                            </section>
                        )}

                        <!-- Similar Doctors -->
                        <SimilarDoctors
                            currentSlug={slug}
                            specialty={doctor.specialty}
                            country={doctor.geography.country}
                            region={doctor.geography.region}
                            tier={doctor.tier}
                            subSpecialty={doctor.subSpecialty}
                            techniques={doctor.techniquesInvented || []}
                            journals={topJournals as string[]}
                            hIndex={doctor.hIndex}
                        />
                    </div>

                    <!-- Sidebar -->
                    <aside class="sidebar-col">
                        <div class="sidebar-sticky">
                            <!-- Quick Facts Card -->
                            <div class="sidebar-card facts-card">
                                <h3 class="sidebar-card__title">Quick Facts</h3>
                                <dl class="facts-list">
                                    {doctor.dateOfBirth && (
                                        <div class="fact-row">
                                            <dt>Born</dt>
                                            <dd>{new Date(doctor.dateOfBirth).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</dd>
                                        </div>
                                    )}
                                    {isHistorical && doctor.dateOfDeath && (
                                        <div class="fact-row">
                                            <dt>Died</dt>
                                            <dd>{new Date(doctor.dateOfDeath).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</dd>
                                        </div>
                                    )}
                                    <div class="fact-row">
                                        <dt>Nationality</dt>
                                        <dd>{doctor.geography.country}</dd>
                                    </div>
                                    <div class="fact-row">
                                        <dt>Specialty</dt>
                                        <dd>{doctor.specialty}</dd>
                                    </div>
                                    {doctor.hIndex > 0 && (
                                        <div class="fact-row">
                                            <dt>H-Index</dt>
                                            <dd><strong>{doctor.hIndex}</strong></dd>
                                        </div>
                                    )}
                                    {doctor.yearsActive > 0 && (
                                        <div class="fact-row">
                                            <dt>Years Active</dt>
                                            <dd>{doctor.yearsActive}</dd>
                                        </div>
                                    )}
                                </dl>
                            </div>

                            <!-- Credentials Card -->
                            {(doctor.orcidId || doctor.npiNumber) && (
                                <div class="sidebar-card credentials-card">
                                    <h3 class="sidebar-card__title">Verified Credentials</h3>
                                    {doctor.orcidId && (
                                        <a href={`https://orcid.org/${doctor.orcidId}`} target="_blank" rel="noopener" class="credential-link">
                                            <img src="https://orcid.org/sites/default/files/images/orcid_16x16.png" alt="ORCID" width="16" height="16" />
                                            <span>{doctor.orcidId}</span>
                                        </a>
                                    )}
                                    {doctor.npiNumber && (
                                        <div class="credential-link">
                                            <span class="npi-icon">NPI</span>
                                            <span>{doctor.npiNumber}</span>
                                        </div>
                                    )}
                                </div>
                            )}

                            <!-- Practice Info Card (from Doctor Portal) -->
                            {!isHistorical && (doctor.languagesSpoken?.length || doctor.acceptedInsurance?.length || doctor.patientPhilosophy) && (
                                <div class="sidebar-card portal-card">
                                    <h3 class="sidebar-card__title">Practice Information</h3>
                                    {doctor.languagesSpoken && doctor.languagesSpoken.length > 0 && (
                                        <div class="portal-row">
                                            <span class="portal-row__label">Languages</span>
                                            <div class="portal-tags">
                                                {doctor.languagesSpoken.map(lang => (
                                                    <span class="portal-tag">{lang}</span>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                    {doctor.acceptedInsurance && doctor.acceptedInsurance.length > 0 && (
                                        <div class="portal-row">
                                            <span class="portal-row__label">Insurance Accepted</span>
                                            <div class="portal-tags">
                                                {doctor.acceptedInsurance.map(ins => (
                                                    <span class="portal-tag">{ins}</span>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                    {doctor.patientPhilosophy && (
                                        <div class="portal-row">
                                            <span class="portal-row__label">Philosophy</span>
                                            <p class="portal-philosophy">{doctor.patientPhilosophy}</p>
                                        </div>
                                    )}
                                    {doctor.bookingUrl && !showConsultation && (
                                        <a href={doctor.bookingUrl} target="_blank" rel="noopener" class="btn btn--primary btn--full">Book Appointment</a>
                                    )}
                                </div>
                            )}

                            <!-- Consultation Card (for living doctors) -->
                            {showConsultation && (
                                <div class="sidebar-card consultation-card">
                                    <h3 class="sidebar-card__title">Book Consultation</h3>
                                    {consultationFee && (
                                        <div class="price-row">
                                            <span>In-Person</span>
                                            <strong>{consultationFee}</strong>
                                        </div>
                                    )}
                                    {doctor.teleConsultationPrice && (
                                        <div class="price-row">
                                            <span>Video Call</span>
                                            <strong>{doctor.teleConsultationPrice}</strong>
                                        </div>
                                    )}
                                    <a href={doctor.bookingUrl!} target="_blank" rel="noopener" class="btn btn--primary btn--full">Book Appointment</a>
                                </div>
                            )}

                            <!-- Improve This Profile -->
                            <div class="sidebar-card suggest-card">
                                <div class="suggest-icon">
                                    <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                        <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                                    </svg>
                                </div>
                                <h3 class="suggest-title">Help Improve This Profile</h3>
                                <p class="suggest-text">Know additional details about {doctor.fullName.split(' ')[0]}? Share information to help make this profile more comprehensive.</p>
                                <div class="suggest-options">
                                    <a href={`/suggest-edit?profile=${slug}&type=citation`} class="suggest-option">
                                        <span class="suggest-option__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></span>
                                        <span>Add Citation</span>
                                    </a>
                                    <a href={`/suggest-edit?profile=${slug}&type=award`} class="suggest-option">
                                        <span class="suggest-option__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6m12 5h1.5a2.5 2.5 0 0 0 0-5H18M6 9a6 6 0 0 0 12 0V4H6v5zm3 12h6m-3-3v3"/></svg></span>
                                        <span>Add Award</span>
                                    </a>
                                    <a href={`/suggest-edit?profile=${slug}&type=affiliation`} class="suggest-option">
                                        <span class="suggest-option__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-4h6v4M12 7v4M10 9h4"/></svg></span>
                                        <span>Add Affiliation</span>
                                    </a>
                                    <a href={`/suggest-edit?profile=${slug}&type=general`} class="suggest-option">
                                        <span class="suggest-option__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></span>
                                        <span>Other Info</span>
                                    </a>
                                </div>
                                <p class="suggest-note">All suggestions are reviewed before publishing</p>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>
        </div>
        
        {isUnclaimed && (
            <ClaimProfile doctorName={doctor.fullName} slug={slug} />
        )}
    </article>
</Layout>

<script define:vars={{ slug, doctorFullName: doctor.fullName, doctorSpecialty: doctor.specialty, doctorTier: doctor.tier, doctorPortrait: doctor.portraitUrl || '' }}>
    // Save to recently viewed in localStorage
    try {
        const STORAGE_KEY = 'mdrpedia_recently_viewed';
        const MAX_ITEMS = 8;
        const raw = localStorage.getItem(STORAGE_KEY);
        const existing = raw ? JSON.parse(raw) : [];
        const filtered = existing.filter(p => p.slug !== slug);
        filtered.unshift({
            slug,
            fullName: doctorFullName,
            specialty: doctorSpecialty,
            tier: doctorTier,
            portraitUrl: doctorPortrait || undefined,
            viewedAt: Date.now(),
        });
        localStorage.setItem(STORAGE_KEY, JSON.stringify(filtered.slice(0, MAX_ITEMS)));
    } catch {}
</script>

<style>
    /* ═══════════════════════════════════════════════════════════════════════════
       DOCTOR PROFILE — PREMIUM MEDICAL DESIGN SYSTEM
       ═══════════════════════════════════════════════════════════════════════════ */

    /* Base Variables */
    .doctor-profile {
        --section-gap: 1.5rem;
        position: relative;
    }

    /* Tier-specific accent colors — editorial system uses minimal tier differentiation */
    .tier-titan {
        --accent: var(--aged-gold);
        --accent-rgb: 183, 142, 58;
    }

    .tier-elite {
        --accent: var(--ink-blue);
        --accent-rgb: 42, 98, 154;
    }

    .tier-master {
        --accent: var(--verdant);
        --accent-rgb: 74, 150, 100;
    }

    .tier-unranked {
        --accent: var(--slate);
        --accent-rgb: 120, 120, 140;
    }

    /* Unranked inherits base editorial styles — no overrides needed */

    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    /* ═══════════════════ HERO SECTION ═══════════════════ */
    .hero {
        position: relative;
        padding: 5rem 0 4rem;
        border-bottom: 1px solid var(--rule);
        overflow: hidden;
        background: var(--paper-2) !important;
    }

    .hero__container {
        position: relative;
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 4rem;
        align-items: start;
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .hero__portrait-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
    }

    .hero__frame {
        position: relative;
        width: 260px;
        height: 260px;
        border-radius: var(--r-4);
        overflow: hidden;
        border: 3px solid var(--accent, var(--rule));
        transition: all 0.4s var(--ease);
    }

    .hero__frame:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-3);
    }

    .hero__frame--titan { border-color: var(--aged-gold); }
    .hero__frame--elite { border-color: var(--ink-blue); }
    .hero__frame--master { border-color: var(--slate); }
    .hero__frame--unranked { border-color: var(--rule); }

    .hero__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: var(--r-4);
    }

    .hero__initials {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 5rem;
        font-weight: 400;
        background: var(--paper-3);
        color: var(--ink-3);
        border-radius: var(--r-3);
        letter-spacing: -0.05em;
        font-family: var(--font-serif);
    }

    .hero__badges {
        display: flex;
        gap: 0.5rem;
    }

    .verify-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        background: var(--verdant-2);
        border: 1px solid var(--verdant);
        border-radius: var(--r-2);
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--verdant);
        text-decoration: none;
        transition: all 0.2s;
    }

    .verify-badge:hover {
        transform: translateY(-1px);
        box-shadow: var(--shadow-1);
    }

    /* Hero Info Column */
    .hero__info-col {
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
        padding-top: 0.5rem;
    }

    .hero__tier-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .historical-tag {
        padding: 5px 12px;
        background: var(--paper-3);
        border: 1px solid var(--rule);
        border-radius: var(--r-2);
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-3);
    }

    .hero__name {
        font-family: var(--font-serif);
        font-size: clamp(2.25rem, 4.5vw, 3.25rem);
        font-weight: 400;
        line-height: 1.1;
        letter-spacing: -0.03em;
        color: var(--ink);
        margin: 0;
    }

    .hero__specialty {
        font-size: 1.125rem;
        font-weight: 500;
        color: var(--ink-2);
        margin: 0;
    }

    .hero__subspecialty {
        color: var(--ink-3);
        font-weight: 400;
    }

    .hero__location {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        color: var(--ink-3);
        margin: 0;
        padding: 6px 0;
    }

    .hero__location svg {
        color: var(--accent, var(--ink-3));
    }

    /* Hero Metrics - Glass Cards */
    .hero__metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    .metric {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 1rem 1.25rem;
        background: var(--paper);
        border: 1px solid var(--rule);
        border-radius: var(--r-3);
        min-width: 90px;
        text-align: center;
        transition: all var(--t-base) var(--ease);
    }

    .metric:hover {
        border-color: var(--rule-strong);
        transform: translateY(-2px);
        box-shadow: var(--shadow-1);
    }

    .metric__value {
        font-family: var(--font-mono);
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .metric__label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-3);
        margin-top: 4px;
        font-weight: 500;
    }

    .metric--impact {
        border-color: var(--accent, var(--rule));
    }

    .metric--impact .metric__value {
        color: var(--accent, var(--ink));
    }

    /* Hero Actions */
    .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
        padding-top: 1.75rem;
        border-top: 1px solid var(--rule);
    }

    .hero__actions > * {
        flex-shrink: 0;
    }

    /* ═══════════════════ AWARDS RIBBON ═══════════════════ */
    .awards-ribbon-section {
        position: relative;
        padding: 1.25rem 0;
        background: var(--paper-2);
        border-bottom: 1px solid var(--rule);
    }

    /* ═══════════════════ CONTENT LAYOUT ═══════════════════ */
    .content-wrapper {
        padding: 2.5rem 0 4rem;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 2rem;
        align-items: start;
    }

    /* ═══════════════════ CARDS ═══════════════════ */
    .card {
        position: relative;
        background: var(--paper);
        border: 1px solid var(--rule);
        border-radius: var(--r-3);
        padding: 1.75rem;
        margin-bottom: var(--section-gap);
        transition: all var(--t-base) var(--ease);
    }

    .card:hover {
        border-color: var(--rule-strong);
        box-shadow: var(--shadow-2);
    }

    .card--overview {
        border-left: 3px solid var(--accent, var(--ink-blue));
    }

    /* Four Pillars */
    .card--pillars {
        border-left: 3px solid var(--aged-gold, #b8860b);
    }
    .pillars__intro {
        font-size: 0.85rem;
        color: var(--ink-3);
        margin-bottom: 1.25rem;
    }
    .pillars__grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .pillar__head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.375rem;
    }
    .pillar__head svg {
        color: var(--ink-3);
        flex-shrink: 0;
    }
    .pillar__label {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--ink-2);
        flex: 1;
    }
    .pillar__value {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--ink);
    }
    .pillar__bar {
        height: 6px;
        background: var(--paper-3, #eee);
        border-radius: 3px;
        overflow: hidden;
    }
    .pillar__fill {
        height: 100%;
        background: var(--aged-gold, #b8860b);
        border-radius: 3px;
        transition: width 0.6s ease;
    }

    .card__title {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        font-family: var(--font-serif);
        font-size: 1rem;
        font-weight: 500;
        margin: 0 0 1.25rem;
        padding-bottom: 0.875rem;
        border-bottom: 1px solid var(--rule);
        color: var(--ink);
        letter-spacing: -0.01em;
    }

    .card__title svg {
        color: var(--accent, var(--ink-3));
        opacity: 0.8;
        width: 18px;
        height: 18px;
    }

    .card__summary {
        font-size: 1rem;
        line-height: 1.7;
        color: var(--ink-2);
        margin: 0;
    }

    .prose {
        font-size: 0.9375rem;
        line-height: 1.75;
        color: var(--ink-2);
    }

    .prose p {
        margin-bottom: 1rem;
    }

    .prose p:last-child {
        margin-bottom: 0;
    }

    /* ═══════════════════ AFFILIATIONS ═══════════════════ */
    .affiliations-grid {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .affiliation-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.125rem;
        background: var(--paper);
        border: 1px solid var(--rule);
        border-radius: var(--r-3);
        text-decoration: none;
        color: inherit;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
    }

    .affiliation-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(var(--accent-rgb), 0.03) 0%, transparent 50%);
        opacity: 0;
        transition: opacity 0.25s;
    }

    .affiliation-card:hover {
        background: var(--paper-2);
        border-color: rgba(var(--accent-rgb), 0.15);
        transform: translateX(4px);
        box-shadow: var(--shadow-2);
    }

    .affiliation-card:hover::before {
        opacity: 1;
    }

    .affiliation-card__logo {
        position: relative;
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        border-radius: var(--r-3);
        overflow: hidden;
        background: white;
        box-shadow: var(--shadow-1);
    }

    .affiliation-card__logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 6px;
        background: white;
    }

    .affiliation-card__initials {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 700;
        color: white;
        text-transform: uppercase;
        background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.8) 0%, rgba(var(--accent-rgb), 0.6) 100%);
    }

    .affiliation-card__info {
        flex: 1;
        position: relative;
    }

    .affiliation-card__name {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--ink);
        margin: 0 0 3px;
        letter-spacing: -0.01em;
    }

    .affiliation-card__role {
        font-size: 0.75rem;
        color: var(--ink-3);
        margin: 0;
        font-weight: 500;
    }

    .affiliation-card__arrow {
        position: relative;
        color: var(--ink-3);
        opacity: 0;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .affiliation-card:hover .affiliation-card__arrow {
        opacity: 1;
        transform: translateX(4px);
        color: rgba(var(--accent-rgb), 0.8);
    }

    /* ═══════════════════ RESEARCH SECTION ═══════════════════ */
    .research-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 0.875rem;
        margin-bottom: 2rem;
    }

    .research-stat {
        position: relative;
        flex: 1;
        min-width: 120px;
        padding: 1.5rem 1.25rem;
        background: var(--paper);
        border: 1px solid var(--rule);
        border-radius: var(--r-3);
        text-align: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
    }

    .research-stat::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 50% 0%, rgba(var(--accent-rgb), 0.08) 0%, transparent 60%);
        opacity: 0;
        transition: opacity 0.3s;
    }

    .research-stat:hover {
        transform: translateY(-3px);
        border-color: rgba(var(--accent-rgb), 0.2);
        box-shadow: var(--shadow-3);
    }

    .research-stat:hover::before {
        opacity: 1;
    }

    .research-stat--highlight {
        background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.1) 0%, rgba(var(--accent-rgb), 0.03) 100%);
        border-color: rgba(var(--accent-rgb), 0.25);
    }

    .research-stat__value {
        position: relative;
        display: block;
        font-family: var(--font-mono);
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.2;
        letter-spacing: -0.02em;
    }

    .research-stat__label {
        position: relative;
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--ink-3);
        margin-top: 6px;
        font-weight: 500;
    }

    .journals-section {
        margin-bottom: 2rem;
    }

    .journals-title, .publications-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--ink-3);
        margin: 0 0 1rem;
    }

    .journals-title::after, .publications-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, var(--rule), transparent);
    }

    .journals-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .journal-tag {
        position: relative;
        padding: 7px 14px;
        background: var(--ink-blue-2);
        border: 1px solid color-mix(in oklch, var(--ink-blue) 20%, transparent);
        border-radius: var(--r-pill);
        font-size: 0.75rem;
        font-weight: 550;
        color: var(--ink-blue);
        transition: all 0.2s;
    }

    .journal-tag:hover {
        background: color-mix(in oklch, var(--ink-blue) 15%, transparent);
        border-color: color-mix(in oklch, var(--ink-blue) 30%, transparent);
        transform: translateY(-1px);
    }

    /* Publications List */
    .publications-list {
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
    }

    .publication {
        position: relative;
        padding: 1.25rem 1.25rem 1.25rem 1.5rem;
        background: var(--paper);
        border-radius: var(--r-3);
        border: 1px solid var(--rule);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .publication::before {
        content: '';
        position: absolute;
        left: 0;
        top: 12px;
        bottom: 12px;
        width: 2px;
        background: linear-gradient(180deg, rgba(var(--accent-rgb), 0.6) 0%, rgba(var(--accent-rgb), 0.2) 100%);
        border-radius: 2px;
        opacity: 0;
        transition: opacity 0.25s;
    }

    .publication:hover {
        border-color: rgba(var(--accent-rgb), 0.15);
        background: var(--paper-2);
        transform: translateX(2px);
        box-shadow: var(--shadow-2);
    }

    .publication:hover::before {
        opacity: 1;
    }

    .publication__title {
        display: block;
        font-weight: 550;
        color: var(--ink);
        text-decoration: none;
        margin-bottom: 0.625rem;
        line-height: 1.5;
        font-size: 0.9375rem;
        letter-spacing: -0.01em;
        transition: color 0.2s;
    }

    .publication__title:hover {
        color: rgba(var(--accent-rgb), 1);
    }

    .publication__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.875rem;
        font-size: 0.8rem;
        color: var(--ink-3);
    }

    .publication__citations {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: rgba(var(--accent-rgb), 0.9);
        font-weight: 600;
        font-size: 0.75rem;
        padding: 2px 8px;
        background: rgba(var(--accent-rgb), 0.1);
        border-radius: 6px;
    }

    .publication__links {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.875rem;
    }

    .pub-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 5px 12px;
        background: var(--rule);
        border: 1px solid var(--rule);
        border-radius: 8px;
        font-size: 0.7rem;
        font-weight: 500;
        color: var(--ink-2);
        text-decoration: none;
        transition: all 0.2s;
    }

    .pub-link:hover {
        background: var(--paper-3);
        border-color: var(--rule-strong);
        color: var(--ink);
        transform: translateY(-1px);
    }

    .pub-link--pubmed {
        background: var(--ink-blue-2);
        border-color: color-mix(in oklch, var(--ink-blue) 20%, transparent);
        color: var(--ink-blue);
    }

    .pub-link--pubmed:hover {
        background: color-mix(in oklch, var(--ink-blue) 15%, transparent);
        border-color: color-mix(in oklch, var(--ink-blue) 30%, transparent);
    }

    .pub-link--oa {
        background: var(--verdant-2);
        border-color: color-mix(in oklch, var(--verdant) 20%, transparent);
        color: var(--verdant);
    }

    .pub-link--oa:hover {
        background: color-mix(in oklch, var(--verdant) 15%, transparent);
        border-color: color-mix(in oklch, var(--verdant) 30%, transparent);
    }

    /* Total Impact Metric */
    .metric--impact {
        background: var(--ink-blue-2);
        border-color: color-mix(in oklch, var(--ink-blue) 25%, transparent);
    }

    .metric--impact .metric__value {
        color: var(--ink-blue);
    }

    /* ═══════════════════ EXPERTISE TAGS ═══════════════════ */
    .expertise-container {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    .expertise-group__title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--ink-3);
        margin: 0 0 0.875rem;
    }

    .expertise-group__title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, var(--rule), transparent);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        position: relative;
        padding: 8px 16px;
        background: var(--paper-2);
        border: 1px solid var(--rule);
        border-radius: var(--r-pill);
        font-size: 0.8rem;
        color: var(--ink-2);
        font-weight: 500;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: default;
    }

    .tag:hover {
        background: var(--paper-3);
        border-color: var(--rule-strong);
        color: var(--ink);
        transform: translateY(-1px);
    }

    .tag--technique {
        background: var(--ink-blue-2);
        border-color: color-mix(in oklch, var(--ink-blue) 25%, transparent);
        color: var(--ink-blue);
        font-weight: 550;
    }

    .tag--technique:hover {
        background: color-mix(in oklch, var(--ink-blue) 15%, transparent);
        border-color: color-mix(in oklch, var(--ink-blue) 35%, transparent);
        box-shadow: var(--shadow-1);
    }

    .tag--rare {
        background: color-mix(in oklch, var(--sanguine) 8%, transparent);
        border-color: color-mix(in oklch, var(--sanguine) 25%, transparent);
        color: var(--sanguine);
        font-weight: 550;
    }

    .tag--rare:hover {
        background: color-mix(in oklch, var(--sanguine) 15%, transparent);
        border-color: color-mix(in oklch, var(--sanguine) 35%, transparent);
        box-shadow: var(--shadow-1);
    }

    .tag--specialty {
        background: var(--ink-blue-2);
        border-color: color-mix(in oklch, var(--ink-blue) 25%, transparent);
        color: var(--ink-blue);
        font-weight: 550;
    }

    .tag--specialty:hover {
        background: color-mix(in oklch, var(--ink-blue) 15%, transparent);
        border-color: color-mix(in oklch, var(--ink-blue) 35%, transparent);
        box-shadow: var(--shadow-1);
    }

    .tag--condition {
        background: color-mix(in oklch, var(--aged-gold) 8%, transparent);
        border-color: color-mix(in oklch, var(--aged-gold) 25%, transparent);
        color: var(--aged-gold);
        font-weight: 550;
    }

    .tag--condition:hover {
        background: color-mix(in oklch, var(--aged-gold) 15%, transparent);
        border-color: color-mix(in oklch, var(--aged-gold) 35%, transparent);
        box-shadow: var(--shadow-1);
    }

    /* Talks & Lectures */
    .talks-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .talk-card {
        position: relative;
        display: flex;
        gap: 1rem;
        padding: 1.125rem;
        background: var(--paper);
        border-radius: var(--r-3);
        border: 1px solid var(--rule);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .talk-card:hover {
        border-color: rgba(var(--accent-rgb), 0.15);
        background: var(--paper-2);
        transform: translateY(-2px);
        box-shadow: var(--shadow-2);
    }

    .talk-card__year {
        flex-shrink: 0;
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.12) 0%, rgba(var(--accent-rgb), 0.06) 100%);
        border: 1px solid rgba(var(--accent-rgb), 0.2);
        border-radius: var(--r-3);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 700;
        color: rgba(var(--accent-rgb), 0.9);
    }

    .talk-card__content {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .talk-card__title {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--ink);
        margin: 0 0 0.35rem;
        line-height: 1.4;
        letter-spacing: -0.01em;
    }

    .talk-card__event {
        font-size: 0.8rem;
        color: var(--ink-3);
        margin: 0;
        font-weight: 500;
    }

    /* ═══════════════════ SIDEBAR ═══════════════════ */
    .sidebar-col {
        position: relative;
    }

    .sidebar-sticky {
        position: sticky;
        top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .sidebar-card {
        position: relative;
        background: var(--paper);
        border: 1px solid var(--rule);
        border-radius: var(--r-4);
        padding: 1.5rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
    }

    .sidebar-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--rule), transparent);
    }

    .sidebar-card:hover {
        border-color: var(--rule-strong);
        transform: translateY(-2px);
        box-shadow: var(--shadow-3);
    }

    .sidebar-card__title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--ink-3);
        margin: 0 0 1.125rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--rule);
    }

    .facts-list {
        margin: 0;
    }

    .fact-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.625rem 0;
        border-bottom: 1px solid var(--rule);
        font-size: 0.8rem;
        transition: all 0.2s;
    }

    .fact-row:last-child {
        border-bottom: none;
    }

    .fact-row:hover {
        background: var(--paper-2);
        margin: 0 -0.5rem;
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        border-radius: 6px;
    }

    .fact-row dt {
        color: var(--ink-3);
        font-weight: 500;
    }

    .fact-row dd {
        margin: 0;
        color: var(--ink);
        text-align: right;
        font-weight: 600;
        font-size: 0.8rem;
    }

    /* Credentials Card */
    .credential-link {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 0.875rem 1rem;
        background: var(--paper-2);
        border: 1px solid var(--rule);
        border-radius: var(--r-3);
        margin-bottom: 0.6rem;
        text-decoration: none;
        color: var(--ink-2);
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .credential-link:hover {
        background: var(--paper-3);
        border-color: var(--rule-strong);
        transform: translateY(-1px);
        box-shadow: var(--shadow-1);
    }

    .npi-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        font-size: 0.5rem;
        font-weight: 800;
        background: var(--verdant);
        color: var(--paper);
        border-radius: 4px;
    }

    /* Portal (Practice Info) Card */
    .portal-card {
        background: var(--paper);
    }
    .portal-row {
        margin-bottom: 1rem;
    }
    .portal-row:last-child {
        margin-bottom: 0;
    }
    .portal-row__label {
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--ink-3);
        margin-bottom: 0.375rem;
        font-weight: 500;
    }
    .portal-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
    }
    .portal-tag {
        font-size: 0.75rem;
        padding: 2px 8px;
        background: var(--paper-2);
        border: 1px solid var(--rule);
        border-radius: var(--r-2);
        color: var(--ink-2);
    }
    .portal-philosophy {
        font-size: 0.85rem;
        color: var(--ink-2);
        line-height: 1.5;
        font-style: italic;
        margin: 0;
    }

    /* Consultation Card */
    .consultation-card {
        background: var(--paper);
        border-color: color-mix(in oklch, var(--verdant) 20%, transparent);
    }

    .consultation-card::before {
        background: linear-gradient(90deg, transparent, color-mix(in oklch, var(--verdant) 15%, transparent), transparent);
